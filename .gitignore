# hooks/hooks.json is NOT ignored, and that is deliberate. Claude Code reads the
# hook wiring from that exact path, so a repository without it installs from a
# marketplace and then does nothing at all — no presence, no guards, no
# messages, and no error to explain it. The committed copy is the shell entry
# point, which is right everywhere bash exists. The installer overwrites it with
# the Python one on hosts without a shell, and that copy has an interpreter path
# baked in, so on those machines it shows up as a local modification.

__pycache__/
*.pyc
.DS_Store
