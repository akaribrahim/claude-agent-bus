{
  "_comment": "Fallback entry point for hosts without bash (Windows without Git Bash). Exec form: no shell, so nothing depends on path separators or quoting. The installer replaces __PYTHON__ with the interpreter it found. It calls bin/hook.py, which is the fast path in Python: it imports os and sys and nothing else, answers 'nothing to do' without loading the engine, and when there is work imports the engine as a module so the bytecode cache applies. Measured on Windows 10: 281 ms per hook became ~105 ms for the common case.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON__",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/hook.py",
              "session-start"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON__",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/hook.py",
              "prompt-submit"
            ],
            "timeout": 12
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON__",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/hook.py",
              "pre-tool"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON__",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/hook.py",
              "record-write"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON__",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/hook.py",
              "post-bash"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON__",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/hook.py",
              "post-batch"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON__",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/hook.py",
              "session-end"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON__",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/hook.py",
              "subagent-start"
            ],
            "timeout": 12
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON__",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/hook.py",
              "subagent-stop"
            ],
            "timeout": 12
          }
        ]
      }
    ]
  }
}
