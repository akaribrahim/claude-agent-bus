#!/bin/bash
# agent-bus — hook fast path.
#
# This runs on EVERY tool batch of EVERY Claude Code session on this machine, so
# it must be nearly free. It uses shell builtins only (no subprocesses) to decide
# whether anything interesting can possibly have happened, and execs the Python
# engine only when it has. When you are the only live session, every event below
# short-circuits on the `live-count` gate — before reading stdin, because that
# read is a byte-at-a-time builtin loop and a large Write payload makes it the
# most expensive thing here.
#
# It must never fail a session: no `set -e`, every path exits 0 unless the engine
# itself deliberately returns a decision.

ev="$1"
BUS="${AGENTBUS_HOME:-$HOME/.claude/agent-bus}"
HERE="$(dirname "$0")"
ENGINE="$HERE/agentbus"

[ -n "$AGENTBUS_OFF" ] && exit 0
[ -x "$ENGINE" ] || exit 0

case "$ev" in
  session-start|session-end|prompt-submit)
    # Once per session or per user turn — always worth the engine. stdin is
    # inherited rather than slurped, so the payload never passes through bash.
    exec "$ENGINE" hook "$ev"
    ;;
esac

# ---- gated events -----------------------------------------------------------
[ -d "$BUS" ] || exit 0

# Is any live session behind the end of the event stream? Builtins only, and it
# runs only on the path where we are otherwise about to give up, so it costs two
# reads in the case that matters.
#
# Cursors of sessions that no longer exist are skipped: one left behind by a
# crash would lag for ever and hold this gate open on every batch.
unread() {
  local seq=0 cur c s
  [ -r "$BUS/events.seq" ] && read -r seq < "$BUS/events.seq"
  [ "${seq:-0}" != 0 ] || return 1
  for c in "$BUS"/cursors/*; do
    [ -f "$c" ] || continue
    s="${c##*/}"
    [ -f "$BUS/sessions/$s.json" ] || continue
    cur=0
    read -r cur < "$c"
    [ "$cur" = "$seq" ] || return 0
  done
  return 1
}

live=0
[ -r "$BUS/live-count" ] && read -r live < "$BUS/live-count"
if [ "${live:-0}" -gt 1 ] 2>/dev/null; then
  :
else
  # Alone: nothing can collide, nothing needs claiming, and every event below
  # short-circuits — with one exception. A session that has just left may have
  # handed something over that nobody has read yet, and its own exit is what
  # took the count back to one. Dropping the message there would lose exactly
  # the handoff the two-session case exists to deliver, which is the common one.
  case "$ev" in
    post-batch) unread || exit 0 ;;
    *) exit 0 ;;
  esac
fi

case "$ev" in
  post-bash)
    # Only worth a look if some command actually took a lock automatically.
    #
    # This event cannot carry the interference guard, however tempting it looks:
    # Claude Code does not fire PostToolUse when a tool call errors, so it never
    # arrives for a failing build — which is the only case that guard is about.
    # That work happens on post-batch instead.
    set -- "$BUS"/autoclaim/*
    [ -e "$1" ] || exit 0
    exec "$ENGINE" hook post-bash
    ;;
esac

# Slurp the hook payload. Returns non-zero at EOF; fine.
payload=""
IFS= read -r -d '' payload

sid=""
sid_re='"session_id"[[:space:]]*:[[:space:]]*"([^"]+)"'
[[ "$payload" =~ $sid_re ]] && sid="${BASH_REMATCH[1]}"

case "$ev" in
  post-batch)
    # Heartbeat is a bare truncate: the file's mtime IS the timestamp, so no
    # `date` subprocess and no write of any content.
    [ -n "$sid" ] && : > "$BUS/sessions/$sid.beat" 2>/dev/null
    [ -n "$sid" ] || exit 0
    # While somebody else is live the engine runs on every batch that ran a
    # command. It is not only asking "are there messages waiting" any more: it
    # reads what those commands printed, and gives back what the ones that
    # failed took, because a failing command never reaches PostToolUse at all.
    # One engine start per batch, in place of one per Bash call, which is what
    # this cost while the guard lived on post-bash.
    #
    # A batch that ran no Bash call cannot have printed anybody's build failure
    # and cannot have claimed anything, so it falls back to the cursor check.
    # This is an exact test, not a heuristic: the payload lists every call.
    bash_re='"tool_name"[[:space:]]*:[[:space:]]*"Bash"'
    if [ "${live:-0}" -le 1 ] || ! [[ "$payload" =~ $bash_re ]]; then
      seq=0; cur=0
      [ -r "$BUS/events.seq" ] && read -r seq < "$BUS/events.seq"
      [ -r "$BUS/cursors/$sid" ] && read -r cur < "$BUS/cursors/$sid"
      [ "$seq" = "$cur" ] && exit 0
    fi
    "$ENGINE" hook post-batch <<< "$payload"
    exit $?
    ;;

  record-write)
    # Remember what this session touched, and push the path into every other
    # live session's filter so their pre-tool fast path can see the collision
    # without waiting for their next user turn.
    [ -n "$sid" ] || exit 0
    fp=""
    for key in file_path notebook_path; do
      fp_re="\"$key\"[[:space:]]*:[[:space:]]*\"([^\"]+)\""
      if [[ "$payload" =~ $fp_re ]]; then fp="${BASH_REMATCH[1]}"; break; fi
    done
    [ -n "$fp" ] || exit 0
    now=$(date +%s)
    printf '%s %s\n' "$now" "$fp" >> "$BUS/writes/$sid.log" 2>/dev/null
    for f in "$BUS"/hot-for/*; do
      [ -f "$f" ] || continue
      case "$f" in */"$sid") continue ;; esac
      printf '%s\n' "$fp" >> "$f" 2>/dev/null
    done
    exit 0
    ;;

  pre-tool)
    tool=""
    tool_re='"tool_name"[[:space:]]*:[[:space:]]*"([^"]+)"'
    [[ "$payload" =~ $tool_re ]] && tool="${BASH_REMATCH[1]}"
    case "$tool" in
      Bash)
        # guard-tokens is one ERE alternation of literal substrings derived from
        # the configured patterns. No match anywhere in the payload means no
        # guarded resource can be involved — cheap, and never a false negative
        # because every pattern contributes a substring it must contain.
        tok=""
        [ -r "$BUS/guard-tokens" ] && read -r tok < "$BUS/guard-tokens"
        [ -n "$tok" ] || exit 0
        shopt -s nocasematch
        if [[ "$payload" =~ $tok ]]; then
          shopt -u nocasematch
        else
          shopt -u nocasematch
          exit 0
        fi
        ;;
      Edit|Write|NotebookEdit)
        [ -n "$sid" ] || exit 0
        [ -s "$BUS/hot-for/$sid" ] || exit 0
        printf '%s' "$payload" | grep -qF -f "$BUS/hot-for/$sid" || exit 0
        ;;
      *)
        exit 0
        ;;
    esac
    "$ENGINE" hook pre-tool <<< "$payload"
    exit $?
    ;;
esac

exit 0
