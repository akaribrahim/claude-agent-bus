<script>
/* Keyed, incremental updates — hand-rolled, because the self-contained rule is
   absolute and this is fifty lines.

   The board polls for as long as a tab is open. The old page rebuilt every
   section from a string on each poll, which threw away text selection
   mid-sentence, closed anything the reader had opened, reset scrolling inside
   those blocks, and made it impossible to show a change AS a change: after a
   wholesale redraw everything is equally new. So each row is created once under
   a stable key — the session id, the checkout, the resource, the event's
   sequence number — and afterwards only the fields that actually differ are
   written.

   Nothing here builds markup out of data either. Every value goes in as text, so
   no branch name, worktree path or message can arrive as HTML. */
var repo = localStorage.getItem("ab-repo") || "";
var seen = +(localStorage.getItem("ab-seen") || 0);   /* where the reader was */
var newest = 0, first = true, last = null;

function ago(ts, now){var d = Math.max(0, now - ts);
 if(d < 60) return d + "s"; if(d < 3600) return Math.floor(d/60) + "m";
 if(d < 86400) return Math.floor(d/3600) + "h" + ("0"+Math.floor(d%3600/60)).slice(-2);
 return Math.floor(d/86400) + "d";}
function clock(ts){var d = new Date(ts*1000);
 return ("0"+d.getHours()).slice(-2)+":"+("0"+d.getMinutes()).slice(-2)+":"+("0"+d.getSeconds()).slice(-2);}
function keep(x){return !repo || x.repo === repo;}
function many(n, one){return n + " " + one + (n === 1 ? "" : "s");}

function el(tag, cls, text){var n = document.createElement(tag);
 if(cls) n.className = cls; if(text != null) n.textContent = text; return n;}
function add(p, tag, cls, text){return p.appendChild(el(tag, cls, text));}
function gap(p){p.appendChild(document.createTextNode(" ")); return p;}
/* Write a value only when it is not the one already there. Touching the DOM for
   an unchanged value is what a diff is for; it also destroys a selection inside
   the node being written. */
function put(node, text){
 text = text == null ? "" : String(text);
 if(node.__v === text) return;
 var moved = node.__v !== undefined;
 node.__v = text; node.textContent = text;
 if(moved) flash(node);
}
/* The same write without the highlight, for a value that changes on every poll
   because it is a clock reading rather than news. "4s ago" becoming "6s ago" is
   not a change anybody wants their eye pulled to, and a page that is open for
   hours must not twitch every two seconds. Only the action itself flashes. */
function putq(node, text){
 text = text == null ? "" : String(text);
 if(node.__v === text) return;
 node.__v = text; node.textContent = text;
}
function flash(node){
 if(first) return;            /* the first paint is not a change */
 node.classList.remove("hit");
 void node.offsetWidth;       /* restart the animation instead of leaving the
                                 class on a node that has already played it */
 node.classList.add("hit");
}
function shown(node, on){var v = on ? "" : "none";
 if(node.style.display !== v) node.style.display = v;}
function hidden(node){return node.style.display === "none";}
function mark(node, cls, on){
 if(node.classList.contains(cls) === !!on) return;
 node.classList.toggle(cls, !!on);
 if(on) flash(node);
}
/* Match rows to items by key: build what is new, update what is already there,
   drop what has gone, and move only the nodes whose position really changed. */
function sync(parent, items, make, fill){
 var have = parent.__rows || (parent.__rows = {}), live = {}, prev = null, i;
 for(i = 0; i < items.length; i++){
  var it = items[i], k = String(it.k), node = have[k], made = !node;
  if(made) node = have[k] = make(it);
  live[k] = 1;
  var want = prev ? prev.nextSibling : parent.firstChild;
  if(node !== want) parent.insertBefore(node, want);
  fill(node, it, made);       /* after insertion: a fill may need to measure */
  prev = node;
 }
 Object.keys(have).forEach(function(k){
  if(!live[k]){parent.removeChild(have[k]); delete have[k];}});
}

/* ---- who this agent is --------------------------------------------------- */
/* Derived from the name and nothing else, so the same agent is the same figure
   on every reload, in every tab and on the second monitor — no table anybody
   has to maintain, and no server round trip. FNV-1a, salted once per trait so
   two traits of one name are independent. What leaves this function is a small
   integer: integers are all that reach the drawing, so a name can never arrive
   as markup by this route either. */
function fnv(s){var h = 2166136261 >>> 0;
 for(var i = 0; i < s.length; i++){
  h ^= s.charCodeAt(i); h = Math.imul(h, 16777619) >>> 0;}
 h ^= h >>> 15; h = Math.imul(h, 2246822507) >>> 0;
 h ^= h >>> 13; return h >>> 0;}
function trait(name, salt, n){return fnv(salt + "" + name) % n;}
/* Muted on purpose: an identity colour must never be mistaken for one of the
   page's four state colours. Dull is WHO, bright is WHAT IS HAPPENING. */
var HUES = [8, 32, 55, 96, 128, 158, 186, 208, 232, 262, 292, 330];
function idOf(name){name = name || "?";
 return {hue: HUES[trait(name, "hue", HUES.length)],
         shell: trait(name, "shell", 5), eyes: trait(name, "eyes", 5),
         crest: trait(name, "crest", 5), lean: trait(name, "lean", 5) - 2};}

var NS = "http://www.w3.org/2000/svg";
function sv(tag, attrs, parent){var n = document.createElementNS(NS, tag);
 for(var k in attrs) n.setAttribute(k, attrs[k]);
 if(parent) parent.appendChild(n); return n;}
var SHELL = [
 "M10 56C10 31 13 15 24 15S38 31 38 56Z",
 "M12 56V27a12 12 0 0 1 24 0v29Z",
 "M13.5 56 16.5 22Q24 13 31.5 22L34.5 56Z",
 "M24 13 37 22V45L24 56 11 45V22Z",
 "M12 56V20q0-5 5-5h14q5 0 5 5v36Z"];
var CREST = [
 null,
 function(g){sv("path", {"class": "line", d: "M24 15V7"}, g);
  sv("circle", {"class": "ink", cx: 24, cy: 5.4, r: 2}, g);},
 function(g){sv("path", {"class": "line", d: "M19 16 16 9M29 16 32 9"}, g);},
 function(g){sv("path", {"class": "ink", d: "M23 14V4.6L30.5 12.4Z"}, g);},
 function(g){sv("rect", {"class": "ink", x: 13.5, y: 10.5, width: 21,
  height: 3, rx: 1.5}, g);}];
function eyes(g, k){
 if(k === 0){sv("circle", {"class": "ink", cx: 18.6, cy: 33, r: 2.9}, g);
  sv("circle", {"class": "ink", cx: 29.4, cy: 33, r: 2.9}, g);}
 else if(k === 1){
  sv("rect", {"class": "ink", x: 17.1, y: 29, width: 3, height: 8, rx: 1.5}, g);
  sv("rect", {"class": "ink", x: 27.9, y: 29, width: 3, height: 8, rx: 1.5}, g);}
 else if(k === 2){
  sv("circle", {"class": "line", cx: 18.6, cy: 33, r: 3.2}, g);
  sv("circle", {"class": "line", cx: 29.4, cy: 33, r: 3.2}, g);}
 else if(k === 3){
  sv("path", {"class": "line", d: "M15 34.6q3.6-4.8 7.2 0"}, g);
  sv("path", {"class": "line", d: "M25.8 34.6q3.6-4.8 7.2 0"}, g);}
 else {sv("rect", {"class": "ink", x: 15.6, y: 30.4, width: 16.8, height: 5.4,
  rx: 2.7}, g);}
}
function figure(name){
 var id = idOf(name);
 var s = sv("svg", {"class": "fig", viewBox: "0 0 48 68"});
 s.style.setProperty("--h", id.hue + "deg");
 sv("ellipse", {"class": "shadow", cx: 24, cy: 63.6, rx: 13.5, ry: 2.6}, s);
 s.__plinth = sv("g", {}, s);
 var g = sv("g", {transform: "rotate(" + id.lean + " 24 56)"}, s);
 sv("path", {"class": "shell", d: SHELL[id.shell]}, g);
 eyes(g, id.eyes);
 if(CREST[id.crest]) CREST[id.crest](g);
 s.__stack = sv("g", {}, s);
 s.__arms = sv("g", {}, g);
 return s;
}
/* Commits this checkout is past its trunk, as courses under its feet. Capped:
   the sixth course says nothing the fifth did not, and the exact number is on
   the chip beside it. Nothing is drawn when the answer is nothing. */
function plinth(s, n){
 var g = s.__plinth, k = Math.min(n || 0, 5), i;
 if(g.__n === k) return; g.__n = k;
 while(g.firstChild) g.removeChild(g.firstChild);
 for(i = 0; i < k; i++)
  sv("rect", {"class": "plinth", x: 11.5 - i * .8, y: 56.4 + i * 1.9,
   width: 25 + i * 1.6, height: 1.5, rx: .7}, g);
}
/* Files written, as a stack of sheets it is carrying. Capped for the same
   reason; the chip has the count. */
function stack(s, n){
 var g = s.__stack, k = Math.min(n || 0, 5), i;
 if(g.__n === k) return; g.__n = k;
 while(g.firstChild) g.removeChild(g.firstChild);
 for(i = 0; i < k; i++)
  sv("rect", {"class": "sheet", x: 0.8, y: 49.6 - i * 2.6, width: 9.6,
   height: 6.4, rx: 1}, g);
}
/* Arms appear only to hold something. Empty hands mean it holds no lock, and
   that is a fact worth being able to see from across the room. */
function arms(s, holding){
 var g = s.__arms;
 if(g.__h === !!holding) return; g.__h = !!holding;
 while(g.firstChild) g.removeChild(g.firstChild);
 if(!holding) return;
 sv("path", {"class": "line", d: "M12.4 41q-3.2 4 .8 7.2M35.6 41q3.2 4-.8 7.2"}, g);
 sv("rect", {"class": "shell", x: 15.6, y: 44.4, width: 16.8, height: 8, rx: 2}, g);
 sv("circle", {"class": "ink", cx: 20, cy: 48.4, r: 1.5}, g);
 sv("path", {"class": "line", d: "M23.6 48.4h6"}, g);
}
function icon(parent, id){
 var s = sv("svg", {"class": "i", viewBox: "0 0 16 16"}, parent);
 sv("use", {href: "#" + id}, s).setAttributeNS(
  "http://www.w3.org/1999/xlink", "xlink:href", "#" + id);
 return s;
}
function chip(parent, cls, ico){
 var t = add(parent, "span", "tag " + cls);
 if(ico) icon(t, ico);
 t.__t = add(t, "span");
 return t;
}
/* A file list is opened by the reader, so it is held open with an inline style
   rather than a class: the test DOM can see that one and cannot see CSS, and a
   list hidden by a stylesheet would have every assertion about it passing while
   nobody could read it. */
function expander(files, list){
 shown(list, false);
 files.onclick = function(ev){
  if(ev && ev.stopPropagation) ev.stopPropagation();
  shown(list, hidden(list));};
}

/* ---- what a party last actually did ------------------------------------- */
/* Derived, not reported. The alternative was asking every agent to write a
   sentence about itself every minute, which costs a tool call and a round trip
   per agent per minute and fills the agent's own context with status reports —
   and is unreliable besides: on the live bus one agent in six used `take` at
   all. The hooks already see every tool call, so the fast path writes one line
   per party and this reads it.
   Separate nodes and not one string, because the TIME changes on every poll and
   the action does not — and because only ONE of these parts may be cut when the
   line will not fit. The target sits inside a box of its own that does the
   cutting, so the text still arrives on the node an assertion can name and the
   highlight still plays on the part that changed. */
var VERB = {Bash: "ran", Edit: "editing", Write: "writing",
            NotebookEdit: "editing"};
function makeDid(parent){
 var n = add(parent, "div", "did"), c = {};
 c.v = add(n, "span", "v");
 c.cut = add(n, "span", "cut");
 c.t = add(c.cut, "span", "tgt");
 c.wh = add(n, "span", "wh");
 c.w = add(n, "span", "w");
 n.c = c; return n;
}
function fillDid(n, did, now){
 shown(n, !!(did && did.what));
 if(!did || !did.what) return;
 put(n.c.v, VERB[did.tool] || did.tool);
 put(n.c.t, did.what);
 /* A path keeps its tail and a command keeps its head, so which end the cut
    comes off is decided by the tool. Not `mark`: this is which way a box
    overflows, and flashing a row because the cut turned round is not what the
    highlight is for. */
 n.classList.toggle("path", did.tool !== "Bash");
 /* Where the file is, when it is not in the checkout this figure is standing on.
    The strip's own heading says where the checkout is, so a path inside it needs
    no qualifier at all — and a path outside it needs one, or the line reads as
    though the repository had a `~/.claude` in it.
    The space before it is the stylesheet's, like every other gap on this line:
    a value written with a space in front of it is a value that reads wrong
    everywhere it is not drawn beside something. */
 put(n.c.wh, did.where || ""); shown(n.c.wh, !!did.where);
 /* The timestamp is when the hook SAW the call, which for a command is when it
    started. Two seconds later, on the poll that draws this, almost all of them
    have finished — and the one that has not says so by how old it is. */
 putq(n.c.w, ", " + ago(did.at, now) + " ago");
 /* Untruncated, on the element the eye is already on: what is drawn is cut to
    the width of the cell, and this is the whole of it. */
 n.title = did.tool + " — " + did.what + (did.where ? " " + did.where : "");
}

/* ---- one agent, standing on its checkout -------------------------------- */
/* Does this figure carry a BLOCK — a sentence it said, work it declared, or
   subagents standing under it? Each of those is genuinely block-shaped and
   cannot share a line with three short cells without either stretching them to
   its own height or hanging past them; and each of them is SHORTER given the
   whole strip than squeezed into a column, so this packs the page rather than
   stretching it. What the agent last DID is not on the list: that line is one
   line now, cut rather than wrapped, so it no longer needs a second column to
   stay one line. Asked in one place, because the packing and the order the
   figures are drawn in have to agree or a block splits a wrapped line of short
   figures in half. */
function block(s){
 return s.agents.length ? 1 : 0;
}
function makeCh(){
 var plot = el("div");           /* the plot of ground it is standing on */
 var d = add(plot, "div", "ch"), c = {};
 c.art = add(d, "div", "art");
 c.halo = add(c.art, "span", "halo");
 c.fig = null;                   /* built on the first fill: needs the name */
 c.info = add(d, "div", "info");
 /* The band beside the figure, above the ground line: who this agent is and what
    it said. It is a node of its own so the band has a floor — see `--say`. */
 var say = add(c.info, "div", "say");
 var top = add(say, "div", "top");
 c.nm = add(top, "div", "nm");
 c.tags = add(top, "div", "tags");
 c.br = chip(c.tags, "br");
 c.ahead = chip(c.tags, "ahead", "i-up");
 c.files = chip(c.tags, "files", "i-sheet");
 c.mail = chip(c.tags, "mail", "i-mail");
 c.own = chip(c.tags, "own", "i-key");
 c.claim = chip(c.tags, "claim", "i-claim");
 c.did = makeDid(c.info);
 c.clash = add(c.info, "div", "clash bad");
 c.list = add(c.info, "div", "list");
 expander(c.files, c.list);
 c.seen = add(c.info, "div", "seen");
 /* Outside the row and not inside it: the row opens the panel when it is
    clicked, and a subagent's own row must not open its parent's. */
 c.kids = add(plot, "div", "kids");
 plot.__ch = d; plot.c = c;
 if(!first) d.classList.add("arrive");
 return plot;
}

/* ---- one subagent, under the session that started it -------------------- */
/* Short on purpose. What can honestly be said about a subagent is its type, how
   long it has been running, the checkout it is in when that is not its
   parent's, what it holds under its own id, what it declared, and what it last
   did. Unread, commits past the trunk and files written are counted per
   SESSION — they are the parent's facts, and repeating them here to make the
   row look as substantial as the one above it would be inventing them. */
function makeKid(){
 var n = el("div", "kid"), c = {};
 c.art = add(n, "div", "art");
 c.fig = null;
 c.info = add(n, "div", "info");
 var top = add(c.info, "div", "top");
 c.nm = add(top, "div", "nm");
 c.tags = add(top, "div", "tags");
 c.kind = chip(c.tags, "kind", "i-sub");
 c.age = chip(c.tags, "age");
 c.br = chip(c.tags, "br");
 c.own = chip(c.tags, "own", "i-key");
 c.wt = add(c.info, "div", "kwt");
 c.did = makeDid(c.info);
 n.c = c;
 if(!first) n.classList.add("arrive");
 return n;
}
function fillKid(n, it){
 var a = it.a, c = n.c;
 if(c.who !== a.name){
  c.who = a.name;
  if(c.fig) c.art.removeChild(c.fig);
  c.fig = figure(a.name);       /* its own face, from its own name */
  c.art.appendChild(c.fig);
 }
 c.art.title = a.name + (a.type ? " — " + a.type : "") + " — " + a.root;
 put(c.nm, a.name);
 put(c.kind.__t, a.type || "agent");
 /* Quietly, like every other clock reading on this page. */
 putq(c.age.__t, "running " + ago(a.started, it.now));
 /* Its own checkout, and only when it is not the one its parent is standing on.
    Sharing the parent's means the strip above already says it, and saying it
    twice is how a row stops being read at all. */
 var away = !!a.root && a.root !== it.root;
 put(c.wt, away ? a.root : ""); shown(c.wt, away);
 c.wt.title = away ? a.root : "";
 put(c.br.__t, a.branch || "no branch");
 shown(c.br, away);
 /* Locks carry `agent_id`, so this is the subagent's own and not its session's.
    A subagent holding the simulator is exactly what somebody watching wants to
    see, and until now it was a dot. */
 put(c.own.__t, "holds " + a.holds); shown(c.own, !!a.holds);
 arms(c.fig, !!a.holds);
 fillDid(c.did, a.did, it.now);
}
function fillCh(plot, it){
 var s = it.s, c = plot.c, d = plot.__ch;
 /* First fill — or this chat took a new name, which happens on the live bus
    whenever somebody renames a session. The figure IS the name, so a renamed
    agent that kept its old face would be walking around as somebody else. */
 if(c.who !== s.agent){
  c.who = s.agent;
  if(c.fig) c.art.removeChild(c.fig);
  c.fig = figure(s.agent);
  c.art.appendChild(c.fig);
  d.onclick = function(){openPanel(c.who);};
 }
 /* The chip that names the figure hangs on the FIGURE. It used to hang on the
    whole row — which for a checkout with one agent in it is the full width of
    the strip, measured at 1240×76 — so the browser popped it anywhere in that
    band, a thousand pixels from the thing it named, and under a sticky header
    it read as a chip stranded on the header. Rewritten every fill, never once,
    so it cannot go on naming a checkout the session has left. */
 c.art.title = s.agent + " — " + s.root;
 CHARS[s.agent] = c.art;
 c.art.__plot = plot;   /* the plot it stands on, for the arc's headroom */
 /* Its subagents, indented under it, each carrying its own fields. Keyed by
    `aid` and not by name, because a name is reused: the second subagent of a
    session that has already retired one is `agentbus/2` again. */
 sync(c.kids, s.agents.map(function(a, i){
   return {k: "sa:" + (a.aid || a.name || i), a: a, root: s.root, now: it.now,
    };}),
  makeKid, fillKid);
 mark(d, "idle", !!s.idle);
 mark(d, "wait", !!s.waiting);
 /* Not `mark`: this is the tree's spine, and flashing a whole row because a
    subagent started is not what the highlight is for. */
 d.classList.toggle("tree", !!s.agents.length);
 put(c.nm, s.agent);
 /* Carrying a block, so this figure takes the whole strip. */
 if(block(s)) plot.setAttribute("data-block", "1");
 else plot.removeAttribute("data-block");
 put(c.br.__t, s.branch || "no branch");
 /* null: not counted yet — the poll runs no git and waits for nothing. "": this
    tree has no default branch to be ahead of. 0: it is on the trunk. The last
    two are nothing to say, and the first is worth saying. */
 var known = s.ahead_of !== null && s.ahead_of !== "";
 put(c.ahead.__t, known ? (s.ahead ? "+" + s.ahead : "") : "…");
 c.ahead.title = known ? s.ahead + " commits past " + s.ahead_of
   : (s.ahead_of === null ? "not counted yet" : "");
 shown(c.ahead, s.ahead_of === null || (known && !!s.ahead));
 plinth(c.fig, known ? s.ahead : 0);
 put(c.files.__t, many(s.wrote_n, "file") + " written");
 shown(c.files, !!s.wrote_n);
 stack(c.fig, s.wrote_n);
 put(c.mail.__t, s.unread + " unread"); shown(c.mail, !!s.unread);
 put(c.own.__t, "holds " + s.owns); shown(c.own, !!s.owns);
 arms(c.fig, !!s.owns);
 /* How many of this session's commands took a shared resource. Nothing else on
    the page says a session has been reaching for the machine at all. */
 put(c.claim.__t, many(s.guarded, "claim"));
 c.claim.title = s.guarded + " commands took a shared resource";
 shown(c.claim, !!s.guarded);
 /* What the bus watched it do, derived from the tool calls the hooks already
    see:
    the line under it is the check on whether the intent is still what is
    happening. */
 fillDid(c.did, s.did, it.now);
 put(c.clash, s.clash.map(function(x){
   return x.path + " — also " + x.also.join(", ");}).join("\n"));
 shown(c.clash, !!s.clash.length);
 put(c.list, s.wrote.join("\n") +
   (s.wrote_n > s.wrote.length ? "\n+" + (s.wrote_n - s.wrote.length) + " older" : ""));
 put(c.seen, s.idle ? "quiet " + ago(s.beat, it.now) : "");
 shown(c.seen, !!s.idle);
}


/* ---- what this checkout would land ------------------------------------- */
function makeGate(){
 var n = el("div", "cand"), c = {};
 c.g = add(n, "span", "g"); icon(c.g, "i-gate"); c.gt = add(c.g, "span");
 c.gb = add(n, "div", "gb"); c.gw = add(n, "div", "gw");
 n.c = c; return n;
}
function fillGate(n, it){var b = it.b, c = n.c;
 put(c.gt, b.onto === "clean" ? "+" + b.ahead + " clear onto the trunk"
   : b.onto === "conflict" ? "+" + b.ahead + " conflicts in "
     + b.onto_conflicts.join(", ")
   : "+" + b.ahead + " not computable");
 mark(c.g, "bad", b.onto !== "clean");
 put(c.gb, b.branch + " · " + many(b.files_n, "file") +
   (b.who && b.who.length ? " · " + b.who.join(", ") + " on it" : ""));
 put(c.gw, b.dirty ? b.dirty + " uncommitted in this checkout" : "");
 shown(c.gw, !!b.dirty);}

/* ---- projects, as a filter --------------------------------------------- */
function makeProj(it){var b = el("button", "proj");
 b.c = {nm: add(b, "span", "nm"), meta: add(b, "span", "pmeta")};
 b.onclick = function(){repo = it.key;
  localStorage.setItem("ab-repo", repo); if(last) render(last);};
 return b;}
function fillProj(b, it){put(b.c.nm, it.label); put(b.c.meta, it.meta);
 mark(b, "on", it.key === repo);}

/* ---- landing, in full -------------------------------------------------- */
/* The strip's own gate says what this checkout would land. This says what would
   happen if all of it landed together — which branches would fight each other,
   what was finished but is not ready, and the command to run. Read-only, and
   deliberately with nothing to press: a control that spends model calls when it
   is clicked is a different kind of object from a window that only watches. */
function makeLand(){var tr = el("tr", "land"), c = {}, td = add(tr, "td");
 c.branch = add(td, "span", "name mono");
 c.ahead = add(tr, "td", "mono");
 td = add(tr, "td");
 c.onto = add(td, "span"); c.oconf = add(td, "div", "clash");
 td = add(tr, "td", "mono");
 c.root = add(td, "span"); c.dirty = add(gap(td), "div", "warn");
 td = add(tr, "td");
 c.tasks = add(td, "div", "clash");
 c.files = add(td, "div", "files"); c.list = add(td, "div", "list");
 expander(c.files, c.list);
 tr.c = c; return tr;}
function fillLand(tr, it){var b = it.b, c = tr.c;
 put(c.branch, b.branch);
 put(c.ahead, "+" + b.ahead + (b.behind ? " / -" + b.behind : ""));
 put(c.onto, b.onto === "clean" ? "clean" :
   b.onto === "conflict" ? "conflicts" : "not computable");
 mark(c.onto, "ok", b.onto === "clean");
 mark(c.onto, "bad", b.onto !== "clean");
 put(c.oconf, b.onto === "conflict" ? b.onto_conflicts.join("\n")
   : b.onto === "unknown" ? b.onto_why : "");
 shown(c.oconf, b.onto !== "clean");
 mark(c.oconf, "bad", b.onto === "conflict");
 put(c.root, b.root || "not checked out");
 /* The difference between "ready" and "looks ready": the branch is ahead, and
    its checkout still has work in it that a merge of the branch would not take. */
 put(c.dirty, b.dirty ? b.dirty + " uncommitted" : "");
 shown(c.dirty, !!b.dirty);
 /* Who is on it, which is the thing to know before merging under somebody. */
 put(c.tasks, b.who && b.who.length ? b.who.join(", ") + " on it right now" : "");
 put(c.files, many(b.files_n, "file") + " changed");
 shown(c.files, !!b.files_n);
 put(c.list, b.files.join("\n") +
   (b.files_n > b.files.length ? "\n+" + (b.files_n - b.files.length) + " more" : ""));}
function makePair(){var tr = el("tr", "pair");
 tr.c = {t: add(tr, "td")}; tr.c.t.colSpan = 5; return tr;}
function makeGrp(){var tr = el("tr", "grp");
 tr.c = {t: add(tr, "td")}; tr.c.t.colSpan = 5; return tr;}
function makeNone(){var tr = el("tr");
 tr.c = {t: add(tr, "td", "empty")}; tr.c.t.colSpan = 5; return tr;}
function fillSpan(tr, it){put(tr.c.t, it.label);}

/* ---- services ---------------------------------------------------------- */
function makeServe(){var tr = el("tr"), c = {}, td = add(tr, "td");
 c.res = add(td, "span", "name mono"); c.port = add(gap(td), "span", "meta mono");
 c.desc = add(td, "div", "meta");
 c.root = add(tr, "td", "mono");
 c.by = add(tr, "td", "meta");
 td = add(tr, "td");
 c.holder = add(td, "span", "name"); c.held = add(gap(td), "span", "meta");
 c.free = add(td, "span", "ok", "free"); c.why = add(td, "div", "meta");
 td = add(tr, "td");
 c.state = add(td, "span"); c.churn = add(td, "div", "warn");
 tr.c = c; return tr;}
function fillServe(tr, it){var s = it.s, c = tr.c;
 put(c.res, s.resource);
 put(c.port, s.port ? ":" + s.port : ""); shown(c.port, !!s.port);
 put(c.desc, s.desc); shown(c.desc, !!s.desc);
 put(c.root, s.root || "—"); put(c.by, s.by || "—");
 put(c.holder, s.held_by);
 put(c.held, s.held_by ? ago(s.held_since, it.now) +
   (s.held_mode === "hard" ? " hard" : "") : "");
 put(c.why, s.held_why); shown(c.why, !!(s.held_by && s.held_why));
 shown(c.holder, !!s.held_by); shown(c.held, !!s.held_by);
 shown(c.free, !s.held_by);
 put(c.state, s.alive ? "running" : (s.movable ? "not started" : "not a service"));
 mark(c.state, "ok", s.alive); mark(c.state, "meta", !s.alive);
 put(c.churn, s.churn >= 3 ? "moved " + s.churn + "× between " +
   s.churn_roots.join(" and ") : "");
 shown(c.churn, s.churn >= 3);}

/* ---- feed -------------------------------------------------------------- */
function makeEv(it){var d = el("div", "ev k-" + it.e.kind), c = {};
 c.t = add(d, "span", "t");
 c.who = add(d, "span", "who"); c.name = add(c.who, "span");
 c.kind = add(add(c.who, "div"), "span", "meta");
 c.txt = add(d, "span", "txt");
 c.txt.onclick = function(){c.txt.classList.toggle("open");};
 d.c = c; if(!first) d.classList.add("arrive"); return d;}
function fillEv(d, it, made){var e = it.e, c = d.c;
 put(c.t, clock(e.ts));
 put(c.name, e.agent + (e.to ? " → " + e.to : ""));
 /* The kind, and for one that repeats, which of the run this is. A wrong-port
    bypass is announced once and counted after that, so the twenty-seventh line
    carries no sentence of its own — the number is the only thing on it that is
    new, and without it the row is indistinguishable from the first. */
 put(c.kind, e.again > 1 ? e.kind + " ×" + e.again : e.kind);
 put(c.txt, e.text);
 /* Only measurable once it is in the document, and an event's text never
    changes afterwards, so this is asked once per event and not once per poll. */
 if(made && c.txt.scrollHeight > c.txt.clientHeight + 2) c.txt.classList.add("clip");}
function makeSince(){var d = el("div", "since", "since you last looked");
 d.title = "click to clear"; d.onclick = looked; return d;}

/* The divider is the reader's own business, so it lives in this browser and
   nowhere else: the server is read-only and remembers nothing about whoever is
   watching, and a cursor kept there would be one two tabs had to share.

   The mark moves when the reader stops looking — and only if they were looking
   in the first place. A board opened in a background tab, or in a window that is
   not the front one, is handed a blur it never earned, and taking that as "read"
   throws away the one thing the divider was for. */
var watching = document.hasFocus() && !document.hidden;
function looked(){
 if(!newest) return;
 seen = newest; localStorage.setItem("ab-seen", String(newest));
 if(last) render(last);
}
function away(){if(!watching) return; watching = false; looked();}
window.addEventListener("focus", function(){watching = true;});
window.addEventListener("blur", away);
document.addEventListener("visibilitychange", function(){
 if(document.hidden) away(); else if(document.hasFocus()) watching = true;});

/* ---- two sessions wrote one file --------------------------------------- */
/* Drawn between the two figures, because it is the only fact here that is about
   a pair. Keyed like everything else, so a collision that is still there on the
   next poll is not redrawn and does not animate again. */
var CHARS = {};
function makeTeth(){var g = sv("g", {"class": "tether"});
 g.__p = sv("path", {}, g); g.__t = sv("text", {"text-anchor": "middle"}, g);
 return g;}
function fillTeth(g, it){
 g.__p.setAttribute("d", it.d);
 g.__t.setAttribute("x", it.x); g.__t.setAttribute("y", it.y);
 if(g.__t.textContent !== it.path) g.__t.textContent = it.path;}
function tethers(host, ss){
 var svg = host.__teth;
 if(!svg){svg = host.__teth = sv("svg", {"class": "tethers"}); host.appendChild(svg);}
 requestAnimationFrame(function(){
  var box = host.getBoundingClientRect(), items = [], done = {};
  svg.setAttribute("width", box.width); svg.setAttribute("height", box.height);
  svg.setAttribute("viewBox", "0 0 " + Math.round(box.width) + " " +
   Math.round(box.height));
  /* `ceil` is the top of the PLOT this figure is standing on, which is what the
     arc has to stay under. Not the yard, which is every project, so a lift
     clamped against it is not clamped at all — and no longer the whole strip
     either: a strip whose figures wrap onto a second line has a second row of
     heads, and the top of the strip is a ceiling somewhere above the row before
     it. The headroom a tied strip declares is the plot's own padding, so the
     plot's top edge is exactly the height the arc may reach. */
  function at(name){var n = CHARS[name]; if(!n) return null;
   var r = n.getBoundingClientRect(),
       f = (n.__plot || n).getBoundingClientRect();
   return {x: r.left - box.left + r.width / 2, y: r.top - box.top + 14,
           ceil: f.top - box.top};}
  ss.forEach(function(s){s.clash.forEach(function(cl){cl.also.forEach(function(o){
   var k = [s.agent, o].sort().join("|") + "|" + cl.path;
   if(done[k]) return; done[k] = 1;
   var a = at(s.agent), b = at(o);
   if(!a || !b) return;
   /* Never out of the strip. The arc and its label belong BETWEEN two figures,
      and the figures sit about thirty pixels below the top of their strip, so an
      unclamped lift put both above it — over the project's heading, and off the
      top of the yard entirely for the first strip on the page: a red path
      floating where nothing it describes is. */
   var head = Math.min(a.y, b.y),
       lift = Math.max(6, Math.min(30 + Math.abs(a.x - b.x) * .10, 44,
                                   head - Math.max(a.ceil, b.ceil) - 16));
   items.push({k: k, path: cl.path,
    d: "M" + a.x + " " + a.y + " Q" + (a.x + b.x) / 2 + " " +
       (head - lift) + " " + b.x + " " + b.y,
    x: (a.x + b.x) / 2, y: head - lift - 3});});});});
  sync(svg, items, makeTeth, fillTeth);
 });
}

/* ---- one character, every field of it ---------------------------------- */
var PANEL = null;
function openPanel(name){
 var s = null, i;
 for(i = 0; i < (last ? last.sessions.length : 0); i++)
  if(last.sessions[i].agent === name) s = last.sessions[i];
 if(!s) return;
 var p = document.getElementById("panel"), c = p.__c;
 if(!c){
  c = p.__c = {};
  var b = add(p, "button", "close", "close");
  b.onclick = function(){p.classList.remove("open"); PANEL = null;};
  var top = add(p, "div", "ptop");
  c.fig = add(top, "div");
  var t = add(top, "div");
  c.h = add(t, "h3"); c.sub = add(t, "div", "seen");
  c.dl = add(p, "dl");
 }
 while(c.fig.firstChild) c.fig.removeChild(c.fig.firstChild);
 var f = figure(s.agent); f.setAttribute("class", "fig pfig");
 c.fig.appendChild(f);
 plinth(f, s.ahead_of ? s.ahead : 0); stack(f, s.wrote_n); arms(f, !!s.owns);
 put(c.h, s.agent);
 put(c.sub, s.repo_label + " · " + (s.idle ? "quiet for " +
  ago(s.beat, last.now) : "working, seen " + ago(s.beat, last.now) + " ago"));
 var rows = [
  ["worktree", s.root, 1],
  ["branch", (s.branch || "detached") +
   (s.ahead_of ? "   " + s.ahead + " ahead of " + s.ahead_of : ""), 1],
  ["session", s.sid, 1],
  ["holds", s.owns || "nothing", 0],
  ["claimed", s.guarded + " commands took a shared resource", 0],
  ["unread", s.unread + (s.waiting ? "   waiting for you" : ""), 0],
  ["wrote", s.wrote.length ? s.wrote.join("\n") +
    (s.wrote_n > s.wrote.length ? "\n+" + (s.wrote_n - s.wrote.length) + " older"
     : "") : "nothing", 1],
  ["clashes", s.clash.map(function(x){
    return x.path + "   also " + x.also.join(", ");}).join("\n") || "none", 1],
  ["last did", s.did && s.did.what ? (VERB[s.did.tool] || s.did.tool) + " " +
    s.did.what + "   " + ago(s.did.at, last.now) + " ago" : "—", 0],
  ["subagents", s.agents.map(function(a){
    return a.name + (a.type ? "   " + a.type : "") +
      (a.root && a.root !== s.root ? "   in " + a.root : "") +
      (a.holds ? "   holds " + a.holds : "") +
      (a.did && a.did.what ? "   " + (VERB[a.did.tool] || a.did.tool) + " " +
        a.did.what : "");}).join("\n") || "none", 0]];
 sync(c.dl, rows.map(function(r){return {k: r[0], r: r};}),
  function(){var n = el("div"); shown(n, false); return n;},
  function(n, it){
   if(!n.__dt){n.__dt = 1;
    n.__k = el("dt"); n.__d = el("dd");
    n.parentNode.insertBefore(n.__k, n); n.parentNode.insertBefore(n.__d, n);}
   put(n.__k, it.r[0]); put(n.__d, it.r[1]);
   mark(n.__d, "mono", !!it.r[2]);});
 p.classList.add("open"); PANEL = s.agent;
}

/* ---- the yard ---------------------------------------------------------- */
/* Ordered by how many agents a project has, busiest first. Five agents in one
   project and one each in four others is the case that matters, and putting the
   crowd at the top is the difference between reading the page and scrolling
   for it. Within a project, the same rule for its checkouts. */
function yard(d, ss, lands, now){
 var pr = {}, order = [], plist = [];
 function P(key, label){
  var p = pr[key];
  if(!p){p = pr[key] = {key: key, label: label || key, ss: [], cand: []};
   order.push(key);}
  if(label) p.label = label;
  return p;}
 ss.forEach(function(s){P(s.repo, s.repo_label).ss.push(s);});
 lands.forEach(function(L){
  L.candidates.forEach(function(b){P(L.repo).cand.push(b);});});
 d.repos.forEach(function(r){if(pr[r.key]) pr[r.key].label = r.label || r.key;});
 order.sort(function(a, b){
  return pr[b].ss.length - pr[a].ss.length ||
   (pr[a].label < pr[b].label ? -1 : pr[a].label > pr[b].label ? 1 : 0);});

 order.forEach(function(key){
  var p = pr[key], roots = [], on = {}, bands = [];
  function R(root){if(!(root in on)){on[root] = []; roots.push(root);} return on[root];}
  p.ss.forEach(function(s){R(s.root).push(s);});
  /* A branch that is ahead of the trunk and a piece of work whose chat has gone
     both belong to a checkout. Give that checkout its strip even when nobody is
     standing on it: it reads as ground with nothing on it, which is the fact. */
  p.cand.forEach(function(b){R(b.root);});
  roots.sort(function(a, b){
   return on[b].length - on[a].length ||
    (!a ? 1 : !b ? -1 : a < b ? -1 : a > b ? 1 : 0);});
  roots.forEach(function(root){
   bands.push({k: "b:" + root, root: root, now: now,
    many: roots.length > 1, ss: on[root],
    cand: p.cand.filter(function(b){return b.root === root;})});});
  /* The strips go INSIDE the project, not after it. Whitespace and a hairline
     between one heading and the next made five projects read as one list; a
     project that CONTAINS its checkouts can be drawn as the one bounded thing
     it is. */
  plist.push({k: "p:" + key, label: p.label, bands: bands,
   meta: many(p.ss.length, "agent") + " · " +
    many(roots.filter(Boolean).length, "checkout")});});
 if(!plist.length) plist.push({k: "none", label: "nobody is live", bands: [],
  meta: "no session has joined the bus"});
 sync(document.getElementById("agents"), plist, makePrj, fillPrj);
 tethers(document.getElementById("agents"), ss);
}
function makePrj(){var n = el("div", "prj"), c = {}, h = add(n, "div", "ph");
 c.nm = add(h, "span", "pn"); c.m = add(h, "span", "pm");
 c.bands = add(n, "div", "pb"); n.c = c; return n;}
function fillPrj(n, it){var c = n.c;
 put(c.nm, it.label); put(c.m, it.meta);
 sync(c.bands, it.bands, makeBand, fillBand);}
function makeBand(){
 var n = el("div", "band"), c = {}, head = add(n, "div", "wt");
 c.path = add(head, "div", "pt");
 /* An inner span, so the path itself is a left-to-right run inside a box that
    overflows from the left. `put` writes text, which would drop this child. */
 c.pn = add(c.path, "span");
 c.pc = add(head, "div", "pc");
 c.floor = add(n, "div", "floor");
 c.left = add(n, "div", "left");
 c.gate = add(n, "div", "gate");
 n.c = c; return n;}
function fillBand(n, it){
 var c = n.c;
 put(c.pn, it.root || "— not checked out");
 /* Untruncated, on the element the eye is already on: a worktree path is the
    one thing on this page most worth copying, and what is drawn may be cut. */
 c.path.title = it.root || "";
 put(c.pc, it.many && it.ss.length ? many(it.ss.length, "agent") + " here"
   : "");
 shown(c.pc, !!(it.many && it.ss.length));
 mark(c.floor, "bare", !it.ss.length);
 /* Headroom for an arc between two of the figures on this strip. Not `mark`:
    this is layout, and flashing a whole strip because a collision appeared is
    not what the highlight is for. */
 c.floor.classList.toggle("tied", it.ss.some(function(s){
   return !!s.clash.length;}));
 sync(c.floor, it.ss.map(function(s){
   return {k: "c:" + s.sid, s: s, now: it.now};}).sort(function(a, b){
   /* Every figure carrying a block first, then every short one — the SAME test
      the packing uses, so the full-width rows come out stacked and the short
      cells pack together onto lines of their own. Interleaved, one block cut a
      wrapped line of short figures in half and left each half standing on its
      own stub of ground. */
   return block(b.s) - block(a.s)
    || b.s.wrote_n - a.s.wrote_n || b.s.unread - a.s.unread
    || (a.s.agent < b.s.agent ? -1 : a.s.agent > b.s.agent ? 1 : 0);}),
  makeCh, fillCh);
 sync(c.gate, it.cand.map(function(b){
   return {k: "g:" + b.branch, b: b};}), makeGate, fillGate);
}

function render(d){
 last = d;
 var now = d.now;
 var ss = d.sessions.filter(keep), lk = d.locks.filter(keep),
     sv = d.serves.filter(keep), ev = d.events.filter(keep),
     lands = (d.landing || []).filter(keep);
 var repos = {};
 ss.forEach(function(s){repos[s.repo] = 1;});
 put(document.getElementById("count"),
   many(ss.length, "agent") + " in " + many(Object.keys(repos).length, "project")
   + " · " + many(ss.reduce(function(n, s){return n + s.agents.length;}, 0),
     "subagent") + " · " + lk.length + " held");
 var w = ss.filter(function(s){return s.waiting;}).length;
 put(document.getElementById("wanting"), w ? w + " waiting for you" : "");
 shown(document.getElementById("wanting"), !!w);
 /* The state nobody can see from the outside and the reader has to act on:
    a branch sitting ahead of the trunk in a checkout with nobody in it. */
 var gone = 0;
 lands.forEach(function(L){L.candidates.forEach(function(b){
   if(!b.who || !b.who.length) gone++;});});
 put(document.getElementById("stuck"), gone ? gone + " with nobody on them" : "");
 shown(document.getElementById("stuck"), !!gone);

 sync(document.getElementById("filters"),
   [{key: "", label: "all projects"}].concat(d.repos).map(function(r){
     var n = d.sessions.filter(function(s){return !r.key || s.repo === r.key;}).length;
     var h = d.locks.filter(function(l){return !r.key || l.repo === r.key;}).length;
     return {k: "p:" + r.key, key: r.key, label: r.label,
             meta: n + " live" + (h ? " · " + h + " held" : "")};}),
   makeProj, fillProj);

 yard(d, ss, lands, now);

 /* Read-only, and computed off the poll: a `merge-tree` per pair of branches for
    as long as a tab is open is not a cost a window that only watches may impose.
    An absent view means not computed yet, which the page says rather than
    implying there is nothing to land. */
 var lr = [];
 lands.forEach(function(L){
  var skip = L.skipped || [];
  if(!L.candidates.length && !skip.length) return;
  var lbl = L.repo;
  d.repos.forEach(function(r){if(r.key === L.repo) lbl = r.label || r.key;});
  lr.push({k: "lg:" + L.repo, kind: "grp", label: lbl + " → " + L.trunk});
  L.candidates.forEach(function(b){
    lr.push({k: "lb:" + L.repo + ":" + b.branch, kind: "land", b: b});});
  L.pairs.forEach(function(p){
    if(p.state === "clean" && !p.both.length) return;
    lr.push({k: "lp:" + L.repo + ":" + p.a + ":" + p.b, kind: "pair",
      label: p.state === "conflict"
        ? p.a + " and " + p.b + " CONFLICT in " + p.conflicts.join(", ")
        : p.state === "unknown"
        ? p.a + " and " + p.b + " could not be compared — " + p.why
        : p.a + " and " + p.b + " both touch " + p.both.join(", ") +
          " — and merge cleanly"});});
  /* Finished, and still not a candidate. Without this the reader is left with
     "I marked that done, so where is it" and no answer on the page. */
  skip.forEach(function(s){
    lr.push({k: "ls:" + L.repo + ":" + s.id, kind: "pair",
      label: s.id + "  " + s.what + " — finished on " +
        (s.branch || "no branch") + ", not ready: " + s.why});});
  if(L.more) lr.push({k: "lm:" + L.repo, kind: "pair",
    label: "+" + L.more + " more finished branches, not compared"});
  /* Printed, not wired to anything. The human runs it. */
  lr.push({k: "lh:" + L.repo, kind: "pair",
    label: "agentbus merges for the detail · agentbus integrate --yes "
      + "does the merge in a scratch worktree, and spends model calls"});});
 if(!lr.length) lr = [{k: "none", kind: "empty", label: lands.length
   ? "nothing finished is ahead of the trunk"
   : "not computed yet — the poll runs no git"}];
 sync(document.getElementById("landing"), lr, function(it){
   return it.kind === "land" ? makeLand() : it.kind === "grp" ? makeGrp()
     : it.kind === "pair" ? makePair() : makeNone();},
  function(node, it){
   if(it.kind === "land") fillLand(node, it); else fillSpan(node, it);});

 sync(document.getElementById("serves"),
   sv.length ? sv.map(function(s){
     return {k: "v:" + s.repo + ":" + s.resource, kind: "serve", s: s, now: now};})
   : [{k: "none", kind: "empty",
       label: "this repository declares no shared resources (agentbus init-repo)"}],
   function(it){return it.kind === "serve" ? makeServe() : makeNone();},
   function(node, it){
     if(it.kind === "serve") fillServe(node, it); else fillSpan(node, it);});

 newest = ev.length ? ev[0].i : 0;
 /* Only when something really has arrived since the reader last looked away: a
    divider with nothing above it is a line drawn for its own sake. */
 var items = [], divided = false, fresh = seen && ev.length && ev[0].i > seen;
 ev.forEach(function(e){
  if(fresh && !divided && e.i <= seen){items.push({k: "since"}); divided = true;}
  items.push({k: "e:" + e.i, e: e});});
 if(fresh && !divided) items.push({k: "since"});
 if(!ev.length) items = [{k: "none", label: "nothing yet"}];
 sync(document.getElementById("feed"), items, function(it){
   return it.e ? makeEv(it) : it.k === "since" ? makeSince()
     : el("div", "empty", it.label);},
  function(node, it, made){if(it.e) fillEv(node, it, made);});
 if(PANEL) openPanel(PANEL);
 first = false;
}
function tick(){fetch("/data").then(function(r){return r.json();}).then(function(d){
  document.getElementById("lost").style.display = "none"; render(d);})
 .catch(function(){document.getElementById("lost").style.display = "block";});}
tick(); setInterval(tick, __INTERVAL__);
</script></body></html>
"""


# How far ahead of the trunk each checkout is, without paying for it on the
# poll. Counting commits means running git, and git once per worktree per poll —
# for as long as a tab is open — is a cost a window that only watches has no
# business imposing on the machine it is watching. So the request path never
# runs git at all: it serves what the cache holds and hands the work to a
# thread. Nothing here is written to disk, which also means two open tabs share
# nothing and neither can leave anything behind.
GIT_TTL = 10              # seconds a counted number is still served for
BOARD_FILES = 12          # files named per session before "+n more"
# Last resort only, after two derived answers, and only if such a branch really
# exists. Assuming a name is what this ladder is here to avoid.
TRUNK_NAMES = ("main", "master", "trunk", "default", "develop")
_GIT = {}                 # root -> {"at": ts, "ahead": int|None, "base": str}
_GIT_RUNNING = set()      # roots a refresh thread already has in hand


def git_probe(root, args, env=None, timeout=20):
    """(exit code, stdout, stderr) for one git command in `root`.

    The exit code is kept because the interesting git commands here say what they
    found *through* it: `merge-tree` exits 0 for a clean merge and 1 for a
    conflicted one, and both are answers. `git_out` throws that away, which is
    right for a command asked only for its number and wrong for one asked a
    question. Never raises: a git that is missing, wedged or past its timeout is
    reported as a failed command, because a coordination layer may not be the
    reason a session breaks."""
    import subprocess
    try:
        out = subprocess.run(("git",) + tuple(args), cwd=root or None,
                             capture_output=True, text=True, timeout=timeout,
                             env=env, encoding="utf-8", errors="replace")
    except Exception as exc:
        return 1, "", str(exc)
    return out.returncode, out.stdout, (out.stderr or "").strip()


def git_out(root, *args):
    """One read-only git command in `root`; "" if it fails or has nothing to say.

    Ten seconds is a long timeout for `rev-list`, and deliberate: this only ever
    runs off the request path, so the cost of waiting is one stale number rather
    than a page that will not load."""
    rc, out, _ = git_probe(root, args, timeout=10)
    return out.strip() if rc == 0 else ""


def default_base(root, known=""):
    """The ref this worktree's own commits should be counted against.

    Derived, not assumed. `origin/HEAD` is the answer the repository itself
    recorded when it was cloned; `init.defaultBranch` is what this machine would
    have named the trunk had it created the repository; the conventional names
    come last and only when such a branch actually exists. Hard-coding one name
    would have the repository this ships from reporting its default correctly and
    an older one, or a worktree of a repository with no remote at all, reporting
    nothing. "" when there is genuinely nothing to compare against — a tree with
    no commits yet — which the page says rather than guesses at."""
    if known:
        return known      # trunks are not renamed twice an afternoon
    head = git_out(root, "symbolic-ref", "--quiet", "--short",
                   "refs/remotes/origin/HEAD")
    if head:
        return head
    have = set(git_out(root, "for-each-ref", "--format=%(refname:short)",
                       "refs/heads/").split("\n"))
    for name in (git_out(root, "config", "--get", "init.defaultBranch"),) + \
            TRUNK_NAMES:
        if name and name in have:
            return name
    return ""


def git_count(root):
    """Count `root`'s commits since its default branch. Runs git — never call
    this from a poll."""
    base = default_base(root, (_GIT.get(root) or {}).get("base") or "")
    count = git_out(root, "rev-list", "--count", "%s..HEAD" % base) if base else ""
    if not count.isdigit():
        # Either there is no trunk to compare with, or the one we remembered has
        # been renamed or its remote removed, or HEAD does not resolve yet in a
        # tree with no commits. Forget the base so the next pass derives it again
        # instead of asking the same dead question every ten seconds.
        return {"at": now(), "ahead": None, "base": ""}
    return {"at": now(), "ahead": int(count), "base": base}


def git_ahead(root):
    """(commits ahead of the trunk, the ref that was counted against) for a
    worktree, from cache only. (None, None) is "not computed yet".

    Refreshed in the background from halfway through the TTL, so a number that
    keeps being asked for never actually expires and the column does not blink
    empty every ten seconds. Past the full TTL it does go empty, which is the
    point: if git is wedged or slow the page says it does not know rather than
    showing a number from some minutes ago as though it were current."""
    ent = _GIT.get(root)
    age = now() - ent["at"] if ent else None
    if root and (age is None or age >= GIT_TTL // 2) and root not in _GIT_RUNNING:
        # Check-then-add, with no lock: two tabs polling in the same instant can
        # both start a refresh for one root. Both run read-only git and write the
        # same answer, so the race costs one extra `rev-list` and nothing else.
        _GIT_RUNNING.add(root)
        import threading
        threading.Thread(target=_git_refresh, args=(root,), daemon=True).start()
    if ent and age < GIT_TTL:
        return ent["ahead"], ent["base"]
    return None, None


def _git_refresh(root):
    try:
        _GIT[root] = git_count(root)
    finally:
        _GIT_RUNNING.discard(root)


# ------------------------------------------------------------- landing ------
#
# What would happen if the finished work landed together.
#
# The question this answers is the one the person running several chats actually
# asks, and it is the last thing they were still doing by hand: "these two both
# say they are done — can I put them on the trunk, and what will fight?"
#
# None of it needs a model. The ledger says which work is finished and on which
# branch; git can compute the rest exactly. So this layer is deterministic,
# free, and instant, and it is the only part of landing that runs every day.
# `agentbus integrate` is the part that costs money, and it starts from here.
#
# Two properties this section is built around.
#
# It touches nothing. Every candidate branch is checked out in a worktree
# somebody is working in *right now*, so a merge, a checkout, an index refresh
# or a stash would rewrite files under a running session mid-tool-call — the one
# recovery this project's own plan says never to do. `git merge-tree` is what
# makes that avoidable: it merges two commits in memory and reports the
# conflicts without a working tree, an index or a ref anywhere in the picture.
# Its `--write-tree` mode does put the merged tree in the object store, so the
# object store is redirected too (`read_only_git_env`) and even those unreferenced
# blobs land in a temporary directory that is deleted afterwards. What is left is
# a set of git commands that cannot write to the repository at all.
#
# It reasons about branches, not checkouts. A ref is visible from every worktree
# of a repository, so all of this runs in the caller's own checkout and never
# reads anybody else's — with one deliberate exception, `dirty_count`, which has
# to look at the other worktree because uncommitted work is the difference
# between "ready" and "looks ready". Reading it is safe; only writing is not.

MERGE_TTL = 30            # seconds a computed landing view is still served for
MERGE_MAX = 6             # branches compared pairwise before the rest is a count
_MERGE = {}               # repo key -> {"at": ts, "view": {...}}
_MERGE_RUNNING = set()    # repo keys a refresh thread already has in hand


def read_only_git_env(root):
    """(environment, scratch directory) that make `merge-tree` unable to write.

    `merge-tree --write-tree` writes the tree it merged, and any blob it had to
    merge, into the object database. Nothing references them and `git gc` removes
    them eventually, so it is harmless — but "harmless" is not the promise this
    layer makes, and a promise that has to be qualified is one nobody can test.
    Pointing `GIT_OBJECT_DIRECTORY` at a temporary directory and naming the real
    one as an alternate makes the writes go somewhere else while every existing
    object is still readable, so the repository comes out byte-identical.

    Returns the unmodified environment when the common directory cannot be found.
    That path is still no merge, no checkout, no index and no ref — only a few
    unreferenced objects — and refusing to answer at all would be worse."""
    import tempfile
    common = git_out(root, "rev-parse", "--path-format=absolute",
                     "--git-common-dir")
    objects = os.path.join(common, "objects") if common else ""
    if not common or not os.path.isdir(objects):
        return None, ""
    scratch = tempfile.mkdtemp(prefix="agentbus-preview-")
    env = dict(os.environ)
    env["GIT_OBJECT_DIRECTORY"] = os.path.join(scratch, "objects")
    env["GIT_ALTERNATE_OBJECT_DIRECTORIES"] = objects
    try:
        os.makedirs(env["GIT_OBJECT_DIRECTORY"])
    except OSError:
        return None, scratch
    return env, scratch


def merge_tree(root, a, b, env=None):
    """("clean"|"conflict"|"unknown", conflicting paths, why) for merging b into a.

    The three answers are not two. `merge-tree` exits 1 both for a merge that
    conflicts and for a ref it cannot resolve, and the second must never be
    reported as the first: "nothing conflicts" about a branch that has been
    deleted is the kind of green answer that gets somebody to run a merge. What
    separates them is stdout — a computed merge always prints its tree, and a
    refused one prints nothing at all.

    A git older than 2.38 has `merge-tree` but not its `--write-tree` mode, and
    answers by printing its own usage line. Passing that through as the reason
    puts `usage: git merge-tree <base-tree> <branch1> <branch2>` on the page
    where an explanation belongs — measured on WSL's git 2.34.1, where every
    landing pair read "could not be compared" and nothing said why, or that the
    whole feature was unavailable rather than the branches being awkward. The
    version is not probed: a version call per pair costs a subprocess to learn
    what the failure already said."""
    rc, out, err = git_probe(root, ("merge-tree", "--write-tree", "--name-only",
                                   "-z", a, b), env=env)
    if not out:
        first = err.split("\n")[0] if err else ""
        if "usage:" in first and "merge-tree" in first:
            return "unknown", [], ("this git is too old — `merge-tree "
                                   "--write-tree` needs 2.38 or newer")
        return "unknown", [], first or "git said nothing"
    # -z framing: the tree, then one field per conflicting path, then an empty
    # field, then the informational messages in groups of four. The empty field
    # is the terminator, which is why this stops rather than filtering.
    names = []
    for field in out.split("\0")[1:]:
        if not field:
            break
        names.append(field)
    if rc == 0:
        return "clean", [], ""
    if not names:
        return "unknown", [], err.split("\n")[0] if err else "conflicted, unnamed"
    return "conflict", names, ""


def worktree_paths(root):
    """{branch: the checkout it is in} for every worktree of this repository.

    From git rather than from the session list, because a branch whose chat has
    gone still has a checkout and still has work on it — which is exactly the
    case somebody merging is looking at."""
    out, here = {}, ""
    for line in git_out(root, "worktree", "list", "--porcelain").split("\n"):
        if line.startswith("worktree "):
            here = line[9:]
        elif line.startswith("branch refs/heads/") and here:
            out[line[18:]] = here
    return out


def dirty_count(root):
    """How many files are modified or untracked in `root`, or None if unasked.

    `--no-optional-locks` is the whole reason this is safe to point at somebody
    else's checkout: a plain `git status` refreshes the index as it goes, which is
    a write to a file a running session is using. This asks the same question
    without taking the lock that would let it answer by writing."""
    if not root or not os.path.isdir(root):
        return None
    rc, out, _ = git_probe(root, ("--no-optional-locks", "status", "--porcelain"))
    if rc != 0:
        return None
    return len([l for l in out.split("\n") if l.strip()])


def merge_view(repo_key, sessions, root, limit=MERGE_MAX):
    """What the work in flight would do if it landed on the trunk together.

    The whole of this function is reads — see the section comment above for what
    that is worth and how it is kept true.

    A candidate is a *branch*, because a branch is the thing that gets merged.
    Until 3.0.0 a candidate was a branch carrying a task somebody had closed with
    `agentbus done`, and the ledger that recorded those is gone: it was a second
    place for an agent to say what it was doing, and one agent in six ever used
    it. What is left is what git already knows and cannot be forgotten to
    declare — every branch with a checkout of its own, plus every branch a live
    session says it is on, that is ahead of the trunk.

    That is a wider net and it is honest about being one: a branch appears here
    while its author is still working on it, where before it appeared only once
    they had said they were finished. So the view reports who is on it and
    whether their checkout is dirty, and the reader decides. The alternative —
    keeping a declaration nobody made — is a page that is empty when the work is
    not."""
    import shutil
    trunk = default_base(root)
    view = {"repo": repo_key, "trunk": trunk, "at": now(), "computed": True,
            "candidates": [], "pairs": [], "skipped": [], "more": 0}
    if not trunk:
        return view

    trees = worktree_paths(root)
    on_branch = {}
    for s in sessions:
        if s.get("repo_key") == repo_key and s.get("branch"):
            on_branch.setdefault(s["branch"], []).append(s.get("agent") or "?")
    branches = set(trees) | set(on_branch)
    branches.discard(trunk)
    if not branches:
        return view

    def held_back(branch, why):
        view["skipped"].append({"branch": branch, "why": why,
                                "who": on_branch.get(branch, [])})

    env, scratch = read_only_git_env(root)
    try:
        ready, files = [], {}
        for branch in sorted(branches):
            rc, out, _ = git_probe(root, ("rev-parse", "--verify", "--quiet",
                                          branch + "^{commit}"))
            if rc != 0 or not out.strip():
                # A session can name a branch that was never created — a chat
                # opened in a checkout whose first commit has not been made.
                held_back(branch, "that branch is gone")
                continue
            ahead = git_out(root, "rev-list", "--count",
                            "%s..%s" % (trunk, branch))
            behind = git_out(root, "rev-list", "--count",
                             "%s..%s" % (branch, trunk))
            if not ahead.isdigit() or int(ahead) == 0:
                held_back(branch, "nothing on it that %s does not have" % trunk)
                continue
            changed = [p for p in git_out(root, "diff", "--name-only",
                                          "%s...%s" % (trunk, branch)).split("\n")
                       if p]
            state, conflicts, why = merge_tree(root, trunk, branch, env)
            where = trees.get(branch, "")
            last = git_out(root, "log", "-1", "--format=%ct", branch)
            files[branch] = changed
            ready.append({
                "branch": branch, "ahead": int(ahead),
                "behind": int(behind) if behind.isdigit() else 0,
                "files": changed[:BOARD_FILES], "files_n": len(changed),
                "root": short_path(where) if where else "",
                "dirty": dirty_count(where) if where else None,
                "onto": state, "onto_conflicts": conflicts[:BOARD_FILES],
                "onto_why": why,
                "at": int(last) if last.isdigit() else 0,
                # Who is on it right now, which is the question the ledger used
                # to answer badly: a branch nobody is on is one you can land
                # without interrupting anybody, and that is worth seeing.
                "who": on_branch.get(branch, [])})
        ready.sort(key=lambda c: -c["at"])
        view["more"] = max(0, len(ready) - limit)
        view["candidates"] = sorted(ready[:limit], key=lambda c: c["branch"])
        cands = view["candidates"]
        for i, a in enumerate(cands):
            for b in cands[i + 1:]:
                state, conflicts, why = merge_tree(root, a["branch"],
                                                   b["branch"], env)
                both = sorted(set(files[a["branch"]]) & set(files[b["branch"]]))
                view["pairs"].append({
                    "a": a["branch"], "b": b["branch"], "state": state,
                    "why": why, "conflicts": conflicts[:BOARD_FILES],
                    "both": both[:BOARD_FILES], "both_n": len(both)})
    finally:
        if scratch:
            shutil.rmtree(scratch, ignore_errors=True)
    return view


def merges_cached(repo_key, root):
    """A landing view for the board, from cache only. None is "not computed yet".

    The same bargain `git_ahead` makes, for a heavier reason. One poll of a page
    left open in a tab would otherwise run a `merge-tree` per pair of branches
    for as long as the tab is open, and a window that only watches has no
    business imposing that. So the request path runs no git at all: it serves what
    the cache holds and hands the work to a thread."""
    ent = _MERGE.get(repo_key)
    age = now() - ent["at"] if ent else None
    if repo_key and root and (age is None or age >= MERGE_TTL // 2) \
            and repo_key not in _MERGE_RUNNING:
        _MERGE_RUNNING.add(repo_key)
        import threading
        threading.Thread(target=_merge_refresh, args=(repo_key, root),
                         daemon=True).start()
    if ent and age < MERGE_TTL:
        return ent["view"]
    return None


def _merge_refresh(repo_key, root):
    try:
        # Its own session list: the poll's is a snapshot from before the thread
        # started, and reading them again costs a directory listing against
        # several seconds of git.
        _MERGE[repo_key] = {"at": now(),
                            "view": merge_view(repo_key, load_sessions(), root)}
    except Exception:
        _MERGE[repo_key] = {"at": now(), "view": None}
    finally:
        _MERGE_RUNNING.discard(repo_key)


def merges_text(view):
    """The landing view as text, for `agentbus merges` and for what `integrate`
    prints before it spends anything."""
    trunk = view["trunk"]
    if not trunk:
        return ("agent-bus: this repository has no default branch to land on, "
                "so there is nothing to compare against.")
    lines = []
    cands = view["candidates"]
    if not cands:
        lines.append("agent-bus: nothing is ready to land on %s." % trunk)
    else:
        lines.append("agent-bus: %d branch%s ready to land on %s"
                     % (len(cands), "" if len(cands) == 1 else "es", trunk))
        for c in cands:
            head = "  %-24s +%d commit%s, %d file%s" % (
                c["branch"], c["ahead"], "" if c["ahead"] == 1 else "s",
                c["files_n"], "" if c["files_n"] == 1 else "s")
            if c["behind"]:
                head += ", %d behind" % c["behind"]
            if c["root"]:
                head += "   %s" % c["root"]
            if c["dirty"]:
                head += " (%d uncommitted)" % c["dirty"]
            lines.append(head)
            if c["who"]:
                lines.append("      %s on it right now"
                             % ", ".join(sorted(set(c["who"]))))
            if c["onto"] == "clean":
                lines.append("      merges into %s cleanly" % trunk)
            elif c["onto"] == "conflict":
                lines.append("      CONFLICTS with %s: %s"
                             % (trunk, ", ".join(c["onto_conflicts"])))
            else:
                lines.append("      could not be merged against %s (%s)"
                             % (trunk, c["onto_why"]))
    if view["more"]:
        lines.append("  (+%d more finished branch%s, not compared)"
                     % (view["more"], "" if view["more"] == 1 else "es"))
    pairs = [p for p in view["pairs"] if p["state"] != "clean" or p["both"]]
    if pairs:
        lines.append("")
        lines.append("Between them:")
        for p in pairs:
            if p["state"] == "conflict":
                lines.append("  %s and %s CONFLICT in %s"
                             % (p["a"], p["b"], ", ".join(p["conflicts"])))
            elif p["state"] == "unknown":
                lines.append("  %s and %s could not be compared (%s)"
                             % (p["a"], p["b"], p["why"]))
            else:
                lines.append("  %s and %s both touch %s — and merge cleanly"
                             % (p["a"], p["b"], ", ".join(p["both"])))
    if view["skipped"]:
        lines.append("")
        lines.append("In flight, but nothing to land:")
        for s in view["skipped"]:
            who = ", ".join(sorted(set(s.get("who") or [])))
            lines.append("  %-24s %s%s" % (s["branch"], s["why"],
                                           "   (%s)" % who if who else ""))
    return "\n".join(lines)


def cli_merges(args):
    """What would happen if the finished work landed together. Changes nothing.

    Deliberately the whole of the daily answer, with no model in it: the ledger
    knows what is finished and git can compute the rest exactly, so the thing
    somebody needed five terminals and a merge to find out is a free, instant
    read. `agentbus integrate` is the other half, and it says what it costs."""
    sessions = load_sessions()
    _, me = resolve_party()
    if not me:
        root, repo_key, _, _ = git_facts(os.getcwd())
        me = {"sid": "", "repo_key": repo_key, "root": root}
    root = me.get("root") or os.getcwd()
    limit = int(opt(args, "--limit", str(MERGE_MAX)) or MERGE_MAX)
    view = merge_view(me.get("repo_key", ""), sessions, root, limit=limit)
    print(merges_text(view))
    if view["candidates"]:
        print("\nNothing above was merged, checked out or written: every git "
              "command here is a read.\n`agentbus integrate` does it for real, "
              "in a scratch worktree, and costs model calls.")


# ----------------------------------------------------------- integrate ------
#
# The one verb here that spends money, and the only one that acts.
#
# What it is for. One chat cannot make another chat act — hooks fire on a
# session's own activity, so nothing can put a turn into an idle interactive
# session, and that is a limit of Claude Code rather than of this plugin. A
# session agent-bus *starts itself* is different, because it was created
# programmatically and can be driven. So the shape that works is not "make those
# two chats coordinate": it is "take the work those two chats finished and have a
# session of our own put it together".
#
# `agentbus merges` has already scoped the job for free. This is the part that
# costs, and it is deliberately something a person types.
#
# Five rails, designed in from the start rather than added as advice to a prompt,
# because a prompt is a request and these are not:
#
#   - It works in a worktree it creates and deletes, detached at the trunk.
#     Never anybody's checkout, and never `main` in a checkout somebody is using —
#     git would refuse the second anyway, and `--detach` means it is not asked.
#   - It cannot push. Every remote's `pushurl` is overridden in the worker's
#     environment, so a push fails before it reaches the network. `git push <url>`
#     with a literal URL would still get out; the rail is against the accident,
#     which is the thing that actually happens.
#   - It registers on the bus like anything else, because the environment it is
#     given has the parent's session identity removed and `AGENTBUS_OFF` cleared.
#     Inheriting either is not a small bug: with the parent's id it would file its
#     writes and its roster line under the chat that started it, and with the bus
#     off it would be invisible to the guards.
#   - It cannot close anybody's task, and not because it is asked not to. A
#     candidate is made of tasks whose state is `done`; `cli_done` refuses a task
#     that is not the caller's own session's, and `take_over` refuses one that is
#     finished. Between them there is no sequence of verbs by which another
#     session closes finished work. The prompt says so as well, but the engine is
#     what makes it true.
#   - It says what it will spend before spending it, and requires a flag rather
#     than a prompt. An agent may run this too, and an agent cannot answer a
#     question at a terminal.

NO_PUSH = "/nonexistent/agent-bus-refuses-to-push"
INTEGRATE_BUDGET = "2.00"     # dollars, handed to the CLI as a hard cap
INTEGRATE_TOOLS = "Bash Read Edit Write Grep Glob"


def worker_env(root, base=None):
    """The environment the headless worker is given. Three deliberate edits.

    Identity is removed. A session spawned from inside another session's Bash
    tool inherits that session's ids through the environment, and would then
    register on the bus AS ITS PARENT — one roster line for two processes, the
    parent's write log collecting the worker's files, and the guards unable to
    tell them apart. `tests/live/acceptance.sh` unsets the same three for the same
    reason.

    `AGENTBUS_OFF` is cleared, which is the opposite kind of edit and just as
    load-bearing: the worker is supposed to be an ordinary citizen of the bus, and
    a worker started from a shell where somebody had switched the bus off would
    register nowhere and be subject to nothing.

    Pushing is made to fail. Every remote's `pushurl` is pointed at a path that
    does not exist, and git config from the environment is inherited by every git
    the worker runs. A push to a literal URL would still get out — this is a rail
    against the accident, not a sandbox — and `AGENTBUS_HOME` is deliberately left
    alone, because the worker must join the same bus everybody else is on."""
    env = dict(os.environ if base is None else base)
    for name in ("AGENTBUS_SESSION", "CLAUDE_CODE_SESSION_ID", "CLAUDE_PID"):
        env.pop(name, None)
    env.pop("AGENTBUS_OFF", None)
    try:
        count = int(env.get("GIT_CONFIG_COUNT") or 0)
    except ValueError:
        count = 0
    for remote in [r for r in git_out(root, "remote").split("\n") if r.strip()]:
        env["GIT_CONFIG_KEY_%d" % count] = "remote.%s.pushurl" % remote
        env["GIT_CONFIG_VALUE_%d" % count] = NO_PUSH
        count += 1
    env["GIT_CONFIG_COUNT"] = str(count)
    env["GIT_TERMINAL_PROMPT"] = "0"
    return env


def worker_argv(prompt, model="", budget=INTEGRATE_BUDGET,
                tools=INTEGRATE_TOOLS):
    """The command line the worker is started with.

    A function of its own so that what is about to be run can be printed and
    asserted without running it. `--max-budget-usd` is the cost rail the CLI
    itself enforces: this verb can promise a ceiling because it is not the one
    counting. `--allowedTools` as one space-separated string is the form
    `tests/live/acceptance.sh` has been driving real sessions with for a while.

    Nothing here skips permissions. A session that can do anything is not what is
    wanted: the tools it needs are the tools it is given."""
    argv = ["claude", "-p", prompt,
            "--output-format", "stream-json", "--verbose"]
    if model:
        argv += ["--model", model]
    if budget:
        argv += ["--max-budget-usd", str(budget)]
    return argv + ["--allowedTools", tools]


def worker_prompt(view, branches, tree):
    """What the worker is told. Scoped by the preview, so it is not asked to
    discover what git has already computed for nothing."""
    trunk = view["trunk"]
    by_branch = {c["branch"]: c for c in view["candidates"]}
    lines = [
        "You are agent-bus's integration worker. You are in a scratch git "
        "worktree made for this one job, at %s, detached at %s. Nobody else is "
        "working in it and nothing you do here touches anybody's checkout."
        % (tree, trunk),
        "",
        "Merge these branches into it, in this order:"]
    for branch in branches:
        c = by_branch.get(branch) or {}
        who = ", ".join(sorted(set(c.get("who") or [])))
        lines.append("  %-24s%s" % (branch, "   (%s is on it)" % who if who else ""))
    trouble = ["  %s: %s, between %s and %s"
               % (p["a"], ", ".join(p["conflicts"]), p["a"], p["b"])
               for p in view["pairs"]
               if p["state"] == "conflict" and p["a"] in branches
               and p["b"] in branches]
    trouble += ["  %s: %s, against %s"
                % (c["branch"], ", ".join(c["onto_conflicts"]), trunk)
                for c in view["candidates"]
                if c["branch"] in branches and c["onto"] == "conflict"]
    if trouble:
        lines += ["", "A preview computed with `git merge-tree` says these will "
                      "conflict, so they are what the job is:"] + trouble
    else:
        lines += ["", "A preview computed with `git merge-tree` says none of "
                      "them conflict, so this should be mechanical. Check "
                      "rather than assume."]
    lines += [
        "",
        "Do this, in order:",
        "  1. `git merge --no-ff <branch>` for each branch above, in the order "
        "given.",
        "  2. Resolve every conflict so that both sides' intent survives. If one "
        "is a real disagreement that needs a person to choose, stop there, leave "
        "it unresolved and say which file and why.",
        "  3. Work out how this repository checks itself — a Makefile target, a "
        "test script, a runner under tests/ — and run it. Report what it said.",
        "  4. Reply with MERGED, CONFLICTS or CHECKS FAILED on the first line by "
        "itself, then a short paragraph.",
        "",
        "Rules, and these are not preferences:",
        "  - Do not push anything. It is not yours to publish and the "
        "environment will refuse it.",
        "  - Do not leave this directory. Do not read, edit, check out or run "
        "anything in another worktree of this repository — other sessions are "
        "working in them right now.",
        "  - Do not run `agentbus done` or `agentbus take`. That work belongs to "
        "the agents who did it, and saying it is finished is their declaration "
        "to make, not yours. The engine will refuse you anyway.",
        "  - Commit nothing except the merges and the conflict resolutions."]
    return "\n".join(lines)


def integrate_text(view, branches, tree_hint, argv, budget):
    """What this is about to do and what it will cost, printed before anything
    exists and before anything is spent.

    Separate from the doing so that the refusal path and the run path cannot
    describe two different jobs — which is the defect class this repository spent
    a whole plan on, in the shape of a block message that advertised a command the
    guard would then refuse."""
    lines = [merges_text(view), "", "Integrating would:"]
    lines.append("  work in    a fresh worktree under %s, detached at %s"
                 % (tree_hint, view["trunk"]))
    lines.append("  merge      %s" % ", then ".join(branches))
    conflicting = sorted({f for p in view["pairs"]
                          if p["state"] == "conflict" and p["a"] in branches
                          and p["b"] in branches for f in p["conflicts"]}
                         | {f for c in view["candidates"]
                            if c["branch"] in branches
                            and c["onto"] == "conflict"
                            for f in c["onto_conflicts"]})
    lines.append("  resolve    %s" % (", ".join(conflicting) if conflicting
                                      else "nothing — the preview says they "
                                           "merge cleanly"))
    lines.append("  then       run whatever this repository uses to check "
                 "itself, and report")
    lines.append("  spend      one headless Claude Code session, capped at "
                 "$%s. This is real money." % budget)
    lines.append("  never      push, touch another worktree, or close anybody's "
                 "task")
    lines.append("")
    lines.append("It runs as: %s" % " ".join(
        a if a != argv[2] else "<the prompt above>" for a in argv))
    return "\n".join(lines)


def landed(tree, branch):
    """Whether `branch` is really an ancestor of what is in the scratch worktree.

    Asked of git rather than of the worker. "I merged them" is a sentence; this is
    the fact, and the difference between the two is the whole reason a report from
    a model gets checked."""
    rc, _, _ = git_probe(tree, ("merge-base", "--is-ancestor", branch, "HEAD"))
    return rc == 0


def cli_integrate(args):
    """Spawn a session of our own to land the finished work. Costs model calls.

    See the section comment above for the five rails and why each one is in the
    engine rather than in the prompt."""
    import shutil
    import subprocess
    import tempfile
    sessions = load_sessions()
    _, me = resolve_party()
    if not me:
        root, repo_key, _, _ = git_facts(os.getcwd())
        me = {"sid": "", "agent": "a shell", "repo_key": repo_key, "root": root}
    root = me.get("root") or os.getcwd()
    view = merge_view(me.get("repo_key", ""), sessions, root,
                      limit=int(opt(args, "--limit", str(MERGE_MAX))))
    budget = opt(args, "--budget", INTEGRATE_BUDGET)
    model = opt(args, "--model", "")

    only = [b for b in (opt(args, "--only", "") or "").split(",") if b.strip()]
    branches, refused = [], []
    for c in view["candidates"]:
        if only and c["branch"] not in only:
            continue
        if c["onto"] == "unknown":
            # Merging what could not even be compared is how a worker is sent to
            # do a job nobody has scoped.
            refused.append("%s — could not be compared against %s (%s)"
                           % (c["branch"], view["trunk"], c["onto_why"]))
            continue
        branches.append(c["branch"])
    for line in refused:
        print("agent-bus: leaving out %s" % line, file=sys.stderr)
    if not branches:
        print(merges_text(view))
        print("\nThere is nothing to integrate. `agentbus merges` is the same "
              "answer without the spending.")
        return

    tmp_root = tempfile.gettempdir()
    prompt = worker_prompt(view, branches, os.path.join(tmp_root, "<new>"))
    argv = worker_argv(prompt, model=model, budget=budget)
    print(integrate_text(view, branches, tmp_root, argv, budget))
    if not flag(args, "--yes"):
        # A flag rather than a question, because an agent may run this and an
        # agent cannot answer one. Non-zero, so nothing reads a refusal as a run.
        print("\nNothing was created and nothing was spent. `--yes` runs it:\n"
              "  agentbus integrate --yes")
        sys.exit(1)

    if not shutil.which("claude"):
        print("agent-bus: no `claude` on PATH, so there is nothing to spawn. "
              "Nothing was created.", file=sys.stderr)
        sys.exit(1)

    holding = tempfile.mkdtemp(prefix="agentbus-land-")
    tree = os.path.join(holding, "landing")
    rc, _, err = git_probe(root, ("worktree", "add", "--detach", tree,
                                 view["trunk"]))
    if rc != 0:
        shutil.rmtree(holding, ignore_errors=True)
        print("agent-bus: could not make a scratch worktree: %s" % err,
              file=sys.stderr)
        sys.exit(1)
    print("\nworktree %s" % tree)

    # Announced, because the worker is about to appear in the roster and the other
    # agents should know why a session they have never seen is holding things.
    emit(me.get("sid"), me.get("agent"), me.get("repo_key", ""), "worker",
         "started an integration worker on %s: merging %s in a scratch "
         "worktree. It will not push and it will not close anybody's task."
         % (view["trunk"], ", ".join(branches)))

    was = git_out(root, "rev-parse", view["trunk"])
    log = os.path.join(holding, "worker.jsonl")
    prompt = worker_prompt(view, branches, tree)     # now with the real path
    argv = worker_argv(prompt, model=model, budget=budget)
    said, code = "", 1
    try:
        with open(log, "w", encoding="utf-8") as fh:
            proc = subprocess.Popen(argv, cwd=tree, stdout=subprocess.PIPE,
                                    stderr=subprocess.STDOUT, text=True,
                                    encoding="utf-8", errors="replace",
                                    env=worker_env(root))
            for line in proc.stdout:
                fh.write(line)
                fh.flush()
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if rec.get("type") == "assistant":
                    for part in rec.get("message", {}).get("content") or []:
                        if isinstance(part, dict) and part.get("type") == "text":
                            text = (part.get("text") or "").strip()
                            if text:
                                print("  · %s" % text.split("\n")[0][:100])
                elif rec.get("type") == "result":
                    said = rec.get("result") or ""
            code = proc.wait()
    except KeyboardInterrupt:
        proc.terminate()
        code = 130
    except OSError as exc:
        print("agent-bus: the worker could not be started: %s" % exc,
              file=sys.stderr)
        code = 1

    missing = [b for b in branches if not landed(tree, b)]
    left = dirty_count(tree)
    now_at = git_out(root, "rev-parse", view["trunk"])
    print("")
    if said:
        print(said.strip())
        print("")
    if now_at and was and now_at != was:
        # Not something the rails should allow, so if it happens it is the most
        # important line on the screen.
        print("agent-bus: WARNING — %s moved while this ran (%s → %s). Nothing "
              "here should have done that; check what else is running."
              % (view["trunk"], was[:9], now_at[:9]), file=sys.stderr)

    if code == 0 and not missing and not left:
        print("Integrated %s onto %s in the scratch worktree. %s"
              % (", ".join(branches), view["trunk"],
                 git_out(tree, "log", "--oneline",
                         "%s..HEAD" % view["trunk"]).replace("\n", "; ")))
        print("Nothing was pushed and no task was closed — closing work is its "
              "author's to declare. Message them with SendMessage if you want "
              "them to; `agentbus status` names who they are.")
        if flag(args, "--keep"):
            print("Kept: %s" % tree)
            return
        git_probe(root, ("worktree", "remove", "--force", tree))
        shutil.rmtree(holding, ignore_errors=True)
        return

    # Left where it is, on purpose: the half-merged tree, the conflict markers and
    # the worker's own transcript are the evidence, and deleting them to keep the
    # temporary directory tidy would throw away the only reason anybody would look.
    why = []
    if code != 0:
        why.append("the worker exited %d" % code)
    if missing:
        why.append("%s never landed" % ", ".join(missing))
    if left:
        why.append("%d file%s left unresolved or uncommitted"
                   % (left, "" if left == 1 else "s"))
    print("agent-bus: this did not finish — %s." % "; ".join(why),
          file=sys.stderr)
    print("The worktree is left for you to look at:\n  %s\n  %s"
          % (tree, log), file=sys.stderr)
    print("When you are done with it:\n  git -C %s worktree remove --force %s"
          % (short_path(root), tree), file=sys.stderr)
    sys.exit(1)


def board_state(limit=60):
    """Everything the dashboard shows, as plain data.

    Read-only on purpose. A viewer left open in a browser tab polls every couple
    of seconds, and the usual engine housekeeping — reaping sessions, rewriting
    the derived files, advancing a cursor — would mean that watching the bus
    changed it. `status` may do those things because a person asked it a
    question; a window that refreshes by itself may not."""
    sessions = load_sessions()
    live_sids = {s["sid"] for s in sessions}
    out = {"now": now(), "sessions": [], "locks": [], "serves": [],
           "events": [], "repos": [], "landing": []}

    # What each session has produced, and where two of them have produced the
    # same file. The overlap is the whole point: two chats that have both edited
    # one file is the thing somebody merging their work needs to see *before* the
    # merge, and the bus already records every write per session, so this half
    # costs no git. Repository-relative, because that is the form two worktrees
    # of one repository have in common — there the same file has two absolute
    # paths and one relative one. Only within a repository: sessions in different
    # projects cannot collide, and pairing them would be noise.
    # Timestamps kept, not thrown away: the ledger asks the same logs what a task
    # has produced *since it was taken*, and reading them a second time per task
    # would cost more than everything else on this page.
    pairs = {s["sid"]: repo_writes(s, 0) for s in sessions}
    wrote = {sid: [rel for _ts, rel in ps] for sid, ps in pairs.items()}
    clash = {}                      # sid -> {relative path: [other agents]}
    for a in sessions:
        for b in sessions:
            if b["sid"] == a["sid"] or b.get("repo_key") != a.get("repo_key"):
                continue
            for rel in set(wrote[a["sid"]]) & set(wrote[b["sid"]]):
                clash.setdefault(a["sid"], {}).setdefault(rel, []).append(
                    b.get("agent") or "?")

    # One read of the log for the whole poll. Each session's unread count is
    # measured from its own cursor, and asking `unseen` to read the log itself
    # once per session would cost several times everything else on this page put
    # together. Read from the lowest cursor of the lot, or from the tail the feed
    # needs, whichever is further back.
    seq = read_int(SEQFILE, 0)
    cursors = {s["sid"]: cursor_of(s, seq) for s in sessions}
    log = read_events(after=min([max(0, seq - limit)] + list(cursors.values())))

    # Read once for every party on the page. A subagent is a party in its own
    # right — it holds under its own `agent_id`, it contends with its siblings —
    # so what it holds is asked of the locks the same way its parent's is, and
    # never lumped onto the session.
    raw_locks = all_locks()

    def holding(sid, aid):
        return sorted({plain_name(l.get("resource")) for l in raw_locks
                       if l.get("sid") == sid
                       and (l.get("agent_id") or "") == aid})

    seen_repos = {}
    for s in sessions:
        subs = []
        for a in load_agents(s["sid"]):
            aid = a.get("agent_id") or ""
            subs.append({
                "name": a.get("name"), "type": a.get("agent_type"),
                # Sent so the page can put a subagent's declared work on the
                # subagent's row. `sid` alone cannot: it is the parent's too.
                "aid": aid,
                "root": short_path(a.get("root", "")),
                "branch": a.get("branch") or "",
                "started": a.get("started", 0),
                "holds": ", ".join(holding(s["sid"], aid)[:3]),
                # Against its OWN root: a subagent working in another worktree is
                # the case this row exists for, and relative to its parent's the
                # path would come out as a string of `..`.
                "did": action_view(
                    last_action(party_key({"sid": s["sid"], "agent_id": aid})),
                    a.get("root"))})
        ahead, base = git_ahead(s.get("root", ""))
        idle = now() - s.get("beat", 0) > IDLE_SECS
        # Not `deliver`: that formats the same events into a sentence for the
        # session itself, and would advance nothing but would read the log five
        # times over. `unseen` is the shared body underneath it.
        unread = len(unseen(s, log=log)[1])
        mine = wrote[s["sid"]]
        out["sessions"].append({
            "sid": s["sid"], "agent": s.get("agent"),
            "root": short_path(s.get("root", "")),
            "branch": s.get("branch") or "", "doing": s.get("doing") or "",
            "beat": s.get("beat", 0), "idle": idle,
            "guarded": int(s.get("guarded", 0) or 0),
            "repo": s.get("repo_key", ""), "repo_label": s.get("repo_label", ""),
            "owns": owns_summary(s["sid"], limit=6), "agents": subs,
            "ahead": ahead, "ahead_of": base,
            "wrote": mine[:BOARD_FILES], "wrote_n": len(mine),
            # `also`, not `with`: the page reads this key in JavaScript, where
            # `with` is a reserved word and only legal after a dot by accident.
            "clash": [{"path": p, "also": sorted(set(who))}
                      for p, who in sorted(clash.get(s["sid"], {}).items())],
            "unread": unread,
            # What the hooks watched it do, beside what it said it was doing.
            # Free: the fast path has already written the line, and this is one
            # small read per party.
            "did": action_view(last_action(s["sid"]), s.get("root")),
            # The one thing on the page that asks to be acted on. A session that
            # is working will read the bus itself at its next turn; a session
            # that has stopped with messages it has never been shown is a window
            # somebody has to go and poke, and that is not visible anywhere else.
            "waiting": bool(idle and unread)})
        seen_repos[s.get("repo_key", "")] = s.get("repo_label", "")

    for lock in raw_locks:
        _, stealable, why = lock_state(lock, sessions)
        out["locks"].append({
            "resource": lock.get("resource"), "agent": lock.get("agent"),
            "mode": lock.get("mode"), "why": lock.get("why") or "",
            "since": lock.get("acquired_at", 0), "repo": lock.get("repo", ""),
            "party_known": bool(lock.get("party_known", True)),
            "orphan": lock.get("sid") not in live_sids,
            "expired": bool(stealable), "expired_why": why})

    # Every resource the repository declares, not only the ones somebody has
    # started. "Nobody is holding the simulator" is as much of an answer as
    # "she is", and a service that has never been started at all is the state a
    # reader most needs to be able to see.
    held = {}
    for lock in out["locks"]:
        held[(lock["repo"], (lock["resource"] or "").split("@")[0])] = lock
    served = {}
    try:
        names = sorted(os.listdir(SERVES))
    except OSError:
        names = []
    for name in names:
        if not name.endswith(".json"):
            continue
        rec = read_json(os.path.join(SERVES, name))
        if rec and rec.get("resource"):
            served[(rec.get("repo", ""), rec["resource"])] = rec

    # Only repositories somebody is actually working in. A serve record whose
    # process is gone, under a repo key nobody is live in, is cruft from an
    # earlier shape of the tree — this machine carries three such — and listing
    # its resources beside the real ones would put the same service on the page
    # twice, once truthfully and once as a ghost.
    roots = {}
    for s in sessions:
        roots.setdefault(s.get("repo_key", ""), s.get("root"))
    for key, rec in served.items():
        if key[0] not in roots and pid_alive(rec.get("pid")):
            roots.setdefault(key[0], rec.get("root"))

    for repo_key, root in sorted(roots.items()):
        cfg = repo_config(repo_key, root)
        declared = [r["name"] for r in cfg.get("resources", []) if r.get("name")]
        for extra in sorted(k[1] for k in served if k[0] == repo_key):
            if extra not in declared:
                declared.append(extra)      # started, then removed from config
        by_name = {r["name"]: r for r in cfg.get("resources", [])}
        for name in declared:
            res = by_name.get(name, {})
            rec = served.get((repo_key, name)) or {}
            lock = held.get((repo_key, name))
            moves = (read_json(moves_path(repo_key, name)) or {}).get("moves", [])
            recent = [m for m in moves if now() - m.get("at", 0) < CHURN_WINDOW]
            alive = bool(rec) and pid_alive(rec.get("pid"))
            out["serves"].append({
                "resource": name, "repo": repo_key,
                "desc": res.get("desc", ""), "port": res.get("port") or rec.get("port"),
                "movable": bool(res.get("start")),
                "root": short_path(rec.get("root", "")) if alive else "",
                "by": rec.get("by") if alive else "",
                "started": rec.get("started", 0) if alive else 0,
                "alive": alive,
                "held_by": (lock or {}).get("agent", ""),
                "held_since": (lock or {}).get("since", 0),
                "held_mode": (lock or {}).get("mode", ""),
                "held_why": (lock or {}).get("why", ""),
                "churn": len(recent),
                "churn_roots": sorted({short_path(m.get("root", ""))
                                       for m in recent})})

    # What the finished work would do if it landed together. Read-only like
    # everything else here, and from cache only: the pairwise merges cost git and
    # a page left open in a tab may not spend it on every poll. The page says
    # "these look ready and here is what would fight" and prints the command; it
    # does not offer to run it. A button that spends model calls when clicked is a
    # different kind of object from the one this page is.
    for repo_key, root in sorted(roots.items()):
        view = merges_cached(repo_key, root)
        if view:
            out["landing"].append(view)

    for r in log:
        if r.get("i", 0) <= seq - limit:
            continue                # read further back than the feed shows, for
        out["events"].append({      # the unread counts; the feed keeps its tail
            "i": r.get("i"), "ts": r.get("ts"), "agent": r.get("agent"),
            "to": r.get("to") or "", "kind": r.get("kind"),
            # Which one of a run this is. A wrong-port bypass says it out loud
            # once and is counted after that, so without the number a run of 28
            # is 27 rows that each look like the first — and the board is the one
            # place where seeing the run is the point.
            "again": r.get("again") or 0,
            "repo": r.get("repo", ""), "text": r.get("text", "")})
    out["events"].reverse()   # newest first: that is what a watcher looks at
    # The filter lists places there is something to watch. A repository that
    # only appears in the log is history, and offering it as a filter would be
    # offering an empty page.
    for key in roots:
        seen_repos.setdefault(key, key.split(":")[0])
    out["repos"] = [{"key": k, "label": v or k} for k, v in sorted(
        seen_repos.items(), key=lambda kv: kv[1] or kv[0]) if k]
    return out


def cli_board(args):
    """A window onto the bus, served to this machine only.

    `watch` answers "what just happened" one line at a time. The question
    somebody with five terminals open actually has is "what is going on" — who
    is live, in which checkout, what is held, which tree each service is
    answering for — and that is a shape, not a stream.

    Bound to the loopback address and nowhere else: this data is every branch
    name and worktree path on the machine, and it is nobody's business but the
    person sitting at it."""
    import http.server
    import json as _json
    import socketserver
    import webbrowser

    port = int(opt(args, "--port", "8787"))
    every = max(1, int(opt(args, "--interval", "2")))

    class Handler(http.server.BaseHTTPRequestHandler):
        def _send(self, body, ctype):
            raw = body.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(raw)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            try:
                self.wfile.write(raw)
            except OSError:
                pass          # the tab was closed mid-write; not our problem

        def do_GET(self):
            if self.path.startswith("/data"):
                try:
                    self._send(_json.dumps(board_state()), "application/json")
                except Exception as exc:
                    self._send(_json.dumps({"error": str(exc)}),
                               "application/json")
                return
            if self.path in ("/", "/index.html"):
                self._send(BOARD_HTML.replace("__INTERVAL__", str(every * 1000)),
                           "text/html; charset=utf-8")
                return
            self.send_error(404)

        def log_message(self, *_a):
            pass              # one line per poll would bury the terminal

    class Server(socketserver.ThreadingTCPServer):
        allow_reuse_address = True
        daemon_threads = True

    httpd = None
    for candidate in (port, 0):
        try:
            httpd = Server(("127.0.0.1", candidate), Handler)
            break
        except OSError as exc:
            if candidate == 0:
                print("agent-bus: could not open a port: %s" % exc,
                      file=sys.stderr)
                sys.exit(1)
            print("agent-bus: port %d is taken, picking another." % candidate,
                  file=sys.stderr)
    url = "http://127.0.0.1:%d/" % httpd.server_address[1]
    print("agent-bus board — %s" % url)
    print("Local only, and read-only: it never changes what it is watching.")
    print("Ctrl-C to stop.")
    # Piped into a file or a pager, stdout is block-buffered and the URL — the
    # one thing the caller needs — would sit unseen until the server stopped.
    sys.stdout.flush()
    if not flag(args, "--no-open"):
        try:
            webbrowser.open(url)
        except Exception:
            pass
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print()
    finally:
        httpd.server_close()


def cli_here(args):
    """Record which worktree the caller is actually working in.

    Everything else infers this, and for a subagent the inference can be wrong
    in a way nothing can detect. A subagent's hook payloads carry its *parent's*
    cwd unless it has changed directory, so an agent told to work in one
    checkout while its parent sits in another looks, to every guard, like it is
    in its parent's tree. On 2026-07-29 one of them was refused permission to
    use the very service it had itself pointed at its own worktree, and turned
    the plugin off for the rest of its turn rather than argue with it.

    A shell knows where it is. This is the one place that answer can be handed
    over, so it is stated rather than guessed:

        cd <your worktree> && agentbus here

    Which party is speaking is settled by the hint the guard leaves, the same
    way `agentbus claim` is — so it must be run as its own command, not buried
    in a script, and `--as <your name>` is the fallback when it cannot be.

    Either way the declaration is durable: it is recorded with a `pinned` flag,
    on the session's record or on the agent's, and everything that infers a
    location from a cwd steps over it until `here` is run somewhere else.

    This is the *writer* of that flag, and it has to be read next to its
    readers, which are all in `resolve_party`: clause (c) of *where they are
    working* for the session's pin, and the declaring half of clause (b) for an
    agent's. Two levels, two records, one flag with one meaning — a session's
    pin never reaches an agent's record and an agent's never reaches the
    session's, which is what stops a subagent's declaration pinning its parent.
    The one statement that still beats both is `git -C <path>`, clause (a),
    because that is about a single command."""
    record, me = need_party()
    me = acting(me, args)
    pos = positional(args)
    where = os.path.realpath(pos[0]) if pos else os.getcwd()
    if not os.path.isdir(where):
        print("agent-bus: no such directory: %s" % where, file=sys.stderr)
        sys.exit(1)
    root, repo_key, label, branch = git_facts(where)
    aid = me.get("agent_id")
    if aid:
        rec = read_json(agent_path(me["sid"], aid))
        if not rec:
            print("agent-bus: no record of that agent — `agentbus whois` lists "
                  "who is who.", file=sys.stderr)
            sys.exit(1)
        # The same flag the session branch writes, because it is the same
        # statement one level down. Without it `_follow_agent_cwd` had nothing
        # to read, and the declaration survived only until a payload arrived
        # with a cwd that was neither the agent's record nor its parent's.
        rec.update({"cwd": where, "root": root, "repo_key": repo_key,
                    "repo_label": label, "branch": branch, "pinned": True,
                    "keyrev": KEY_REV})
        write_json(agent_path(me["sid"], aid), rec)
        who = rec.get("name")
    else:
        # The session file, so the record — never `me`, which by this point may
        # be a subagent that failed to find its own record above.
        rec = read_json(os.path.join(SESSIONS, "%s.json" % record["sid"])) or record
        rec["sid"] = record["sid"]
        rec.update({"cwd": where, "root": root, "repo_key": repo_key,
                    "repo_label": label, "branch": branch, "pinned": True,
                    "keyrev": KEY_REV})
        write_json(os.path.join(SESSIONS, "%s.json" % record["sid"]),
                   require_record(rec, "cli_here"))
        who = rec.get("agent")
    refresh_derived()
    print("%s is working in %s (%s)" % (who, short_path(root), branch or "-"))
    if aid:
        return
    print("(that was recorded for the session. If you are a subagent, run this "
          "as its own\n command so the guard can see who you are, or add "
          "--as <your name>.)")


def port_env_name(res):
    """The shell variable `agentbus env` exports for a resource."""
    return res.get("env") or ("AGENTBUS_PORT_" +
                              re.sub(r"[^A-Za-z0-9]+", "_", res.get("name", "")).upper())


def port_env(me, base=None):
    """`os.environ` plus every declared port for THIS checkout.

    The half of per-worktree ports the guard cannot reach. Giving a checkout its
    own API port does nothing for a mobile app whose base URL is baked into the
    bundle from a `.env` naming the original checkout's: the app still calls the
    other tree, the screen still looks right, and the result belongs to somebody
    else's code. The guard cannot see it, because the request leaves a simulator
    and not the shell being watched — so it is not a guard that can close this,
    it is the environment the bundler was started in.

    Which is what this is. Every process agent-bus starts or wraps — a declared
    service, and anything under `agentbus run` — gets the same variables
    `agentbus env` prints, under the same names, so a start command can say
    `--api http://localhost:$AGENTBUS_PORT_API` and mean this worktree's API
    without knowing a number or which resources are isolated. Raised as an open
    gap by the session that did the per-worktree config, 2026-08-02, and left
    open long enough to be measured: 16 runs went past the wrong-port guard with
    `AGENTBUS_OFF`, 30 of those mentions naming the original checkout's port.

    Ports only. This does not carry identity: a service outlives the session
    that started it, and stamping AGENTBUS_SESSION into it would make whatever
    it later spawns claim to be a chat that has gone."""
    out = dict(os.environ if base is None else base)
    try:
        cfg = repo_config(me.get("repo_key"), me.get("root"))
        for res in cfg.get("resources", []):
            if res.get("port"):
                out[port_env_name(res)] = str(res["port"])
    except Exception:
        pass    # a missing config is not a reason to fail to start a service
    return out


def cli_port(args):
    """The port this checkout should use for a resource.

    Two worktrees of one repository running the same dev server on one port is
    the failure this whole plugin exists for: the port hides which checkout is
    answering, so a test passes against somebody else's code. Coordinating one
    port is the expensive way to solve that. Giving each checkout its own is the
    cheap way, and on the machine this was written for it would have removed 87
    per cent of every block the bus has ever issued.

    The number is derived from the checkout's path, so it is stable without any
    state, and the repository's original checkout keeps the declared port so
    nothing changes for whoever is working there."""
    me = need_me()
    pos = positional(args)
    if not pos:
        print("usage: agentbus port <resource>", file=sys.stderr)
        sys.exit(1)
    res = find_resource(me, pos[0])
    if not res:
        print("no resource named '%s' in this repo's config" % pos[0],
              file=sys.stderr)
        sys.exit(1)
    if not res.get("port"):
        print("'%s' declares no port" % pos[0], file=sys.stderr)
        sys.exit(1)
    print(res["port"])


def cli_env(args):
    """Every declared port for this checkout, as shell exports.

        eval "$(agentbus env)"
        make dev

    Resources that did not ask for per-worktree ports are exported too, at their
    declared value, so one line covers the whole configuration and a script does
    not have to know which is which.

    For a shell somebody is typing into. Anything agent-bus starts or wraps
    itself — a declared service, and every command under `agentbus run` — is
    already given these, under these names, without being asked. See
    `port_env`."""
    me = need_me()
    cfg = repo_config(me.get("repo_key"), me.get("root"))
    rows = [r for r in cfg.get("resources", []) if r.get("port")]
    if flag(args, "--json"):
        print(json.dumps({port_env_name(r): r["port"] for r in rows}, indent=2))
        return
    if not rows:
        print("# no resource in this repo declares a port", file=sys.stderr)
        return
    for r in rows:
        own = " (this checkout's own)" if r.get("_declared_port") else ""
        print("export %s=%d%s" % (port_env_name(r), r["port"],
                                  ("   # %s%s" % (r["name"], own))))


def find_resource(me, name):
    cfg = repo_config(me.get("repo_key"), me.get("root"))
    return next((r for r in cfg.get("resources", []) if r["name"] == name), None)


def cli_serve(args):
    """Point declared services at this worktree, restarting any that are serving
    another one. This is the half `sim-lock.sh` had and a lock alone cannot do.

    A comma list, like `claim`, `release`, `wait` and `run` — and for the reason
    those take one: one command wanting a device and the three services it
    implies is answered by moving three services, and being handed three separate
    lines to run is the whole reason an agent reaches for `AGENTBUS_OFF` instead.
    The block that advertises this line is the one that knows how many there are.

    Each service is taken, moved and handed back in turn rather than all held at
    once. A handover is not a claim: the lock is here to stop two sessions
    restarting one service in the same second, and holding the first while the
    third is starting would make this verb the thing other sessions queue behind."""
    me = acting(need_me(), args)
    pos = positional(args)
    if not pos:
        print("usage: agentbus serve <resource>[,<resource>] [--as <you>]",
              file=sys.stderr)
        sys.exit(1)
    # From the Plan, like every other verb: this splits the list, and a service
    # is not usually instance-keyed but a `scope: "worktree"` one would have been
    # claimed here under a name the guard never writes.
    plan = plan_for(me, names=pos[0])
    if plan["reason"] == "no-such-resource":
        print(render_block(plan), file=sys.stderr)
        sys.exit(1)
    # Every name resolved and checked before anything moves, for the reason
    # `agentbus claim` refuses a list before taking any of it: half a handover
    # leaves the reader's command answering from two checkouts at once, which is
    # worse than not starting.
    declared = []
    for planned in plan["resources"]:
        res = find_resource(me, planned["name"])
        if not res:
            print("no resource named '%s' in this repo's config" % planned["name"],
                  file=sys.stderr)
            sys.exit(1)
        if not res.get("start"):
            print("'%s' declares no `start` command, so agent-bus cannot move it. "
                  "Add one to .claude/agent-bus.json." % planned["name"],
                  file=sys.stderr)
            sys.exit(1)
        declared.append((planned, res))
    for planned, res in declared:
        ok, lock, holder, reason = do_claim(me, planned["lock"], why="handover",
                                            mode="hard")
        if not ok:
            if not holder:
                print("agent-bus: could not take '%s': %s"
                      % (planned["name"], reason), file=sys.stderr)
                sys.exit(1)
            # The line under this used to be advice this function wrote out for
            # itself — the only line on the command surface still composed by
            # hand rather than taken from the Plan.
            print(render_refusal(
                _lock_block(me, "", planned, lock, holder, plan["resources"]),
                " — ask before moving it out from under them."), file=sys.stderr)
            sys.exit(1)
        good, detail = ensure_serving(me, res)
        do_release(me, planned["lock"], quiet=True)
        if not good:
            print("agent-bus: %s" % detail, file=sys.stderr)
            sys.exit(1)
        print("'%s' %s" % (planned["name"], detail))


def cli_serves(_args):
    me = need_me()
    cfg = repo_config(me.get("repo_key"), me.get("root"))
    for res in cfg.get("resources", []):
        if not res.get("port") and not res.get("start"):
            continue
        root, how = serving(me.get("repo_key"), res)
        mark = "you" if root and os.path.realpath(root) == os.path.realpath(
            me.get("root") or "") else ""
        print("%-12s %-9s %-46s %s" % (res["name"], how, short_path(root or "-"), mark))


def expand_implied(names, me):
    """The named resources, plus whatever they imply.

    `agentbus run simulator` took the simulator and nothing else, while a bare
    `maestro test` took the simulator *and* the two bundlers and the API —
    because the guard expands `implies` and the CLI never did. The careful
    command was the weaker one: another session could re-serve a bundler
    mid-run and the run would silently switch to its bundle, which is precisely
    what this plugin exists to prevent.

    Reported from real use on 2026-07-28 by an agent that lost six minutes to it
    twice and then negotiated a manual protocol with the other session instead.
    Its exact words: "'agentbus run simulator' bile metro-app'i tutmuyor"."""
    cfg = repo_config(me.get("repo_key"), me.get("root"))
    by_name = {r["name"]: r for r in cfg.get("resources", [])}
    out, added = list(names), []
    for name in list(names):
        for dep in (by_name.get(name) or {}).get("implies", []):
            if dep in by_name and dep not in out:
                out.append(dep)
                added.append(dep)
    return out, added


def cli_run(args):
    import subprocess
    me = need_me()
    if "--" not in args:
        print("usage: agentbus run <res>[,<res>] [--why \"...\"] -- <command>",
              file=sys.stderr)
        sys.exit(1)
    cut = args.index("--")
    head, cmd = args[:cut], args[cut + 1:]
    me = acting(me, head)
    pos = positional(head)
    if not pos or not cmd:
        print("usage: agentbus run <res>[,<res>] [--why \"...\"] -- <command>",
              file=sys.stderr)
        sys.exit(1)
    # Under the keys the guard uses, not the names typed: a worktree-scoped
    # resource is one lock per checkout and an instance one lock per device, and
    # taking the bare name would write a lock that nothing consults.
    plan = plan_for(me, names=pos[0])
    if plan["reason"] == "no-such-resource":
        print(render_block(plan), file=sys.stderr)
        sys.exit(1)
    # Asked of the resources rather than of the string, so that `agentbus run
    # simulator@ABC123` pulls in what the simulator implies exactly as
    # `agentbus run simulator` does. Unlike `claim`, `run` expands: the careful
    # command was the weaker one, and another session re-serving a bundler
    # mid-run would silently switch the run to its bundle.
    _, implied = expand_implied([r["name"] for r in plan["resources"]], me)
    if implied:
        print("agent-bus: also taking %s — %s implies %s."
              % (", ".join(implied), pos[0], ", ".join(implied)), file=sys.stderr)
        plan = plan_for(me, names=[pos[0]] + implied)
    why = opt(head, "--why", redact(" ".join(cmd))[:120])
    taken = []
    try:
        for res in plan["resources"]:
            ok, lock, holder, reason = do_claim(me, res["lock"], why=why,
                                                mode="hard")
            if not ok:
                if not holder:
                    print("agent-bus: could not take '%s': %s"
                          % (_named(res), reason), file=sys.stderr)
                    sys.exit(75)
                print(render_refusal(
                    _lock_block(me, "", res, lock, holder, plan["resources"]),
                    " — not running."), file=sys.stderr)
                sys.exit(75)
            taken.append(res)
        # Holding the lock is not enough: make the services actually answer with
        # this worktree's code before the command runs.
        for res in plan["resources"]:
            declared = find_resource(me, res["name"])
            if declared and declared.get("start"):
                good, detail = ensure_serving(me, declared)
                if not good:
                    print("agent-bus: %s" % detail, file=sys.stderr)
                    sys.exit(75)
                if "restarted" in (detail or ""):
                    print("agent-bus: '%s' %s" % (res["name"], detail),
                          file=sys.stderr)
        # cmd is already word-split by the calling shell, so run it directly:
        # joining it back into a shell string would destroy the quoting in
        # forms like `-- bash -c 'cd x && maestro test'`.
        #
        # With this checkout's ports in the environment, because the command
        # under `run` is the one most likely to need them — a test runner, a
        # curl, a bundler — and it is already being told which tree to use by
        # every other means available.
        rc = subprocess.call(cmd, env=port_env(me))
        sys.exit(rc)
    finally:
        spoken = []
        for res in taken:
            lock = load_lock(me.get("repo_key"), res["lock"])
            if do_release(me, res["lock"], quiet=True) \
                    and (lock or {}).get("announced"):
                spoken.append(res["lock"])
        announce_locks(me, "released", spoken)


def cli_name(args):
    # The record: this mutates what it is given and writes it to the session
    # file. A session is named, not a party — `agentbus name` run by a subagent
    # renames its parent, deliberately, and must not persist the subagent's
    # identity while doing it.
    me = require_record(need_record(), "cli_name")
    pos = positional(args)
    if not pos:
        print(me.get("agent"))
        return
    old = me.get("agent")
    me["agent"] = re.sub(r"[^A-Za-z0-9_.#-]", "-", pos[0])[:24]
    write_json(os.path.join(SESSIONS, "%s.json" % me["sid"]), me)
    emit(me["sid"], me["agent"], me["repo_key"], "rename",
         "renamed from %s to %s" % (old, me["agent"]))
    print(me["agent"])


def cli_own(args):
    """Declare a part of the tree yours. The one thing here that is not a lock:
    it is not about a command that is running now, it is about where the other
    agents should not be working for the next while."""
    me = need_me()
    sessions = load_sessions()
    if flag(args, "--list"):
        shown = 0
        for s in sessions:
            summary = owns_summary(s["sid"], limit=20)
            if not summary or s.get("repo_key") != me.get("repo_key"):
                continue
            shown += 1
            print("%-18s %s%s" % (s.get("agent"), summary,
                                  "   (you)" if s["sid"] == me["sid"] else ""))
        if not shown:
            print("nobody in this repo has declared anything")
        return
    pos = positional(args)
    if not pos:
        print('usage: agentbus own "<glob>" [...] [--why "..."] [--strict]\n'
              "       agentbus own --list\n\n"
              "Quote the glob, or the shell expands it before agentbus sees it.",
              file=sys.stderr)
        sys.exit(1)
    why = opt(args, "--why", "")
    strict = flag(args, "--strict")
    decs = load_owns(me["sid"])
    added = []
    for raw in pos:
        glob = normalise_glob(raw, me.get("root"))
        if not glob:
            continue
        covers = ownership_covers(me, glob)
        if covers == "resource":
            # `own` takes a path; `claim` takes a resource. They look identical
            # on the command line and they are different namespaces, and getting
            # them the wrong way round produces the one thing this project
            # refuses to ship: a guard somebody believes they have set which
            # protects nothing. Reported from Windows on 2026-07-31, where a
            # session ran `agentbus own worktree`, was told it now owned
            # something, and announced to three other agents that the checkout
            # was safe. It was not, and `status` printed the declaration and
            # "Free: worktree" in the same breath.
            print("agent-bus: '%s' is a resource, not a path — `own` declares "
                  "part of the tree,\nand there is no `%s` in this repository. "
                  "You almost certainly want:\n  agentbus claim %s%s\n\n"
                  "If you did mean a path, give one that exists, or a glob: "
                  "`%s/**`."
                  % (glob, glob, glob, (' --why "%s"' % why) if why else "",
                     glob), file=sys.stderr)
            sys.exit(1)
        if covers == "nothing":
            # Not refused: a glob for a directory about to be created is a
            # legitimate way to claim ground before you break it. But it is said
            # out loud, because the silent version of this is indistinguishable
            # from a working declaration.
            print("agent-bus: note — nothing in this repository matches '%s' "
                  "right now, so it\nguards nothing yet." % glob,
                  file=sys.stderr)
        decs = [d for d in decs if d.get("glob") != glob]
        decs.append({"glob": glob, "why": why, "at": now(), "strict": strict})
        added.append(glob)
    if not added:
        print("nothing to own", file=sys.stderr)
        sys.exit(1)
    if not save_owns(me["sid"], decs):
        print("could not record that", file=sys.stderr)
        sys.exit(1)
    refresh_derived(sessions)   # the fast path filters on this; make it live now
    print("you now own:")
    for d in decs:
        print("  %-28s %s%s" % (d.get("glob"), d.get("why") or "",
                                "  [strict]" if d.get("strict") else ""))
    others = [s for s in sessions
              if s["sid"] != me["sid"] and s.get("repo_key") == me.get("repo_key")]
    if others:
        print("\nSessions in this checkout are now blocked from editing these; "
              "in another\nworktree they are warned instead%s."
              % (" — except --strict, which blocks there too" if strict else ""))
        emit(me["sid"], me["agent"], me["repo_key"], "own",
             "owns %s%s%s" % (", ".join(added), " [strict]" if strict else "",
                              (' — ' + why) if why else ""))
    else:
        print("\nNobody else is live in this repo, so nothing is blocked yet.")


def cli_disown(args):
    me = need_me()
    decs = load_owns(me["sid"])
    if not decs:
        print("you own nothing")
        return
    if flag(args, "--all"):
        dropped = [d.get("glob") for d in decs]
        keep = []
    else:
        pos = positional(args)
        if not pos:
            print('usage: agentbus disown "<glob>" | --all', file=sys.stderr)
            sys.exit(1)
        wanted = {normalise_glob(p, me.get("root")) for p in pos}
        dropped = [d.get("glob") for d in decs if d.get("glob") in wanted]
        keep = [d for d in decs if d.get("glob") not in wanted]
    if not dropped:
        print("not yours: %s" % ", ".join(positional(args)), file=sys.stderr)
        sys.exit(1)
    save_owns(me["sid"], keep)
    refresh_derived()
    print("released %s" % ", ".join(dropped))
    emit(me["sid"], me["agent"], me["repo_key"], "disown",
         "no longer owns %s" % ", ".join(dropped))


CONFIG_README = (
    "Delete what you do not have and fix the ports and commands. "
    "patterns: regexes matched against each command's argv. "
    "port/cwd/start/ready: let agent-bus own the service, so it can "
    "say which checkout it is serving and move it to yours. "
    "implies: resources a command needs indirectly. "
    "scope 'worktree': contended only within one checkout. "
    "why/hint: shown verbatim when a command is blocked — this is "
    "where the knowledge that stops a workaround goes."
)

WORKTREE_RESOURCE = {
    "name": "worktree",
    "desc": "this checkout's working tree and git index",
    "why": "",
    "scope": "worktree",
    "patterns": [r"\bgit\s+(checkout|switch|stash|reset|rebase|add|commit)\b",
                 r"\b(npm|pnpm|yarn|bun)\s+(install|ci)\b"],
    "_from": "",   # not detected from anything: every repository has one
}

# The port a framework listens on when nobody told it otherwise. Only defaults
# that are actually defaults — a wrong guess here writes a config that silently
# guards nothing, which is worse than a resource the reader has to fill in.
FRAMEWORK_PORTS = (
    ("next", 3000), ("nuxt", 3000), ("nest", 3000), ("remix", 3000),
    ("react-scripts", 3000), ("vite", 5173), ("astro", 4321), ("expo", 8081),
)

DB_IMAGES = (("postgres", "psql"), ("postgis", "psql"), ("mysql", "mysql"),
             ("mariadb", "mysql"), ("redis", "redis-cli"), ("mongo", "mongosh"))


def lit(word):
    """A regex matching this literal word.

    Not `re.escape`: that escapes the hyphen in `redis-cli` and
    `react-scripts`, which is correct, unnecessary outside a character class,
    and unreadable in a file somebody is being asked to read and edit."""
    return re.sub(r"([.^$*+?()\[\]{}|\\])", r"\\\1", word or "")


# ------------------------------------------------------------- detection ----
#
# A stranger installs the plugin, opens two sessions, and nothing happens,
# because their repository has no config and the old `init-repo` wrote a generic
# template they had to fill in by hand. Most people conclude it is broken and
# stop. So the first run reads the repository instead of guessing, and what it
# writes has this project's real ports and real start commands in it.
#
# Everything here is best-effort and silent about what it cannot find. A draft
# with three of the four resources is useful; an exception during `init-repo` is
# not. The reader is told where every line came from so they can check it.

def read_text(path, limit=200000):
    try:
        with open(path, "r", encoding="utf-8-sig", errors="replace") as fh:
            return fh.read(limit)
    except (OSError, UnicodeDecodeError):
        return ""


def port_in(text):
    """The port a command line pins, or None."""
    for pat in (r"--port[=\s]+(\d{2,5})\b", r"\bPORT\s*=\s*(\d{2,5})\b",
                r"-p\s+(\d{2,5})\b", r"\blocalhost:(\d{2,5})\b",
                r"--inspect-port[=\s]+(\d{2,5})\b"):
        m = re.search(pat, text or "")
        if m:
            return int(m.group(1))
    return None


def package_manager(root):
    for lock, form in (("bun.lock", "bun run"), ("bun.lockb", "bun run"),
                       ("pnpm-lock.yaml", "pnpm run"), ("yarn.lock", "yarn"),
                       ("package-lock.json", "npm run")):
        if os.path.exists(os.path.join(root, lock)):
            return form
    return "npm run"


def unique_name(base, taken):
    if base not in taken:
        return base
    for n in range(2, 20):
        cand = "%s%d" % (base, n)
        if cand not in taken:
            return cand
    return base


def detect_node(root, taken):
    pkg = read_text(os.path.join(root, "package.json"))
    if not pkg:
        return []
    try:
        scripts = (json.loads(pkg) or {}).get("scripts") or {}
    except ValueError:
        return []
    runner = package_manager(root)
    out = []
    for key in ("dev", "start", "serve"):
        script = scripts.get(key)
        if not isinstance(script, str) or not script.strip():
            continue
        port = port_in(script)
        framework, framework_pattern = "", ""
        for name, default in FRAMEWORK_PORTS:
            m = re.search(r"\b%s\b(\s+([A-Za-z][\w-]*))?" % lit(name), script)
            if not m:
                continue
            framework = name
            port = port or default
            # `\bnext\b` on its own would claim the server for `git commit -m
            # next-release`. Pin the subcommand the script actually runs when
            # there is one, the way a hand-written config would.
            framework_pattern = (r"\b%s\s+%s\b" % (lit(name), lit(m.group(2)))
                                 if m.group(2) else r"\b%s\b" % lit(name))
            break
        name = unique_name("server", taken)
        taken.add(name)
        patterns = []
        if framework_pattern:
            patterns.append(framework_pattern)
        patterns.append(r"\b(npm|pnpm|yarn|bun)\s+(run\s+)?%s\b" % lit(key))
        if port:
            patterns.append(r":%d\b" % port)
        res = {"name": name, "desc": "the dev server%s" % (" on :%d" % port if port else ""),
               "why": "", "hint": "",
               "start": "%s %s" % (runner, key), "patterns": patterns,
               "_from": "package.json scripts.%s" % key}
        if port:
            res["port"] = port
        out.append(res)
        break   # one server per package.json; dev wins over start wins over serve
    return out


def detect_make(root, taken):
    body = read_text(os.path.join(root, "Makefile"))
    if not body:
        return []
    out = []
    lines = body.split("\n")
    for i, line in enumerate(lines):
        m = re.match(r"^([A-Za-z0-9_.-]+)\s*:(?!=)", line)
        if not m:
            continue
        target = m.group(1)
        if target not in ("dev", "dev-api", "dev-web", "serve", "start", "run"):
            continue
        recipe = []
        for nxt in lines[i + 1:]:
            if nxt.startswith("\t") or nxt.startswith("    "):
                recipe.append(nxt)
            elif nxt.strip():
                break
        port = port_in("\n".join(recipe))
        base = "server" if target in ("dev", "serve", "start", "run") else target
        name = unique_name(base, taken)
        taken.add(name)
        patterns = [r"\bmake\s+%s\b" % lit(target)]
        if port:
            patterns.append(r":%d\b" % port)
        res = {"name": name,
               "desc": "what `make %s` starts%s" % (target, " on :%d" % port if port else ""),
               "why": "", "hint": "", "start": "make %s" % target,
               "patterns": patterns, "_from": "Makefile target `%s`" % target}
        if port:
            res["port"] = port
        out.append(res)
    return out


def detect_procfile(root, taken):
    body = read_text(os.path.join(root, "Procfile"))
    if not body:
        return []
    out = []
    for line in body.split("\n"):
        m = re.match(r"^([A-Za-z0-9_-]+)\s*:\s*(\S.*)$", line.strip())
        if not m:
            continue
        proc, command = m.group(1), m.group(2)
        port = port_in(command)
        name = unique_name(proc, taken)
        taken.add(name)
        head = os.path.basename((command.split() or [""])[0])
        patterns = [r"\b%s\b" % lit(head)] if head else []
        if port:
            patterns.append(r":%d\b" % port)
        res = {"name": name, "desc": "the `%s` process" % proc, "why": "", "hint": "",
               "start": command, "patterns": patterns or [r"\b%s\b" % lit(proc)],
               "_from": "Procfile"}
        if port:
            res["port"] = port
        out.append(res)
    return out


def detect_python(root, taken):
    out = []
    manage = os.path.join(root, "manage.py")
    if os.path.exists(manage):
        has_settings = any(
            os.path.exists(os.path.join(root, d, "settings.py"))
            for d in ([""] + [e for e in os.listdir(root)
                              if os.path.isdir(os.path.join(root, e))][:60]))
        if has_settings:
            name = unique_name("server", taken)
            taken.add(name)
            out.append({"name": name, "desc": "the Django dev server on :8000",
                        "why": "", "hint": "", "port": 8000,
                        "start": "python manage.py runserver",
                        "patterns": [r"\bmanage\.py\s+runserver\b", r":8000\b"],
                        "_from": "manage.py next to a settings.py"})
    deps = (read_text(os.path.join(root, "pyproject.toml"))
            + read_text(os.path.join(root, "requirements.txt")))
    if re.search(r"\b(uvicorn|fastapi)\b", deps, re.I):
        name = unique_name("api", taken)
        taken.add(name)
        out.append({"name": name, "desc": "the ASGI app on :8000", "why": "", "hint": "",
                    "port": 8000, "patterns": [r"\buvicorn\b", r":8000\b"],
                    "_from": "uvicorn/fastapi in %s" % (
                        "pyproject.toml" if os.path.exists(
                            os.path.join(root, "pyproject.toml")) else "requirements.txt")})
    return out


def detect_db(root, taken):
    """A `db` resource, and deliberately without a `start`.

    agent-bus must never restart somebody's database: the point of the guard is
    that a reseed or a destructive migration invalidates the rows the other
    sessions are holding, and taking the service down to prove it would be the
    same damage by another route."""
    for name in ("docker-compose.yml", "docker-compose.yaml", "compose.yml",
                 "compose.yaml"):
        body = read_text(os.path.join(root, name))
        if not body:
            continue
        images = re.findall(r"^\s*image:\s*[\"']?([^\s\"']+)", body, re.M)
        found, clients = [], []
        for image in images:
            for key, client in DB_IMAGES:
                if key in image.lower():
                    found.append(image)
                    if client not in clients:
                        clients.append(client)
                    break
        if not found:
            continue
        res_name = unique_name("db", taken)
        taken.add(res_name)
        patterns = [r"\b%s\b" % lit(c) for c in clients]
        patterns += [r"\balembic\b", r"\bprisma\s+migrate\b", r"\bmake\s+seed\b"]
        return [{"name": res_name, "desc": "the shared development database",
                 "why": "", "hint": "", "patterns": patterns,
                 "_from": "%s (%s)" % (name, ", ".join(found[:3]))}]
    return []


def detect_e2e(root, taken, servers):
    import glob as globmod
    found = []
    for pattern, tool in (("playwright.config.*", "playwright"),
                          ("cypress.config.*", "cypress"),
                          ("wdio.conf.*", "wdio")):
        if globmod.glob(os.path.join(root, pattern)):
            found.append(tool)
    if os.path.isdir(os.path.join(root, "maestro")):
        found.append("maestro")
    if not found:
        return []
    name = unique_name("e2e", taken)
    taken.add(name)
    res = {"name": name, "desc": "the end-to-end runner and whatever it drives",
           "why": "", "hint": "",
           "patterns": [r"\b%s\b" % lit(t) for t in found],
           "_from": ", ".join("%s config" % t for t in found)}
    if servers:
        res["implies"] = list(servers)
    return [res]


def detect_resources(root):
    """Draft resource entries read from the repository's own files."""
    taken = set()
    out = []
    for finder in (detect_node, detect_make, detect_procfile, detect_python):
        try:
            out.extend(finder(root, taken))
        except Exception:
            pass   # a malformed file is not a reason for init-repo to fail
    try:
        out.extend(detect_db(root, taken))
    except Exception:
        pass
    servers = [r["name"] for r in out if r.get("port") or r.get("start")]
    try:
        out.extend(detect_e2e(root, taken, servers))
    except Exception:
        pass
    worktree = dict(WORKTREE_RESOURCE)
    worktree["name"] = unique_name("worktree", taken)
    out.append(worktree)
    return out


def detection_summary(resources):
    lines = ["agent-bus: looked at this repository and found", ""]
    for res in resources:
        port = ":%d" % res["port"] if res.get("port") else ""
        if res.get("start"):
            what = res["start"]
        elif res.get("implies"):
            what = "implies %s" % ", ".join(res["implies"])
        elif res["name"].startswith("worktree"):
            what = "this checkout's tree and index"
        else:
            what = "(no start command)"
        origin = res.get("_from", "")
        lines.append(("  %-10s %-7s %-30s %s" % (
            res["name"], port, what, "from " + origin if origin else "")).rstrip())
    return "\n".join(lines)


def cli_init_repo(args):
    ensure_dirs()
    root, repo_key, label, _ = git_facts(os.getcwd())
    local = flag(args, "--local")
    dry = flag(args, "--dry-run")
    if local:
        path = os.path.join(REPOS, "%s.json" % repo_key)
    else:
        path = os.path.join(root, ".claude", "agent-bus.json")
    if os.path.exists(path) and not flag(args, "--force") and not dry:
        print("already configured: %s\nPass --force to overwrite it." % path)
        return

    resources = detect_resources(root)
    print(detection_summary(resources))
    print()

    cfg = {"_readme": CONFIG_README, "label": label,
           "resources": [{k: v for k, v in r.items() if not k.startswith("_")}
                         for r in resources]}
    if local:
        cfg["repo_key"] = repo_key
    if dry:
        print("--dry-run: nothing was written. This is what it would be:\n")
        print(json.dumps(cfg, indent=2))
        return
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
    except OSError:
        pass
    if not write_json_pretty(path, cfg):
        print("could not write %s" % path, file=sys.stderr)
        sys.exit(1)
    refresh_derived()
    print("Wrote %s. Read it, fix anything wrong, then commit it so every\n"
          "worktree and machine gets the same guards. `why` and `hint` are "
          "empty — filling\nthem in is what stops an agent working around a "
          "block." % path)
    if local:
        print("\nThis one is machine-local and overrides the committed config by name.")


def cli_register(_args):
    """Attach the current shell's session to the bus without waiting for a restart."""
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not sid:
        print("no CLAUDE_CODE_SESSION_ID in the environment", file=sys.stderr)
        sys.exit(1)
    hook_session_start({"session_id": sid, "cwd": os.getcwd(), "session_title": "x"})
    print("registered %s" % sid)


def plugin_root():
    return os.path.dirname(os.path.dirname(os.path.realpath(__file__)))


def plugin_name():
    manifest = read_json(os.path.join(plugin_root(), ".claude-plugin",
                                      "plugin.json")) or {}
    return manifest.get("name") or "agent-bus"


def loaded_copies():
    """Every copy of this plugin Claude Code will actually load hooks from.

    A marketplace install leaves two directories and only one of them is read:

        ~/.claude/plugins/marketplaces/<mp>/            the clone it fetched
        ~/.claude/plugins/cache/<mp>/<plugin>/<ver>/    what is loaded

    `plugin_root` answers with whichever copy this file happens to be in, so an
    installer run out of the marketplace clone patched that clone and left the
    cache holding the repository's committed `hooks.json` — the POSIX variant,
    which on Windows means `bash → ab-hook → python3 shebang → a stub that is
    not Python`. Every hook died, no session registered, and both the installer
    and `doctor` reported success, because each was describing the copy it had
    just touched. Reported from Windows 10 on 2026-07-30, and again on the
    1.5.0 update, because the cache path carries the version and a bump creates
    a fresh unpatched directory.

    Older versions are kept rather than replaced, which is what lets a session
    that is already running survive an update — so every version found is
    returned, not just the newest."""
    cache = os.path.join(HOME, ".claude", "plugins", "cache")
    name = plugin_name()
    out = []
    for depth in ("*", "*/*", "*/*/*"):
        import glob as globmod
        for d in globmod.glob(os.path.join(cache, depth)):
            manifest = read_json(os.path.join(d, ".claude-plugin", "plugin.json"))
            if manifest and manifest.get("name") == name:
                out.append(os.path.realpath(d))
    here = os.path.realpath(plugin_root())
    return sorted(set(p for p in out if p != here))


def hooks_look_wrong(root):
    """Why a copy's wiring cannot work here, or "" when it looks fine."""
    path = os.path.join(root, "hooks", "hooks.json")
    try:
        with open(path, encoding="utf-8-sig") as fh:
            text = fh.read()
    except OSError:
        return "has no hooks.json at all"
    if "__PYTHON__" in text:
        return "still has the __PYTHON__ placeholder — it was never installed"
    if IS_WIN and "ab-hook" in text:
        return ("is wired to the shell fast path, which needs bash and a real "
                "python3 on PATH")
    return ""


def unwired_copies():
    """[(root, why)] for every copy Claude Code loads that cannot work here.
    Empty on almost every machine, and cheap to ask on the rest.

    `claude plugin update` writes a new cache directory holding the committed
    hooks.json, and the installer is what turns that into something this host
    can run. Until it is re-run — on Windows, where the committed wiring names a
    shell entry point that is not there — every hook in the new copy dies. No
    session registers, no write is recorded, no guard fires, and the first thing
    anybody sees is a roster that has quietly gone empty. `doctor` and `install`
    have reported this since the fault was found; neither of them is what a
    confused agent runs, and `status` is."""
    out = []
    try:
        roots = list(loaded_copies())
        # And the copy this is running from, when that is itself one Claude Code
        # loads. `loaded_copies` answers "the OTHER copies" on purpose — the
        # ordinary shape is a shim pointing at the wired older version, warning
        # about the fresh unwired one beside it. But running the unwired copy's
        # own engine is what somebody checking on it actually does, and it
        # answered with nothing at all. Reported from Windows 10 on 2026-08-12
        # by exactly that route.
        here = os.path.realpath(plugin_root())
        if os.path.join(".claude", "plugins", "cache") in here:
            roots.append(here)
        for other in roots:
            why = hooks_look_wrong(other)
            if why:
                out.append((other, why))
    except Exception:
        pass    # a diagnosis is never worth taking `status` down with it
    return out


def cli_install(args):
    """Wire this machine up. Both installer scripts are thin wrappers around this,
    so Windows and POSIX get the same decisions made by the same code."""
    import shutil
    import stat
    root = plugin_root()
    want = os.path.join(HOME, ".claude", "skills", "agent-bus")
    print("agent-bus installer\n")
    here = os.path.realpath(root)
    others = loaded_copies()
    if here == os.path.realpath(want):
        print("  + location: %s" % root)
    elif os.path.join(".claude", "plugins", "cache") in here:
        print("  + location: %s" % root)
        print("    the marketplace cache — this is the copy Claude Code loads")
    elif os.path.join(".claude", "plugins") in here:
        # The marketplace *clone*, which is the source and not what is loaded.
        # Saying "Claude Code loads it from here" was confidently wrong, and on
        # Windows it meant a successful-looking install where every hook died.
        print("  + location: %s" % root)
        print("    the marketplace clone — Claude Code loads the cache copy, "
              "not this one")
    else:
        print("  ! this clone is at %s" % root)
        print("  ! Claude Code loads it only from %s, or from a marketplace "
              "install — move or re-clone it there" % want)
    print("  + python: %s (%s)" % (sys.executable, sys.version.split()[0]))

    # Entry point. The shell fast path exits in ~5 ms using builtins only and
    # wakes this engine just for real work; it needs bash and a `python3` on
    # PATH because it execs the engine through its shebang. Everywhere else,
    # call Python directly: one interpreter start per hook, but no dependency on
    # a shell, a path separator, or quoting rules.
    use_bash = (not IS_WIN and shutil.which("bash") and shutil.which("python3")
                and not flag(args, "--python-hooks"))
    src = "hooks.posix.json" if use_bash else "hooks.python.json"
    try:
        with open(os.path.join(root, "hooks", src), encoding="utf-8-sig") as fh:
            text = fh.read()
        if not use_bash:
            text = text.replace("__PYTHON__", json.dumps(sys.executable)[1:-1])
        with open(os.path.join(root, "hooks", "hooks.json"), "w",
                  encoding="utf-8") as fh:
            fh.write(text)
    except OSError as exc:
        print("  ! could not write hooks/hooks.json: %s" % exc)
        return
    print("  + hooks: %s" % ("shell fast path (~5 ms per hook)" if use_bash
                             else "python fallback (no shell needed)"))

    # And every other copy Claude Code might load, which is the whole point:
    # patching only the directory this file sits in is how an install succeeds
    # while the hooks that actually run are the committed POSIX ones.
    for other in others:
        try:
            with open(os.path.join(other, "hooks", "hooks.json"), "w",
                      encoding="utf-8") as fh:
                fh.write(text)
            print("  + also wired: %s" % short_path(other))
        except OSError as exc:
            print("  ! could not wire %s: %s" % (short_path(other), exc))

    for name in ("bin/agentbus", "bin/ab-hook", "install.sh"):
        p = os.path.join(root, name)
        try:
            os.chmod(p, os.stat(p).st_mode | stat.S_IXUSR | stat.S_IXGRP)
        except OSError:
            pass

    bindir = os.path.join(HOME, ".local", "bin")
    try:
        os.makedirs(bindir, exist_ok=True)
        engine = os.path.join(root, "bin", "agentbus")
        # Which engine the command on PATH should call. Normally this one — but
        # not when this one is the marketplace clone. That directory is what
        # `claude plugin update` resets, and it is not the copy Claude Code
        # loads; a shim pointing into it is a command that breaks on an update
        # it had nothing to do with. And running the installer from the clone is
        # not a mistake, it is what the README tells a Windows reader to do, so
        # this is the ordinary path and not a corner. Point at the loaded copy
        # instead. Raised from Windows 10 on 2026-08-12 by someone who had just
        # done exactly that.
        #
        # Newest by mtime, not by sorting the version out of the path: "2.9.0"
        # sorts above "2.13.1" and the answer would be a copy two releases old.
        if others and os.path.join(".claude", "plugins", "marketplaces") in here:
            try:
                loaded = max(others, key=os.path.getmtime)
                engine = os.path.join(loaded, "bin", "agentbus")
                print("  + command points at %s, not at this clone"
                      % short_path(loaded))
            except OSError:
                pass
        if IS_WIN:
            # `newline=""` on both, and it is not a detail. Text mode on Windows
            # rewrites every "\n" as "\r\n", so the .cmd — which already spells
            # its line ends out — was written with "\r\r\n", and the Git Bash
            # shim next to it came out CRLF, which is a shell script whose first
            # line is `#!/bin/sh\r`. That is the same breakage `.gitattributes`
            # exists to prevent in the checkout, arriving through the one door
            # `git add --renormalize` cannot reach, because this file is
            # generated rather than checked out.
            with open(os.path.join(bindir, "agentbus.cmd"), "w",
                      encoding="utf-8", newline="") as fh:
                fh.write('@echo off\r\n"%s" "%s" %%*\r\n' % (sys.executable, engine))
            with open(os.path.join(bindir, "agentbus"), "w",
                      encoding="utf-8", newline="") as fh:  # Git Bash
                fh.write('#!/bin/sh\nexec "%s" "%s" "$@"\n'
                         % (sys.executable.replace("\\", "/"), engine.replace("\\", "/")))
        else:
            link = os.path.join(bindir, "agentbus")
            if os.path.islink(link) or os.path.exists(link):
                os.unlink(link)
            os.symlink(engine, link)
        on_path = any(os.path.normcase(os.path.normpath(p)) ==
                      os.path.normcase(os.path.normpath(bindir))
                      for p in os.environ.get("PATH", "").split(os.pathsep))
        print("  %s command: %s%s" % ("+" if on_path else "!", bindir,
                                      "" if on_path else "  (NOT on PATH — add it)"))
    except OSError as exc:
        print("  ! could not create the agentbus command: %s" % exc)

    settings = os.path.join(HOME, ".claude", "settings.json")
    try:
        cfg = read_json(settings)
        if cfg is None and os.path.exists(settings):
            print('  ! ~/.claude/settings.json is not valid JSON — add '
                  '"Bash(agentbus:*)" to permissions.allow yourself')
        else:
            cfg = cfg or {}
            perms = cfg.get("permissions")
            if not isinstance(perms, dict):
                perms = {}
                cfg["permissions"] = perms
            allow = perms.get("allow")
            if not isinstance(allow, list):
                allow = []
                perms["allow"] = allow
            if "Bash(agentbus:*)" in allow:
                print("  + permission: already allowlisted")
            else:
                allow.append("Bash(agentbus:*)")
                os.makedirs(os.path.dirname(settings), exist_ok=True)
                # Atomic: this is the user's global settings file, and a crash
                # between truncate and flush would leave it empty.
                if write_json_pretty(settings, cfg):
                    print("  + permission: Bash(agentbus:*) allowlisted")
                else:
                    print('  ! could not write settings.json — add '
                          '"Bash(agentbus:*)" to permissions.allow yourself')
    except Exception as exc:
        print("  ! could not update settings.json (%s) — add "
              '"Bash(agentbus:*)" to permissions.allow yourself' % exc)

    print()
    cli_doctor([])
    print("\nRestart Claude Code (or /reload-plugins, then `agentbus register`).")
    print("In a repo with shared services: agentbus init-repo")


def cli_forget(args):
    """Drop session records by hand — the broom for anything the automatic
    reaping cannot reach."""
    pos = positional(args)
    gone = []
    for s in load_sessions():
        if flag(args, "--stale"):
            if now() - s.get("beat", 0) > IDLE_SECS * 3:
                gone.append(s)
        elif pos and (s.get("agent") == pos[0] or s["sid"] == pos[0]):
            gone.append(s)
    if not pos and not flag(args, "--stale"):
        print("usage: agentbus forget <agent|session-id> | --stale", file=sys.stderr)
        sys.exit(1)
    for s in gone:
        forget_session(s["sid"])
    refresh_derived()
    print("forgot %d: %s" % (len(gone), ", ".join(s.get("agent", "?") for s in gone)))


def cli_doctor(_args):
    ensure_dirs()
    sessions = load_sessions(reap=True)
    refresh_derived(sessions)
    print("bus dir      : %s" % BUS)
    print("live sessions: %d" % len(sessions))
    print("events       : %d" % read_int(SEQFILE, 0))
    print("guard tokens : %s" % (read_text(TOKENFILE).strip()[:200]
                                 if os.path.exists(TOKENFILE) else "-"))
    _, me = resolve_party()     # read-only: the name this caller answers to
    print("this session : %s" % (me.get("agent") if me else "NOT REGISTERED"))

    # Claude Code's own session registry, which is where every address in every
    # block message comes from. Four things can go wrong with it and none of
    # them is visible anywhere else: it can move, this session can be absent
    # from it, the two names for this session can disagree, and its shape can
    # change under a Claude Code upgrade. The last is the reason for the
    # unrecognised-value line — this plugin reads somebody else's undocumented
    # file, and the honest way to depend on one is to say out loud when it stops
    # looking like what was measured.
    reg = cc_sessions(force=True)
    alive = [r for r in reg.values() if r["alive"]]
    dead = len(reg) - len(alive)
    print("addresses    : %s" % CC_SESSIONS)
    if not reg:
        print("  NOT READABLE — every block will say `run ListAgents` instead of "
              "naming somebody")
    else:
        print("  %d live%s, versions %s"
              % (len(alive), ", %d stale" % dead if dead else "",
                 ", ".join(sorted({r["version"] for r in alive if r["version"]})
                           ) or "unknown"))
        odd = sorted({r["status"] for r in alive
                      if r["status"] and r["status"] not in CC_STATUSES})
        kinds = sorted({r["kind"] for r in alive
                        if r["kind"] and r["kind"] != "interactive"})
        if odd or kinds:
            print("  values this build has not seen before: %s"
                  % ", ".join(odd + kinds))
    if me:
        addr, _status = address_of(me.get("sid"), me.get("pid"))
        if not addr:
            print("  THIS SESSION HAS NO ADDRESS — the others cannot be told how "
                  "to reach you")
        elif addr != me.get("agent"):
            print("  you are `%s` here and `%s` to SendMessage — the roster "
                  "prints the second, which is the one that works"
                  % (me.get("agent"), addr))
        else:
            print("  you are `%s` to both" % addr)
    root, repo_key, label, _ = git_facts(os.getcwd())
    shared = os.path.join(root, ".claude", "agent-bus.json")
    local = os.path.join(REPOS, "%s.json" % repo_key)
    cfg = repo_config(repo_key, root)
    print("repo         : %s (%s)" % (label, repo_key))
    print("  in repo    : %s" % (shared if os.path.exists(shared) else "-"))
    print("  local      : %s" % (local if os.path.exists(local) else "-"))
    resources = cfg.get("resources", [])
    if not resources:
        print("  resources  : none — `agentbus init-repo` to declare some")
    for res in resources:
        stamp = os.path.join(MATCHED, re.sub(r"[^A-Za-z0-9_.-]", "_",
                                             "%s__%s" % (repo_key, res["name"])))
        try:
            bits = ["last matched %s" % ago(int(os.path.getmtime(stamp)))]
        except OSError:
            bits = ["NEVER matched — a moved port or renamed script fails silently"]
        if res.get("port"):
            root, how = serving(repo_key, res)
            bits.append("serving %s (%s)" % (short_path(root or "-"), how))
        missing = [p for p in res.get("patterns", []) if not literal_runs(p)]
        if missing:
            bits.append("%d pattern(s) with no literal to pre-filter on" % len(missing))
        print("  %-12s %s" % (res["name"], "; ".join(bits)))
    root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    hooks = os.path.join(root, "hooks", "hooks.json")
    print("hooks        : %s" % (hooks if os.path.exists(hooks)
                                 else "MISSING — run the installer"))
    # The copy this is running from is not necessarily the copy Claude Code
    # loads. Reporting only the one just patched is how a Windows install looked
    # healthy while every hook was dying — see loaded_copies.
    for other in loaded_copies():
        why = hooks_look_wrong(other)
        print("  %s %s%s" % ("!" if why else "+", short_path(other),
                             ("  — %s" % why) if why else "  (wired)"))
        if why:
            print("      Claude Code loads this one. Re-run: %s install"
                  % os.path.join(other, "bin", "agentbus"))
    # Every block message this plugin writes tells the agent to run `agentbus
    # <something>`. If that command does not resolve, the agent is handed advice
    # it cannot act on, so this is worth a line of its own.
    import shutil
    found = shutil.which("agentbus")
    print("command      : %s" % (found or "NOT on PATH — run `%s install`"
                                 % os.path.realpath(__file__)))
    # Whether this file's bytecode is cached, which is worth a line because when
    # it is not, every hook that wakes the engine reads and compiles ten thousand
    # lines again — 238 ms of a 313 ms floor on the Windows host that was measured
    # on — and nothing about paying it is visible from the outside. Both fast paths
    # import this file so that the cache applies; a plugin directory that is not
    # writable gets no cache, silently, for the life of the install.
    import importlib.util
    src = os.path.realpath(__file__)
    try:
        pyc = importlib.util.cache_from_source(src)
        cached = os.path.getmtime(pyc) >= os.path.getmtime(src)
    except (OSError, NotImplementedError, ValueError):
        pyc, cached = "", False
    print("bytecode     : %s" % (
        short_path(pyc) if cached else
        "NOT cached (%s) — every woken hook recompiles this file"
        % ("this directory is not writable"
           if not os.access(os.path.dirname(src), os.W_OK)
           else "no hook has woken the engine since it last changed")))


COMMANDS = {
    "status": cli_status, "whois": cli_whois, "claim": cli_claim,
    "release": cli_release, "wait": cli_wait, "post": cli_post,
    "note": cli_post, "inbox": cli_inbox, "run": cli_run, "name": cli_name,
    "own": cli_own, "disown": cli_disown,
    "watch": cli_watch, "board": cli_board, "here": cli_here,
    "port": cli_port, "env": cli_env,
    "merges": cli_merges, "integrate": cli_integrate,
    "init-repo": cli_init_repo, "doctor": cli_doctor,
    "register": cli_register, "install": cli_install, "serve": cli_serve,
    "serves": cli_serves, "forget": cli_forget,
}

HOOKS = {
    "session-start": hook_session_start, "prompt-submit": hook_prompt_submit,
    "subagent-start": hook_subagent_start, "subagent-stop": hook_subagent_stop,
    "pre-tool": hook_pre_tool, "post-batch": hook_post_batch,
    "session-end": hook_session_end, "record-write": hook_record_write,
    "post-bash": hook_post_bash,
}

USAGE = """agentbus — coordination between parallel Claude Code sessions

  status                       who is live, what is held, what serves whom
  post | inbox                 moved. Messages between sessions are Claude
                               Code's SendMessage tool now; both verbs print
                               the call that works and refuse to send.
  watch [--repo] [-n 20]       follow every agent on this machine, live
  board [--port 8787]          the same thing as a page, in your browser
  here [<path>] [--as <you>]   record which worktree you are working in
  port <res>                   the port this checkout should use
  env [--json]                 every declared port, as shell exports
  run <res>[,<res>] -- <cmd>   point the services at your tree, hold, run, release
  serve <res>                  restart a service so it serves YOUR worktree
  serves                       which checkout each service is answering for
  own "<glob>" [--why ".."] [--strict]   declare part of the tree yours
  own --list | disown "<glob>" | disown --all
  claim <res> [--why ".."] [--steal] [--as <you>]
  wait <res> [--timeout 90]    queue for a held resource
  release <res> | --all
  merges                       what the branches in flight would do if they
                               landed together, and what would conflict. Reads
                               only.
  integrate --yes [--only a,b] [--budget 2.00] [--keep]
                               spawn a headless session to actually land them, in
                               a scratch worktree. Spends model calls.
  name [<new>]                 read or set this session's name
  init-repo                    declare this repo's shared resources
  install | doctor | whois | register | forget <agent|--stale>
"""


def run_hook(event, raw):
    """Dispatch one hook from the text of its payload.

    Split out from `main` so the Python fast path can decide whether an event is
    worth waking this module for, having already read stdin — it must not be
    read twice, and the gate has to see it to decide."""
    if event not in HOOKS:
        return
    try:
        payload = json.loads((raw or b"").decode("utf-8-sig", "replace") or "{}")
    except ValueError as exc:
        sys.stderr.write("agent-bus: could not read the %s payload (%s) — "
                         "the guard was skipped for this call\n" % (event, exc))
        return
    HOOKS[event](payload)


def read_payload():
    """The hook payload, from bytes, as UTF-8 whatever the console thinks.

    `sys.stdin.read()` decodes with whatever encoding Python picked, which off
    Windows is UTF-8 and on Windows is the locale codepage unless something in
    the environment says otherwise. Two ways that fails, both measured on a
    Turkish Windows 10 host with `cp1254`:

      - a UTF-8 BOM — which PowerShell prepends when piping to a native
        executable — makes `json.loads` raise on the very first character;
      - a payload naming a file with non-ASCII in it either decodes to mojibake,
        so a glob or pattern whose matched part is not ASCII misses silently, or
        hits a byte undefined in the codepage and raises `UnicodeDecodeError`.

    `utf-8-sig` strips the BOM if one is there and is plain UTF-8 otherwise, and
    reading `buffer` skips the locale guess entirely."""
    raw = sys.stdin.buffer.read()
    return json.loads(raw.decode("utf-8-sig", "replace") or "{}")


def use_utf8():
    """Print UTF-8 whatever the console thinks it is.

    Windows consoles are not UTF-8 by default, so every message this prints with
    an em-dash in it arrives as mojibake — which is enough to make agents on a
    Turkish machine start transliterating what they say to each other so it stays
    readable.

    A function rather than the first lines of `main` because `main` is no longer
    the only way in. Both fast paths reach this module by importing it and calling
    `run_hook`, so an entry point that skipped this would write the hook's own
    "could not read the payload" warning to a console that cannot encode it — and
    that warning exists precisely because a guard which fails open has to say so.
    Losing it inside a UnicodeEncodeError is the silence it was written against."""
    for stream in (sys.stdout, sys.stderr):
        if hasattr(stream, "reconfigure"):
            try:
                stream.reconfigure(encoding="utf-8")
            except (OSError, ValueError):
                pass


def repair_argv():
    """Undo the locale's guess at what the command line said.

    Python decodes `argv` with the filesystem encoding and `surrogateescape`, so
    on a host whose locale is not UTF-8 — and `LC_ALL=C` makes that ASCII —
    every non-ASCII byte arrives as a lone surrogate. `json.dumps` with
    `ensure_ascii=False` carries those through without complaint, and the
    `.encode("utf-8")` on the next line raises `UnicodeEncodeError: surrogates
    not allowed`. That is not an `OSError`, and `OSError` is the only thing the
    write is wrapped in, so it went straight past and took the event log with
    it: nothing written, and the message a session meant to leave for the others
    simply gone. Every guard and every event carrying text from the command line
    was in the same position.

    Nothing was ever lost, which is what makes the repair exact rather than
    lossy: `surrogateescape` is reversible, so encoding those bytes back out and
    decoding them as UTF-8 is the text that was typed. Only arguments that
    actually carry a surrogate are touched. Found by the 2.13.0 encoding suite
    on its first run under WSL, 2026-08-12 — a case a UTF-8 host cannot
    produce."""
    fixed = []
    for arg in sys.argv:
        try:
            arg.encode("utf-8")
        except UnicodeEncodeError:
            arg = arg.encode("utf-8", "surrogateescape").decode("utf-8", "replace")
        fixed.append(arg)
    sys.argv = fixed


def main():
    use_utf8()
    repair_argv()
    ensure_dirs()
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return
    if argv[0] == "hook":
        if len(argv) < 2 or argv[1] not in HOOKS:
            return
        try:
            payload = read_payload()
        except ValueError as exc:
            # Never silently. A hook that returns nothing is byte-identical to
            # one that considered the call and allowed it, so a guard that fails
            # open has to say it did — on stderr, which never reaches the
            # session's parser. Three separate debugging sessions on Windows
            # were spent concluding the ownership guard was broken when the
            # payload had simply not parsed.
            sys.stderr.write("agent-bus: could not read the %s payload (%s) — "
                             "the guard was skipped for this call\n"
                             % (argv[1], exc))
            return
        HOOKS[argv[1]](payload)
        return
    fn = COMMANDS.get(argv[0])
    if not fn:
        print(USAGE)
        sys.exit(1)
    fn(argv[1:])


if __name__ == "__main__":
    try:
        main()
    except SystemExit:
        raise
    except Exception:
        # A coordination layer must never be the reason a session breaks.
        if os.environ.get("AGENTBUS_DEBUG"):
            import traceback
            traceback.print_exc(file=sys.stderr)
        sys.exit(0)
