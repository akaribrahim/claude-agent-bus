@media(prefers-reduced-motion:reduce){
 /* The ring, the tether and the highlight ARE the encoding, so only their
    entrances go, and the highlight stays put instead of fading out. */
 .hit,.arrive,.ch.wait .halo,.tethers path{animation:none}
 .hit{background:var(--mark)}}
