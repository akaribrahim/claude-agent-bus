#!/usr/bin/env python3
"""
agent-bus — coordination for parallel Claude Code sessions on one machine.

WHY THIS EXISTS. Several Claude Code sessions can work the same repository at
once, each in its own git worktree. Their file edits do not collide — separate
checkouts. What they cannot have separately is anything that lives behind a
single port or a single database on this machine: a dev server, a bundler, a
simulator, one Postgres. The failure is silent in the worst possible way: the
port hides which checkout is answering, so an agent runs a test, gets a green
result, and believes it — while it was exercising another worktree's code.

Documentation cannot fix that, because the agent has to remember to read it.
This does, because the decision is made in a PreToolUse hook: the command simply
does not run, and the agent is told who holds the resource and how to get it.

Three jobs:

  presence   every session registers itself, so each new one opens knowing who
             else is live, where, and on what branch
  locks      commands that touch a shared resource take it automatically; if
             someone else holds it the command is denied with a real reason
  messages   an append-only stream, delivered into the other agents' context at
             their next turn — no polling, no file they have to remember to read

State lives in ~/.claude/agent-bus (see LAYOUT below), never in this directory,
so updating the plugin never loses it.
"""

import errno
import json
import os
import re
import sys
import time

# hashlib, shlex, shutil, stat and subprocess are imported where they are used.
# Every hook on every tool call pays for this module's import list, and those
# five cost more than the rest of the interpreter start put together — on the
# Windows entry point, where hooks call Python directly, that is the whole bill.

# ---------------------------------------------------------------- layout ----
#
# LAYOUT
#   sessions/<sid>.json   one live session: agent name, worktree, branch, pid
#   sessions/<sid>.beat   empty; its mtime is the session's last sign of life
#   cursors/<sid>         highest event id this session has been shown
#   hot-for/<sid>         paths other live sessions wrote lately (fast-path filter)
#   writes/<sid>.log      "<epoch> <abs path>" per write, for collision checks
#   locks/<key>.json      one held resource
#   repos/<repo>.json     which resources exist in a repo and what claims them
#   events.jsonl          append-only stream, the thing agents actually read
#   events.seq            id of the last event; the fast path compares to cursors
#   live-count            number of live sessions; 1 means the bus is free
#   guard-tokens          ERE of literals worth waking the engine for

IS_WIN = sys.platform.startswith("win")
HOME = os.path.expanduser("~")
BUS = os.environ.get("AGENTBUS_HOME", os.path.join(HOME, ".claude", "agent-bus"))
SESSIONS = os.path.join(BUS, "sessions")
CURSORS = os.path.join(BUS, "cursors")
HOTFOR = os.path.join(BUS, "hot-for")
WRITES = os.path.join(BUS, "writes")
LOCKS = os.path.join(BUS, "locks")
AUTOCLAIM = os.path.join(BUS, "autoclaim")
OWNS = os.path.join(BUS, "owns")
AGENTS = os.path.join(BUS, "agents")
SERVES = os.path.join(BUS, "serves")
MATCHED = os.path.join(BUS, "matched")
REPOS = os.path.join(BUS, "repos")
EVENTS = os.path.join(BUS, "events.jsonl")
SEQFILE = os.path.join(BUS, "events.seq")
LIVEFILE = os.path.join(BUS, "live-count")
TOKENFILE = os.path.join(BUS, "guard-tokens")

STALE_BEAT = 45 * 60      # no heartbeat this long and no pid: the session is gone
ABANDONED_BEAT = 3 * 3600  # this long without a heartbeat retires it either way
IDLE_SECS = 5 * 60        # holder quiet this long: a soft lock may be taken
SOFT_TTL = 15 * 60        # auto-taken lock, measured from last use
HARD_TTL = 45 * 60        # explicitly claimed lock
COLLIDE_WINDOW = 15 * 60  # two sessions editing one file inside this window collide
MAX_DELIVER = 12          # events shown at once; the rest are summarised
ROTATE_AT = 5000          # events.jsonl lines before trimming

# Deliberately shorter than COLLIDE_WINDOW: a collision is about two sessions
# working the same file at all, while this is about a failure happening RIGHT
# NOW because somebody is mid-edit. Blaming an edit from ten minutes ago for a
# build that just broke is a guess, and a wrong guess here is worse than silence.
INTERFERENCE_WINDOW = 5 * 60
MAX_INTERFERENCE_FILES = 3

# What a failed command looks like from the outside: the shapes compilers, test
# runners and interpreters use.
#
# `errors?\b` is anchored only at the end, deliberately. Anchoring the front as
# well reads better and is wrong: Python names its failures ImportError,
# SyntaxError, TypeError, ValueError, and a leading `\b` misses every one of
# them. The cost of the loose end is that "0 errors" also matches — which does
# not matter here, because a note still requires the output to name a file
# another live session wrote in the last five minutes.
FAILURE_SIGNAL = re.compile(
    r"errors?\b"             # error, ERROR, ImportError, error TS2304, error[E0432]
    r"|\bfailed\b|\bfail:"    # FAILED, FAIL:
    r"|\btraceback\b|\bexception\b"
    r"|\bcannot find\b|\bundefined reference\b|\bpanic:"
    r"|✗|✘",
    re.I)

# Command heads that cannot start a service or reach a port, so a guarded token
# appearing after one of them is a mention, not a use: `grep -r uvicorn api/`.
READONLY_HEADS = {
    "grep", "rg", "cat", "bat", "ls", "ll", "head", "tail", "find", "fd", "tree",
    "echo", "printf", "jq", "yq", "wc", "sed", "awk", "cut", "sort", "uniq",
    "less", "more", "file", "stat", "which", "type", "man", "diff",
    "pwd", "date", "true", "false", "test", "basename", "dirname", "realpath",
    "code", "open", "agentbus",
}

# `git` is not read-only as a whole: checkout, switch, stash, reset, rebase,
# merge, add and commit all rewrite the working tree or the index, which is how
# two sessions in one checkout actually destroy each other's work.
GIT_READONLY_SUBCOMMANDS = {
    "status", "log", "diff", "show", "rev-parse", "branch", "ls-files", "blame",
    "describe", "remote", "config", "grep", "shortlog", "reflog", "tag",
    "worktree", "fetch", "cat-file", "for-each-ref", "check-ignore",
}

# Wrappers to strip before deciding what a segment really runs.
WRAPPERS = {"sudo", "time", "nohup", "exec", "command", "env", "caffeinate"}

# Heads whose `-c` argument is a command rather than text.
SHELL_HEADS = {"bash", "sh", "zsh", "dash", "ksh", "fish"}


# ------------------------------------------------------------- utilities ----

def now():
    return int(time.time())


def ensure_dirs():
    for d in (BUS, SESSIONS, CURSORS, HOTFOR, WRITES, LOCKS, REPOS, AUTOCLAIM,
              OWNS, AGENTS, SERVES, MATCHED):
        try:
            os.makedirs(d, exist_ok=True)
        except OSError:
            pass


def read_json(path, default=None):
    try:
        with open(path, "r") as fh:
            return json.load(fh)
    except Exception:
        return default


def write_json(path, obj):
    tmp = "%s.tmp.%d" % (path, os.getpid())
    try:
        with open(tmp, "w") as fh:
            json.dump(obj, fh)
        os.replace(tmp, path)
        return True
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return False


def write_json_pretty(path, obj):
    """For files a human reads and edits — atomically, like everything else."""
    tmp = "%s.tmp.%d" % (path, os.getpid())
    try:
        with open(tmp, "w") as fh:
            json.dump(obj, fh, indent=2)
            fh.write("\n")
        os.replace(tmp, path)
        return True
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return False


def read_int(path, default=0):
    try:
        with open(path, "r") as fh:
            return int(fh.read().strip() or default)
    except Exception:
        return default


def write_text(path, text):
    tmp = "%s.tmp.%d" % (path, os.getpid())
    try:
        with open(tmp, "w") as fh:
            fh.write(text)
        os.replace(tmp, path)
        return True
    except Exception:
        # On Windows os.replace onto a file another process has open raises. A
        # cursor that silently fails to advance would replay the same messages
        # every turn, so callers that care are told.
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return False


class Mutex:
    """Atomic across processes: mkdir either creates the directory or fails."""

    def __init__(self, name, timeout=5.0):
        self.path = os.path.join(BUS, ".%s.mutex" % name)
        self.timeout = timeout
        self.held = False

    def __enter__(self):
        deadline = time.time() + self.timeout
        while True:
            try:
                os.mkdir(self.path)
                self.held = True
                write_text(os.path.join(self.path, "owner"), "%d\n" % os.getpid())
                return self
            except OSError as exc:
                if exc.errno != errno.EEXIST:
                    return self
                # Break it only when the process that took it is gone. Breaking
                # on age alone lets a slow holder be robbed mid-section, and then
                # its __exit__ removes somebody else's mutex.
                owner = read_int(os.path.join(self.path, "owner"), 0)
                try:
                    stale = time.time() - os.path.getmtime(self.path) > 60
                    if (owner and not pid_alive(owner)) or (not owner and stale):
                        os.rmdir(self.path)
                        continue
                except OSError:
                    pass
                if time.time() > deadline:
                    return self
                time.sleep(0.02)

    def __exit__(self, *_):
        if self.held:
            try:
                os.unlink(os.path.join(self.path, "owner"))
            except OSError:
                pass
            try:
                os.rmdir(self.path)
            except OSError:
                pass
        return False


def ago(ts):
    if not ts:
        return "?"
    d = max(0, now() - int(ts))
    if d < 60:
        return "just now"
    if d < 3600:
        return "%dm ago" % (d // 60)
    if d < 86400:
        return "%dh%02dm ago" % (d // 3600, (d % 3600) // 60)
    return "%dd ago" % (d // 86400)


def held_for(ts):
    d = max(0, now() - int(ts or 0))
    if d < 60:
        return "%ds" % d
    if d < 3600:
        return "%dm" % (d // 60)
    return "%dh%02dm" % (d // 3600, (d % 3600) // 60)


# ------------------------------------------------------------------ repo ----

def git_facts(cwd):
    """(worktree root, repo key, label, branch) — the repo key is shared by all
    worktrees of one repository, because it is derived from the common git dir."""
    import hashlib
    import subprocess
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--git-common-dir", "--show-toplevel",
             "--abbrev-ref", "HEAD"],
            cwd=cwd, capture_output=True, text=True, timeout=5,
        )
        common, root, branch = (out.stdout.strip().split("\n") + ["", "", ""])[:3]
        # Not gated on the exit status. In a repository with no commits yet,
        # `--abbrev-ref HEAD` fails and takes the whole call down with it — but
        # the two answers that matter are already on stdout. Throwing them away
        # gave a brand-new repository a path-derived key that changed the moment
        # somebody made their first commit, quietly orphaning anything written
        # against the old one.
        if not common or not root:
            raise RuntimeError
        if branch in ("", "HEAD"):
            # Unborn, or detached. symbolic-ref answers for the first.
            ref = subprocess.run(["git", "symbolic-ref", "--short", "HEAD"],
                                 cwd=cwd, capture_output=True, text=True, timeout=5)
            branch = ref.stdout.strip() if ref.returncode == 0 else ""
    except Exception:
        root = cwd
        key = "path:" + hashlib.sha1(cwd.encode()).hexdigest()[:8]
        return cwd, key, os.path.basename(cwd.rstrip("/")) or "?", ""
    if not os.path.isabs(common):
        common = os.path.normpath(os.path.join(root, common))
    common = os.path.realpath(common)
    label = os.path.basename(os.path.dirname(common)) or "repo"
    key = "%s:%s" % (label, hashlib.sha1(common.encode()).hexdigest()[:6])
    return root, key, label, branch


def repo_relative(path, root):
    """`path` as the repository sees it, or "" when it is outside `root`.

    This is the form two worktrees of one repository have in common: the same
    file has two absolute paths and one repository-relative one, so anything
    that has to mean the same thing in both checkouts — an ownership glob, a
    filename in a build failure — is written and compared in this form."""
    try:
        rel = os.path.relpath(os.path.realpath(path), os.path.realpath(root or "/"))
    except ValueError:
        return ""   # different drives on Windows
    return "" if rel.startswith("..") else rel.replace(os.sep, "/")


def agent_name_from(branch, label, taken):
    base = (branch or "").split("/")[-1].strip() or label or "agent"
    if base in ("HEAD", "main", "master", "develop"):
        base = "%s-%s" % (label, base)
    parts = [p for p in re.split(r"[^A-Za-z0-9]+", base) if p][:3]
    name = "-".join(parts).lower() or "agent"
    if name not in taken:
        return name
    for n in range(2, 40):
        cand = "%s#%d" % (name, n)
        if cand not in taken:
            return cand
    return name


def claude_pid():
    """The pid of the Claude Code process this hook belongs to. Used for liveness:
    a heartbeat can be stale during a long turn, but the process is proof."""
    import subprocess
    env = os.environ.get("CLAUDE_PID")
    if env and env.isdigit():
        return int(env)
    pid = os.getppid()
    if IS_WIN:
        return pid  # no cheap portable ancestor walk; CLAUDE_PID covers the rest
    for _ in range(5):
        try:
            out = subprocess.run(["ps", "-o", "ppid=,comm=", "-p", str(pid)],
                                 capture_output=True, text=True, timeout=3)
            line = out.stdout.strip()
            if not line:
                return pid
            ppid, comm = line.split(None, 1)
            if "claude" in comm.lower():
                return pid
            pid = int(ppid)
            if pid <= 1:
                return os.getppid()
        except Exception:
            return os.getppid()
    return os.getppid()


def pid_alive(pid):
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return False
    if pid <= 0:
        return False
    if IS_WIN:
        # os.kill(pid, 0) is NOT a liveness probe on Windows. CPython maps every
        # signal other than CTRL_C_EVENT/CTRL_BREAK_EVENT onto TerminateProcess,
        # so the POSIX idiom would kill the very sessions this is tracking.
        try:
            import ctypes
            k32 = ctypes.windll.kernel32
            k32.OpenProcess.restype = ctypes.c_void_p
            k32.OpenProcess.argtypes = [ctypes.c_ulong, ctypes.c_int, ctypes.c_ulong]
            k32.CloseHandle.argtypes = [ctypes.c_void_p]
            handle = k32.OpenProcess(0x1000, 0, pid)  # QUERY_LIMITED_INFORMATION
            if not handle:
                # ERROR_ACCESS_DENIED means the process exists and belongs to
                # somebody else — an elevated session, say. Reading that as dead
                # would reap a live session and drop its locks.
                return k32.GetLastError() == 5
            code = ctypes.c_ulong()
            k32.GetExitCodeProcess.argtypes = [ctypes.c_void_p,
                                               ctypes.POINTER(ctypes.c_ulong)]
            ok = k32.GetExitCodeProcess(handle, ctypes.byref(code))
            k32.CloseHandle(handle)
            return bool(ok) and code.value == 259  # STILL_ACTIVE
        except Exception:
            return True  # unknown beats reaping a session that is still working
    try:
        os.kill(pid, 0)
        return True
    except OSError as exc:
        return exc.errno == errno.EPERM
    except Exception:
        return False


# -------------------------------------------------------------- sessions ----

def beat_path(sid):
    return os.path.join(SESSIONS, "%s.beat" % sid)


def touch_beat(sid):
    try:
        open(beat_path(sid), "w").close()
    except OSError:
        pass


def last_beat(sid):
    try:
        return int(os.path.getmtime(beat_path(sid)))
    except OSError:
        return 0


def load_sessions(reap=False):
    """All sessions that still look alive. With reap=True, dead ones are removed
    and whatever they were holding is released."""
    out = []
    dead = []
    try:
        names = os.listdir(SESSIONS)
    except OSError:
        return out
    for n in names:
        if not n.endswith(".json"):
            continue
        sid = n[:-5]
        rec = read_json(os.path.join(SESSIONS, n))
        if not rec:
            dead.append(sid)
            continue
        rec["sid"] = sid
        rec["beat"] = last_beat(sid) or rec.get("started", 0)
        alive = pid_alive(rec.get("pid", 0))
        quiet = now() - rec["beat"]
        # The pid is evidence, not proof: it can be recorded wrong, or reused by
        # an unrelated process, and then the record would never expire and would
        # hold locks and a roster line forever. Long enough silence retires a
        # session regardless — it re-registers by itself the moment it acts.
        if quiet > ABANDONED_BEAT or (not alive and quiet > STALE_BEAT):
            dead.append(sid)
            continue
        rec["alive_pid"] = alive
        out.append(rec)
    if reap and dead:
        for sid in dead:
            forget_session(sid)
    out.sort(key=lambda r: r.get("started", 0))
    return out


def forget_session(sid):
    release_all(sid, quiet=True)
    for a in load_agents(sid):
        forget_agent(sid, a.get("agent_id"))
    for p in (os.path.join(SESSIONS, "%s.json" % sid), beat_path(sid),
              os.path.join(CURSORS, sid), os.path.join(HOTFOR, sid),
              os.path.join(OWNS, "%s.json" % sid),
              os.path.join(WRITES, "%s.log" % sid)):
        try:
            os.unlink(p)
        except OSError:
            pass


def refresh_derived(sessions=None):
    """live-count and guard-tokens are read by the shell fast path, which cannot
    parse JSON. Keep them in sync whenever the engine runs anyway."""
    if sessions is None:
        sessions = load_sessions()
    write_text(LIVEFILE, "%d\n" % len(sessions))
    # Union over every live session's root, not one arbitrary root per repo: all
    # worktrees share a repo_key, so reading only the first would let a worktree
    # whose branch predates the config file switch the guard off for everyone.
    tokens, unfilterable = set(), False
    for s in sessions:
        cfg = repo_config(s.get("repo_key"), s.get("root"))
        for res in cfg.get("resources", []):
            if not res.get("patterns"):
                continue
            toks = resource_tokens(res)
            if not toks:
                unfilterable = True  # nothing mandatory to filter on
                continue
            for tok in toks:
                tokens.add(re.escape(tok))
    # Every `agentbus` command wakes the engine when this repository declares
    # anything. `agentbus serve web` names its resource and nothing else, so
    # none of the patterns' literals appear in it — and the guard has to see it,
    # because deciding which subagent is asking can only be done in the hook.
    if tokens or unfilterable:
        tokens.add(re.escape("agentbus"))
    # A resource whose patterns have no mandatory literal cannot be pre-filtered.
    # Waking the engine on every command costs milliseconds; missing the guard
    # costs a silently wrong test, so the gate opens for everything instead.
    write_text(TOKENFILE, ("." if unfilterable
                           else "|".join(sorted(tokens)) if tokens else "") + "\n")
    sweep_locks(sessions)
    sweep_autoclaims()
    rebuild_hot(sessions)


def sweep_autoclaims():
    """Delete claim records that nothing will ever come back to release.

    An automatic claim is remembered under its tool call's id and forgotten when
    that call finishes. Anything that stops the finish arriving leaves the record
    behind for ever — which is exactly what the PostToolUse-on-error hole did
    until it was found on 2026-07-28, and twenty-two of them were still sitting
    there afterwards.

    Not merely litter. The shell fast path decides whether PostToolUse is worth
    an engine start by asking whether *any* claim record exists, so a handful of
    dead ones make every Bash call in every session on this machine pay ~40ms
    for nothing, for ever. An hour is far longer than the longest real command
    and far shorter than the soft lock it would have belonged to."""
    cutoff = now() - 3600
    try:
        names = os.listdir(AUTOCLAIM)
    except OSError:
        return
    for name in names:
        path = os.path.join(AUTOCLAIM, name)
        try:
            if os.path.getmtime(path) < cutoff:
                os.unlink(path)
        except OSError:
            pass


def sweep_locks(sessions):
    """Delete locks that already grant nothing — expired, or held by a session
    that is gone. They confuse `status` and outlive the reason they were taken;
    leaving them on disk made a session look like it was holding the whole rig
    an hour after it had finished with it."""
    try:
        names = os.listdir(LOCKS)
    except OSError:
        return
    for name in names:
        if not name.endswith(".json"):
            continue
        path = os.path.join(LOCKS, name)
        lock = read_json(path)
        if not lock:
            continue
        holder, stealable, _ = lock_state(lock, sessions)
        if not stealable:
            continue
        with Mutex("lock-" + re.sub(r"[^A-Za-z0-9]", "_",
                                    lock.get("resource", ""))[:40]):
            current = read_json(path)
            if current and current.get("acquired_at") == lock.get("acquired_at"):
                try:
                    os.unlink(path)
                except OSError:
                    pass


def rebuild_hot(sessions):
    """hot-for/<sid> is what the pre-tool fast path greps a tool payload against
    before deciding whether to wake the engine, and it holds two kinds of thing:

      - absolute paths other live sessions wrote recently, for the reactive
        collision guard;
      - the fixed leading text of anything they have declared they own.

    The second is not an optimisation, it is what makes ownership work at all.
    Without it the engine is woken only once the owner has already written the
    file, so a declaration would be enforced one edit too late — which is
    exactly the failure declaring scope up front is meant to prevent."""
    cutoff = now() - COLLIDE_WINDOW
    per, owned = {}, {}
    for s in sessions:
        per[s["sid"]] = recent_writes(s["sid"], cutoff)
        owned[s["sid"]] = [glob_prefix(d.get("glob")) for d in load_owns(s["sid"])]
    for s in sessions:
        paths = set()
        for other in per:
            if other == s["sid"]:
                continue
            paths.update(p for _, p in per[other])
            paths.update(owned[other])
        write_text(os.path.join(HOTFOR, s["sid"]),
                   "".join(p + "\n" for p in sorted(paths)))


def recent_writes(sid, cutoff, compact=False):
    """Compact only your OWN log. Rewriting another session's file races with the
    shell hook appending to it, and the append that lands mid-rewrite is lost —
    which means a real edit vanishes from the collision record."""
    path = os.path.join(WRITES, "%s.log" % sid)
    out = []
    try:
        with open(path, "r") as fh:
            lines = fh.readlines()[-800:]
    except OSError:
        return out
    for line in lines:
        try:
            ts, p = line.rstrip("\n").split(" ", 1)
            ts = int(ts)
        except ValueError:
            continue
        if ts >= cutoff:
            out.append((ts, p))
    if compact and len(lines) > 400:
        write_text(path, "".join("%d %s\n" % (t, p) for t, p in out))
    return out


def follow_cwd(rec, cwd, trusted=True):
    """Keep a session's recorded worktree in step with where it is working.

    Claude Code can move a session into a worktree it creates under
    `.claude/worktrees/`, and the record's root is derived once, at SessionStart.
    Left alone it stays wrong for the rest of the session — and everything that
    matters reads it. `serve` starts the service from that root, so the service
    comes up from the tree the session *started* in while the message says it
    used yours; `serving_check` compares against that root, so the session is
    told the port is fine when it is answering with somebody else's code.

    That is the exact silent wrong-checkout failure this plugin exists to
    prevent, produced by the plugin itself. Reported from real use on
    2026-07-27, after it quietly reverted an API to `main` and an agent spent
    time on a fix that had stopped being deployed.

    The new worktree sits *inside* the old root's path, so noticing it means
    asking git again rather than comparing prefixes.

    A hook payload's `cwd` is the session's own and is taken as given. The CLI's
    is only wherever somebody happened to run a command from — a human in
    another terminal could be anywhere — so from there a move is followed only
    within the same repository. That still covers the case this exists for,
    because every worktree of one repository shares its key."""
    if not cwd or cwd == rec.get("cwd"):
        return rec
    root, repo_key, label, branch = git_facts(cwd)
    if not trusted and repo_key != rec.get("repo_key"):
        return rec
    rec.update({"cwd": cwd, "root": root, "repo_key": repo_key,
                "repo_label": label, "branch": branch})
    write_json(os.path.join(SESSIONS, "%s.json" % rec["sid"]), rec)
    # No announcement. The first version of this emitted a note on every move,
    # and a session running parallel subagents in different worktrees moves on
    # every other tool call: it produced thirty notes in three minutes into
    # every other session's context in that repository. A move is visible in the
    # roster, which is where somebody looking for it will look.
    return rec


def caller_view(me, cwd):
    """`me`, but rooted where this particular call is actually running.

    A session has one worktree; a session running parallel subagents in two
    worktrees does not, and the guards need an answer per call rather than per
    session. `serving_check` asks "is this service answering for *my* tree", and
    for a subagent the honest answer is about the subagent's tree, not its
    parent's.

    A view, not a write. Persisting it was the first thing tried and it was
    worse: two subagents dragged the session's root back and forth between them
    on every tool call, so the record was not even consistently wrong."""
    if not cwd or cwd == me.get("cwd"):
        return me
    root, repo_key, label, branch = git_facts(cwd)
    view = dict(me)
    view.update({"cwd": cwd, "root": root, "repo_key": repo_key,
                 "repo_label": label, "branch": branch})
    return view


def current_session(payload=None):
    """Which session am I? Hooks are told on stdin; the CLI reads the environment
    Claude Code exports into every Bash call."""
    sid = None
    if payload:
        sid = payload.get("session_id")
    sid = sid or os.environ.get("AGENTBUS_SESSION") or os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not sid:
        return None, None
    rec = read_json(os.path.join(SESSIONS, "%s.json" % sid))
    if rec:
        rec["sid"] = sid
        if payload:
            # A subagent's tool call carries its own cwd and an `agent_id`. That
            # cwd is the subagent's, not the session's, so it must not move the
            # session: two subagents working in two worktrees would drag the
            # root back and forth between them on every tool call, which is
            # worse than a stale root because it is not even consistently wrong.
            # The guards still decide from the caller's own tree — see
            # caller_view in hook_pre_tool.
            if not payload.get("agent_id"):
                rec = follow_cwd(rec, payload.get("cwd"))
        else:
            # The CLI runs from wherever the caller is standing — a moved
            # session, or a subagent in its own worktree. That is the right
            # answer for `serve` and `run`, and it must not be written back:
            # the caller may be one of several subagents in several worktrees.
            here = caller_view(rec, os.getcwd())
            if here.get("repo_key") == rec.get("repo_key"):
                rec = here
    return sid, rec


# -------------------------------------------------------------- subagents ----
#
# A subagent launched with the Task tool runs inside its parent's process and
# its hooks carry the parent's `session_id`. Everything here treats "who is
# acting" as a *party* rather than a session: the session itself, or one
# subagent within it.
#
# That matters because two subagents run genuinely in parallel. Before this they
# shared an identity, so a lock one held read as "already yours" to the other
# and both walked through — two agents driving one simulator, which is the
# failure this plugin exists to stop, happening inside a single session.
#
# What tells them apart is `agent_id`, which Claude Code puts on every hook a
# subagent causes — SubagentStart, its own PreToolUse, PostToolUse and
# PostToolBatch, and SubagentStop — and on none that the session itself causes.
# It is *not* in the environment of the Bash tool, so the CLI cannot know which
# subagent is calling it; every decision that needs to know is therefore made in
# the hook, where it is known.

def agent_path(sid, aid):
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", "%s__%s" % (sid, aid))
    return os.path.join(AGENTS, "%s.json" % safe)


def load_agents(sid=None):
    """Live subagents, optionally just one session's."""
    out = []
    try:
        names = os.listdir(AGENTS)
    except OSError:
        return out
    for name in sorted(names):
        if not name.endswith(".json"):
            continue
        rec = read_json(os.path.join(AGENTS, name))
        if not rec or (sid and rec.get("sid") != sid):
            continue
        out.append(rec)
    out.sort(key=lambda r: r.get("started", 0))
    return out


def forget_agent(sid, aid):
    release_all_for(sid, aid, quiet=True)
    for path in (agent_path(sid, aid),
                 os.path.join(CURSORS, party_key({"sid": sid, "agent_id": aid}))):
        try:
            os.unlink(path)
        except OSError:
            pass


def party_key(me):
    """One string naming the party that acts: a session, or a subagent in it."""
    aid = me.get("agent_id") or ""
    return "%s__%s" % (me.get("sid") or "", aid) if aid else (me.get("sid") or "")


def same_party(holder, me):
    """Whether a lock held by `holder` is already this caller's to use.

    Two different subagents conflict. A parent and its own subagent never do —
    a parent that claimed something and then delegated must not deadlock against
    the agent it is waiting for, and a backgrounded subagent must not be blocked
    by the session that started it."""
    if (holder.get("sid") or "") != (me.get("sid") or ""):
        return False
    a = holder.get("agent_id") or ""
    b = me.get("agent_id") or ""
    return a == b or not a or not b


def subagent_name(parent_agent, sid):
    """`checkout-rewrite/2` — obviously that session's, and typeable."""
    taken = {a.get("name") for a in load_agents(sid)}
    for n in range(1, 60):
        cand = "%s/%d" % (parent_agent or "agent", n)
        if cand not in taken:
            return cand
    return "%s/x" % (parent_agent or "agent")


def register_agent(sid, aid, agent_type=None, cwd=None):
    """Record a subagent. Also reachable from the ordinary hooks, because a
    subagent that missed SubagentStart — the plugin was installed or reloaded
    while it was already running — would otherwise stay nameless and invisible
    for its whole life. Sessions have had the same fallback since the beginning;
    this is the same idea one level down."""
    if not sid or not aid:
        return None
    ensure_dirs()
    parent = read_json(os.path.join(SESSIONS, "%s.json" % sid)) or {}
    cwd = cwd or parent.get("cwd") or os.getcwd()
    root, repo_key, label, branch = git_facts(cwd)
    rec = {"sid": sid, "agent_id": aid, "agent_type": agent_type or "agent",
           "name": subagent_name(parent.get("agent"), sid),
           "parent": parent.get("agent"), "cwd": cwd, "root": root,
           "repo_key": repo_key, "repo_label": label, "branch": branch,
           "started": now(), "seen": now()}
    write_json(agent_path(sid, aid), rec)
    # Its cursor starts at the end of the stream: a subagent that lives for two
    # minutes does not want the last hour of the repository's chatter.
    write_text(os.path.join(CURSORS, party_key({"sid": sid, "agent_id": aid})),
               "%d\n" % read_int(SEQFILE, 0))
    return rec


def hook_subagent_start(payload):
    register_agent(payload.get("session_id"), payload.get("agent_id"),
                   payload.get("agent_type"), payload.get("cwd"))


def hook_subagent_stop(payload):
    sid, aid = payload.get("session_id"), payload.get("agent_id")
    if sid and aid:
        forget_agent(sid, aid)


def name_hint_once(me):
    """Told to a subagent once: the name everybody else sees it by.

    A subagent has no way to find this out for itself. Its Bash environment is
    its parent's, so `agentbus post` is attributed to the parent — and the
    agents on this machine had noticed, and were writing "(agent /2)" into the
    body of every message by hand to compensate. Giving them the name is the
    honest fix: the tool should do that, not the agent."""
    aid = me.get("agent_id")
    if not aid:
        return ""
    rec = read_json(agent_path(me.get("sid"), aid))
    if not rec or rec.get("told"):
        return ""
    rec["told"] = now()
    write_json(agent_path(me.get("sid"), aid), rec)
    return ("agent-bus: on this machine you are `%s` — that is the name the "
            "other agents see, and the name to reach you at. Sign what you say "
            "with it, or it is attributed to the session that started you:\n"
            "  agentbus post --as %s \"...\"" % (rec["name"], rec["name"]))


def party_view(me, payload):
    """`me`, seen as whichever party is actually acting.

    A subagent gets its own name and its own worktree; everything else — the
    repo, the session id — it shares with its parent."""
    aid = payload.get("agent_id") if payload else None
    if not aid:
        return me
    view = dict(me)
    view["agent_id"] = aid
    view["agent_type"] = payload.get("agent_type") or "agent"
    rec = read_json(agent_path(me.get("sid"), aid))
    if rec:
        view["agent"] = rec.get("name") or view.get("agent")
        for k in ("root", "repo_key", "repo_label", "branch"):
            if rec.get(k):
                view[k] = rec[k]
    else:
        # SubagentStart was missed — the plugin was installed or reloaded while
        # this subagent was already running. Record it now rather than leaving
        # it nameless for the rest of its life.
        rec = register_agent(me.get("sid"), aid, view.get("agent_type"),
                             me.get("cwd"))
        if rec:
            view["agent"] = rec["name"]
    return view


# ---------------------------------------------------------------- events ----

def emit(sid, agent, repo_key, kind, text, to=None, extra=None):
    rec = {"ts": now(), "sid": sid or "", "agent": agent or "?",
           "repo": repo_key or "", "kind": kind, "text": (text or "")[:1500]}
    if to:
        rec["to"] = to
    if extra:
        rec.update(extra)
    with Mutex("events"):
        seq = read_int(SEQFILE, 0) + 1
        rec["i"] = seq
        line = json.dumps(rec, ensure_ascii=False) + "\n"
        try:
            # A single write of one short line is atomic under O_APPEND, which is
            # what lets every session share this file without a writer lock.
            flags = (os.O_CREAT | os.O_WRONLY | os.O_APPEND
                     | getattr(os, "O_BINARY", 0))
            fd = os.open(EVENTS, flags, 0o600)
            os.write(fd, line.encode("utf-8"))
            os.close(fd)
        except OSError:
            return 0
        write_text(SEQFILE, "%d\n" % seq)
    return seq


def read_events(after=0):
    out = []
    try:
        with open(EVENTS, "r") as fh:
            for line in fh:
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if rec.get("i", 0) > after:
                    out.append(rec)
    except OSError:
        pass
    return out


def rotate_events():
    try:
        if os.path.getsize(EVENTS) < ROTATE_AT * 120:
            return
    except OSError:
        return
    # Read and write under the same mutex: reading first and trimming afterwards
    # discards everything appended in between.
    with Mutex("events"):
        try:
            with open(EVENTS, "r") as fh:
                lines = fh.readlines()
        except OSError:
            return
        if len(lines) >= ROTATE_AT:
            write_text(EVENTS, "".join(lines[-1000:]))


# Kinds worth interrupting another agent's turn for. Lock churn is not: with
# automatic claims lasting one command, "took 'api'" / "released 'api'" would be
# two context injections per scoped run carrying nothing anyone can act on. They
# stay in the stream for `status` and `inbox`; they just do not get delivered.
DELIVERED_KINDS = {"note", "serve", "handoff"}


def interesting_to(rec, me):
    """An event reaches a session when it is addressed to it, or when it happened
    in the same repository and says something. Work in another project stays out
    of the way entirely."""
    # Not `sid`: a subagent shares its parent's, and a message from one to the
    # other would be filtered out as the reader's own.
    if rec.get("sid") == me.get("sid") and rec.get("agent") == me.get("agent"):
        return False
    if rec.get("to"):
        return rec["to"] == me.get("agent")
    if rec.get("kind") not in DELIVERED_KINDS:
        return False
    return rec.get("repo") == me.get("repo_key")


def deliver(me, advance=True):
    """Everything this session has not been shown yet, formatted for context."""
    key = party_key(me)
    cursor = read_int(os.path.join(CURSORS, key), 0)
    seq = read_int(SEQFILE, 0)
    if cursor > seq:
        cursor = 0  # the counter was reset or restored under us; do not wedge
    if seq <= cursor:
        return ""
    fresh = read_events(after=cursor)
    mine = [r for r in fresh if interesting_to(r, me)]
    if advance:
        # Advance to what was actually read, not to the sequence number sampled
        # before reading: an event appended in between would be shown twice.
        top = max([seq] + [r.get("i", 0) for r in fresh])
        write_text(os.path.join(CURSORS, key), "%d\n" % top)
    if not mine:
        return ""
    shown = mine[-MAX_DELIVER:]
    lines = []
    for r in shown:
        who = r.get("agent", "?")
        direct = " → you" if r.get("to") else ""
        text = r.get("text", "")
        if "\n" in text:
            # A handoff is inherently several lines; folding it into the
            # one-line form would run the whole summary together and make the
            # thing that is worth reading the thing that gets skimmed.
            body = "\n".join("      " + ln for ln in text.split("\n"))
            lines.append("  - %s%s, %s:\n%s" % (who, direct, ago(r.get("ts")), body))
        else:
            lines.append("  - %s%s, %s: %s" % (who, direct, ago(r.get("ts")), text))
    head = "agent-bus — %d new message%s from other sessions:" % (
        len(mine), "" if len(mine) == 1 else "s")
    if len(mine) > len(shown):
        head += " (showing the last %d)" % len(shown)
    return head + "\n" + "\n".join(lines)


# ----------------------------------------------------------------- locks ----

def lock_path(repo_key, res):
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", "%s__%s" % (repo_key, res))
    return os.path.join(LOCKS, "%s.json" % safe)


def load_lock(repo_key, res):
    return read_json(lock_path(repo_key, res))


def lock_state(lock, sessions):
    """(holder record or None, stealable, why-stealable)"""
    if not lock:
        return None, True, "free"
    holder = next((s for s in sessions if s["sid"] == lock.get("sid")), None)
    if holder is None:
        return None, True, "holder is gone"
    ttl = HARD_TTL if lock.get("mode") == "hard" else SOFT_TTL
    if now() - lock.get("last_used", 0) > ttl:
        return holder, True, "lock expired"
    if lock.get("mode") == "soft" and now() - holder.get("beat", 0) > IDLE_SECS:
        return holder, True, "holder idle and holding only a soft lock"
    return holder, False, ""


def do_claim(me, res, why="", mode="soft", steal=False, sessions=None):
    """(ok, lock, holder, reason). Never blocks; `wait` is the blocking form."""
    sessions = sessions if sessions is not None else load_sessions()
    repo_key = me.get("repo_key", "")
    with Mutex("lock-" + re.sub(r"[^A-Za-z0-9]", "_", res)[:40]):
        lock = load_lock(repo_key, res)
        holder, stealable, reason = lock_state(lock, sessions)
        if lock and same_party(lock, me):
            lock["last_used"] = now()
            if mode == "hard":
                lock["mode"] = "hard"
                if why:
                    lock["why"] = why
            write_json(lock_path(repo_key, res), lock)
            return True, lock, None, "already yours"
        if holder and not stealable and not steal:
            return False, lock, holder, reason
        queue = (lock or {}).get("queue", []) if lock else []
        queue = [q for q in queue if q.get("sid") != me.get("sid")]
        new = {"resource": res, "repo": repo_key, "sid": me.get("sid"),
               "agent_id": me.get("agent_id") or "",
               "agent": me.get("agent"), "worktree": me.get("root"),
               "branch": me.get("branch"), "mode": mode, "why": why,
               "acquired_at": now(), "last_used": now(), "queue": queue}
        if not write_json(lock_path(repo_key, res), new):
            # Reporting a claim we could not record would hand out the resource
            # to everyone who asks.
            return False, lock, holder, "could not write the lock file"
    if holder:
        emit(me.get("sid"), me.get("agent"), repo_key, "lock",
             "took '%s' from %s (%s)%s" % (res, holder.get("agent"),
                                           "forced" if steal else reason,
                                           (' — ' + why) if why else ""))
    elif mode == "hard" or why:
        emit(me.get("sid"), me.get("agent"), repo_key, "lock",
             "took '%s'%s" % (res, (' — ' + why) if why else ""))
    return True, new, holder, ""


def do_release(me, res, quiet=False):
    repo_key = me.get("repo_key", "")
    # Check and unlink under the same mutex do_claim uses: between a bare check
    # and the unlink, another session can legitimately take the lock, and then
    # this would delete theirs.
    with Mutex("lock-" + re.sub(r"[^A-Za-z0-9]", "_", res)[:40]):
        lock = load_lock(repo_key, res)
        if not lock or not same_party(lock, me):
            return False
        waiting = lock.get("queue", [])
        try:
            os.unlink(lock_path(repo_key, res))
        except OSError:
            return False
    if not quiet:
        tail = ""
        if waiting:
            tail = " — waiting: %s" % ", ".join(q.get("agent", "?") for q in waiting)
        emit(me.get("sid"), lock.get("agent") or me.get("agent"), repo_key,
             "lock", "released '%s'%s" % (res, tail))
    return True


def release_all(sid, quiet=False):
    try:
        names = os.listdir(LOCKS)
    except OSError:
        return 0
    n = 0
    for name in names:
        lock = read_json(os.path.join(LOCKS, name))
        if lock and lock.get("sid") == sid:
            try:
                os.unlink(os.path.join(LOCKS, name))
                n += 1
            except OSError:
                pass
            if not quiet:
                emit(sid, lock.get("agent"), lock.get("repo"), "lock",
                     "released '%s'" % lock.get("resource"))
    return n


def release_all_for(sid, aid, quiet=False):
    """Everything one subagent was holding, given back when it stops."""
    try:
        names = os.listdir(LOCKS)
    except OSError:
        return 0
    n = 0
    for name in names:
        lock = read_json(os.path.join(LOCKS, name))
        if not lock or lock.get("sid") != sid or (lock.get("agent_id") or "") != aid:
            continue
        try:
            os.unlink(os.path.join(LOCKS, name))
            n += 1
        except OSError:
            pass
        if not quiet:
            emit(sid, lock.get("agent"), lock.get("repo"), "lock",
                 "released '%s'" % lock.get("resource"))
    return n


def held_by(sid):
    out = []
    try:
        for name in os.listdir(LOCKS):
            lock = read_json(os.path.join(LOCKS, name))
            if lock and lock.get("sid") == sid:
                out.append(lock)
    except OSError:
        pass
    return out


# ------------------------------------------------------------- ownership ----
#
# A lock says "I am using this right now". Ownership says "this part of the tree
# is mine for the next while — do not drift into it".
#
# The file guard that already exists is reactive: it blocks a write to a file
# another session touched in the last fifteen minutes. That is one edit too
# late, and it cannot express the thing people running several agents actually
# need, which is to say up front what an agent must NOT touch. Ownership is
# declared, enforced, and dies with the session that declared it — nobody has to
# remember to clean it up, and nobody has to maintain a "never touch" list by
# hand in CLAUDE.md.

def owns_path(sid):
    return os.path.join(OWNS, "%s.json" % sid)


def load_owns(sid):
    rec = read_json(owns_path(sid)) or {}
    globs = rec.get("globs")
    return globs if isinstance(globs, list) else []


def save_owns(sid, globs):
    if globs:
        return write_json(owns_path(sid), {"globs": globs})
    try:
        os.unlink(owns_path(sid))
    except OSError:
        pass
    return True


def normalise_glob(glob, root=None):
    """A declaration in the form everything else compares against: repository-
    relative, forward slashes, no leading or trailing separator. An absolute
    path inside the worktree is accepted and converted, because that is what
    tab-completion produces."""
    glob = (glob or "").strip().replace(os.sep, "/")
    if root and os.path.isabs(glob):
        rel = repo_relative(glob, root)
        if rel:
            glob = rel
    return glob.strip("/")


def glob_matches(glob, rel):
    """Does this declaration cover this repository-relative path?

    `fnmatch`, not pathlib globbing, and the difference is deliberate: here `*`
    crosses directory separators, so `src/*` covers `src/a/b.ts`. Somebody
    claiming `src/*` means the subtree, and the surprising direction would be
    the other one. It is a simplification and it is documented in SKILL.md and
    README.md rather than left to be discovered.

    A declaration with no wildcard at all is read as a directory: `agentbus own
    api` is what a person types when they mean the whole of `api/`, and owning
    exactly one file named `api` and nothing under it would be a silent no-op —
    the worst possible outcome for a guard somebody thought they had set."""
    import fnmatch
    glob = normalise_glob(glob)
    rel = (rel or "").replace(os.sep, "/")
    if not glob or not rel:
        return False
    if not any(ch in glob for ch in "*?["):
        return rel == glob or rel.startswith(glob + "/")
    # fnmatchcase, not fnmatch: fnmatch normalises case *and* separators through
    # os.path.normcase, which on Windows turns the `/` in a glob into `\` and
    # stops it matching anything at all.
    return fnmatch.fnmatchcase(rel, glob)


def glob_prefix(glob):
    """The fixed leading text of a declaration — what the shell fast path can
    grep a tool payload for before deciding to wake the engine.

    Empty when the declaration starts with a wildcard. `grep -F` reads an empty
    pattern as one that matches everything, which is the right answer: a
    declaration that cannot be pre-filtered must not become a declaration that
    is never enforced."""
    glob = normalise_glob(glob)
    cut = len(glob)
    for ch in "*?[":
        i = glob.find(ch)
        if i >= 0:
            cut = min(cut, i)
    return glob[:cut]


def owners_of(path, me, sessions):
    """[(session, declaration)] for every live session that has declared this
    path — this session included, so callers can see their own claim."""
    real = os.path.realpath(path)
    out = []
    for s in sessions:
        # A glob is written against a repository root, so one from another
        # project cannot describe this file even if the text happens to fit.
        if s.get("repo_key") != me.get("repo_key"):
            continue
        rel = repo_relative(real, me.get("root")) or \
            repo_relative(real, s.get("root"))
        if not rel:
            continue
        for dec in load_owns(s["sid"]):
            if glob_matches(dec.get("glob"), rel):
                out.append((s, dec))
                break
    return out


def ownership_text(me, path, owner, dec, same_tree):
    rel = repo_relative(os.path.realpath(path), me.get("root")) or path
    lines = [
        'agent-bus: BLOCKED. %s has declared this part of the tree theirs.'
        % owner.get("agent"),
        "",
        "  file    : %s" % rel,
        "  owner   : %s   branch %s" % (owner.get("agent"),
                                        owner.get("branch") or "-"),
        "  claimed : %s, %s ago" % (dec.get("glob"), held_for(dec.get("at"))),
    ]
    if dec.get("why"):
        lines.append('  reason  : "%s"' % dec["why"])
    if same_tree:
        lines.append("  worktree: %s   (the same one you are in)"
                     % short_path(owner.get("root", "")))
    else:
        # Without this the agent can see it is in a different checkout, knows
        # that means no overwrite, and concludes the bus is wrong — which is how
        # an agent learns to route around it.
        lines += [
            "  worktree: %s   (not yours)" % short_path(owner.get("root", "")),
            "",
            "  They marked this scope --strict, which means they want it left "
            "alone even",
            "  from another checkout — usually because they are restructuring "
            "it and any",
            "  parallel edit will be painful to merge.",
        ]
    lines += [
        "",
        "Ask before taking it:",
        '  agentbus post --to %s "I need %s — what are you doing with it?"'
        % (owner.get("agent"), rel),
        "",
        "Once they have agreed, take the file itself and the block lifts:",
        "  agentbus claim 'file:%s' --why \"agreed with %s\""
        % (os.path.realpath(path), owner.get("agent")),
        "",
        "(Or the human can rerun the edit with AGENTBUS_OFF=1 in front of it.)",
    ]
    return "\n".join(lines)


def ownership_verdict(me, path, sessions):
    """("deny"|"note"|"", text) for an Edit/Write against declared ownership.

    Denies inside one checkout and warns across worktrees, because two sessions
    editing one path in two branches is what branches are for — denying it would
    be wrong, and a guard that is wrong is a guard agents learn to work around.
    Inside one checkout it is a genuine overwrite. `--strict` is how an owner
    says the cross-worktree case matters to them too."""
    owners = owners_of(path, me, sessions)
    if not owners:
        return "", ""
    if any(s["sid"] == me.get("sid") for s, _ in owners):
        return "", ""   # my own declaration is not a block on me
    mine_root = os.path.realpath(me.get("root") or "")
    same_tree = [(s, d) for s, d in owners
                 if os.path.realpath(s.get("root") or "") == mine_root]
    if same_tree:
        s, dec = same_tree[0]
        return "deny", ownership_text(me, path, s, dec, True)
    strict = [(s, d) for s, d in owners if d.get("strict")]
    if strict:
        s, dec = strict[0]
        return "deny", ownership_text(me, path, s, dec, False)
    s, dec = owners[0]
    rel = repo_relative(os.path.realpath(path), me.get("root")) or path
    return "note", (
        "agent-bus: %s has declared '%s' theirs on %s%s. You are in a different "
        "worktree, so this edit is allowed and nothing is being overwritten — "
        "but you are both changing %s, and that lands at merge time. Worth a "
        "word first if it is more than a line:\n"
        '  agentbus post --to %s "I am also editing %s"'
        % (s.get("agent"), dec.get("glob"), s.get("branch") or "-",
           (' — "%s"' % dec["why"]) if dec.get("why") else "",
           rel, s.get("agent"), rel))


# ---------------------------------------------------------------- handoff ----
#
# A session ends and what it learned goes with it. The next agent re-derives it
# from the diff, or does not, and repeats the work. Everything needed to write
# the summary is already on disk — this is only the part nobody would think to
# write down, assembled at the one moment somebody is guaranteed not to be
# around to do it by hand.

def bump_guarded(me):
    """Count the commands this session took a shared resource for.

    This is the one number in a handoff that cannot be reconstructed afterwards.
    `matched/` looked like the place to get it and is not: it holds one file per
    repository and resource for the whole machine, and its mtime says when that
    resource last matched *anybody's* command, not how many of them were this
    session's."""
    sid = me.get("sid")
    if not sid:
        return
    path = os.path.join(SESSIONS, "%s.json" % sid)
    rec = read_json(path)
    if not rec:
        return
    # Re-read rather than mutate the caller's copy: the record is also written
    # by `doing`, `name` and re-registration, and writing back a stale dict here
    # would silently undo whichever of those happened most recently.
    rec["guarded"] = int(rec.get("guarded", 0) or 0) + 1
    write_json(path, rec)


def still_serving(me):
    """[(resource, root)] — services this session started that are still up.

    These outlive the session, which is the founding bug this whole plugin
    exists for: the process keeps answering on the port long after the session
    that started it has gone, and the next request from any worktree is silently
    served that dead session's code. It is the most useful line in a handoff."""
    out = []
    mine = os.path.realpath(me.get("root") or "")
    try:
        names = os.listdir(SERVES)
    except OSError:
        return out
    for name in sorted(names):
        rec = read_json(os.path.join(SERVES, name))
        if not rec or rec.get("repo") != me.get("repo_key"):
            continue
        if os.path.realpath(rec.get("root") or "") != mine:
            continue
        if not pid_alive(rec.get("pid")):
            continue
        out.append((rec.get("resource"), rec.get("root")))
    return out


def repo_writes(me, cutoff=0):
    """This session's writes that are inside its own repository — newest first,
    one entry per file.

    Writes outside the tree are dropped. A scratch file under /tmp is not work
    anybody needs handed over, and counting one made a session that had done
    nothing else announce itself on the way out: the first handoff this plugin
    ever wrote in anger said "wrote 1 file, most recently /tmp/claude-clip.txt".
    A summary nobody needs is what stops the useful ones being read."""
    seen, out = set(), []
    for ts, path in reversed(recent_writes(me.get("sid"), cutoff)):
        real = os.path.realpath(path)
        if real in seen:
            continue
        seen.add(real)
        rel = repo_relative(real, me.get("root"))
        if rel:
            out.append((ts, rel))
    return out


def did_something(me):
    """Whether this session is worth writing a handoff about at all.

    A summary from a session that only read things is noise, and noise is
    precisely what makes the useful ones get skimmed past."""
    if repo_writes(me):
        return True
    if int(me.get("guarded", 0) or 0):
        return True
    return bool(held_by(me.get("sid")))


def handoff_text(me, note=""):
    """A summary of what this session did, for the sessions that outlive it."""
    sid = me.get("sid")
    files = [rel for _, rel in repo_writes(me)]
    lines = ["agent-bus: %s finished on %s (%s)." % (
        me.get("agent"), me.get("branch") or "-", short_path(me.get("root", "")))]
    if me.get("doing"):
        lines.append("  was doing : %s" % me["doing"])
    if files:
        lines.append("  wrote     : %d file%s, most recently %s"
                     % (len(files), "" if len(files) == 1 else "s",
                        ", ".join(files[:10])))
    guarded = int(me.get("guarded", 0) or 0)
    if guarded:
        lines.append("  claimed   : %d command%s took a shared resource"
                     % (guarded, "" if guarded == 1 else "s"))
    for res, root in still_serving(me):
        lines.append("  still up  : '%s' is STILL RUNNING and still serving %s — "
                     "it will answer with THAT tree until somebody runs "
                     "`agentbus serve %s`" % (res, short_path(root), res))
    owned = [d.get("glob") for d in load_owns(sid)]
    if owned:
        lines.append("  freed     : %s — declared theirs, now nobody's"
                     % ", ".join(owned))
    if note:
        lines.append("  note      : %s" % note)
    return "\n".join(lines)


# --------------------------------------------------------------- serving ----
#
# A lock says who may use a service. It does not say which checkout that service
# is actually serving, and those are different facts: a session can end, its
# detached dev server keeps answering on the same port, the lock is released, and
# the next request from any worktree is silently answered by the dead session's
# code. That is the original bug this whole plugin exists for, and only this part
# of it closes the case.
#
# So ownership is tracked separately from the lock, and agent-bus owns the
# lifecycle: it starts the service, therefore it knows which tree it serves. A
# service it did not start is reported as unknown rather than guessed — the
# working directory of a foreign process is readable on macOS and Linux, and not
# on Windows, and a wrong guess here is worse than no answer.

def serve_path(repo_key, res):
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", "%s__%s" % (repo_key, res))
    return os.path.join(SERVES, "%s.json" % safe)


def port_pid(port):
    """The pid listening on a TCP port, or None."""
    import subprocess
    try:
        if IS_WIN:
            out = subprocess.run(["netstat", "-ano", "-p", "TCP"],
                                 capture_output=True, text=True, timeout=8)
            for line in out.stdout.splitlines():
                cols = line.split()
                if len(cols) >= 5 and cols[3] == "LISTENING" \
                        and cols[1].endswith(":%d" % port):
                    return int(cols[4])
            return None
        out = subprocess.run(["lsof", "-ti", "tcp:%d" % port, "-sTCP:LISTEN"],
                             capture_output=True, text=True, timeout=8)
        first = out.stdout.split()
        return int(first[0]) if first else None
    except Exception:
        return None


def pid_cwd(pid):
    """The working directory of a running process, or None where the platform
    will not say (Windows does not expose it to another process)."""
    import subprocess
    if IS_WIN or not pid:
        return None
    try:
        out = subprocess.run(["lsof", "-a", "-p", str(pid), "-d", "cwd", "-Fn"],
                             capture_output=True, text=True, timeout=8)
        for line in out.stdout.splitlines():
            if line.startswith("n"):
                return line[1:]
    except Exception:
        pass
    return None


def same_group(a, b):
    """Whether two pids belong to one process group.

    `shell=True` does not always exec the command it was given. On macOS the
    shell replaces itself with a simple command, so the pid we recorded when we
    started the service is the pid listening on the port. On Linux /bin/sh forks
    it and stays, and those two pids differ — which made agent-bus fail to
    recognise a service it had started itself, and fall back to probing the
    port. `start_new_session=True` puts the whole thing in its own group, and
    that is what they still have in common."""
    if IS_WIN or not a or not b:
        return False
    try:
        return os.getpgid(int(a)) == os.getpgid(int(b))
    except (OSError, ValueError):
        return False


def serving(repo_key, res_cfg):
    """Who a declared service is currently serving.

    Returns (root, how) where `how` is 'agent-bus' when we started it, 'probe'
    when the platform let us read a foreign process's directory, 'unknown' when
    something is listening that we cannot attribute, and (None, 'down') when
    nothing is."""
    name, port = res_cfg["name"], res_cfg.get("port")
    rec = read_json(serve_path(repo_key, name))
    # One lsof, not two: it was called again a few lines down for the same port.
    listener = port_pid(port) if port else None
    if rec and pid_alive(rec.get("pid")):
        if not port or listener == rec.get("pid") \
                or same_group(listener, rec.get("pid")):
            return rec.get("root"), "agent-bus"
    if not port:
        return (None, "down") if not rec else (rec.get("root"), "stale")
    if not listener:
        return None, "down"
    pid = listener
    cwd = pid_cwd(pid)
    if cwd:
        root = cwd
        for _ in range(6):  # the service may run from a subdirectory of the tree
            if os.path.isdir(os.path.join(root, ".git")) or \
               os.path.isfile(os.path.join(root, ".git")):
                return root, "probe"
            parent = os.path.dirname(root)
            if parent == root:
                break
            root = parent
        return cwd, "probe"
    return None, "unknown"


def stop_service(repo_key, res_cfg):
    import signal
    import subprocess
    name, port = res_cfg["name"], res_cfg.get("port")
    rec = read_json(serve_path(repo_key, name)) or {}
    pid = rec.get("pid")
    if not pid or not pid_alive(pid):
        # The record can outlive the process — another worktree's session may
        # have replaced the service since. Whatever is on the port now is what
        # has to go, not what we last wrote down.
        pid = port_pid(port) if port else None
    if not pid:
        try:
            os.unlink(serve_path(repo_key, name))
        except OSError:
            pass
        return True  # nothing is running: the goal state is already reached
    try:
        if IS_WIN:
            subprocess.run(["taskkill", "/F", "/T", "/PID", str(pid)],
                           capture_output=True, timeout=15)
        else:
            try:
                os.killpg(os.getpgid(pid), signal.SIGTERM)
            except Exception:
                os.kill(pid, signal.SIGTERM)
            for _ in range(40):
                if not pid_alive(pid):
                    break
                time.sleep(0.25)
            if pid_alive(pid):
                try:
                    os.killpg(os.getpgid(pid), signal.SIGKILL)
                except Exception:
                    os.kill(pid, signal.SIGKILL)
    except Exception:
        pass  # it may have exited between the probe and the signal
    try:
        os.unlink(serve_path(repo_key, name))
    except OSError:
        pass
    if port:
        for _ in range(20):
            if port_pid(port) is None:
                return True
            time.sleep(0.25)
        return False
    return not pid_alive(pid)


def wait_ready(res_cfg, root, timeout=60):
    import socket
    import subprocess
    deadline = time.time() + timeout
    ready, port = res_cfg.get("ready"), res_cfg.get("port")
    while time.time() < deadline:
        if ready:
            try:
                if subprocess.run(ready, shell=True, cwd=root, capture_output=True,
                                  timeout=10).returncode == 0:
                    return True
            except Exception:
                pass
        elif port:
            try:
                with socket.create_connection(("127.0.0.1", port), timeout=1):
                    return True
            except OSError:
                pass
        else:
            return True
        time.sleep(1)
    return False


def start_service(me, res_cfg):
    import subprocess
    name = res_cfg["name"]
    root = me.get("root")
    cwd = os.path.join(root, res_cfg["cwd"]) if res_cfg.get("cwd") else root
    logs = os.path.join(BUS, "logs")
    try:
        os.makedirs(logs, exist_ok=True)
    except OSError:
        pass
    log = os.path.join(logs, "%s__%s.log" % (
        re.sub(r"[^A-Za-z0-9_.-]", "_", me.get("repo_key", "")), name))
    kwargs = {}
    if IS_WIN:
        kwargs["creationflags"] = 0x00000008 | 0x00000200  # DETACHED | NEW_GROUP
    else:
        kwargs["start_new_session"] = True                  # its own process group
    try:
        fh = open(log, "ab")
        proc = subprocess.Popen(res_cfg["start"], shell=True, cwd=cwd,
                                stdout=fh, stderr=subprocess.STDOUT,
                                stdin=subprocess.DEVNULL, **kwargs)
    except Exception as exc:
        return False, "could not start: %s" % exc
    write_json(serve_path(me.get("repo_key"), name), {
        "resource": name, "repo": me.get("repo_key"), "root": root,
        "cwd": cwd, "by": me.get("agent"), "pid": proc.pid,
        "port": res_cfg.get("port"), "started": now(), "log": log,
    })
    if not wait_ready(res_cfg, cwd):
        return False, "started but never became ready — see %s" % log
    return True, log


def ensure_serving(me, res_cfg, sessions=None):
    """Make this resource serve MY worktree. (ok, message)"""
    if not res_cfg.get("start"):
        return True, ""
    repo_key = me.get("repo_key")
    root, how = serving(repo_key, res_cfg)
    if how in ("agent-bus", "probe") and root and \
            os.path.realpath(root) == os.path.realpath(me.get("root") or ""):
        return True, "already serving your worktree"
    if how != "down":
        if not stop_service(repo_key, res_cfg):
            return False, ("something is on %s that agent-bus could not stop; "
                           "stop it yourself and retry"
                           % (res_cfg.get("port") or res_cfg["name"]))
    ok, detail = start_service(me, res_cfg)
    if not ok:
        return False, detail
    emit(me.get("sid"), me.get("agent"), repo_key, "serve",
         "'%s' now serves %s" % (res_cfg["name"], short_path(me.get("root"))))
    return True, "restarted from your worktree (log: %s)" % detail


# ------------------------------------------------------ resource matching ----

def repo_config(repo_key, root=None):
    """What this repository's shared resources are.

    The declaration belongs in the repository — `<root>/.claude/agent-bus.json` —
    so it travels with the project to every machine and every collaborator rather
    than living on the one laptop where somebody happened to write it. A
    machine-local file may add or override entries by name for anything that is
    genuinely local (a different port, a path only you have)."""
    shared = read_json(os.path.join(root, ".claude", "agent-bus.json"), {}) if root else {}
    local = read_json(os.path.join(REPOS, "%s.json" % repo_key), {}) or {}
    if not shared:
        return local
    if not local:
        return shared
    merged = dict(shared)
    by_name = {r["name"]: r for r in shared.get("resources", [])}
    for res in local.get("resources", []):
        by_name[res["name"]] = res
    merged["resources"] = list(by_name.values())
    return merged


def literal_runs(pattern):
    """The runs of plain characters in a regex — every match must contain the
    longest of them, which is what makes it usable as a cheap pre-filter."""
    runs, cur, i, n = [], [], 0, len(pattern or "")
    while i < n:
        ch = pattern[i]
        if ch == "\\" and i + 1 < n:
            nxt = pattern[i + 1]
            if nxt.isalnum():          # \b \d \s \w … : a class or an anchor
                runs.append("".join(cur))
                cur = []
            else:                       # \. \- \/ … : an escaped literal
                cur.append(nxt)
            i += 2
            continue
        if ch in "*?" and cur:
            cur.pop()                   # the preceding character is optional
        if ch in "[](){}|?*+^$.":
            runs.append("".join(cur))
            cur = []
            i += 1
            continue
        cur.append(ch)
        i += 1
    runs.append("".join(cur))
    return [r for r in runs if r]


def strip_groups(pattern):
    """The pattern with every (...) removed — what is left is mandatory."""
    out, depth, i = [], 0, 0
    while i < len(pattern or ""):
        ch = pattern[i]
        if ch == "\\" and i + 1 < len(pattern):
            if depth == 0:
                out.append(ch)
                out.append(pattern[i + 1])
            i += 2
            continue
        if ch == "(":
            depth += 1
        elif ch == ")":
            depth = max(0, depth - 1)
        elif depth == 0:
            out.append(ch)
        i += 1
    return "".join(out)


def top_level_groups(pattern):
    groups, depth, start, i = [], 0, 0, 0
    while i < len(pattern or ""):
        ch = pattern[i]
        if ch == "\\":
            i += 2
            continue
        if ch == "(":
            if depth == 0:
                start = i + 1
            depth += 1
        elif ch == ")":
            depth -= 1
            if depth == 0:
                groups.append(pattern[start:i])
        i += 1
    return groups


def split_alternatives(body):
    parts, depth, cur = [], 0, []
    for ch in body:
        if ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
        if ch == "|" and depth == 0:
            parts.append("".join(cur))
            cur = []
        else:
            cur.append(ch)
    parts.append("".join(cur))
    return parts


def pattern_tokens(pat):
    """Literals such that EVERY string matching `pat` contains at least one.

    The longest literal run in the raw pattern is not that: in
    `git\\s+(checkout|add|cherry-pick)` the longest run lives inside the
    alternation, so filtering on it drops `git add` — the guard silently never
    fires. What is mandatory is what sits outside the groups; failing that, one
    literal from every branch of a group, since a match must take some branch."""
    outside = [r for r in literal_runs(strip_groups(pat)) if len(r) >= 2]
    if outside:
        return {max(outside, key=len)}
    for body in top_level_groups(pat):
        branches, usable = set(), True
        for branch in split_alternatives(body):
            runs = [r for r in literal_runs(branch) if len(r) >= 2]
            if not runs:
                usable = False
                break
            branches.add(max(runs, key=len))
        if usable and branches:
            return branches
    return set()  # nothing can be pre-filtered on: the caller must always wake


def resource_tokens(res):
    """Literal substrings the shell fast path filters on before waking the
    engine. Derived from the patterns so the two cannot drift apart — a
    hand-written list had silently stopped covering `make seed`."""
    out = set(res.get("tokens", []))
    for pat in res.get("patterns", []):
        toks = pattern_tokens(pat)
        if not toks:
            return set()  # signals "cannot filter this resource"
        out |= toks
    if res.get("port"):
        out.add(str(res["port"]))
    return {t for t in out if len(t) >= 2}


def strip_heredocs(cmd):
    """Drop heredoc bodies. What a command feeds to stdin is data — a commit
    message, a plan, a JSON payload — and matching resource patterns against it
    is how `git commit -m "$(cat <<EOF ... restart uvicorn ... EOF)"` ends up
    claiming the API."""
    lines = (cmd or "").split("\n")
    kept, i = [], 0
    while i < len(lines):
        kept.append(lines[i])
        m = re.search(r"<<-?\s*(['\"]?)([A-Za-z_][A-Za-z0-9_]*)\1", lines[i])
        if m:
            word, j = m.group(2), i + 1
            while j < len(lines) and lines[j].strip() != word:
                j += 1
            i = j
        i += 1
    return "\n".join(kept)


def split_segments(cmd):
    """Split on `;`, `&&`, `||`, `|` and newlines that are not inside quotes.
    A quote-blind split invents segments out of the middle of message text."""
    segments, cur, quote, i = [], [], None, 0
    n = len(cmd or "")
    while i < n:
        ch = cmd[i]
        if quote:
            cur.append(ch)
            if ch == quote:
                quote = None
            i += 1
        elif ch in "'\"":
            quote = ch
            cur.append(ch)
            i += 1
        elif ch == "\\" and i + 1 < n:
            cur.append(ch)
            cur.append(cmd[i + 1])
            i += 2
        elif cmd.startswith("&&", i) or cmd.startswith("||", i):
            segments.append("".join(cur))
            cur = []
            i += 2
        elif ch in ";|\n":
            segments.append("".join(cur))
            cur = []
            i += 1
        else:
            cur.append(ch)
            i += 1
    segments.append("".join(cur))
    return [s for s in segments if s.strip()]


def tokens_of(segment):
    import shlex
    try:
        lex = shlex.shlex(segment, posix=True)
        lex.whitespace_split = True
        return list(lex)
    except ValueError:
        return segment.split()


def is_readonly(head, toks):
    """A guarded word behind a read-only command is a mention, not a use.

    `git` is only read-only in its reading subcommands: `git checkout`, `stash`,
    `reset` and `add -A` rewrite the working tree, which is exactly what two
    sessions sharing one checkout destroy each other with."""
    if head == "git":
        sub = next((t for t in toks[1:] if not t.startswith("-")), "")
        return sub in GIT_READONLY_SUBCOMMANDS
    return head in READONLY_HEADS


def command_targets(cmd, depth=0):
    """The words of a command that are plausibly things it acts on.

    A shell command carries two kinds of words: what it operates on, and text it
    merely transports — a commit message, a PR body, a heredoc. Matching a
    resource pattern against the second kind is how a commit message that names
    a tool claims that tool and blocks the commit. The rule that separates them
    cheaply: a token containing whitespace is prose. Real targets — paths,
    ports, URLs, flags — do not have spaces in them."""
    out = []
    for seg in split_segments(strip_heredocs(cmd)):
        toks = tokens_of(seg)
        while toks and (re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", toks[0])
                        or os.path.basename(toks[0]) in WRAPPERS):
            toks = toks[1:]
        if not toks:
            continue
        head = os.path.basename(toks[0])
        if head in SHELL_HEADS and depth < 3:
            # `bash -c '…'` — that quoted argument is a command, not prose.
            inline = next((toks[i + 1] for i, tok in enumerate(toks[1:], 1)
                           if tok == "-c" and i + 1 < len(toks)), None)
            if inline is not None:
                out.extend(command_targets(inline, depth + 1))
                continue
            # `bash script.sh` — the script cannot be read, but its name and
            # arguments still can, so fall through rather than going blind.
        if is_readonly(head, toks):
            continue
        out.append(" ".join(t for t in toks if not re.search(r"\s", t)))
    return out


def explicit_resources(cmd, cfg):
    """Resources named outright on an `agentbus` command line.

    `agentbus run simulator -- maestro test` is a request for the simulator, and
    the guard has to see it as one. The CLI cannot: a subagent's Bash
    environment is byte-identical to its parent's, so by the time `agentbus run`
    is executing, nothing there knows which subagent is calling. Deciding it
    here, in the hook, where `agent_id` is on the payload, is what makes
    `agentbus run` serialise between two subagents instead of handing both of
    them the same rig."""
    out = []
    by_name = {r["name"]: r for r in cfg.get("resources", [])}
    for seg in split_segments(strip_heredocs(cmd)):
        toks = tokens_of(seg)
        while toks and (re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", toks[0])
                        or os.path.basename(toks[0]) in WRAPPERS):
            toks = toks[1:]
        if len(toks) < 3 or os.path.basename(toks[0]) != "agentbus":
            continue
        if toks[1] not in ("run", "claim", "serve", "wait"):
            continue
        for name in toks[2].split(","):
            res = by_name.get(name.strip())
            if res and res["name"] not in [h["name"] for h in out]:
                res = dict(res)
                # `serve` and `run` exist to move a service to your tree, so the
                # "this is serving somebody else" check must not stop them.
                res["_explicit"] = True
                out.append(res)
    return out


def resources_for(cmd, cfg):
    """Which declared resources this command would touch."""
    hits = explicit_resources(cmd, cfg)
    resources = cfg.get("resources", [])
    if not resources:
        return hits
    by_name = {r["name"]: r for r in resources}
    for text in command_targets(cmd):
        for res in resources:
            if res["name"] in [h["name"] for h in hits]:
                continue
            for pat in res.get("patterns", []):
                try:
                    if re.search(pat, text, re.I):
                        hits.append(res)
                        break
                except re.error:
                    continue
    # A Maestro run needs the simulator, but it is also only meaningful against
    # the bundler and API serving your worktree, so one match can pull in others.
    for res in list(hits):
        for name in res.get("implies", []):
            dep = by_name.get(name)
            if dep and dep["name"] not in [h["name"] for h in hits]:
                dep = dict(dep)
                dep["_implied_by"] = res["name"]
                hits.append(dep)
    return hits


# ------------------------------------------------------------ formatting ----

def roster_text(me, sessions):
    same, other = [], []
    for s in sessions:
        if s["sid"] == me.get("sid"):
            continue
        (same if s.get("repo_key") == me.get("repo_key") else other).append(s)
    lines = []
    if same:
        lines.append("Other sessions on this repo (%d):" % len(same))
        for s in same:
            idle = "" if now() - s.get("beat", 0) < IDLE_SECS else "  [idle]"
            lines.append("  - %s  %s  %s  (last seen %s)%s" % (
                s.get("agent"), short_path(s.get("root", "")), s.get("branch") or "-",
                ago(s.get("beat")), idle))
            if s.get("doing"):
                lines.append("      doing: %s" % s["doing"])
            for a in load_agents(s["sid"]):
                lines.append("      · %s  (%s, %s)" % (
                    a.get("name"), a.get("agent_type"),
                    short_path(a.get("root", ""))))
            owned = owns_summary(s["sid"])
            if owned:
                lines.append("      owns: %s" % owned)
    if other:
        labels = sorted({s.get("repo_label", "?") for s in other})
        lines.append("Elsewhere on this Mac: %d session%s (%s)." % (
            len(other), "" if len(other) == 1 else "s", ", ".join(labels)))
    return "\n".join(lines)


def locks_text(me, sessions, with_serving=True):
    cfg = repo_config(me.get("repo_key", ""), me.get("root"))
    resources = cfg.get("resources", [])
    if not resources:
        return ""
    mine = os.path.realpath(me.get("root") or "")
    held, free, serves = [], [], []
    for res in resources:
        lock = load_lock(me.get("repo_key"), lock_name(me, res))
        holder, stealable, _ = lock_state(lock, sessions)
        if lock and holder and not stealable:
            yours = " (yours)" if lock.get("sid") == me.get("sid") else ""
            held.append("  - %s → %s%s, %s%s" % (
                res["name"], lock.get("agent"), yours,
                held_for(lock.get("acquired_at")),
                (', "%s"' % lock["why"]) if lock.get("why") else ""))
        else:
            free.append(res["name"])
        if with_serving and (res.get("port") or res.get("start")):
            root, how = serving(me.get("repo_key"), res)
            if how == "down":
                continue
            if root and os.path.realpath(root) == mine:
                serves.append("  - %s serves YOUR worktree" % res["name"])
            elif root:
                serves.append("  - %s serves %s — a request to it answers with "
                              "THAT checkout's code" % (res["name"], short_path(root)))
            else:
                serves.append("  - %s is up but agent-bus did not start it; which "
                              "checkout it serves is unknown" % res["name"])
    out = []
    if held:
        out.append("Shared resources in use:")
        out.extend(held)
    if free:
        out.append("Free: %s" % ", ".join(free))
    if serves:
        out.append("Running services:")
        out.extend(serves)
    return "\n".join(out)


def short_path(p):
    return p.replace(HOME, "~") if p else "?"


def owns_summary(sid, limit=4):
    """One line naming what a session has declared, for the roster."""
    decs = load_owns(sid)
    if not decs:
        return ""
    shown = ", ".join("%s%s" % (d.get("glob", "?"),
                                " (strict)" if d.get("strict") else "")
                      for d in decs[:limit])
    if len(decs) > limit:
        shown += ", +%d more" % (len(decs) - limit)
    return shown


def ownership_text_block(me, sessions):
    """The ownership section of `status` and of the session-start banner."""
    lines = []
    for s in sessions:
        summary = owns_summary(s["sid"], limit=8)
        if not summary or s.get("repo_key") != me.get("repo_key"):
            continue
        who = "you" if s["sid"] == me.get("sid") else s.get("agent")
        lines.append("  - %s: %s" % (who, summary))
    if not lines:
        return ""
    return "Declared ownership:\n" + "\n".join(lines)


RULES = (
    "How this works: a command that touches a shared resource takes it for the "
    "length of that command. You hear about it only when someone else holds it, "
    "or when the service is answering for a different checkout than yours — both "
    "are blocked with the reason. Useful: `agentbus status`, "
    "`agentbus serve <res>` to point a service at your worktree, "
    "`agentbus run <res> -- <cmd>` to do that and run one command, "
    "`agentbus post \"...\"` to tell the others something they cannot see."
    "\n\nOne rule that is not enforced by a block: if a build or test failure "
    "names files you did not edit, do not fix them. Another session is probably "
    "mid-edit and the error will disappear on its own — wait and re-run. If it "
    "persists, ask them (`agentbus post --to <agent> \"...\"`) rather than "
    "editing. Fix only files you own."
)


# ----------------------------------------------------------------- hooks ----

def register(payload):
    """Create or refresh this session's record. Also reachable from the other
    hooks: a session that missed SessionStart — installed mid-session, hook timed
    out, wrongly reaped — would otherwise stay invisible and unguarded forever,
    with nothing to tell anyone."""
    ensure_dirs()
    sid = payload.get("session_id") or os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not sid:
        return None, False
    cwd = payload.get("cwd") or os.getcwd()
    root, repo_key, label, branch = git_facts(cwd)
    sessions = load_sessions(reap=True)
    existing = read_json(os.path.join(SESSIONS, "%s.json" % sid))
    taken = {s.get("agent") for s in sessions if s["sid"] != sid}
    rec = existing or {}
    rec.update({
        "sid": sid, "pid": claude_pid(), "cwd": cwd, "root": root,
        "repo_key": repo_key, "repo_label": label, "branch": branch,
        "started": rec.get("started") or now(),
    })
    if not rec.get("agent") or rec.get("agent") in taken:
        rec["agent"] = agent_name_from(branch, label, taken)
    write_json(os.path.join(SESSIONS, "%s.json" % sid), rec)
    touch_beat(sid)
    if existing is None:
        # Start at the current end of the stream: nobody wants a backlog.
        write_text(os.path.join(CURSORS, sid), "%d\n" % read_int(SEQFILE, 0))
    return rec, existing is None


def install_hint_once():
    """Said once per machine: the `agentbus` command cannot be found.

    Installing from a marketplace wires the hooks but cannot put a command on
    anybody's PATH, and every block this plugin produces ends in advice to run
    one. Without this the first block is followed by `command not found` and the
    agent has no way to act on anything it was just told."""
    marker = os.path.join(BUS, ".cli-notice")
    if os.path.exists(marker):
        return ""
    import shutil
    if shutil.which("agentbus"):
        write_text(marker, "on-path\n")
        return ""
    write_text(marker, "%d\n" % now())
    return ("agent-bus: the hooks are running, but the `agentbus` command is "
            "not on PATH — so the commands in any message from agent-bus will "
            "not run. Ask the human to run this once:\n  %s install"
            % os.path.realpath(__file__))


def hook_session_start(payload):
    rec, first_time = register(payload)
    if not rec:
        return
    sid, repo_key = rec["sid"], rec["repo_key"]
    root, branch, label = rec["root"], rec["branch"], rec["repo_label"]
    sessions = load_sessions()
    if first_time and len(sessions) > 1:
        emit(sid, rec["agent"], repo_key, "join",
             "joined on %s (%s)" % (branch or "-", short_path(root)))
    refresh_derived(sessions)
    rotate_events()

    others = [s for s in sessions if s["sid"] != sid]
    hint = install_hint_once()
    if not others:
        # Alone: say nothing, cost nothing — unless the plugin cannot actually
        # be driven, which is worth exactly one sentence, once.
        if hint:
            print(json.dumps({"hookSpecificOutput": {
                "hookEventName": "SessionStart", "additionalContext": hint}}))
        return

    blocks = ["## agent-bus", "You are `%s`. %d other Claude Code session%s live on "
              "this Mac right now." % (rec["agent"], len(others),
                                       " is" if len(others) == 1 else "s are")]
    r = roster_text(rec, sessions)
    if r:
        blocks.append(r)
    lk = locks_text(rec, sessions)
    if lk:
        blocks.append(lk)
    pending = deliver(rec)
    if pending:
        blocks.append(pending)
    if hint:
        blocks.append(hint)
    blocks.append(RULES)

    out = {"hookSpecificOutput": {
        "hookEventName": "SessionStart",
        "additionalContext": "\n\n".join(blocks)}}
    if not payload.get("session_title"):
        out["hookSpecificOutput"]["sessionTitle"] = "%s · %s" % (
            rec["agent"], branch or label)
    print(json.dumps(out))


def hook_prompt_submit(payload):
    if os.environ.get("AGENTBUS_OFF"):
        return
    sid, me = current_session(payload)
    if not me:
        me, _ = register(payload)
        if not me:
            return
        sid = me["sid"]
    touch_beat(sid)
    sessions = load_sessions(reap=True)
    refresh_derived(sessions)
    rotate_events()
    # Keep an explicit claim from expiring under a session that is still working.
    # This has to be written back: mutating the parsed dict changed nothing.
    for lock in held_by(sid):
        if lock.get("mode") == "hard":
            lock["last_used"] = now()
            write_json(lock_path(lock.get("repo"), lock.get("resource")), lock)
    text = deliver(me)
    if not text:
        return
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "UserPromptSubmit", "additionalContext": text}}))


def batch_bash_output(payload):
    """Everything the Bash calls in this batch printed.

    This is where the interference guard has to read from, and not from
    PostToolUse, because **PostToolUse does not fire when a tool call errors** —
    which is every single case this guard exists for. Verified against Claude
    Code 2.1.220: a batch whose Bash command exits non-zero produces
    PreToolUse and PostToolBatch and no PostToolUse at all. PostToolBatch
    carries `tool_calls`, each with its `tool_response`, whatever the outcome.

    Only Bash calls are read. A Read of a file that happens to contain the word
    "error" is not a failing build, and treating it as one would produce an
    accusation out of a coincidence."""
    calls = payload.get("tool_calls")
    if not isinstance(calls, list):
        return ""
    parts = []
    for call in calls:
        if not isinstance(call, dict) or call.get("tool_name") != "Bash":
            continue
        text = response_text(call.get("tool_response"))
        if text:
            parts.append(text)
    return "\n".join(parts)


def release_batch_claims(me, payload):
    """Give back what the commands in this batch took.

    PostToolUse releases a claim the moment its command finishes, but it never
    runs for a command that failed — so without this, a failing guarded command
    would hold the resource for its full soft TTL and block the other session
    for a quarter of an hour."""
    calls = payload.get("tool_calls")
    if not isinstance(calls, list):
        return
    for call in calls:
        if isinstance(call, dict):
            release_autoclaim(me, call.get("tool_use_id"))


def hook_post_batch(payload):
    # Deliberately not gated on the live count. What matters is whether there is
    # anything this session has not been shown, and the two are not the same
    # thing: a session that ends hands over on its way out, and its exit is what
    # drops the count. `deliver` reads a cursor and a counter and returns "" when
    # there is nothing, which is the usual case and is cheap.
    if os.environ.get("AGENTBUS_OFF"):
        return
    sid, me = current_session(payload)
    if not me:
        return
    touch_beat(sid)
    me = party_view(me, payload)
    release_batch_claims(me, payload)
    blocks = []
    hint = name_hint_once(me)
    if hint:
        blocks.append(hint)
    if read_int(LIVEFILE, 0) >= 2:
        note = interference_note(me, batch_bash_output(payload), load_sessions())
        if note:
            blocks.append(note)
    text = deliver(me)
    if text:
        blocks.append(text)
    if not blocks:
        return
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PostToolBatch",
        "additionalContext": "\n\n".join(blocks)}}))


def note_block(me, what, why):
    """Record that something was refused.

    A denial used to leave no trace at all: the agent was told, and nobody else
    could ever see that it had happened. So "did the bus actually stop anything
    today" was unanswerable, which is a poor position for a tool whose whole
    claim is that it stops things. Not delivered into anyone's context — it is
    for the log, `watch` and `status`."""
    emit(me.get("sid"), me.get("agent"), me.get("repo_key"), "block",
         "blocked on %s — %s" % (what, why))


def deny(reason):
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": reason}}))


def note_ctx(text):
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse", "additionalContext": text}}))


def hook_pre_tool(payload):
    if os.environ.get("AGENTBUS_OFF"):
        return
    if read_int(LIVEFILE, 0) < 2:
        return  # alone: nothing to collide with, and Windows calls us directly
    sid, me = current_session(payload)
    if not me:
        me, _ = register(payload)  # missing SessionStart is not an exemption
        if not me:
            return
    tool = payload.get("tool_name")
    ti = payload.get("tool_input") or {}
    me = party_view(caller_view(me, payload.get("cwd")), payload)
    sessions = load_sessions()
    if tool == "Bash":
        return guard_bash(me, ti.get("command", ""), sessions,
                          payload.get("tool_use_id"))
    if tool in ("Edit", "Write", "NotebookEdit"):
        return guard_file(me, ti.get("file_path") or ti.get("notebook_path") or "",
                          sessions)


def remember_autoclaim(me, tool_use_id, names):
    """What this one command took, so PostToolUse can give it straight back.

    An automatic claim means "for the length of this command" — otherwise a
    one-second curl holds the API for the full soft TTL and the other session
    waits a quarter of an hour for a service nobody is using."""
    if not tool_use_id or not names:
        return
    write_json(autoclaim_path(tool_use_id),
               {"sid": me.get("sid"), "party": party_key(me),
                "repo": me.get("repo_key"), "resources": names})


def response_text(tool_response):
    """Everything a finished Bash call printed, as one string.

    The shape varies — a dict of stdout/stderr, or a bare string — and a hook
    that assumes one of them raises on the other, which would silently disable
    this check on whichever host disagreed."""
    if isinstance(tool_response, str):
        text = tool_response
    elif isinstance(tool_response, dict):
        parts = [tool_response.get(k) for k in
                 ("stdout", "stderr", "output", "error", "content")]
        text = "\n".join(p for p in parts if isinstance(p, str) and p)
    else:
        return ""
    if len(text) > 200000:
        # Compilers put the failure at the top and test runners at the bottom,
        # so keep both ends rather than an arbitrary prefix.
        text = text[:100000] + "\n" + text[-100000:]
    return text


def output_mentions(text, path, rel):
    """Does this output actually name that file?

    The basename is allowed only when it is long enough and carries an
    extension. `x.ts` appears in the error message of every TypeScript file in
    the project, and `main` appears in half of all output; matching on those
    would produce an accusation from a coincidence."""
    if path and path in text:
        return True
    if rel and rel in text:
        return True
    base = os.path.basename(path or "")
    return len(base) >= 6 and "." in base and base in text


def interference_note(me, tool_response, sessions):
    """Text warning that a failure names another live session's in-flight files,
    or "" when nothing applies.

    This is the part of the plugin no amount of documentation can replace: the
    agent reading a build failure cannot tell that the broken file belongs to
    somebody else who is halfway through editing it, and its instinct is to fix
    it. Only the bus knows who touched what and when.

    Conservative on purpose. Two independent conditions must both hold — the
    command must look like it failed, and its output must name a file another
    live session in this repository wrote in the last few minutes. A false
    accusation is worse than silence: an agent that catches the bus being wrong
    about ownership is an agent that starts working around it."""
    text = response_text(tool_response)
    if not text or not FAILURE_SIGNAL.search(text):
        return ""
    cutoff = now() - INTERFERENCE_WINDOW

    # Anything this session also touched inside the window is dropped: the
    # failure may legitimately be its own, and telling an agent not to fix its
    # own broken edit is the one mistake that would make this feature harmful.
    ours = set()
    for _, path in recent_writes(me.get("sid"), cutoff):
        ours.add(os.path.realpath(path))
        rel = repo_relative(path, me.get("root"))
        if rel:
            ours.add(rel)

    found = {}
    for s in sessions:
        if s["sid"] == me.get("sid"):
            continue
        # A session in a different repository cannot have broken this build, so
        # naming it would be a coincidence dressed up as a cause.
        if s.get("repo_key") != me.get("repo_key"):
            continue
        seen = set()
        for ts, path in reversed(recent_writes(s["sid"], cutoff)):
            real = os.path.realpath(path)
            if real in seen:
                continue
            seen.add(real)
            rel = repo_relative(path, s.get("root"))
            if real in ours or (rel and rel in ours):
                continue
            if not output_mentions(text, path, rel):
                continue
            shown = rel or short_path(path)
            if shown not in found or ts > found[shown][1]:
                found[shown] = (s.get("agent"), ts)
    if not found:
        return ""

    ordered = sorted(((p, a, t) for p, (a, t) in found.items()),
                     key=lambda f: -f[2])[:MAX_INTERFERENCE_FILES]
    who = ordered[0][1]
    base = os.path.basename(ordered[0][0])
    lines = ["agent-bus: this failure names files another live session is "
             "editing right now:"]
    for shown, agent, ts in ordered:
        lines.append("  %s — %s, %s ago" % (shown, agent, held_for(ts)))
    lines += [
        "Do not fix them. That session is mid-edit and the error is probably "
        "transient;",
        "re-run the command in a moment. If it persists, ask rather than edit:",
        '  agentbus post --to %s "your edit to %s breaks my build — done soon?"'
        % (who, base),
        "Fix only files you own.",
    ]
    return "\n".join(lines)


def release_autoclaim(me, tool_use_id):
    """Give back what one command took automatically."""
    if not tool_use_id or not me:
        return
    rec = read_json(autoclaim_path(tool_use_id))
    forget_autoclaim(tool_use_id)
    # Exactly this party: one subagent must not hand back what another took.
    if not rec or rec.get("party", rec.get("sid")) != party_key(me):
        return
    for name in rec.get("resources", []):
        lock = load_lock(me.get("repo_key"), name)
        if lock and lock.get("sid") == me.get("sid") \
                and lock.get("mode") == "soft":
            do_release(me, name, quiet=True)


def hook_post_bash(payload):
    """Give a finished command's claim back as soon as it finishes.

    The interference check is deliberately NOT here. This event does not fire
    when a tool call errors, which is every case that check exists for — so it
    lives in PostToolBatch, where the output arrives whatever the outcome, and
    where the same batch's claims are released again for the commands that
    failed and never reached this hook at all."""
    sid, me = current_session(payload)
    if not me:
        return
    release_autoclaim(party_view(me, payload), payload.get("tool_use_id"))


def lock_name(me, res):
    """The name this resource is locked under.

    Most resources are one per machine. A `scope: "worktree"` resource is one per
    checkout — the working tree and the git index, which only sessions sharing a
    root can corrupt for each other. Since automatic claims now last exactly one
    command, this serialises `git commit` against a concurrent `git stash` in the
    same tree without ever making two sessions in different worktrees wait."""
    if res.get("scope") == "worktree":
        import hashlib
        digest = hashlib.sha1(
            os.path.realpath(me.get("root") or "").encode()).hexdigest()[:6]
        return "%s@%s" % (res["name"], digest)
    return res["name"]


def autoclaim_path(tool_use_id):
    return os.path.join(AUTOCLAIM, "%s.json"
                        % re.sub(r"[^A-Za-z0-9_.-]", "_", tool_use_id or "none"))


def forget_autoclaim(tool_use_id):
    try:
        os.unlink(autoclaim_path(tool_use_id))
    except OSError:
        pass


def serving_check(me, hits):
    """Is the service this command is about to talk to actually serving MY tree?

    Holding the lock does not make :8082 answer with your code. This is the check
    that turns "nobody else has it booked" into "the answer you get is yours",
    and it has to run even when the lock is free — the dangerous case is a
    session that ended while its detached server kept answering."""
    mine = os.path.realpath(me.get("root") or "")
    for res in hits:
        if res.get("_explicit"):
            continue   # `agentbus serve`/`run` are how a service gets moved
        if not res.get("start") and not res.get("port"):
            continue
        root, how = serving(me.get("repo_key"), res)
        if how == "down":
            continue
        if root and os.path.realpath(root) == mine:
            continue
        if how == "unknown":
            return "warn", (
                "agent-bus: something is listening on %s that agent-bus did not "
                "start, so which checkout it serves is unknown — the result you "
                "get may belong to another worktree. `agentbus serve %s` restarts "
                "it from yours." % (res.get("port") or res["name"], res["name"]))
        rec = read_json(serve_path(me.get("repo_key"), res["name"])) or {}
        note_block(me, "'%s'" % res["name"],
                   "it is serving %s" % short_path(root or "?"))
        lines = [
            'agent-bus: BLOCKED. "%s" (%s) is serving a different checkout, so '
            "this command would exercise that code and report it as yours."
            % (res["name"], res.get("desc", "shared service")),
            "",
            "  serving   : %s" % short_path(root or "?"),
            "  you are in: %s" % short_path(me.get("root", "")),
        ]
        if rec.get("by"):
            lines.append("  started by: %s, %s" % (rec["by"], ago(rec.get("started"))))
        if res.get("why"):
            lines += ["", "  " + res["why"]]
        lines += [
            "",
            "Point it at your worktree — this stops the current one and starts",
            "yours, and tells the other sessions it moved:",
            "  agentbus serve %s" % res["name"],
            "",
            "Or run one command against your own tree and leave it there:",
            "  agentbus run %s -- <your command>" % res["name"],
        ]
        return "deny", "\n".join(lines)
    return "", ""


def guard_bash(me, cmd, sessions, payload_tool_use_id=None):
    cfg = repo_config(me.get("repo_key", ""), me.get("root"))
    hits = resources_for(cmd, cfg)
    if not hits:
        return
    # A resource whose patterns stop matching — a port moved, a script was
    # renamed — fails silently and looks exactly like a resource nobody is
    # using. Recording the last match lets `doctor` say so.
    for res in hits:
        try:
            open(os.path.join(MATCHED, re.sub(r"[^A-Za-z0-9_.-]", "_", "%s__%s" % (
                me.get("repo_key"), res["name"]))), "w").close()
        except OSError:
            pass
    # Check every resource before taking any. A command that is going to be
    # denied must not leave half the rig claimed behind it.
    blocked = []
    for res in hits:
        lock = load_lock(me.get("repo_key"), lock_name(me, res))
        if lock and same_party(lock, me):
            continue
        holder, stealable, _ = lock_state(lock, sessions)
        if holder and not stealable:
            blocked.append((res, lock, holder))
    if not blocked:
        taken = []
        for res in hits:
            ok, lock, holder, _ = do_claim(me, lock_name(me, res), mode="soft",
                                           sessions=sessions)
            if ok:
                taken.append(lock_name(me, res))
                continue
            # The check above ran outside the mutex; do_claim re-tested inside it
            # and lost. Ignoring that answer is how two sessions both proceed.
            for name in taken:
                do_release(me, name, quiet=True)
            blocked = [(res, lock, holder)]
            break
        if not blocked:
            remember_autoclaim(me, payload_tool_use_id, taken)
            if taken:
                bump_guarded(me)
            verdict, text = serving_check(me, hits)
            if verdict == "deny":
                for name in taken:
                    do_release(me, name, quiet=True)
                forget_autoclaim(payload_tool_use_id)
                deny(text)
            elif verdict == "warn":
                note_ctx(text)
            return
    res, lock, holder = blocked[0]
    note_block(me, "'%s'" % res["name"],
               "held by %s" % (lock.get("agent") or holder.get("agent")))
    same_tree = (os.path.realpath(holder.get("root") or "")
                 == os.path.realpath(me.get("root") or ""))
    lines = [
        'agent-bus: BLOCKED. "%s" (%s) is in use by another live Claude Code '
        'session.' % (res["name"], res.get("desc", "shared resource")),
        "",
        # The lock's own name, not the session's: a lock taken by a subagent is
        # held by that subagent, and telling the reader to go and talk to the
        # session would point them at the wrong agent.
        "  holder    : %s   branch %s" % (lock.get("agent") or holder.get("agent"),
                                          holder.get("branch") or "-"),
        "  worktree  : %s%s" % (short_path(holder.get("root", "")),
                                "   (the same one you are in)" if same_tree else ""),
        "  held for  : %s   (%s lock)" % (held_for(lock.get("acquired_at")),
                                          lock.get("mode", "soft")),
        "  last seen : %s" % ago(holder.get("beat")),
    ]
    if lock.get("why"):
        lines.append('  doing     : "%s"' % lock["why"])
    elif holder.get("doing"):
        lines.append('  doing     : "%s"' % holder["doing"])
    if res.get("_implied_by"):
        lines += ["", "  Your command drives '%s', which is only meaningful against "
                      "the '%s' serving your worktree — so it needs that too."
                  % (res["_implied_by"], res["name"])]
    sibling = (lock.get("sid") == me.get("sid")
               and (lock.get("agent_id") or "") and (me.get("agent_id") or ""))
    if sibling:
        # Two subagents of one session. Nothing here is about checkouts — they
        # share one — so the same-checkout wording below would be answering a
        # question nobody asked, while the resource's own `why` is exactly the
        # point: one of the thing, two of you.
        lines += ["", "  You are two agents of the same session, running at the "
                      "same time. Wait for theirs to finish — an automatic claim "
                      "lasts only as long as one command — or split the work so "
                      "you are not both driving it."]
        if res.get("why"):
            lines += ["", "  " + res["why"]]
    elif same_tree:
        # The configured `why` explains cross-worktree damage. Two sessions in
        # ONE checkout are running the same code, so quoting it here would state
        # something the agent can see is false — and an agent that catches the
        # bus being wrong is an agent that starts working around it.
        lines += ["", "  You are both in this checkout, so the result would be "
                      "yours either way — but you would be running it twice at "
                      "once against one service. Wait for their command to end; "
                      "automatic claims last only as long as the command."]
    elif res.get("why"):
        lines += ["", "  " + res["why"]]
    if len(blocked) > 1:
        lines.append("  Also in use: %s" % ", ".join(b[0]["name"] for b in blocked[1:]))
    lines += [
        "",
        "Do not work around this by editing the command: a different port, a",
        "direct binary path or a subshell all reach the same service.",
        "",
        "  agentbus status                       what is going on",
        '  agentbus post --to %s "..."   ask them'
        % (lock.get("agent") or holder.get("agent")),
        '  agentbus wait %s --why "..."  queue; takes it the moment it frees'
        % res["name"],
    ]
    if res.get("hint"):
        lines += ["", "  " + res["hint"]]
    lines += [
        "",
        "(If this is wrong, the human can rerun it themselves with "
        "`AGENTBUS_OFF=1 <command>`.)",
        '(Last resort, only when you know they have finished: '
        '`agentbus claim %s --steal --why "..."`.)' % res["name"],
    ]
    deny("\n".join(lines))


def file_lock_name(path):
    return "file:%s" % path


def guard_file(me, path, sessions):
    if not path:
        return
    path = os.path.realpath(path)
    # An explicit claim is the way out of a file block, so it has to actually do
    # something: the previous message advertised a command that guard_file never
    # consulted, which left a blocked session with no exit but the clock.
    mine = load_lock(me.get("repo_key"), file_lock_name(path))
    if mine and mine.get("sid") == me.get("sid"):
        return
    if mine:
        holder = next((s for s in sessions if s["sid"] == mine.get("sid")), None)
        if holder:
            deny("agent-bus: BLOCKED. %s has explicitly claimed this file:\n\n"
                 "  file  : %s\n  since : %s\n  reason: %s\n\n"
                 "Ask before taking it:\n  agentbus post --to %s \"...\"\n"
                 "  agentbus claim 'file:%s' --steal --why \"they agreed\""
                 % (holder.get("agent"), short_path(path),
                    held_for(mine.get("acquired_at")), mine.get("why") or "-",
                    holder.get("agent"), path))
            return
    # Declared ownership comes before the reactive check: it is the whole point
    # of declaring one that the block does not wait for somebody to write the
    # file first. At most one of these speaks — two note_ctx calls would put two
    # JSON documents on stdout and corrupt the session's view of the hook.
    verdict, text = ownership_verdict(me, path, sessions)
    if verdict == "deny":
        note_block(me, short_path(path), "somebody has declared it theirs")
        deny(text)
        return
    if verdict == "note":
        note_ctx(text)
        return
    cutoff = now() - COLLIDE_WINDOW
    same_tree, same_repo = [], []
    for s in sessions:
        if s["sid"] == me.get("sid"):
            continue
        writes = recent_writes(s["sid"], cutoff)
        hit = next((w for w in reversed(writes) if os.path.realpath(w[1]) == path), None)
        if hit and s.get("root") == me.get("root"):
            same_tree.append((s, hit))
        elif s.get("repo_key") == me.get("repo_key"):
            rel = os.path.relpath(path, me.get("root") or "/")
            other = os.path.join(s.get("root") or "/", rel)
            hit2 = next((w for w in reversed(writes)
                         if os.path.realpath(w[1]) == os.path.realpath(other)), None)
            if hit2:
                same_repo.append((s, hit2))
    if same_tree:
        s, hit = same_tree[0]
        note_block(me, short_path(path), "%s is editing it" % s.get("agent"))
        deny("\n".join([
            "agent-bus: BLOCKED. Another live session is editing this exact file in "
            "this exact checkout — your write would be made on top of theirs, or "
            "theirs on top of yours.",
            "",
            "  file    : %s" % short_path(path),
            "  other   : %s  (branch %s, wrote it %s)" % (
                s.get("agent"), s.get("branch") or "-", ago(hit[0])),
            "  worktree: %s   (the same one you are in)" % short_path(s.get("root", "")),
            "",
            "Split the work or take turns:",
            '  agentbus post --to %s "I need this file for <reason>"' % s.get("agent"),
            "  agentbus status",
            "",
            "Once they have agreed, take it and the block lifts for you and",
            "applies to them instead:",
            "  agentbus claim 'file:%s' --why \"agreed with %s\"" % (path, s.get("agent")),
            "",
            "(Or the human can rerun the edit with AGENTBUS_OFF=1 in front of it.)",
        ]))
        return
    if same_repo:
        s, hit = same_repo[0]
        note_ctx("agent-bus: %s edited the same file on %s %s (different worktree, "
                 "so no conflict now — but expect it at merge time)."
                 % (s.get("agent"), s.get("branch") or "-", ago(hit[0])))


def hook_session_end(payload):
    sid = payload.get("session_id") or os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not sid:
        return
    rec = read_json(os.path.join(SESSIONS, "%s.json" % sid))
    if rec and len(load_sessions()) > 1:
        rec["sid"] = sid
        # Before forget_session, which deletes the writes log and the ownership
        # record the summary is assembled from.
        if did_something(rec):
            emit(sid, rec.get("agent"), rec.get("repo_key"), "handoff",
                 handoff_text(rec))
        emit(sid, rec.get("agent"), rec.get("repo_key"), "leave", "session ended")
    forget_session(sid)
    refresh_derived()


def hook_record_write(payload):
    """Fallback only: the shell fast path normally records writes itself."""
    if read_int(LIVEFILE, 0) < 2:
        return
    sid, me = current_session(payload)
    if not me:
        return
    ti = payload.get("tool_input") or {}
    path = ti.get("file_path") or ti.get("notebook_path")
    if not path:
        return
    try:
        with open(os.path.join(WRITES, "%s.log" % sid), "a") as fh:
            fh.write("%d %s\n" % (now(), path))
    except OSError:
        pass


# ------------------------------------------------------------------- cli ----

def need_me():
    sid, me = current_session()
    if not me:
        print("agent-bus: this shell is not attached to a registered session.\n"
              "Start a new Claude Code session, or run `agentbus register`.",
              file=sys.stderr)
        sys.exit(1)
    return me


def cli_status(_args):
    sessions = load_sessions(reap=True)
    refresh_derived(sessions)
    sid, me = current_session()
    if not me:
        # Run from a shell that is not a registered session: report on whatever
        # repository the caller is standing in.
        root, repo_key, label, _ = git_facts(os.getcwd())
        me = {"sid": "", "repo_key": repo_key, "root": root, "repo_label": label}
    print("agent-bus — %d live session%s" % (len(sessions), "" if len(sessions) == 1 else "s"))
    for s in sessions:
        mark = "*" if s["sid"] == me.get("sid") else " "
        print(" %s %-18s %-42s %-28s %s" % (
            mark, s.get("agent"), short_path(s.get("root", "")),
            s.get("branch") or "-", ago(s.get("beat"))))
        for a in load_agents(s["sid"]):
            print("   %-18s %-42s %-28s %s" % (
                "  · " + (a.get("name") or "?"), short_path(a.get("root", "")),
                a.get("branch") or "-", a.get("agent_type") or ""))
    print()
    lk = locks_text(me, sessions)
    print(lk if lk else "No shared resources declared for this repo "
                        "(`agentbus init-repo` to add some).")
    owned = ownership_text_block(me, sessions)
    if owned:
        print("\n" + owned)
    recent = read_events(after=max(0, read_int(SEQFILE, 0) - 15))
    if recent:
        print("\nRecent:")
        for r in recent[-8:]:
            print("  %-16s %-9s %s" % (r.get("agent"), ago(r.get("ts")), r.get("text")))


def cli_whois(_args):
    for s in load_sessions():
        print("%-18s %-42s %s" % (s.get("agent"), short_path(s.get("root", "")),
                                  s.get("branch") or "-"))
        for a in load_agents(s["sid"]):
            print("  · %-16s %-42s %s" % (
                a.get("name"), short_path(a.get("root", "")),
                a.get("agent_type") or ""))


def opt(args, name, default=None):
    if name in args:
        i = args.index(name)
        if i + 1 < len(args):
            return args[i + 1]
    return default


def flag(args, name):
    return name in args


def positional(args):
    out, skip = [], False
    for i, a in enumerate(args):
        if skip:
            skip = False
            continue
        if a.startswith("--"):
            if a in ("--why", "--to", "--timeout", "--as", "--note"):
                skip = True
            continue
        out.append(a)
    return out


def cli_claim(args):
    me = need_me()
    pos = positional(args)
    if not pos:
        print("usage: agentbus claim <resource> [--why \"...\"] [--steal]", file=sys.stderr)
        sys.exit(1)
    ok, lock, holder, reason = do_claim(me, pos[0], why=opt(args, "--why", ""),
                                        mode="hard", steal=flag(args, "--steal"))
    if ok:
        print("claimed '%s'" % pos[0])
        _, implied = expand_implied([pos[0]], me)
        if implied:
            # Not expanded silently: a claim is deliberate. But holding the
            # simulator while somebody else re-serves the bundler under you is
            # the trap this exists to prevent, so it is said out loud.
            print("note: '%s' implies %s, which you have NOT taken. "
                  "`agentbus claim %s` if the run needs them held too."
                  % (pos[0], ", ".join(implied),
                     ",".join([pos[0]] + implied)))
        return
    print("'%s' is held by %s (%s, %s). %s" % (
        pos[0], holder.get("agent"), lock.get("mode"),
        held_for(lock.get("acquired_at")), reason), file=sys.stderr)
    sys.exit(1)


def cli_release(args):
    me = need_me()
    if flag(args, "--all"):
        print("released %d" % release_all(me["sid"]))
        return
    pos = positional(args)
    if not pos:
        print("usage: agentbus release <resource> | --all", file=sys.stderr)
        sys.exit(1)
    print("released '%s'" % pos[0] if do_release(me, pos[0]) else "not yours")


def cli_wait(args):
    me = need_me()
    pos = positional(args)
    if not pos:
        print("usage: agentbus wait <resource> [--timeout 300] [--why \"...\"]",
              file=sys.stderr)
        sys.exit(1)
    res, why = pos[0], opt(args, "--why", "")
    # Below the Bash tool's own default timeout, so the wait reports back rather
    # than being killed with its queue entry left behind.
    timeout = int(opt(args, "--timeout", "90"))
    deadline = time.time() + timeout
    announced = False
    while True:
        ok, lock, holder, _ = do_claim(me, res, why=why, mode="hard")
        if ok:
            print("claimed '%s'" % res)
            return
        if not announced:
            enqueue(me, res)
            emit(me["sid"], me["agent"], me["repo_key"], "note",
                 "waiting for '%s'%s" % (res, (' — ' + why) if why else ""),
                 to=holder.get("agent"))
            announced = True
            print("'%s' is held by %s; queued." % (res, holder.get("agent")),
                  file=sys.stderr)
        if time.time() > deadline:
            print("timed out waiting for '%s'" % res, file=sys.stderr)
            sys.exit(1)
        time.sleep(3)


def enqueue(me, res):
    with Mutex("lock-" + re.sub(r"[^A-Za-z0-9]", "_", res)[:40]):
        lock = load_lock(me["repo_key"], res)
        if not lock:
            return
        q = [x for x in lock.get("queue", []) if x.get("sid") != me["sid"]]
        q.append({"sid": me["sid"], "agent": me["agent"], "at": now()})
        lock["queue"] = q
        write_json(lock_path(me["repo_key"], res), lock)


def speak_as(me, name):
    """The name this caller may sign a message with: its own, or one of its own
    subagents'. Not anybody else's — a name on this bus is worth something only
    because it says who actually spoke."""
    if not name or name == me.get("agent"):
        return me.get("agent")
    for a in load_agents(me.get("sid")):
        if a.get("name") == name:
            return name
    return None


def cli_post(args):
    me = need_me()
    pos = positional(args)
    text = " ".join(pos).strip()
    if not text:
        print('usage: agentbus post [--to <agent>] [--as <you>] "message"',
              file=sys.stderr)
        sys.exit(1)
    sender = speak_as(me, opt(args, "--as"))
    if not sender:
        print("agent-bus: '%s' is not you or one of your subagents. "
              "`agentbus whois` lists who is who." % opt(args, "--as"),
              file=sys.stderr)
        sys.exit(1)
    to = opt(args, "--to")
    emit(me["sid"], sender, me["repo_key"], "note", text, to=to)
    print("posted%s" % (" to %s" % to if to else " to everyone on this repo"))


def watch_line(r, width=None):
    """One event, formatted for a human reading over the agents' shoulders."""
    when = time.strftime("%H:%M:%S", time.localtime(r.get("ts", 0)))
    who = r.get("agent", "?")
    kind = r.get("kind", "?")
    repo = (r.get("repo") or "").split(":")[0]
    to = " → %s" % r["to"] if r.get("to") else ""
    head = "%s  %-20s %-8s %-14s" % (when, (who + to)[:20], kind, repo[:14])
    text = (r.get("text") or "").rstrip()
    if "\n" not in text:
        return head + text
    pad = " " * 10
    return head + text.split("\n")[0] + "\n" + "\n".join(
        pad + ln for ln in text.split("\n")[1:])


def cli_watch(args):
    """Follow what every agent on this machine is doing, as it happens.

    `status` is a snapshot and `inbox` is what was addressed to you. Neither
    answers "what is going on right now", which is the question somebody with
    four terminals open actually has — and until refusals were recorded as
    events, nothing answered "did it stop anything today" either.

    Polling, not inotify: two file reads a second, no dependency, same on both
    platforms."""
    only_repo = flag(args, "--repo")
    tail = int(opt(args, "-n", "15"))
    me = None
    if only_repo:
        _, me = current_session()
        if not me:
            root, repo_key, label, _ = git_facts(os.getcwd())
            me = {"repo_key": repo_key}
    seq = read_int(SEQFILE, 0)
    start = max(0, seq - tail)
    print("agent-bus — following%s. Ctrl-C to stop.\n"
          % (" this repository" if only_repo else " every repository"))
    shown = start
    try:
        while True:
            for r in read_events(after=shown):
                shown = max(shown, r.get("i", 0))
                if only_repo and r.get("repo") != me.get("repo_key"):
                    continue
                print(watch_line(r))
                sys.stdout.flush()
            time.sleep(0.8)
    except KeyboardInterrupt:
        print()


def cli_inbox(_args):
    me = need_me()
    seen = 0
    for r in read_events(after=0):
        if not interesting_to(r, me):
            continue
        seen += 1
        print("%-16s %-9s %s%s" % (r.get("agent"), ago(r.get("ts")),
                                   "→you " if r.get("to") else "", r.get("text")))
    if not seen:
        print("(nothing yet)")


def find_resource(me, name):
    cfg = repo_config(me.get("repo_key"), me.get("root"))
    return next((r for r in cfg.get("resources", []) if r["name"] == name), None)


def cli_serve(args):
    """Point a declared service at this worktree, restarting it if it is serving
    another one. This is the half `sim-lock.sh` had and a lock alone cannot do."""
    me = need_me()
    pos = positional(args)
    if not pos:
        print("usage: agentbus serve <resource>", file=sys.stderr)
        sys.exit(1)
    res = find_resource(me, pos[0])
    if not res:
        print("no resource named '%s' in this repo's config" % pos[0], file=sys.stderr)
        sys.exit(1)
    if not res.get("start"):
        print("'%s' declares no `start` command, so agent-bus cannot move it. "
              "Add one to .claude/agent-bus.json." % pos[0], file=sys.stderr)
        sys.exit(1)
    ok, lock, holder, _ = do_claim(me, res["name"], why="handover", mode="hard")
    if not ok:
        print("'%s' is held by %s (%s) — ask before moving it out from under them:"
              "\n  agentbus post --to %s \"I need %s pointed at my worktree\""
              % (res["name"], holder.get("agent"),
                 held_for(lock.get("acquired_at")), holder.get("agent"),
                 res["name"]), file=sys.stderr)
        sys.exit(1)
    good, detail = ensure_serving(me, res)
    do_release(me, res["name"], quiet=True)
    if not good:
        print("agent-bus: %s" % detail, file=sys.stderr)
        sys.exit(1)
    print("'%s' %s" % (res["name"], detail))


def cli_serves(_args):
    me = need_me()
    cfg = repo_config(me.get("repo_key"), me.get("root"))
    for res in cfg.get("resources", []):
        if not res.get("port") and not res.get("start"):
            continue
        root, how = serving(me.get("repo_key"), res)
        mark = "you" if root and os.path.realpath(root) == os.path.realpath(
            me.get("root") or "") else ""
        print("%-12s %-9s %-46s %s" % (res["name"], how, short_path(root or "-"), mark))


def expand_implied(names, me):
    """The named resources, plus whatever they imply.

    `agentbus run simulator` took the simulator and nothing else, while a bare
    `maestro test` took the simulator *and* the two bundlers and the API —
    because the guard expands `implies` and the CLI never did. The careful
    command was the weaker one: another session could re-serve a bundler
    mid-run and the run would silently switch to its bundle, which is precisely
    what this plugin exists to prevent.

    Reported from real use on 2026-07-28 by an agent that lost six minutes to it
    twice and then negotiated a manual protocol with the other session instead.
    Its exact words: "'agentbus run simulator' bile metro-app'i tutmuyor"."""
    cfg = repo_config(me.get("repo_key"), me.get("root"))
    by_name = {r["name"]: r for r in cfg.get("resources", [])}
    out, added = list(names), []
    for name in list(names):
        for dep in (by_name.get(name) or {}).get("implies", []):
            if dep in by_name and dep not in out:
                out.append(dep)
                added.append(dep)
    return out, added


def cli_run(args):
    import subprocess
    me = need_me()
    if "--" not in args:
        print("usage: agentbus run <res>[,<res>] [--why \"...\"] -- <command>",
              file=sys.stderr)
        sys.exit(1)
    cut = args.index("--")
    head, cmd = args[:cut], args[cut + 1:]
    pos = positional(head)
    if not pos or not cmd:
        print("usage: agentbus run <res>[,<res>] [--why \"...\"] -- <command>",
              file=sys.stderr)
        sys.exit(1)
    names, implied = expand_implied([x for x in pos[0].split(",") if x], me)
    if implied:
        print("agent-bus: also taking %s — %s implies %s."
              % (", ".join(implied), pos[0], ", ".join(implied)), file=sys.stderr)
    why = opt(head, "--why", " ".join(cmd)[:120])
    taken = []
    try:
        for res in names:
            ok, lock, holder, reason = do_claim(me, res, why=why, mode="hard")
            if not ok:
                print("agent-bus: '%s' is held by %s (%s). Not running."
                      % (res, holder.get("agent"), held_for(lock.get("acquired_at"))),
                      file=sys.stderr)
                sys.exit(75)
            taken.append(res)
        # Holding the lock is not enough: make the services actually answer with
        # this worktree's code before the command runs.
        for res in names:
            declared = find_resource(me, res)
            if declared and declared.get("start"):
                good, detail = ensure_serving(me, declared)
                if not good:
                    print("agent-bus: %s" % detail, file=sys.stderr)
                    sys.exit(75)
                if "restarted" in (detail or ""):
                    print("agent-bus: '%s' %s" % (res, detail), file=sys.stderr)
        # cmd is already word-split by the calling shell, so run it directly:
        # joining it back into a shell string would destroy the quoting in
        # forms like `-- bash -c 'cd x && maestro test'`.
        rc = subprocess.call(cmd)
        sys.exit(rc)
    finally:
        for res in taken:
            do_release(me, res)


def cli_name(args):
    me = need_me()
    pos = positional(args)
    if not pos:
        print(me.get("agent"))
        return
    old = me.get("agent")
    me["agent"] = re.sub(r"[^A-Za-z0-9_.#-]", "-", pos[0])[:24]
    write_json(os.path.join(SESSIONS, "%s.json" % me["sid"]), me)
    emit(me["sid"], me["agent"], me["repo_key"], "note",
         "renamed from %s to %s" % (old, me["agent"]))
    print(me["agent"])


def cli_doing(args):
    me = need_me()
    me["doing"] = " ".join(positional(args))[:160]
    write_json(os.path.join(SESSIONS, "%s.json" % me["sid"]), me)
    print("noted")


def cli_handoff(args):
    """Hand over deliberately, rather than waiting for the session to end.

    Worth running before a long compaction or when you are about to be
    interrupted: the automatic one at SessionEnd only fires if the session ends
    the way it is supposed to."""
    me = need_me()
    note = opt(args, "--note", "") or " ".join(positional(args))
    text = handoff_text(me, note)
    print(text)
    others = [s for s in load_sessions()
              if s["sid"] != me["sid"] and s.get("repo_key") == me.get("repo_key")]
    if not others:
        print("\n(nobody else is live in this repo, so this went nowhere)")
        return
    emit(me["sid"], me["agent"], me["repo_key"], "handoff", text)
    print("\nsent to %d session%s" % (len(others), "" if len(others) == 1 else "s"))


def cli_own(args):
    """Declare a part of the tree yours. The one thing here that is not a lock:
    it is not about a command that is running now, it is about where the other
    agents should not be working for the next while."""
    me = need_me()
    sessions = load_sessions()
    if flag(args, "--list"):
        shown = 0
        for s in sessions:
            summary = owns_summary(s["sid"], limit=20)
            if not summary or s.get("repo_key") != me.get("repo_key"):
                continue
            shown += 1
            print("%-18s %s%s" % (s.get("agent"), summary,
                                  "   (you)" if s["sid"] == me["sid"] else ""))
        if not shown:
            print("nobody in this repo has declared anything")
        return
    pos = positional(args)
    if not pos:
        print('usage: agentbus own "<glob>" [...] [--why "..."] [--strict]\n'
              "       agentbus own --list\n\n"
              "Quote the glob, or the shell expands it before agentbus sees it.",
              file=sys.stderr)
        sys.exit(1)
    why = opt(args, "--why", "")
    strict = flag(args, "--strict")
    decs = load_owns(me["sid"])
    added = []
    for raw in pos:
        glob = normalise_glob(raw, me.get("root"))
        if not glob:
            continue
        decs = [d for d in decs if d.get("glob") != glob]
        decs.append({"glob": glob, "why": why, "at": now(), "strict": strict})
        added.append(glob)
    if not added:
        print("nothing to own", file=sys.stderr)
        sys.exit(1)
    if not save_owns(me["sid"], decs):
        print("could not record that", file=sys.stderr)
        sys.exit(1)
    refresh_derived(sessions)   # the fast path filters on this; make it live now
    print("you now own:")
    for d in decs:
        print("  %-28s %s%s" % (d.get("glob"), d.get("why") or "",
                                "  [strict]" if d.get("strict") else ""))
    others = [s for s in sessions
              if s["sid"] != me["sid"] and s.get("repo_key") == me.get("repo_key")]
    if others:
        print("\nSessions in this checkout are now blocked from editing these; "
              "in another\nworktree they are warned instead%s."
              % (" — except --strict, which blocks there too" if strict else ""))
        emit(me["sid"], me["agent"], me["repo_key"], "note",
             "owns %s%s%s" % (", ".join(added), " [strict]" if strict else "",
                              (' — ' + why) if why else ""))
    else:
        print("\nNobody else is live in this repo, so nothing is blocked yet.")


def cli_disown(args):
    me = need_me()
    decs = load_owns(me["sid"])
    if not decs:
        print("you own nothing")
        return
    if flag(args, "--all"):
        dropped = [d.get("glob") for d in decs]
        keep = []
    else:
        pos = positional(args)
        if not pos:
            print('usage: agentbus disown "<glob>" | --all', file=sys.stderr)
            sys.exit(1)
        wanted = {normalise_glob(p, me.get("root")) for p in pos}
        dropped = [d.get("glob") for d in decs if d.get("glob") in wanted]
        keep = [d for d in decs if d.get("glob") not in wanted]
    if not dropped:
        print("not yours: %s" % ", ".join(positional(args)), file=sys.stderr)
        sys.exit(1)
    save_owns(me["sid"], keep)
    refresh_derived()
    print("released %s" % ", ".join(dropped))
    emit(me["sid"], me["agent"], me["repo_key"], "note",
         "no longer owns %s" % ", ".join(dropped))


CONFIG_README = (
    "Delete what you do not have and fix the ports and commands. "
    "patterns: regexes matched against each command's argv. "
    "port/cwd/start/ready: let agent-bus own the service, so it can "
    "say which checkout it is serving and move it to yours. "
    "implies: resources a command needs indirectly. "
    "scope 'worktree': contended only within one checkout. "
    "why/hint: shown verbatim when a command is blocked — this is "
    "where the knowledge that stops a workaround goes."
)

WORKTREE_RESOURCE = {
    "name": "worktree",
    "desc": "this checkout's working tree and git index",
    "why": "",
    "scope": "worktree",
    "patterns": [r"\bgit\s+(checkout|switch|stash|reset|rebase|add|commit)\b",
                 r"\b(npm|pnpm|yarn|bun)\s+(install|ci)\b"],
    "_from": "",   # not detected from anything: every repository has one
}

# The port a framework listens on when nobody told it otherwise. Only defaults
# that are actually defaults — a wrong guess here writes a config that silently
# guards nothing, which is worse than a resource the reader has to fill in.
FRAMEWORK_PORTS = (
    ("next", 3000), ("nuxt", 3000), ("nest", 3000), ("remix", 3000),
    ("react-scripts", 3000), ("vite", 5173), ("astro", 4321), ("expo", 8081),
)

DB_IMAGES = (("postgres", "psql"), ("postgis", "psql"), ("mysql", "mysql"),
             ("mariadb", "mysql"), ("redis", "redis-cli"), ("mongo", "mongosh"))


def lit(word):
    """A regex matching this literal word.

    Not `re.escape`: that escapes the hyphen in `redis-cli` and
    `react-scripts`, which is correct, unnecessary outside a character class,
    and unreadable in a file somebody is being asked to read and edit."""
    return re.sub(r"([.^$*+?()\[\]{}|\\])", r"\\\1", word or "")


# ------------------------------------------------------------- detection ----
#
# A stranger installs the plugin, opens two sessions, and nothing happens,
# because their repository has no config and the old `init-repo` wrote a generic
# template they had to fill in by hand. Most people conclude it is broken and
# stop. So the first run reads the repository instead of guessing, and what it
# writes has this project's real ports and real start commands in it.
#
# Everything here is best-effort and silent about what it cannot find. A draft
# with three of the four resources is useful; an exception during `init-repo` is
# not. The reader is told where every line came from so they can check it.

def read_text(path, limit=200000):
    try:
        with open(path, "r") as fh:
            return fh.read(limit)
    except (OSError, UnicodeDecodeError):
        return ""


def port_in(text):
    """The port a command line pins, or None."""
    for pat in (r"--port[=\s]+(\d{2,5})\b", r"\bPORT\s*=\s*(\d{2,5})\b",
                r"-p\s+(\d{2,5})\b", r"\blocalhost:(\d{2,5})\b",
                r"--inspect-port[=\s]+(\d{2,5})\b"):
        m = re.search(pat, text or "")
        if m:
            return int(m.group(1))
    return None


def package_manager(root):
    for lock, form in (("bun.lock", "bun run"), ("bun.lockb", "bun run"),
                       ("pnpm-lock.yaml", "pnpm run"), ("yarn.lock", "yarn"),
                       ("package-lock.json", "npm run")):
        if os.path.exists(os.path.join(root, lock)):
            return form
    return "npm run"


def unique_name(base, taken):
    if base not in taken:
        return base
    for n in range(2, 20):
        cand = "%s%d" % (base, n)
        if cand not in taken:
            return cand
    return base


def detect_node(root, taken):
    pkg = read_text(os.path.join(root, "package.json"))
    if not pkg:
        return []
    try:
        scripts = (json.loads(pkg) or {}).get("scripts") or {}
    except ValueError:
        return []
    runner = package_manager(root)
    out = []
    for key in ("dev", "start", "serve"):
        script = scripts.get(key)
        if not isinstance(script, str) or not script.strip():
            continue
        port = port_in(script)
        framework, framework_pattern = "", ""
        for name, default in FRAMEWORK_PORTS:
            m = re.search(r"\b%s\b(\s+([A-Za-z][\w-]*))?" % lit(name), script)
            if not m:
                continue
            framework = name
            port = port or default
            # `\bnext\b` on its own would claim the server for `git commit -m
            # next-release`. Pin the subcommand the script actually runs when
            # there is one, the way a hand-written config would.
            framework_pattern = (r"\b%s\s+%s\b" % (lit(name), lit(m.group(2)))
                                 if m.group(2) else r"\b%s\b" % lit(name))
            break
        name = unique_name("server", taken)
        taken.add(name)
        patterns = []
        if framework_pattern:
            patterns.append(framework_pattern)
        patterns.append(r"\b(npm|pnpm|yarn|bun)\s+(run\s+)?%s\b" % lit(key))
        if port:
            patterns.append(r":%d\b" % port)
        res = {"name": name, "desc": "the dev server%s" % (" on :%d" % port if port else ""),
               "why": "", "hint": "",
               "start": "%s %s" % (runner, key), "patterns": patterns,
               "_from": "package.json scripts.%s" % key}
        if port:
            res["port"] = port
        out.append(res)
        break   # one server per package.json; dev wins over start wins over serve
    return out


def detect_make(root, taken):
    body = read_text(os.path.join(root, "Makefile"))
    if not body:
        return []
    out = []
    lines = body.split("\n")
    for i, line in enumerate(lines):
        m = re.match(r"^([A-Za-z0-9_.-]+)\s*:(?!=)", line)
        if not m:
            continue
        target = m.group(1)
        if target not in ("dev", "dev-api", "dev-web", "serve", "start", "run"):
            continue
        recipe = []
        for nxt in lines[i + 1:]:
            if nxt.startswith("\t") or nxt.startswith("    "):
                recipe.append(nxt)
            elif nxt.strip():
                break
        port = port_in("\n".join(recipe))
        base = "server" if target in ("dev", "serve", "start", "run") else target
        name = unique_name(base, taken)
        taken.add(name)
        patterns = [r"\bmake\s+%s\b" % lit(target)]
        if port:
            patterns.append(r":%d\b" % port)
        res = {"name": name,
               "desc": "what `make %s` starts%s" % (target, " on :%d" % port if port else ""),
               "why": "", "hint": "", "start": "make %s" % target,
               "patterns": patterns, "_from": "Makefile target `%s`" % target}
        if port:
            res["port"] = port
        out.append(res)
    return out


def detect_procfile(root, taken):
    body = read_text(os.path.join(root, "Procfile"))
    if not body:
        return []
    out = []
    for line in body.split("\n"):
        m = re.match(r"^([A-Za-z0-9_-]+)\s*:\s*(\S.*)$", line.strip())
        if not m:
            continue
        proc, command = m.group(1), m.group(2)
        port = port_in(command)
        name = unique_name(proc, taken)
        taken.add(name)
        head = os.path.basename((command.split() or [""])[0])
        patterns = [r"\b%s\b" % lit(head)] if head else []
        if port:
            patterns.append(r":%d\b" % port)
        res = {"name": name, "desc": "the `%s` process" % proc, "why": "", "hint": "",
               "start": command, "patterns": patterns or [r"\b%s\b" % lit(proc)],
               "_from": "Procfile"}
        if port:
            res["port"] = port
        out.append(res)
    return out


def detect_python(root, taken):
    out = []
    manage = os.path.join(root, "manage.py")
    if os.path.exists(manage):
        has_settings = any(
            os.path.exists(os.path.join(root, d, "settings.py"))
            for d in ([""] + [e for e in os.listdir(root)
                              if os.path.isdir(os.path.join(root, e))][:60]))
        if has_settings:
            name = unique_name("server", taken)
            taken.add(name)
            out.append({"name": name, "desc": "the Django dev server on :8000",
                        "why": "", "hint": "", "port": 8000,
                        "start": "python manage.py runserver",
                        "patterns": [r"\bmanage\.py\s+runserver\b", r":8000\b"],
                        "_from": "manage.py next to a settings.py"})
    deps = (read_text(os.path.join(root, "pyproject.toml"))
            + read_text(os.path.join(root, "requirements.txt")))
    if re.search(r"\b(uvicorn|fastapi)\b", deps, re.I):
        name = unique_name("api", taken)
        taken.add(name)
        out.append({"name": name, "desc": "the ASGI app on :8000", "why": "", "hint": "",
                    "port": 8000, "patterns": [r"\buvicorn\b", r":8000\b"],
                    "_from": "uvicorn/fastapi in %s" % (
                        "pyproject.toml" if os.path.exists(
                            os.path.join(root, "pyproject.toml")) else "requirements.txt")})
    return out


def detect_db(root, taken):
    """A `db` resource, and deliberately without a `start`.

    agent-bus must never restart somebody's database: the point of the guard is
    that a reseed or a destructive migration invalidates the rows the other
    sessions are holding, and taking the service down to prove it would be the
    same damage by another route."""
    for name in ("docker-compose.yml", "docker-compose.yaml", "compose.yml",
                 "compose.yaml"):
        body = read_text(os.path.join(root, name))
        if not body:
            continue
        images = re.findall(r"^\s*image:\s*[\"']?([^\s\"']+)", body, re.M)
        found, clients = [], []
        for image in images:
            for key, client in DB_IMAGES:
                if key in image.lower():
                    found.append(image)
                    if client not in clients:
                        clients.append(client)
                    break
        if not found:
            continue
        res_name = unique_name("db", taken)
        taken.add(res_name)
        patterns = [r"\b%s\b" % lit(c) for c in clients]
        patterns += [r"\balembic\b", r"\bprisma\s+migrate\b", r"\bmake\s+seed\b"]
        return [{"name": res_name, "desc": "the shared development database",
                 "why": "", "hint": "", "patterns": patterns,
                 "_from": "%s (%s)" % (name, ", ".join(found[:3]))}]
    return []


def detect_e2e(root, taken, servers):
    import glob as globmod
    found = []
    for pattern, tool in (("playwright.config.*", "playwright"),
                          ("cypress.config.*", "cypress"),
                          ("wdio.conf.*", "wdio")):
        if globmod.glob(os.path.join(root, pattern)):
            found.append(tool)
    if os.path.isdir(os.path.join(root, "maestro")):
        found.append("maestro")
    if not found:
        return []
    name = unique_name("e2e", taken)
    taken.add(name)
    res = {"name": name, "desc": "the end-to-end runner and whatever it drives",
           "why": "", "hint": "",
           "patterns": [r"\b%s\b" % lit(t) for t in found],
           "_from": ", ".join("%s config" % t for t in found)}
    if servers:
        res["implies"] = list(servers)
    return [res]


def detect_resources(root):
    """Draft resource entries read from the repository's own files."""
    taken = set()
    out = []
    for finder in (detect_node, detect_make, detect_procfile, detect_python):
        try:
            out.extend(finder(root, taken))
        except Exception:
            pass   # a malformed file is not a reason for init-repo to fail
    try:
        out.extend(detect_db(root, taken))
    except Exception:
        pass
    servers = [r["name"] for r in out if r.get("port") or r.get("start")]
    try:
        out.extend(detect_e2e(root, taken, servers))
    except Exception:
        pass
    worktree = dict(WORKTREE_RESOURCE)
    worktree["name"] = unique_name("worktree", taken)
    out.append(worktree)
    return out


def detection_summary(resources):
    lines = ["agent-bus: looked at this repository and found", ""]
    for res in resources:
        port = ":%d" % res["port"] if res.get("port") else ""
        if res.get("start"):
            what = res["start"]
        elif res.get("implies"):
            what = "implies %s" % ", ".join(res["implies"])
        elif res["name"].startswith("worktree"):
            what = "this checkout's tree and index"
        else:
            what = "(no start command)"
        origin = res.get("_from", "")
        lines.append(("  %-10s %-7s %-30s %s" % (
            res["name"], port, what, "from " + origin if origin else "")).rstrip())
    return "\n".join(lines)


def cli_init_repo(args):
    ensure_dirs()
    root, repo_key, label, _ = git_facts(os.getcwd())
    local = flag(args, "--local")
    dry = flag(args, "--dry-run")
    if local:
        path = os.path.join(REPOS, "%s.json" % repo_key)
    else:
        path = os.path.join(root, ".claude", "agent-bus.json")
    if os.path.exists(path) and not flag(args, "--force") and not dry:
        print("already configured: %s\nPass --force to overwrite it." % path)
        return

    resources = detect_resources(root)
    print(detection_summary(resources))
    print()

    cfg = {"_readme": CONFIG_README, "label": label,
           "resources": [{k: v for k, v in r.items() if not k.startswith("_")}
                         for r in resources]}
    if local:
        cfg["repo_key"] = repo_key
    if dry:
        print("--dry-run: nothing was written. This is what it would be:\n")
        print(json.dumps(cfg, indent=2))
        return
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
    except OSError:
        pass
    if not write_json_pretty(path, cfg):
        print("could not write %s" % path, file=sys.stderr)
        sys.exit(1)
    refresh_derived()
    print("Wrote %s. Read it, fix anything wrong, then commit it so every\n"
          "worktree and machine gets the same guards. `why` and `hint` are "
          "empty — filling\nthem in is what stops an agent working around a "
          "block." % path)
    if local:
        print("\nThis one is machine-local and overrides the committed config by name.")


def cli_register(_args):
    """Attach the current shell's session to the bus without waiting for a restart."""
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not sid:
        print("no CLAUDE_CODE_SESSION_ID in the environment", file=sys.stderr)
        sys.exit(1)
    hook_session_start({"session_id": sid, "cwd": os.getcwd(), "session_title": "x"})
    print("registered %s" % sid)


def plugin_root():
    return os.path.dirname(os.path.dirname(os.path.realpath(__file__)))


def cli_install(args):
    """Wire this machine up. Both installer scripts are thin wrappers around this,
    so Windows and POSIX get the same decisions made by the same code."""
    import shutil
    import stat
    root = plugin_root()
    want = os.path.join(HOME, ".claude", "skills", "agent-bus")
    print("agent-bus installer\n")
    here = os.path.realpath(root)
    if here == os.path.realpath(want):
        print("  + location: %s" % root)
    elif os.path.join(".claude", "plugins") in here:
        # Installed from a marketplace. Claude Code loads it from exactly here,
        # so telling the reader to move it would break the thing they just
        # installed — which is what this said until the flow was actually run.
        print("  + location: %s" % root)
        print("    installed from a marketplace; Claude Code loads it from here")
    else:
        print("  ! this clone is at %s" % root)
        print("  ! Claude Code loads it only from %s, or from a marketplace "
              "install — move or re-clone it there" % want)
    print("  + python: %s (%s)" % (sys.executable, sys.version.split()[0]))

    # Entry point. The shell fast path exits in ~5 ms using builtins only and
    # wakes this engine just for real work; it needs bash and a `python3` on
    # PATH because it execs the engine through its shebang. Everywhere else,
    # call Python directly: one interpreter start per hook, but no dependency on
    # a shell, a path separator, or quoting rules.
    use_bash = (not IS_WIN and shutil.which("bash") and shutil.which("python3")
                and not flag(args, "--python-hooks"))
    src = "hooks.posix.json" if use_bash else "hooks.python.json"
    try:
        with open(os.path.join(root, "hooks", src)) as fh:
            text = fh.read()
        if not use_bash:
            text = text.replace("__PYTHON__", json.dumps(sys.executable)[1:-1])
        with open(os.path.join(root, "hooks", "hooks.json"), "w") as fh:
            fh.write(text)
    except OSError as exc:
        print("  ! could not write hooks/hooks.json: %s" % exc)
        return
    print("  + hooks: %s" % ("shell fast path (~5 ms per hook)" if use_bash
                             else "python fallback (no shell needed)"))

    for name in ("bin/agentbus", "bin/ab-hook", "install.sh"):
        p = os.path.join(root, name)
        try:
            os.chmod(p, os.stat(p).st_mode | stat.S_IXUSR | stat.S_IXGRP)
        except OSError:
            pass

    bindir = os.path.join(HOME, ".local", "bin")
    try:
        os.makedirs(bindir, exist_ok=True)
        engine = os.path.join(root, "bin", "agentbus")
        if IS_WIN:
            with open(os.path.join(bindir, "agentbus.cmd"), "w") as fh:
                fh.write('@echo off\r\n"%s" "%s" %%*\r\n' % (sys.executable, engine))
            with open(os.path.join(bindir, "agentbus"), "w") as fh:  # Git Bash
                fh.write('#!/bin/sh\nexec "%s" "%s" "$@"\n'
                         % (sys.executable.replace("\\", "/"), engine.replace("\\", "/")))
        else:
            link = os.path.join(bindir, "agentbus")
            if os.path.islink(link) or os.path.exists(link):
                os.unlink(link)
            os.symlink(engine, link)
        on_path = any(os.path.normcase(os.path.normpath(p)) ==
                      os.path.normcase(os.path.normpath(bindir))
                      for p in os.environ.get("PATH", "").split(os.pathsep))
        print("  %s command: %s%s" % ("+" if on_path else "!", bindir,
                                      "" if on_path else "  (NOT on PATH — add it)"))
    except OSError as exc:
        print("  ! could not create the agentbus command: %s" % exc)

    settings = os.path.join(HOME, ".claude", "settings.json")
    try:
        cfg = read_json(settings)
        if cfg is None and os.path.exists(settings):
            print('  ! ~/.claude/settings.json is not valid JSON — add '
                  '"Bash(agentbus:*)" to permissions.allow yourself')
        else:
            cfg = cfg or {}
            perms = cfg.get("permissions")
            if not isinstance(perms, dict):
                perms = {}
                cfg["permissions"] = perms
            allow = perms.get("allow")
            if not isinstance(allow, list):
                allow = []
                perms["allow"] = allow
            if "Bash(agentbus:*)" in allow:
                print("  + permission: already allowlisted")
            else:
                allow.append("Bash(agentbus:*)")
                os.makedirs(os.path.dirname(settings), exist_ok=True)
                # Atomic: this is the user's global settings file, and a crash
                # between truncate and flush would leave it empty.
                if write_json_pretty(settings, cfg):
                    print("  + permission: Bash(agentbus:*) allowlisted")
                else:
                    print('  ! could not write settings.json — add '
                          '"Bash(agentbus:*)" to permissions.allow yourself')
    except Exception as exc:
        print("  ! could not update settings.json (%s) — add "
              '"Bash(agentbus:*)" to permissions.allow yourself' % exc)

    print()
    cli_doctor([])
    print("\nRestart Claude Code (or /reload-plugins, then `agentbus register`).")
    print("In a repo with shared services: agentbus init-repo")


def cli_forget(args):
    """Drop session records by hand — the broom for anything the automatic
    reaping cannot reach."""
    pos = positional(args)
    gone = []
    for s in load_sessions():
        if flag(args, "--stale"):
            if now() - s.get("beat", 0) > IDLE_SECS * 3:
                gone.append(s)
        elif pos and (s.get("agent") == pos[0] or s["sid"] == pos[0]):
            gone.append(s)
    if not pos and not flag(args, "--stale"):
        print("usage: agentbus forget <agent|session-id> | --stale", file=sys.stderr)
        sys.exit(1)
    for s in gone:
        forget_session(s["sid"])
    refresh_derived()
    print("forgot %d: %s" % (len(gone), ", ".join(s.get("agent", "?") for s in gone)))


def cli_doctor(_args):
    ensure_dirs()
    sessions = load_sessions(reap=True)
    refresh_derived(sessions)
    print("bus dir      : %s" % BUS)
    print("live sessions: %d" % len(sessions))
    print("events       : %d" % read_int(SEQFILE, 0))
    print("guard tokens : %s" % (open(TOKENFILE).read().strip()[:200]
                                 if os.path.exists(TOKENFILE) else "-"))
    sid, me = current_session()
    print("this session : %s" % (me.get("agent") if me else "NOT REGISTERED"))
    root, repo_key, label, _ = git_facts(os.getcwd())
    shared = os.path.join(root, ".claude", "agent-bus.json")
    local = os.path.join(REPOS, "%s.json" % repo_key)
    cfg = repo_config(repo_key, root)
    print("repo         : %s (%s)" % (label, repo_key))
    print("  in repo    : %s" % (shared if os.path.exists(shared) else "-"))
    print("  local      : %s" % (local if os.path.exists(local) else "-"))
    resources = cfg.get("resources", [])
    if not resources:
        print("  resources  : none — `agentbus init-repo` to declare some")
    for res in resources:
        stamp = os.path.join(MATCHED, re.sub(r"[^A-Za-z0-9_.-]", "_",
                                             "%s__%s" % (repo_key, res["name"])))
        try:
            bits = ["last matched %s" % ago(int(os.path.getmtime(stamp)))]
        except OSError:
            bits = ["NEVER matched — a moved port or renamed script fails silently"]
        if res.get("port"):
            root, how = serving(repo_key, res)
            bits.append("serving %s (%s)" % (short_path(root or "-"), how))
        missing = [p for p in res.get("patterns", []) if not literal_runs(p)]
        if missing:
            bits.append("%d pattern(s) with no literal to pre-filter on" % len(missing))
        print("  %-12s %s" % (res["name"], "; ".join(bits)))
    plugin_root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    hooks = os.path.join(plugin_root, "hooks", "hooks.json")
    print("hooks        : %s" % (hooks if os.path.exists(hooks)
                                 else "MISSING — run the installer"))
    # Every block message this plugin writes tells the agent to run `agentbus
    # <something>`. If that command does not resolve, the agent is handed advice
    # it cannot act on, so this is worth a line of its own.
    import shutil
    found = shutil.which("agentbus")
    print("command      : %s" % (found or "NOT on PATH — run `%s install`"
                                 % os.path.realpath(__file__)))


COMMANDS = {
    "status": cli_status, "whois": cli_whois, "claim": cli_claim,
    "release": cli_release, "wait": cli_wait, "post": cli_post,
    "note": cli_post, "inbox": cli_inbox, "run": cli_run, "name": cli_name,
    "own": cli_own, "disown": cli_disown, "handoff": cli_handoff,
    "watch": cli_watch,
    "doing": cli_doing, "init-repo": cli_init_repo, "doctor": cli_doctor,
    "register": cli_register, "install": cli_install, "serve": cli_serve,
    "serves": cli_serves, "forget": cli_forget,
}

HOOKS = {
    "session-start": hook_session_start, "prompt-submit": hook_prompt_submit,
    "subagent-start": hook_subagent_start, "subagent-stop": hook_subagent_stop,
    "pre-tool": hook_pre_tool, "post-batch": hook_post_batch,
    "session-end": hook_session_end, "record-write": hook_record_write,
    "post-bash": hook_post_bash,
}

USAGE = """agentbus — coordination between parallel Claude Code sessions

  status                       who is live, what is held, what serves whom
  post [--to <agent>] [--as <you>] "..."   leave a message for the others
  inbox                        everything addressed to this repo / to you
  watch [--repo] [-n 20]       follow every agent on this machine, live
  run <res>[,<res>] -- <cmd>   point the services at your tree, hold, run, release
  serve <res>                  restart a service so it serves YOUR worktree
  serves                       which checkout each service is answering for
  own "<glob>" [--why ".."] [--strict]   declare part of the tree yours
  own --list | disown "<glob>" | disown --all
  claim <res> [--why ".."] [--steal]
  wait <res> [--timeout 90]    queue for a held resource
  release <res> | --all
  handoff [--note "..."]       summarise what you did, for the others
  doing "..."                  one line others see in their roster
  name [<new>]                 read or set this session's name
  init-repo                    declare this repo's shared resources
  install | doctor | whois | register | forget <agent|--stale>
"""


def main():
    ensure_dirs()
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return
    if argv[0] == "hook":
        if len(argv) < 2 or argv[1] not in HOOKS:
            return
        try:
            payload = json.loads(sys.stdin.read() or "{}")
        except ValueError:
            return
        HOOKS[argv[1]](payload)
        return
    fn = COMMANDS.get(argv[0])
    if not fn:
        print(USAGE)
        sys.exit(1)
    fn(argv[1:])


if __name__ == "__main__":
    try:
        main()
    except SystemExit:
        raise
    except Exception:
        # A coordination layer must never be the reason a session breaks.
        if os.environ.get("AGENTBUS_DEBUG"):
            import traceback
            traceback.print_exc(file=sys.stderr)
        sys.exit(0)
