/* Keyed, incremental updates — hand-rolled, because the self-contained rule is
   absolute and this is fifty lines.

   The board polls for as long as a tab is open. The old page rebuilt every
   section from a string on each poll, which threw away text selection
   mid-sentence, closed anything the reader had opened, reset scrolling inside
   those blocks, and made it impossible to show a change AS a change: after a
   wholesale redraw everything is equally new. So each row is created once under
   a stable key — the session id, the resource, the event's sequence number — and
   afterwards only the fields that actually differ are written.

   Nothing here builds markup out of data either. Every value goes in as text, so
   no branch name, worktree path or message can arrive as HTML. */
var repo = localStorage.getItem("ab-repo") || "";
var seen = +(localStorage.getItem("ab-seen") || 0);   /* where the reader was */
var newest = 0, first = true, last = null;

function ago(ts, now){var d = Math.max(0, now - ts);
 if(d < 60) return d + "s"; if(d < 3600) return Math.floor(d/60) + "m";
 if(d < 86400) return Math.floor(d/3600) + "h" + ("0"+Math.floor(d%3600/60)).slice(-2);
 return Math.floor(d/86400) + "d";}
function clock(ts){var d = new Date(ts*1000);
 return ("0"+d.getHours()).slice(-2)+":"+("0"+d.getMinutes()).slice(-2)+":"+("0"+d.getSeconds()).slice(-2);}
function keep(x){return !repo || x.repo === repo;}

function el(tag, cls, text){var n = document.createElement(tag);
 if(cls) n.className = cls; if(text != null) n.textContent = text; return n;}
function add(p, tag, cls, text){return p.appendChild(el(tag, cls, text));}
function gap(p){p.appendChild(document.createTextNode(" ")); return p;}
/* Write a value only when it is not the one already there. Touching the DOM for
   an unchanged value is what a diff is for; it also destroys a selection inside
   the node being written. */
function put(node, text){
 text = text == null ? "" : String(text);
 if(node.__v === text) return;
 var moved = node.__v !== undefined;
 node.__v = text; node.textContent = text;
 if(moved) flash(node);
}
function flash(node){
 if(first) return;            /* the first paint is not a change */
 node.classList.remove("hit");
 void node.offsetWidth;       /* restart the animation instead of leaving the
                                 class on a node that has already played it */
 node.classList.add("hit");
}
function shown(node, on){var v = on ? "" : "none";
 if(node.style.display !== v) node.style.display = v;}
function mark(node, cls, on){
 if(node.classList.contains(cls) === !!on) return;
 node.classList.toggle(cls, !!on);
 if(on) flash(node);
}
/* Match rows to items by key: build what is new, update what is already there,
   drop what has gone, and move only the nodes whose position really changed. */
function sync(parent, items, make, fill){
 var have = parent.__rows || (parent.__rows = {}), live = {}, prev = null, i;
 for(i = 0; i < items.length; i++){
  var it = items[i], k = String(it.k), node = have[k], made = !node;
  if(made) node = have[k] = make(it);
  live[k] = 1;
  var want = prev ? prev.nextSibling : parent.firstChild;
  if(node !== want) parent.insertBefore(node, want);
  fill(node, it, made);       /* after insertion: a fill may need to measure */
  prev = node;
 }
 Object.keys(have).forEach(function(k){
  if(!live[k]){parent.removeChild(have[k]); delete have[k];}});
}

/* ---- projects ------------------------------------------------------------ */
function makeProj(it){var b = el("button", "proj");
 b.c = {nm: add(b, "span", "nm")};
 b.appendChild(el("br"));
 b.c.meta = add(b, "span", "meta");
 b.onclick = function(){repo = it.key;
  localStorage.setItem("ab-repo", repo); if(last) render(last);};
 return b;}
function fillProj(b, it){put(b.c.nm, it.label); put(b.c.meta, it.meta);
 mark(b, "on", it.key === repo);}

/* ---- live agents --------------------------------------------------------- */
function makeSess(){var tr = el("tr"), c = {}, td = add(tr, "td");
 c.dot = add(td, "span", "dot"); c.name = add(gap(td), "span", "name");
 c.want = add(gap(td), "span", "tag want", "waiting");
 td = add(tr, "td", "mono");
 c.branch = add(td, "span"); c.ahead = add(gap(td), "span", "tag");
 c.root = add(tr, "td", "mono");
 td = add(tr, "td");
 c.doing = add(td, "div"); c.owns = add(td, "div", "meta");
 c.files = add(td, "div", "files"); c.list = add(td, "div", "list");
 c.clash = add(td, "div", "bad clash");
 c.files.onclick = function(){c.list.classList.toggle("open");};
 td = add(tr, "td", "meta");
 c.seen = add(td, "span"); c.unread = add(gap(td), "span", "warn");
 tr.c = c; return tr;}
function fillSess(tr, it){var s = it.s, c = tr.c;
 mark(c.dot, "stale", s.idle);
 put(c.name, s.agent);
 shown(c.want, s.waiting); mark(tr, "waiting", s.waiting);
 put(c.branch, s.branch || "-");
 /* null: not counted yet — the poll runs no git and waits for nothing. "": this
    tree has no default branch to be ahead of, so there is nothing to say. */
 put(c.ahead, s.ahead_of ? "+" + s.ahead : (s.ahead_of === null ? "…" : ""));
 c.ahead.title = s.ahead_of ? s.ahead + " ahead of " + s.ahead_of
   : (s.ahead_of === null ? "not counted yet" : "");
 shown(c.ahead, s.ahead_of !== "");
 put(c.root, s.root);
 put(c.doing, s.doing || "—");
 put(c.owns, s.owns ? "owns " + s.owns : ""); shown(c.owns, !!s.owns);
 put(c.files, s.wrote_n + (s.wrote_n === 1 ? " file" : " files") + " written");
 shown(c.files, !!s.wrote_n);
 put(c.list, s.wrote.join("\n") +
   (s.wrote_n > s.wrote.length ? "\n+" + (s.wrote_n - s.wrote.length) + " older" : ""));
 put(c.clash, s.clash.map(function(x){
   return x.path + " — also " + x.also.join(", ");}).join("\n"));
 shown(c.clash, !!s.clash.length);
 put(c.seen, ago(s.beat, it.now) + (s.idle ? " idle" : ""));
 put(c.unread, s.unread ? s.unread + " unread" : ""); shown(c.unread, !!s.unread);}
function makeKid(){var tr = el("tr", "kid"), c = {};
 c.name = add(tr, "td"); c.branch = add(tr, "td", "mono");
 c.root = add(tr, "td", "mono"); c.type = add(tr, "td"); add(tr, "td");
 tr.c = c; return tr;}
function fillKid(tr, it){var a = it.a, c = tr.c;
 put(c.name, a.name); put(c.branch, a.branch || "-");
 put(c.root, a.root); put(c.type, a.type || "");}
function makeGrp(){var tr = el("tr", "grp");
 tr.c = {t: add(tr, "td")}; tr.c.t.colSpan = 5; return tr;}
function makeNone(){var tr = el("tr");
 tr.c = {t: add(tr, "td", "empty")}; tr.c.t.colSpan = 5; return tr;}
function fillSpan(tr, it){put(tr.c.t, it.label);}

/* ---- services ------------------------------------------------------------ */
function makeServe(){var tr = el("tr"), c = {}, td = add(tr, "td");
 c.res = add(td, "span", "name mono"); c.port = add(gap(td), "span", "meta mono");
 c.desc = add(td, "div", "meta");
 c.root = add(tr, "td", "mono");
 c.by = add(tr, "td", "meta");
 td = add(tr, "td");
 c.holder = add(td, "span", "name"); c.held = add(gap(td), "span", "meta");
 c.free = add(td, "span", "ok", "free"); c.why = add(td, "div", "meta");
 td = add(tr, "td");
 c.state = add(td, "span"); c.churn = add(td, "div", "warn");
 tr.c = c; return tr;}
function fillServe(tr, it){var s = it.s, c = tr.c;
 put(c.res, s.resource);
 put(c.port, s.port ? ":" + s.port : ""); shown(c.port, !!s.port);
 put(c.desc, s.desc); shown(c.desc, !!s.desc);
 put(c.root, s.root || "—"); put(c.by, s.by || "—");
 put(c.holder, s.held_by);
 put(c.held, s.held_by ? ago(s.held_since, it.now) +
   (s.held_mode === "hard" ? " hard" : "") : "");
 put(c.why, s.held_why); shown(c.why, !!(s.held_by && s.held_why));
 shown(c.holder, !!s.held_by); shown(c.held, !!s.held_by);
 shown(c.free, !s.held_by);
 put(c.state, s.alive ? "running" : (s.movable ? "not started" : "not a service"));
 mark(c.state, "ok", s.alive); mark(c.state, "meta", !s.alive);
 put(c.churn, s.churn >= 3 ? "moved " + s.churn + "× between " +
   s.churn_roots.join(" and ") : "");
 shown(c.churn, s.churn >= 3);}

/* ---- feed ---------------------------------------------------------------- */
function makeEv(it){var d = el("div", "ev k-" + it.e.kind), c = {};
 c.t = add(d, "span", "t");
 c.who = add(d, "span", "who"); c.name = add(c.who, "span");
 c.kind = add(add(c.who, "div"), "span", "meta");
 c.txt = add(d, "span", "txt");
 c.txt.onclick = function(){c.txt.classList.toggle("open");};
 d.c = c; if(!first) d.classList.add("arrive"); return d;}
function fillEv(d, it, made){var e = it.e, c = d.c;
 put(c.t, clock(e.ts));
 put(c.name, e.agent + (e.to ? " → " + e.to : ""));
 put(c.kind, e.kind);
 put(c.txt, e.text);
 /* Only measurable once it is in the document, and an event's text never
    changes afterwards, so this is asked once per event and not once per poll. */
 if(made && c.txt.scrollHeight > c.txt.clientHeight + 2) c.txt.classList.add("clip");}
function makeSince(){var d = el("div", "since", "since you last looked");
 d.title = "click to clear"; d.onclick = looked; return d;}

/* The divider is the reader's own business, so it lives in this browser and
   nowhere else: the server is read-only and remembers nothing about whoever is
   watching, and a cursor kept there would be one two tabs had to share.

   The mark moves when the reader stops looking — and only if they were looking
   in the first place. A board opened in a background tab, or in a window that is
   not the front one, is handed a blur it never earned, and taking that as "read"
   throws away the one thing the divider was for. */
var watching = document.hasFocus() && !document.hidden;
function looked(){
 if(!newest) return;
 seen = newest; localStorage.setItem("ab-seen", String(newest));
 if(last) render(last);
}
function away(){if(!watching) return; watching = false; looked();}
window.addEventListener("focus", function(){watching = true;});
window.addEventListener("blur", away);
document.addEventListener("visibilitychange", function(){
 if(document.hidden) away(); else if(document.hasFocus()) watching = true;});

function render(d){
 last = d;
 var now = d.now;
 var ss = d.sessions.filter(keep), lk = d.locks.filter(keep),
     sv = d.serves.filter(keep), ev = d.events.filter(keep);
 put(document.getElementById("count"),
   ss.length + " session" + (ss.length==1?"":"s") + " · " +
   ss.reduce(function(n,s){return n + s.agents.length;},0) + " subagents · " +
   lk.length + " held");
 var w = ss.filter(function(s){return s.waiting;}).length;
 put(document.getElementById("wanting"), w ? "· " + w + " waiting for you" : "");

 sync(document.getElementById("filters"),
   [{key:"", label:"all projects"}].concat(d.repos).map(function(r){
     var n = d.sessions.filter(function(s){return !r.key || s.repo === r.key;}).length;
     var h = d.locks.filter(function(l){return !r.key || l.repo === r.key;}).length;
     return {k: "p:" + r.key, key: r.key, label: r.label,
             meta: n + " live" + (h ? " · " + h + " held" : "")};}),
   makeProj, fillProj);

 /* Grouped by repository, because sessions in different projects cannot collide
    with each other and the collisions are what the reader is here for. */
 var rows = [], order = [];
 ss.forEach(function(s){if(order.indexOf(s.repo) < 0) order.push(s.repo);});
 order.sort(function(a, b){
   var la = "", lb = "";
   ss.forEach(function(s){if(s.repo === a) la = s.repo_label || a;
                          if(s.repo === b) lb = s.repo_label || b;});
   return la < lb ? -1 : la > lb ? 1 : 0;});
 order.forEach(function(key){
  var group = ss.filter(function(s){return s.repo === key;});
  rows.push({k: "g:" + key, kind: "grp", label: group[0].repo_label || key});
  group.forEach(function(s){
   rows.push({k: "s:" + s.sid, kind: "sess", s: s, now: now});
   s.agents.forEach(function(a, i){
    rows.push({k: "a:" + s.sid + ":" + (a.name || i), kind: "kid", a: a});});});});
 if(!ss.length) rows.push({k: "none", kind: "empty", label: "nobody is live"});
 sync(document.getElementById("agents"), rows, function(it){
   return it.kind === "sess" ? makeSess() : it.kind === "kid" ? makeKid()
     : it.kind === "grp" ? makeGrp() : makeNone();},
  function(node, it, made){
   if(it.kind === "sess") fillSess(node, it);
   else if(it.kind === "kid") fillKid(node, it);
   else fillSpan(node, it);});

 sync(document.getElementById("serves"),
   sv.length ? sv.map(function(s){
     return {k: "v:" + s.repo + ":" + s.resource, kind: "serve", s: s, now: now};})
   : [{k: "none", kind: "empty",
       label: "this repository declares no shared resources (agentbus init-repo)"}],
   function(it){return it.kind === "serve" ? makeServe() : makeNone();},
   function(node, it){
     if(it.kind === "serve") fillServe(node, it); else fillSpan(node, it);});

 newest = ev.length ? ev[0].i : 0;
 /* Only when something really has arrived since the reader last looked away: a
    divider with nothing above it is a line drawn for its own sake. */
 var items = [], divided = false, fresh = seen && ev.length && ev[0].i > seen;
 ev.forEach(function(e){
  if(fresh && !divided && e.i <= seen){items.push({k: "since"}); divided = true;}
  items.push({k: "e:" + e.i, e: e});});
 if(fresh && !divided) items.push({k: "since"});
 if(!ev.length) items = [{k: "none", label: "nothing yet"}];
 sync(document.getElementById("feed"), items, function(it){
   return it.e ? makeEv(it) : it.k === "since" ? makeSince()
     : el("div", "empty", it.label);},
  function(node, it, made){if(it.e) fillEv(node, it, made);});
 first = false;
}
function tick(){fetch("/data").then(function(r){return r.json();}).then(function(d){
  document.getElementById("lost").style.display = "none"; render(d);})
 .catch(function(){document.getElementById("lost").style.display = "block";});}
tick(); setInterval(tick, __INTERVAL__);
</script></body></html>
"""


# How far ahead of the trunk each checkout is, without paying for it on the
# poll. Counting commits means running git, and git once per worktree per poll —
# for as long as a tab is open — is a cost a window that only watches has no
# business imposing on the machine it is watching. So the request path never
# runs git at all: it serves what the cache holds and hands the work to a
# thread. Nothing here is written to disk, which also means two open tabs share
# nothing and neither can leave anything behind.
GIT_TTL = 10              # seconds a counted number is still served for
BOARD_FILES = 12          # files named per session before "+n more"
# Last resort only, after two derived answers, and only if such a branch really
# exists. Assuming a name is what this ladder is here to avoid.
TRUNK_NAMES = ("main", "master", "trunk", "default", "develop")
_GIT = {}                 # root -> {"at": ts, "ahead": int|None, "base": str}
_GIT_RUNNING = set()      # roots a refresh thread already has in hand


def git_out(root, *args):
    """One read-only git command in `root`; "" if it fails or has nothing to say.

    Ten seconds is a long timeout for `rev-list`, and deliberate: this only ever
    runs off the request path, so the cost of waiting is one stale number rather
    than a page that will not load."""
    import subprocess
    try:
        out = subprocess.run(("git",) + args, cwd=root, capture_output=True,
                             text=True, timeout=10)
    except Exception:
        return ""
    return out.stdout.strip() if out.returncode == 0 else ""


def default_base(root, known=""):
    """The ref this worktree's own commits should be counted against.

    Derived, not assumed. `origin/HEAD` is the answer the repository itself
    recorded when it was cloned; `init.defaultBranch` is what this machine would
    have named the trunk had it created the repository; the conventional names
    come last and only when such a branch actually exists. Hard-coding one name
    would have the repository this ships from reporting its default correctly and
    an older one, or a worktree of a repository with no remote at all, reporting
    nothing. "" when there is genuinely nothing to compare against — a tree with
    no commits yet — which the page says rather than guesses at."""
    if known:
        return known      # trunks are not renamed twice an afternoon
    head = git_out(root, "symbolic-ref", "--quiet", "--short",
                   "refs/remotes/origin/HEAD")
    if head:
        return head
    have = set(git_out(root, "for-each-ref", "--format=%(refname:short)",
                       "refs/heads/").split("\n"))
    for name in (git_out(root, "config", "--get", "init.defaultBranch"),) + \
            TRUNK_NAMES:
        if name and name in have:
            return name
    return ""


def git_count(root):
    """Count `root`'s commits since its default branch. Runs git — never call
    this from a poll."""
    base = default_base(root, (_GIT.get(root) or {}).get("base") or "")
    count = git_out(root, "rev-list", "--count", "%s..HEAD" % base) if base else ""
    if not count.isdigit():
        # Either there is no trunk to compare with, or the one we remembered has
        # been renamed or its remote removed, or HEAD does not resolve yet in a
        # tree with no commits. Forget the base so the next pass derives it again
        # instead of asking the same dead question every ten seconds.
        return {"at": now(), "ahead": None, "base": ""}
    return {"at": now(), "ahead": int(count), "base": base}


def git_ahead(root):
    """(commits ahead of the trunk, the ref that was counted against) for a
    worktree, from cache only. (None, None) is "not computed yet".

    Refreshed in the background from halfway through the TTL, so a number that
    keeps being asked for never actually expires and the column does not blink
    empty every ten seconds. Past the full TTL it does go empty, which is the
    point: if git is wedged or slow the page says it does not know rather than
    showing a number from some minutes ago as though it were current."""
    ent = _GIT.get(root)
    age = now() - ent["at"] if ent else None
    if root and (age is None or age >= GIT_TTL // 2) and root not in _GIT_RUNNING:
        # Check-then-add, with no lock: two tabs polling in the same instant can
        # both start a refresh for one root. Both run read-only git and write the
        # same answer, so the race costs one extra `rev-list` and nothing else.
        _GIT_RUNNING.add(root)
        import threading
        threading.Thread(target=_git_refresh, args=(root,), daemon=True).start()
    if ent and age < GIT_TTL:
        return ent["ahead"], ent["base"]
    return None, None


def _git_refresh(root):
    try:
        _GIT[root] = git_count(root)
    finally:
        _GIT_RUNNING.discard(root)


def board_state(limit=60):
    """Everything the dashboard shows, as plain data.

    Read-only on purpose. A viewer left open in a browser tab polls every couple
    of seconds, and the usual engine housekeeping — reaping sessions, rewriting
    the derived files, advancing a cursor — would mean that watching the bus
    changed it. `status` may do those things because a person asked it a
    question; a window that refreshes by itself may not."""
    sessions = load_sessions()
    live_sids = {s["sid"] for s in sessions}
    out = {"now": now(), "sessions": [], "locks": [], "serves": [],
           "events": [], "repos": []}

    # What each session has produced, and where two of them have produced the
    # same file. The overlap is the whole point: two chats that have both edited
    # one file is the thing somebody merging their work needs to see *before* the
    # merge, and the bus already records every write per session, so this half
    # costs no git. Repository-relative, because that is the form two worktrees
    # of one repository have in common — there the same file has two absolute
    # paths and one relative one. Only within a repository: sessions in different
    # projects cannot collide, and pairing them would be noise.
    wrote = {s["sid"]: [rel for _ts, rel in repo_writes(s, 0)] for s in sessions}
    clash = {}                      # sid -> {relative path: [other agents]}
    for a in sessions:
        for b in sessions:
            if b["sid"] == a["sid"] or b.get("repo_key") != a.get("repo_key"):
                continue
            for rel in set(wrote[a["sid"]]) & set(wrote[b["sid"]]):
                clash.setdefault(a["sid"], {}).setdefault(rel, []).append(
                    b.get("agent") or "?")

    # One read of the log for the whole poll. Each session's unread count is
    # measured from its own cursor, and asking `unseen` to read the log itself
    # once per session would cost several times everything else on this page put
    # together. Read from the lowest cursor of the lot, or from the tail the feed
    # needs, whichever is further back.
    seq = read_int(SEQFILE, 0)
    cursors = {s["sid"]: cursor_of(s, seq) for s in sessions}
    log = read_events(after=min([max(0, seq - limit)] + list(cursors.values())))

    seen_repos = {}
    for s in sessions:
        subs = [{"name": a.get("name"), "type": a.get("agent_type"),
                 "root": short_path(a.get("root", "")),
                 "branch": a.get("branch") or "",
                 "started": a.get("started", 0)}
                for a in load_agents(s["sid"])]
        ahead, base = git_ahead(s.get("root", ""))
        idle = now() - s.get("beat", 0) > IDLE_SECS
        # Not `deliver`: that formats the same events into a sentence for the
        # session itself, and would advance nothing but would read the log five
        # times over. `unseen` is the shared body underneath it.
        unread = len(unseen(s, log=log)[1])
        mine = wrote[s["sid"]]
        out["sessions"].append({
            "sid": s["sid"], "agent": s.get("agent"),
            "root": short_path(s.get("root", "")),
            "branch": s.get("branch") or "", "doing": s.get("doing") or "",
            "beat": s.get("beat", 0), "idle": idle,
            "guarded": int(s.get("guarded", 0) or 0),
            "repo": s.get("repo_key", ""), "repo_label": s.get("repo_label", ""),
            "owns": owns_summary(s["sid"], limit=6), "agents": subs,
            "ahead": ahead, "ahead_of": base,
            "wrote": mine[:BOARD_FILES], "wrote_n": len(mine),
            # `also`, not `with`: the page reads this key in JavaScript, where
            # `with` is a reserved word and only legal after a dot by accident.
            "clash": [{"path": p, "also": sorted(set(who))}
                      for p, who in sorted(clash.get(s["sid"], {}).items())],
            "unread": unread,
            # The one thing on the page that asks to be acted on. A session that
            # is working will read the bus itself at its next turn; a session
            # that has stopped with messages it has never been shown is a window
            # somebody has to go and poke, and that is not visible anywhere else.
            "waiting": bool(idle and unread)})
        seen_repos[s.get("repo_key", "")] = s.get("repo_label", "")

    try:
        names = sorted(os.listdir(LOCKS))
    except OSError:
        names = []
    for name in names:
        if not name.endswith(".json"):
            continue
        lock = read_json(os.path.join(LOCKS, name))
        if not lock:
            continue
        _, stealable, why = lock_state(lock, sessions)
        out["locks"].append({
            "resource": lock.get("resource"), "agent": lock.get("agent"),
            "mode": lock.get("mode"), "why": lock.get("why") or "",
            "since": lock.get("acquired_at", 0), "repo": lock.get("repo", ""),
            "party_known": bool(lock.get("party_known", True)),
            "orphan": lock.get("sid") not in live_sids,
            "expired": bool(stealable), "expired_why": why})

    # Every resource the repository declares, not only the ones somebody has
    # started. "Nobody is holding the simulator" is as much of an answer as
    # "she is", and a service that has never been started at all is the state a
    # reader most needs to be able to see.
    held = {}
    for lock in out["locks"]:
        held[(lock["repo"], (lock["resource"] or "").split("@")[0])] = lock
    served = {}
    try:
        names = sorted(os.listdir(SERVES))
    except OSError:
        names = []
    for name in names:
        if not name.endswith(".json"):
            continue
        rec = read_json(os.path.join(SERVES, name))
        if rec and rec.get("resource"):
            served[(rec.get("repo", ""), rec["resource"])] = rec

    # Only repositories somebody is actually working in. A serve record whose
    # process is gone, under a repo key nobody is live in, is cruft from an
    # earlier shape of the tree — this machine carries three such — and listing
    # its resources beside the real ones would put the same service on the page
    # twice, once truthfully and once as a ghost.
    roots = {}
    for s in sessions:
        roots.setdefault(s.get("repo_key", ""), s.get("root"))
    for key, rec in served.items():
        if key[0] not in roots and pid_alive(rec.get("pid")):
            roots.setdefault(key[0], rec.get("root"))

    for repo_key, root in sorted(roots.items()):
        cfg = repo_config(repo_key, root)
        declared = [r["name"] for r in cfg.get("resources", []) if r.get("name")]
        for extra in sorted(k[1] for k in served if k[0] == repo_key):
            if extra not in declared:
                declared.append(extra)      # started, then removed from config
        by_name = {r["name"]: r for r in cfg.get("resources", [])}
        for name in declared:
            res = by_name.get(name, {})
            rec = served.get((repo_key, name)) or {}
            lock = held.get((repo_key, name))
            moves = (read_json(moves_path(repo_key, name)) or {}).get("moves", [])
            recent = [m for m in moves if now() - m.get("at", 0) < CHURN_WINDOW]
            alive = bool(rec) and pid_alive(rec.get("pid"))
            out["serves"].append({
                "resource": name, "repo": repo_key,
                "desc": res.get("desc", ""), "port": res.get("port") or rec.get("port"),
                "movable": bool(res.get("start")),
                "root": short_path(rec.get("root", "")) if alive else "",
                "by": rec.get("by") if alive else "",
                "started": rec.get("started", 0) if alive else 0,
                "alive": alive,
                "held_by": (lock or {}).get("agent", ""),
                "held_since": (lock or {}).get("since", 0),
                "held_mode": (lock or {}).get("mode", ""),
                "held_why": (lock or {}).get("why", ""),
                "churn": len(recent),
                "churn_roots": sorted({short_path(m.get("root", ""))
                                       for m in recent})})

    for r in log:
        if r.get("i", 0) <= seq - limit:
            continue                # read further back than the feed shows, for
        out["events"].append({      # the unread counts; the feed keeps its tail
            "i": r.get("i"), "ts": r.get("ts"), "agent": r.get("agent"),
            "to": r.get("to") or "", "kind": r.get("kind"),
            "repo": r.get("repo", ""), "text": r.get("text", "")})
    out["events"].reverse()   # newest first: that is what a watcher looks at
    # The filter lists places there is something to watch. A repository that
    # only appears in the log is history, and offering it as a filter would be
    # offering an empty page.
    for key in roots:
        seen_repos.setdefault(key, key.split(":")[0])
    out["repos"] = [{"key": k, "label": v or k} for k, v in sorted(
        seen_repos.items(), key=lambda kv: kv[1] or kv[0]) if k]
    return out


def cli_board(args):
    """A window onto the bus, served to this machine only.

    `watch` answers "what just happened" one line at a time. The question
    somebody with five terminals open actually has is "what is going on" — who
    is live, in which checkout, what is held, which tree each service is
    answering for — and that is a shape, not a stream.

    Bound to the loopback address and nowhere else: this data is every branch
    name and worktree path on the machine, and it is nobody's business but the
    person sitting at it."""
    import http.server
    import json as _json
    import socketserver
    import webbrowser

    port = int(opt(args, "--port", "8787"))
    every = max(1, int(opt(args, "--interval", "2")))

    class Handler(http.server.BaseHTTPRequestHandler):
        def _send(self, body, ctype):
            raw = body.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(raw)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            try:
                self.wfile.write(raw)
            except OSError:
                pass          # the tab was closed mid-write; not our problem

        def do_GET(self):
            if self.path.startswith("/data"):
                try:
                    self._send(_json.dumps(board_state()), "application/json")
                except Exception as exc:
                    self._send(_json.dumps({"error": str(exc)}),
                               "application/json")
                return
            if self.path in ("/", "/index.html"):
                self._send(BOARD_HTML.replace("__INTERVAL__", str(every * 1000)),
                           "text/html; charset=utf-8")
                return
            self.send_error(404)

        def log_message(self, *_a):
            pass              # one line per poll would bury the terminal

    class Server(socketserver.ThreadingTCPServer):
        allow_reuse_address = True
        daemon_threads = True

    httpd = None
    for candidate in (port, 0):
        try:
            httpd = Server(("127.0.0.1", candidate), Handler)
            break
        except OSError as exc:
            if candidate == 0:
                print("agent-bus: could not open a port: %s" % exc,
                      file=sys.stderr)
                sys.exit(1)
            print("agent-bus: port %d is taken, picking another." % candidate,
                  file=sys.stderr)
    url = "http://127.0.0.1:%d/" % httpd.server_address[1]
    print("agent-bus board — %s" % url)
    print("Local only, and read-only: it never changes what it is watching.")
    print("Ctrl-C to stop.")
    # Piped into a file or a pager, stdout is block-buffered and the URL — the
    # one thing the caller needs — would sit unseen until the server stopped.
    sys.stdout.flush()
    if not flag(args, "--no-open"):
        try:
            webbrowser.open(url)
        except Exception:
            pass
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print()
    finally:
        httpd.server_close()


def cli_here(args):
    """Record which worktree the caller is actually working in.

    Everything else infers this, and for a subagent the inference can be wrong
    in a way nothing can detect. A subagent's hook payloads carry its *parent's*
    cwd unless it has changed directory, so an agent told to work in one
    checkout while its parent sits in another looks, to every guard, like it is
    in its parent's tree. On 2026-07-29 one of them was refused permission to
    use the very service it had itself pointed at its own worktree, and turned
    the plugin off for the rest of its turn rather than argue with it.

    A shell knows where it is. This is the one place that answer can be handed
    over, so it is stated rather than guessed:

        cd <your worktree> && agentbus here

    Which party is speaking is settled by the hint the guard leaves, the same
    way `agentbus claim` is — so it must be run as its own command, not buried
    in a script, and `--as <your name>` is the fallback when it cannot be.

    Either way the declaration is durable: it is recorded with a `pinned` flag,
    on the session's record or on the agent's, and everything that infers a
    location from a cwd steps over it until `here` is run somewhere else.

    This is the *writer* of that flag, and it has to be read next to its
    readers, which are all in `resolve_party`: clause (c) of *where they are
    working* for the session's pin, and the declaring half of clause (b) for an
    agent's. Two levels, two records, one flag with one meaning — a session's
    pin never reaches an agent's record and an agent's never reaches the
    session's, which is what stops a subagent's declaration pinning its parent.
    The one statement that still beats both is `git -C <path>`, clause (a),
    because that is about a single command."""
    record, me = need_party()
    me = acting(me, args)
    pos = positional(args)
    where = os.path.realpath(pos[0]) if pos else os.getcwd()
    if not os.path.isdir(where):
        print("agent-bus: no such directory: %s" % where, file=sys.stderr)
        sys.exit(1)
    root, repo_key, label, branch = git_facts(where)
    aid = me.get("agent_id")
    if aid:
        rec = read_json(agent_path(me["sid"], aid))
        if not rec:
            print("agent-bus: no record of that agent — `agentbus whois` lists "
                  "who is who.", file=sys.stderr)
            sys.exit(1)
        # The same flag the session branch writes, because it is the same
        # statement one level down. Without it `_follow_agent_cwd` had nothing
        # to read, and the declaration survived only until a payload arrived
        # with a cwd that was neither the agent's record nor its parent's.
        rec.update({"cwd": where, "root": root, "repo_key": repo_key,
                    "repo_label": label, "branch": branch, "pinned": True})
        write_json(agent_path(me["sid"], aid), rec)
        who = rec.get("name")
    else:
        # The session file, so the record — never `me`, which by this point may
        # be a subagent that failed to find its own record above.
        rec = read_json(os.path.join(SESSIONS, "%s.json" % record["sid"])) or record
        rec["sid"] = record["sid"]
        rec.update({"cwd": where, "root": root, "repo_key": repo_key,
                    "repo_label": label, "branch": branch, "pinned": True})
        write_json(os.path.join(SESSIONS, "%s.json" % record["sid"]),
                   require_record(rec, "cli_here"))
        who = rec.get("agent")
    refresh_derived()
    print("%s is working in %s (%s)" % (who, short_path(root), branch or "-"))
    if aid:
        return
    print("(that was recorded for the session. If you are a subagent, run this "
          "as its own\n command so the guard can see who you are, or add "
          "--as <your name>.)")


def port_env_name(res):
    """The shell variable `agentbus env` exports for a resource."""
    return res.get("env") or ("AGENTBUS_PORT_" +
                              re.sub(r"[^A-Za-z0-9]+", "_", res.get("name", "")).upper())


def cli_port(args):
    """The port this checkout should use for a resource.

    Two worktrees of one repository running the same dev server on one port is
    the failure this whole plugin exists for: the port hides which checkout is
    answering, so a test passes against somebody else's code. Coordinating one
    port is the expensive way to solve that. Giving each checkout its own is the
    cheap way, and on the machine this was written for it would have removed 87
    per cent of every block the bus has ever issued.

    The number is derived from the checkout's path, so it is stable without any
    state, and the repository's original checkout keeps the declared port so
    nothing changes for whoever is working there."""
    me = need_me()
    pos = positional(args)
    if not pos:
        print("usage: agentbus port <resource>", file=sys.stderr)
        sys.exit(1)
    res = find_resource(me, pos[0])
    if not res:
        print("no resource named '%s' in this repo's config" % pos[0],
              file=sys.stderr)
        sys.exit(1)
    if not res.get("port"):
        print("'%s' declares no port" % pos[0], file=sys.stderr)
        sys.exit(1)
    print(res["port"])


def cli_env(args):
    """Every declared port for this checkout, as shell exports.

        eval "$(agentbus env)"
        make dev

    Resources that did not ask for per-worktree ports are exported too, at their
    declared value, so one line covers the whole configuration and a script does
    not have to know which is which."""
    me = need_me()
    cfg = repo_config(me.get("repo_key"), me.get("root"))
    rows = [r for r in cfg.get("resources", []) if r.get("port")]
    if flag(args, "--json"):
        print(json.dumps({port_env_name(r): r["port"] for r in rows}, indent=2))
        return
    if not rows:
        print("# no resource in this repo declares a port", file=sys.stderr)
        return
    for r in rows:
        own = " (this checkout's own)" if r.get("_declared_port") else ""
        print("export %s=%d%s" % (port_env_name(r), r["port"],
                                  ("   # %s%s" % (r["name"], own))))


def cli_inbox(_args):
    me = need_me()
    seen = 0
    for r in read_events(after=0):
        if not interesting_to(r, me):
            continue
        seen += 1
        print("%-16s %-9s %s%s" % (r.get("agent"), ago(r.get("ts")),
                                   "→you " if r.get("to") else "", r.get("text")))
    if not seen:
        print("(nothing yet)")


def find_resource(me, name):
    cfg = repo_config(me.get("repo_key"), me.get("root"))
    return next((r for r in cfg.get("resources", []) if r["name"] == name), None)


def cli_serve(args):
    """Point a declared service at this worktree, restarting it if it is serving
    another one. This is the half `sim-lock.sh` had and a lock alone cannot do."""
    me = acting(need_me(), args)
    pos = positional(args)
    if not pos:
        print("usage: agentbus serve <resource> [--as <you>]", file=sys.stderr)
        sys.exit(1)
    res = find_resource(me, pos[0])
    if not res:
        print("no resource named '%s' in this repo's config" % pos[0], file=sys.stderr)
        sys.exit(1)
    if not res.get("start"):
        print("'%s' declares no `start` command, so agent-bus cannot move it. "
              "Add one to .claude/agent-bus.json." % pos[0], file=sys.stderr)
        sys.exit(1)
    # From the Plan, like every other verb: this is a service and services are
    # not usually instance-keyed, but a `scope: "worktree"` one would have been
    # claimed here under a name the guard never writes.
    plan = plan_for(me, names=res["name"])
    planned = plan["resources"][0]
    ok, lock, holder, reason = do_claim(me, planned["lock"], why="handover",
                                        mode="hard")
    if not ok:
        if not holder:
            print("agent-bus: could not take '%s': %s" % (res["name"], reason),
                  file=sys.stderr)
            sys.exit(1)
        # The line under this used to be an `agentbus post --to <holder>` this
        # function wrote out for itself — the only advice on the command surface
        # that was still composed by hand rather than taken from the Plan.
        print(render_refusal(
            _lock_block(me, "", planned, lock, holder, plan["resources"]),
            " — ask before moving it out from under them."), file=sys.stderr)
        sys.exit(1)
    good, detail = ensure_serving(me, res)
    do_release(me, planned["lock"], quiet=True)
    if not good:
        print("agent-bus: %s" % detail, file=sys.stderr)
        sys.exit(1)
    print("'%s' %s" % (res["name"], detail))


def cli_serves(_args):
    me = need_me()
    cfg = repo_config(me.get("repo_key"), me.get("root"))
    for res in cfg.get("resources", []):
        if not res.get("port") and not res.get("start"):
            continue
        root, how = serving(me.get("repo_key"), res)
        mark = "you" if root and os.path.realpath(root) == os.path.realpath(
            me.get("root") or "") else ""
        print("%-12s %-9s %-46s %s" % (res["name"], how, short_path(root or "-"), mark))


def expand_implied(names, me):
    """The named resources, plus whatever they imply.

    `agentbus run simulator` took the simulator and nothing else, while a bare
    `maestro test` took the simulator *and* the two bundlers and the API —
    because the guard expands `implies` and the CLI never did. The careful
    command was the weaker one: another session could re-serve a bundler
    mid-run and the run would silently switch to its bundle, which is precisely
    what this plugin exists to prevent.

    Reported from real use on 2026-07-28 by an agent that lost six minutes to it
    twice and then negotiated a manual protocol with the other session instead.
    Its exact words: "'agentbus run simulator' bile metro-app'i tutmuyor"."""
    cfg = repo_config(me.get("repo_key"), me.get("root"))
    by_name = {r["name"]: r for r in cfg.get("resources", [])}
    out, added = list(names), []
    for name in list(names):
        for dep in (by_name.get(name) or {}).get("implies", []):
            if dep in by_name and dep not in out:
                out.append(dep)
                added.append(dep)
    return out, added


def cli_run(args):
    import subprocess
    me = need_me()
    if "--" not in args:
        print("usage: agentbus run <res>[,<res>] [--why \"...\"] -- <command>",
              file=sys.stderr)
        sys.exit(1)
    cut = args.index("--")
    head, cmd = args[:cut], args[cut + 1:]
    me = acting(me, head)
    pos = positional(head)
    if not pos or not cmd:
        print("usage: agentbus run <res>[,<res>] [--why \"...\"] -- <command>",
              file=sys.stderr)
        sys.exit(1)
    # Under the keys the guard uses, not the names typed: a worktree-scoped
    # resource is one lock per checkout and an instance one lock per device, and
    # taking the bare name would write a lock that nothing consults.
    plan = plan_for(me, names=pos[0])
    if plan["reason"] == "no-such-resource":
        print(render_block(plan), file=sys.stderr)
        sys.exit(1)
    # Asked of the resources rather than of the string, so that `agentbus run
    # simulator@ABC123` pulls in what the simulator implies exactly as
    # `agentbus run simulator` does. Unlike `claim`, `run` expands: the careful
    # command was the weaker one, and another session re-serving a bundler
    # mid-run would silently switch the run to its bundle.
    _, implied = expand_implied([r["name"] for r in plan["resources"]], me)
    if implied:
        print("agent-bus: also taking %s — %s implies %s."
              % (", ".join(implied), pos[0], ", ".join(implied)), file=sys.stderr)
        plan = plan_for(me, names=[pos[0]] + implied)
    why = opt(head, "--why", " ".join(cmd)[:120])
    taken = []
    try:
        for res in plan["resources"]:
            ok, lock, holder, reason = do_claim(me, res["lock"], why=why,
                                                mode="hard")
            if not ok:
                if not holder:
                    print("agent-bus: could not take '%s': %s"
                          % (_named(res), reason), file=sys.stderr)
                    sys.exit(75)
                print(render_refusal(
                    _lock_block(me, "", res, lock, holder, plan["resources"]),
                    " — not running."), file=sys.stderr)
                sys.exit(75)
            taken.append(res)
        # Holding the lock is not enough: make the services actually answer with
        # this worktree's code before the command runs.
        for res in plan["resources"]:
            declared = find_resource(me, res["name"])
            if declared and declared.get("start"):
                good, detail = ensure_serving(me, declared)
                if not good:
                    print("agent-bus: %s" % detail, file=sys.stderr)
                    sys.exit(75)
                if "restarted" in (detail or ""):
                    print("agent-bus: '%s' %s" % (res["name"], detail),
                          file=sys.stderr)
        # cmd is already word-split by the calling shell, so run it directly:
        # joining it back into a shell string would destroy the quoting in
        # forms like `-- bash -c 'cd x && maestro test'`.
        rc = subprocess.call(cmd)
        sys.exit(rc)
    finally:
        spoken = []
        for res in taken:
            lock = load_lock(me.get("repo_key"), res["lock"])
            if do_release(me, res["lock"], quiet=True) \
                    and (lock or {}).get("announced"):
                spoken.append(res["lock"])
        announce_locks(me, "released", spoken)


def cli_name(args):
    # The record: this mutates what it is given and writes it to the session
    # file. A session is named, not a party — `agentbus name` run by a subagent
    # renames its parent, deliberately, and must not persist the subagent's
    # identity while doing it.
    me = require_record(need_record(), "cli_name")
    pos = positional(args)
    if not pos:
        print(me.get("agent"))
        return
    old = me.get("agent")
    me["agent"] = re.sub(r"[^A-Za-z0-9_.#-]", "-", pos[0])[:24]
    write_json(os.path.join(SESSIONS, "%s.json" % me["sid"]), me)
    emit(me["sid"], me["agent"], me["repo_key"], "note",
         "renamed from %s to %s" % (old, me["agent"]))
    print(me["agent"])


def cli_doing(args):
    me = require_record(need_record(), "cli_doing")   # written back, as above
    me["doing"] = " ".join(positional(args))[:160]
    write_json(os.path.join(SESSIONS, "%s.json" % me["sid"]), me)
    print("noted")


def task_record(me, tid, what, needs):
    """A new ledger entry, with everything about it that is measured rather than
    typed: who is acting, where they are standing, and which branch that is."""
    return {"id": tid, "what": what, "sid": me.get("sid"),
            "agent": me.get("agent"), "agent_id": me.get("agent_id") or "",
            "branch": me.get("branch") or "", "root": me.get("root") or "",
            "at": now(), "state": "open", "needs": needs,
            "done_at": 0, "note": "", "wrote": [], "wrote_n": 0, "from": ""}


def cli_take(args):
    """Say what you have started. One line, and the rest is worked out.

    The board could already show what a session had *done* — its branch, how far
    ahead, the files it wrote, which of them clash with another chat's. What it
    could not show is intent: that this chat has the api findings and that one
    cannot rebase until they land. That only existed in the head of the person
    watching, who was routing it by hand between chats.

    So it is deliberately one short sentence and at most one reference. Every
    field a form would have asked for is derived — see the tasks section — and
    the reason is not tidiness: agents forget, measurably, and a ledger with six
    fields to fill in is one nobody fills in on the afternoon it would have
    mattered."""
    me = acting(need_me(), args)
    pos = positional(args)
    what = " ".join(pos).strip()
    if not what:
        print('usage: agentbus take "<what you have started>" [--needs <task>] '
              '[--as <you>]\n'
              '       agentbus take <task>   pick up work whose session has gone',
              file=sys.stderr)
        sys.exit(1)
    # `take t3` picks up an entry that already exists. Decided by shape rather
    # than by a flag because the two are never confusable in practice — nobody
    # describes what they are doing as "t3" — and a flag would be a third thing
    # to remember on the line this exists to keep to one.
    if len(pos) == 1 and TASK_REF.match(pos[0]):
        print(take_over(me, pos[0]))
        return
    repo = me.get("repo_key", "")
    with tasks_mutex(repo):
        led = load_ledger(repo)
        ref = opt(args, "--needs", "")
        needs = []
        if ref:
            other = find_task(led, ref)
            if not other:
                # Refused rather than recorded. A reference to a task that does
                # not exist can never be satisfied, so the board would show this
                # one as blocked for ever by something nobody can finish.
                print("agent-bus: no task '%s' in this repository. `agentbus "
                      "status` lists them, and `--needs` only takes a task id — "
                      "if the agent you are waiting for has not said what they "
                      "are doing, ask them to:\n"
                      "  agentbus post --to <agent> \"take what you are on so I "
                      "can see when it lands\"" % ref, file=sys.stderr)
                sys.exit(1)
            needs = [other["id"]]
        # Running the same line twice is not two pieces of work. An agent that
        # re-reads its instructions and says the same thing again is the common
        # case, not a mistake worth an error.
        for t in led["tasks"]:
            if (t.get("state") == "open" and t.get("sid") == me.get("sid")
                    and (t.get("what") or "") == what[:200]):
                if needs and needs[0] not in (t.get("needs") or []):
                    t["needs"] = list(t.get("needs") or []) + needs
                    save_ledger(led)
                print("%s (already yours)" % t.get("id"))
                return
        tid = next_task_id(led)
        led["tasks"].append(task_record(me, tid, what[:200], needs))
        if not save_ledger(led):
            print("agent-bus: could not write the ledger", file=sys.stderr)
            sys.exit(1)
    tail = ""
    if needs:
        tail = " — needs %s first" % needs[0]
    emit(me.get("sid"), me.get("agent"), repo, "task",
         "took %s: %s%s" % (tid, what[:200], tail))
    print("%s%s" % (tid, tail))
    print("`agentbus done %s` when it lands." % tid)


def take_over(me, tid):
    """Pick up a task whose session has gone. Returns the line to print.

    Returns it rather than printing it because only the CLI verbs and the two
    hook emitters may write to stdout — one stray `print` in a helper corrupts a
    session's view of every hook result, and `tests/check_syntax.py` is what
    keeps that true by construction.

    The counterpart of showing an ownerless task rather than deleting it: the
    work is on a branch that still exists, and somebody has to be able to say
    they are carrying it on and then close it. Never off a session that is still
    live, for the reason `same_party` refuses to adopt an anonymous lock —
    nobody can prove the other agent has stopped, and a silent takeover is worse
    than a refusal that names who to ask."""
    repo = me.get("repo_key", "")
    sessions = load_sessions()
    with tasks_mutex(repo):
        led = load_ledger(repo)
        t = find_task(led, tid)
        if not t:
            print("agent-bus: no task '%s' in this repository. `agentbus status` "
                  "lists them." % tid, file=sys.stderr)
            sys.exit(1)
        if t.get("state") == "done":
            print("agent-bus: '%s' is finished (%s). `agentbus take \"...\"` for "
                  "new work." % (tid, t.get("what")), file=sys.stderr)
            sys.exit(1)
        holder = next((s for s in sessions if s["sid"] == t.get("sid")), None)
        if holder is not None and t.get("sid") != me.get("sid"):
            print("agent-bus: '%s' is %s's and they are still live. Ask them "
                  "before you carry it:\n"
                  "  agentbus post --to %s \"are you still on %s? I can take it\"\n"
                  "Nothing is taken off an agent that can still speak for itself."
                  % (tid, t.get("agent"), t.get("agent"), tid), file=sys.stderr)
            sys.exit(1)
        was = t.get("agent")
        t["from"] = was if was != me.get("agent") else t.get("from") or ""
        t.update(sid=me.get("sid"), agent=me.get("agent"),
                 agent_id=me.get("agent_id") or "",
                 branch=me.get("branch") or "", root=me.get("root") or "",
                 state="open")
        # From now, not from when the other agent started: what this reader wants
        # from the file list is what the task has produced since it changed hands.
        t["at"] = now()
        if not save_ledger(led):
            print("agent-bus: could not write the ledger", file=sys.stderr)
            sys.exit(1)
        what = t.get("what")
    emit(me.get("sid"), me.get("agent"), repo, "task",
         "picked up %s from %s: %s" % (tid, was, what))
    return "%s is yours — %s (was %s)" % (tid, what, was)


def cli_done(args):
    """Say it has landed. The other half of the one line, and the only other
    thing an agent is asked for.

    Cannot be derived, and it is worth being clear about why rather than
    inferring it badly: a session that has stopped writing files might be
    finished, might be thinking, and might be waiting for a review. The bus can
    see a file change; it cannot see an intention being satisfied."""
    me = acting(need_me(), args)
    pos = positional(args)
    repo = me.get("repo_key", "")
    with tasks_mutex(repo):
        led = load_ledger(repo)
        # By session, not by party. A lock is refused to a sibling because two
        # agents driving one device at once destroys something; closing a task
        # destroys nothing, and refusing a parent's `done` because its subagent
        # typed the `take` would be friction with no failure behind it. Who
        # actually closed it is recorded either way.
        mine = [t for t in led["tasks"]
                if t.get("state") == "open" and t.get("sid") == me.get("sid")]
        if pos:
            t = find_task(led, pos[0])
            if not t:
                print("agent-bus: no task '%s' in this repository. `agentbus "
                      "status` lists them." % pos[0], file=sys.stderr)
                sys.exit(1)
            if t.get("state") == "done":
                print("%s was already done." % t.get("id"))
                return
            if t.get("sid") != me.get("sid"):
                print("agent-bus: '%s' is %s's, not yours. `agentbus take %s` "
                      "picks it up if their session has gone, and then you can "
                      "finish it." % (pos[0], t.get("agent"), pos[0]),
                      file=sys.stderr)
                sys.exit(1)
        elif not mine:
            print("agent-bus: you have not taken anything in this repository. "
                  "`agentbus take \"<what you are doing>\"` first.",
                  file=sys.stderr)
            sys.exit(1)
        elif len(mine) > 1:
            print("agent-bus: you have %d open — say which:\n%s"
                  % (len(mine), "\n".join("  agentbus done %s   (%s)"
                                          % (t.get("id"), t.get("what"))
                                          for t in mine)), file=sys.stderr)
            sys.exit(1)
        else:
            t = mine[0]
        rel = [p for _ts, p in repo_writes(me, int(t.get("at", 0) or 0))]
        t["state"] = "done"
        t["done_at"] = now()
        t["note"] = opt(args, "--note", "")[:200]
        # Recorded now because it stops being answerable later: the write log is
        # deleted with the session, and "what did that task produce" is the
        # question somebody merging asks tomorrow.
        t["wrote"], t["wrote_n"] = rel[:BOARD_FILES], len(rel)
        if not save_ledger(led):
            print("agent-bus: could not write the ledger", file=sys.stderr)
            sys.exit(1)
        tid, what, note, wrote_n = t["id"], t.get("what"), t["note"], t["wrote_n"]
        # Everybody this unblocks, from their own declaration. They are named in
        # the one line rather than sent a second: the ledger is per repository, so
        # every waiter is already in the audience a plain post reaches.
        waiting = sorted({o.get("agent") or "?" for o in led["tasks"]
                          if o.get("state") == "open"
                          and tid in (o.get("needs") or [])})
    bits = []
    if wrote_n:
        bits.append("%d file%s" % (wrote_n, "" if wrote_n == 1 else "s"))
    if note:
        bits.append(note)
    if waiting:
        bits.append("%s can go on" % ", ".join(waiting))
    emit(me.get("sid"), me.get("agent"), repo, "task",
         "finished %s: %s%s" % (tid, what,
                                (" — " + "; ".join(bits)) if bits else ""))
    print("done %s%s" % (tid, (" — " + "; ".join(bits)) if bits else ""))


def cli_handoff(args):
    """Hand over deliberately, rather than waiting for the session to end.

    Worth running before a long compaction or when you are about to be
    interrupted: the automatic one at SessionEnd only fires if the session ends
    the way it is supposed to."""
    me = need_me()
    note = opt(args, "--note", "") or " ".join(positional(args))
    text = handoff_text(me, note)
    print(text)
    others = [s for s in load_sessions()
              if s["sid"] != me["sid"] and s.get("repo_key") == me.get("repo_key")]
    if not others:
        print("\n(nobody else is live in this repo, so this went nowhere)")
        return
    emit(me["sid"], me["agent"], me["repo_key"], "handoff", text)
    print("\nsent to %d session%s" % (len(others), "" if len(others) == 1 else "s"))


def cli_own(args):
    """Declare a part of the tree yours. The one thing here that is not a lock:
    it is not about a command that is running now, it is about where the other
    agents should not be working for the next while."""
    me = need_me()
    sessions = load_sessions()
    if flag(args, "--list"):
        shown = 0
        for s in sessions:
            summary = owns_summary(s["sid"], limit=20)
            if not summary or s.get("repo_key") != me.get("repo_key"):
                continue
            shown += 1
            print("%-18s %s%s" % (s.get("agent"), summary,
                                  "   (you)" if s["sid"] == me["sid"] else ""))
        if not shown:
            print("nobody in this repo has declared anything")
        return
    pos = positional(args)
    if not pos:
        print('usage: agentbus own "<glob>" [...] [--why "..."] [--strict]\n'
              "       agentbus own --list\n\n"
              "Quote the glob, or the shell expands it before agentbus sees it.",
              file=sys.stderr)
        sys.exit(1)
    why = opt(args, "--why", "")
    strict = flag(args, "--strict")
    decs = load_owns(me["sid"])
    added = []
    for raw in pos:
        glob = normalise_glob(raw, me.get("root"))
        if not glob:
            continue
        covers = ownership_covers(me, glob)
        if covers == "resource":
            # `own` takes a path; `claim` takes a resource. They look identical
            # on the command line and they are different namespaces, and getting
            # them the wrong way round produces the one thing this project
            # refuses to ship: a guard somebody believes they have set which
            # protects nothing. Reported from Windows on 2026-07-31, where a
            # session ran `agentbus own worktree`, was told it now owned
            # something, and announced to three other agents that the checkout
            # was safe. It was not, and `status` printed the declaration and
            # "Free: worktree" in the same breath.
            print("agent-bus: '%s' is a resource, not a path — `own` declares "
                  "part of the tree,\nand there is no `%s` in this repository. "
                  "You almost certainly want:\n  agentbus claim %s%s\n\n"
                  "If you did mean a path, give one that exists, or a glob: "
                  "`%s/**`."
                  % (glob, glob, glob, (' --why "%s"' % why) if why else "",
                     glob), file=sys.stderr)
            sys.exit(1)
        if covers == "nothing":
            # Not refused: a glob for a directory about to be created is a
            # legitimate way to claim ground before you break it. But it is said
            # out loud, because the silent version of this is indistinguishable
            # from a working declaration.
            print("agent-bus: note — nothing in this repository matches '%s' "
                  "right now, so it\nguards nothing yet." % glob,
                  file=sys.stderr)
        decs = [d for d in decs if d.get("glob") != glob]
        decs.append({"glob": glob, "why": why, "at": now(), "strict": strict})
        added.append(glob)
    if not added:
        print("nothing to own", file=sys.stderr)
        sys.exit(1)
    if not save_owns(me["sid"], decs):
        print("could not record that", file=sys.stderr)
        sys.exit(1)
    refresh_derived(sessions)   # the fast path filters on this; make it live now
    print("you now own:")
    for d in decs:
        print("  %-28s %s%s" % (d.get("glob"), d.get("why") or "",
                                "  [strict]" if d.get("strict") else ""))
    others = [s for s in sessions
              if s["sid"] != me["sid"] and s.get("repo_key") == me.get("repo_key")]
    if others:
        print("\nSessions in this checkout are now blocked from editing these; "
              "in another\nworktree they are warned instead%s."
              % (" — except --strict, which blocks there too" if strict else ""))
        emit(me["sid"], me["agent"], me["repo_key"], "note",
             "owns %s%s%s" % (", ".join(added), " [strict]" if strict else "",
                              (' — ' + why) if why else ""))
    else:
        print("\nNobody else is live in this repo, so nothing is blocked yet.")


def cli_disown(args):
    me = need_me()
    decs = load_owns(me["sid"])
    if not decs:
        print("you own nothing")
        return
    if flag(args, "--all"):
        dropped = [d.get("glob") for d in decs]
        keep = []
    else:
        pos = positional(args)
        if not pos:
            print('usage: agentbus disown "<glob>" | --all', file=sys.stderr)
            sys.exit(1)
        wanted = {normalise_glob(p, me.get("root")) for p in pos}
        dropped = [d.get("glob") for d in decs if d.get("glob") in wanted]
        keep = [d for d in decs if d.get("glob") not in wanted]
    if not dropped:
        print("not yours: %s" % ", ".join(positional(args)), file=sys.stderr)
        sys.exit(1)
    save_owns(me["sid"], keep)
    refresh_derived()
    print("released %s" % ", ".join(dropped))
    emit(me["sid"], me["agent"], me["repo_key"], "note",
         "no longer owns %s" % ", ".join(dropped))


CONFIG_README = (
    "Delete what you do not have and fix the ports and commands. "
    "patterns: regexes matched against each command's argv. "
    "port/cwd/start/ready: let agent-bus own the service, so it can "
    "say which checkout it is serving and move it to yours. "
    "implies: resources a command needs indirectly. "
    "scope 'worktree': contended only within one checkout. "
    "why/hint: shown verbatim when a command is blocked — this is "
    "where the knowledge that stops a workaround goes."
)

WORKTREE_RESOURCE = {
    "name": "worktree",
    "desc": "this checkout's working tree and git index",
    "why": "",
    "scope": "worktree",
    "patterns": [r"\bgit\s+(checkout|switch|stash|reset|rebase|add|commit)\b",
                 r"\b(npm|pnpm|yarn|bun)\s+(install|ci)\b"],
    "_from": "",   # not detected from anything: every repository has one
}

# The port a framework listens on when nobody told it otherwise. Only defaults
# that are actually defaults — a wrong guess here writes a config that silently
# guards nothing, which is worse than a resource the reader has to fill in.
FRAMEWORK_PORTS = (
    ("next", 3000), ("nuxt", 3000), ("nest", 3000), ("remix", 3000),
    ("react-scripts", 3000), ("vite", 5173), ("astro", 4321), ("expo", 8081),
)

DB_IMAGES = (("postgres", "psql"), ("postgis", "psql"), ("mysql", "mysql"),
             ("mariadb", "mysql"), ("redis", "redis-cli"), ("mongo", "mongosh"))


def lit(word):
    """A regex matching this literal word.

    Not `re.escape`: that escapes the hyphen in `redis-cli` and
    `react-scripts`, which is correct, unnecessary outside a character class,
    and unreadable in a file somebody is being asked to read and edit."""
    return re.sub(r"([.^$*+?()\[\]{}|\\])", r"\\\1", word or "")


# ------------------------------------------------------------- detection ----
#
# A stranger installs the plugin, opens two sessions, and nothing happens,
# because their repository has no config and the old `init-repo` wrote a generic
# template they had to fill in by hand. Most people conclude it is broken and
# stop. So the first run reads the repository instead of guessing, and what it
# writes has this project's real ports and real start commands in it.
#
# Everything here is best-effort and silent about what it cannot find. A draft
# with three of the four resources is useful; an exception during `init-repo` is
# not. The reader is told where every line came from so they can check it.

def read_text(path, limit=200000):
    try:
        with open(path, "r") as fh:
            return fh.read(limit)
    except (OSError, UnicodeDecodeError):
        return ""


def port_in(text):
    """The port a command line pins, or None."""
    for pat in (r"--port[=\s]+(\d{2,5})\b", r"\bPORT\s*=\s*(\d{2,5})\b",
                r"-p\s+(\d{2,5})\b", r"\blocalhost:(\d{2,5})\b",
                r"--inspect-port[=\s]+(\d{2,5})\b"):
        m = re.search(pat, text or "")
        if m:
            return int(m.group(1))
    return None


def package_manager(root):
    for lock, form in (("bun.lock", "bun run"), ("bun.lockb", "bun run"),
                       ("pnpm-lock.yaml", "pnpm run"), ("yarn.lock", "yarn"),
                       ("package-lock.json", "npm run")):
        if os.path.exists(os.path.join(root, lock)):
            return form
    return "npm run"


def unique_name(base, taken):
    if base not in taken:
        return base
    for n in range(2, 20):
        cand = "%s%d" % (base, n)
        if cand not in taken:
            return cand
    return base


def detect_node(root, taken):
    pkg = read_text(os.path.join(root, "package.json"))
    if not pkg:
        return []
    try:
        scripts = (json.loads(pkg) or {}).get("scripts") or {}
    except ValueError:
        return []
    runner = package_manager(root)
    out = []
    for key in ("dev", "start", "serve"):
        script = scripts.get(key)
        if not isinstance(script, str) or not script.strip():
            continue
        port = port_in(script)
        framework, framework_pattern = "", ""
        for name, default in FRAMEWORK_PORTS:
            m = re.search(r"\b%s\b(\s+([A-Za-z][\w-]*))?" % lit(name), script)
            if not m:
                continue
            framework = name
            port = port or default
            # `\bnext\b` on its own would claim the server for `git commit -m
            # next-release`. Pin the subcommand the script actually runs when
            # there is one, the way a hand-written config would.
            framework_pattern = (r"\b%s\s+%s\b" % (lit(name), lit(m.group(2)))
                                 if m.group(2) else r"\b%s\b" % lit(name))
            break
        name = unique_name("server", taken)
        taken.add(name)
        patterns = []
        if framework_pattern:
            patterns.append(framework_pattern)
        patterns.append(r"\b(npm|pnpm|yarn|bun)\s+(run\s+)?%s\b" % lit(key))
        if port:
            patterns.append(r":%d\b" % port)
        res = {"name": name, "desc": "the dev server%s" % (" on :%d" % port if port else ""),
               "why": "", "hint": "",
               "start": "%s %s" % (runner, key), "patterns": patterns,
               "_from": "package.json scripts.%s" % key}
        if port:
            res["port"] = port
        out.append(res)
        break   # one server per package.json; dev wins over start wins over serve
    return out


def detect_make(root, taken):
    body = read_text(os.path.join(root, "Makefile"))
    if not body:
        return []
    out = []
    lines = body.split("\n")
    for i, line in enumerate(lines):
        m = re.match(r"^([A-Za-z0-9_.-]+)\s*:(?!=)", line)
        if not m:
            continue
        target = m.group(1)
        if target not in ("dev", "dev-api", "dev-web", "serve", "start", "run"):
            continue
        recipe = []
        for nxt in lines[i + 1:]:
            if nxt.startswith("\t") or nxt.startswith("    "):
                recipe.append(nxt)
            elif nxt.strip():
                break
        port = port_in("\n".join(recipe))
        base = "server" if target in ("dev", "serve", "start", "run") else target
        name = unique_name(base, taken)
        taken.add(name)
        patterns = [r"\bmake\s+%s\b" % lit(target)]
        if port:
            patterns.append(r":%d\b" % port)
        res = {"name": name,
               "desc": "what `make %s` starts%s" % (target, " on :%d" % port if port else ""),
               "why": "", "hint": "", "start": "make %s" % target,
               "patterns": patterns, "_from": "Makefile target `%s`" % target}
        if port:
            res["port"] = port
        out.append(res)
    return out


def detect_procfile(root, taken):
    body = read_text(os.path.join(root, "Procfile"))
    if not body:
        return []
    out = []
    for line in body.split("\n"):
        m = re.match(r"^([A-Za-z0-9_-]+)\s*:\s*(\S.*)$", line.strip())
        if not m:
            continue
        proc, command = m.group(1), m.group(2)
        port = port_in(command)
        name = unique_name(proc, taken)
        taken.add(name)
        head = os.path.basename((command.split() or [""])[0])
        patterns = [r"\b%s\b" % lit(head)] if head else []
        if port:
            patterns.append(r":%d\b" % port)
        res = {"name": name, "desc": "the `%s` process" % proc, "why": "", "hint": "",
               "start": command, "patterns": patterns or [r"\b%s\b" % lit(proc)],
               "_from": "Procfile"}
        if port:
            res["port"] = port
        out.append(res)
    return out


def detect_python(root, taken):
    out = []
    manage = os.path.join(root, "manage.py")
    if os.path.exists(manage):
        has_settings = any(
            os.path.exists(os.path.join(root, d, "settings.py"))
            for d in ([""] + [e for e in os.listdir(root)
                              if os.path.isdir(os.path.join(root, e))][:60]))
        if has_settings:
            name = unique_name("server", taken)
            taken.add(name)
            out.append({"name": name, "desc": "the Django dev server on :8000",
                        "why": "", "hint": "", "port": 8000,
                        "start": "python manage.py runserver",
                        "patterns": [r"\bmanage\.py\s+runserver\b", r":8000\b"],
                        "_from": "manage.py next to a settings.py"})
    deps = (read_text(os.path.join(root, "pyproject.toml"))
            + read_text(os.path.join(root, "requirements.txt")))
    if re.search(r"\b(uvicorn|fastapi)\b", deps, re.I):
        name = unique_name("api", taken)
        taken.add(name)
        out.append({"name": name, "desc": "the ASGI app on :8000", "why": "", "hint": "",
                    "port": 8000, "patterns": [r"\buvicorn\b", r":8000\b"],
                    "_from": "uvicorn/fastapi in %s" % (
                        "pyproject.toml" if os.path.exists(
                            os.path.join(root, "pyproject.toml")) else "requirements.txt")})
    return out


def detect_db(root, taken):
    """A `db` resource, and deliberately without a `start`.

    agent-bus must never restart somebody's database: the point of the guard is
    that a reseed or a destructive migration invalidates the rows the other
    sessions are holding, and taking the service down to prove it would be the
    same damage by another route."""
    for name in ("docker-compose.yml", "docker-compose.yaml", "compose.yml",
                 "compose.yaml"):
        body = read_text(os.path.join(root, name))
        if not body:
            continue
        images = re.findall(r"^\s*image:\s*[\"']?([^\s\"']+)", body, re.M)
        found, clients = [], []
        for image in images:
            for key, client in DB_IMAGES:
                if key in image.lower():
                    found.append(image)
                    if client not in clients:
                        clients.append(client)
                    break
        if not found:
            continue
        res_name = unique_name("db", taken)
        taken.add(res_name)
        patterns = [r"\b%s\b" % lit(c) for c in clients]
        patterns += [r"\balembic\b", r"\bprisma\s+migrate\b", r"\bmake\s+seed\b"]
        return [{"name": res_name, "desc": "the shared development database",
                 "why": "", "hint": "", "patterns": patterns,
                 "_from": "%s (%s)" % (name, ", ".join(found[:3]))}]
    return []


def detect_e2e(root, taken, servers):
    import glob as globmod
    found = []
    for pattern, tool in (("playwright.config.*", "playwright"),
                          ("cypress.config.*", "cypress"),
                          ("wdio.conf.*", "wdio")):
        if globmod.glob(os.path.join(root, pattern)):
            found.append(tool)
    if os.path.isdir(os.path.join(root, "maestro")):
        found.append("maestro")
    if not found:
        return []
    name = unique_name("e2e", taken)
    taken.add(name)
    res = {"name": name, "desc": "the end-to-end runner and whatever it drives",
           "why": "", "hint": "",
           "patterns": [r"\b%s\b" % lit(t) for t in found],
           "_from": ", ".join("%s config" % t for t in found)}
    if servers:
        res["implies"] = list(servers)
    return [res]


def detect_resources(root):
    """Draft resource entries read from the repository's own files."""
    taken = set()
    out = []
    for finder in (detect_node, detect_make, detect_procfile, detect_python):
        try:
            out.extend(finder(root, taken))
        except Exception:
            pass   # a malformed file is not a reason for init-repo to fail
    try:
        out.extend(detect_db(root, taken))
    except Exception:
        pass
    servers = [r["name"] for r in out if r.get("port") or r.get("start")]
    try:
        out.extend(detect_e2e(root, taken, servers))
    except Exception:
        pass
    worktree = dict(WORKTREE_RESOURCE)
    worktree["name"] = unique_name("worktree", taken)
    out.append(worktree)
    return out


def detection_summary(resources):
    lines = ["agent-bus: looked at this repository and found", ""]
    for res in resources:
        port = ":%d" % res["port"] if res.get("port") else ""
        if res.get("start"):
            what = res["start"]
        elif res.get("implies"):
            what = "implies %s" % ", ".join(res["implies"])
        elif res["name"].startswith("worktree"):
            what = "this checkout's tree and index"
        else:
            what = "(no start command)"
        origin = res.get("_from", "")
        lines.append(("  %-10s %-7s %-30s %s" % (
            res["name"], port, what, "from " + origin if origin else "")).rstrip())
    return "\n".join(lines)


def cli_init_repo(args):
    ensure_dirs()
    root, repo_key, label, _ = git_facts(os.getcwd())
    local = flag(args, "--local")
    dry = flag(args, "--dry-run")
    if local:
        path = os.path.join(REPOS, "%s.json" % repo_key)
    else:
        path = os.path.join(root, ".claude", "agent-bus.json")
    if os.path.exists(path) and not flag(args, "--force") and not dry:
        print("already configured: %s\nPass --force to overwrite it." % path)
        return

    resources = detect_resources(root)
    print(detection_summary(resources))
    print()

    cfg = {"_readme": CONFIG_README, "label": label,
           "resources": [{k: v for k, v in r.items() if not k.startswith("_")}
                         for r in resources]}
    if local:
        cfg["repo_key"] = repo_key
    if dry:
        print("--dry-run: nothing was written. This is what it would be:\n")
        print(json.dumps(cfg, indent=2))
        return
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
    except OSError:
        pass
    if not write_json_pretty(path, cfg):
        print("could not write %s" % path, file=sys.stderr)
        sys.exit(1)
    refresh_derived()
    print("Wrote %s. Read it, fix anything wrong, then commit it so every\n"
          "worktree and machine gets the same guards. `why` and `hint` are "
          "empty — filling\nthem in is what stops an agent working around a "
          "block." % path)
    if local:
        print("\nThis one is machine-local and overrides the committed config by name.")


def cli_register(_args):
    """Attach the current shell's session to the bus without waiting for a restart."""
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not sid:
        print("no CLAUDE_CODE_SESSION_ID in the environment", file=sys.stderr)
        sys.exit(1)
    hook_session_start({"session_id": sid, "cwd": os.getcwd(), "session_title": "x"})
    print("registered %s" % sid)


def plugin_root():
    return os.path.dirname(os.path.dirname(os.path.realpath(__file__)))


def plugin_name():
    manifest = read_json(os.path.join(plugin_root(), ".claude-plugin",
                                      "plugin.json")) or {}
    return manifest.get("name") or "agent-bus"


def loaded_copies():
    """Every copy of this plugin Claude Code will actually load hooks from.

    A marketplace install leaves two directories and only one of them is read:

        ~/.claude/plugins/marketplaces/<mp>/            the clone it fetched
        ~/.claude/plugins/cache/<mp>/<plugin>/<ver>/    what is loaded

    `plugin_root` answers with whichever copy this file happens to be in, so an
    installer run out of the marketplace clone patched that clone and left the
    cache holding the repository's committed `hooks.json` — the POSIX variant,
    which on Windows means `bash → ab-hook → python3 shebang → a stub that is
    not Python`. Every hook died, no session registered, and both the installer
    and `doctor` reported success, because each was describing the copy it had
    just touched. Reported from Windows 10 on 2026-07-30, and again on the
    1.5.0 update, because the cache path carries the version and a bump creates
    a fresh unpatched directory.

    Older versions are kept rather than replaced, which is what lets a session
    that is already running survive an update — so every version found is
    returned, not just the newest."""
    cache = os.path.join(HOME, ".claude", "plugins", "cache")
    name = plugin_name()
    out = []
    for depth in ("*", "*/*", "*/*/*"):
        import glob as globmod
        for d in globmod.glob(os.path.join(cache, depth)):
            manifest = read_json(os.path.join(d, ".claude-plugin", "plugin.json"))
            if manifest and manifest.get("name") == name:
                out.append(os.path.realpath(d))
    here = os.path.realpath(plugin_root())
    return sorted(set(p for p in out if p != here))


def hooks_look_wrong(root):
    """Why a copy's wiring cannot work here, or "" when it looks fine."""
    path = os.path.join(root, "hooks", "hooks.json")
    try:
        with open(path) as fh:
            text = fh.read()
    except OSError:
        return "no hooks.json at all"
    if "__PYTHON__" in text:
        return "still has the __PYTHON__ placeholder — never installed"
    if IS_WIN and "ab-hook" in text:
        return ("wired to the shell fast path, which needs bash and a real "
                "python3 on PATH")
    return ""


def cli_install(args):
    """Wire this machine up. Both installer scripts are thin wrappers around this,
    so Windows and POSIX get the same decisions made by the same code."""
    import shutil
    import stat
    root = plugin_root()
    want = os.path.join(HOME, ".claude", "skills", "agent-bus")
    print("agent-bus installer\n")
    here = os.path.realpath(root)
    others = loaded_copies()
    if here == os.path.realpath(want):
        print("  + location: %s" % root)
    elif os.path.join(".claude", "plugins", "cache") in here:
        print("  + location: %s" % root)
        print("    the marketplace cache — this is the copy Claude Code loads")
    elif os.path.join(".claude", "plugins") in here:
        # The marketplace *clone*, which is the source and not what is loaded.
        # Saying "Claude Code loads it from here" was confidently wrong, and on
        # Windows it meant a successful-looking install where every hook died.
        print("  + location: %s" % root)
        print("    the marketplace clone — Claude Code loads the cache copy, "
              "not this one")
    else:
        print("  ! this clone is at %s" % root)
        print("  ! Claude Code loads it only from %s, or from a marketplace "
              "install — move or re-clone it there" % want)
    print("  + python: %s (%s)" % (sys.executable, sys.version.split()[0]))

    # Entry point. The shell fast path exits in ~5 ms using builtins only and
    # wakes this engine just for real work; it needs bash and a `python3` on
    # PATH because it execs the engine through its shebang. Everywhere else,
    # call Python directly: one interpreter start per hook, but no dependency on
    # a shell, a path separator, or quoting rules.
    use_bash = (not IS_WIN and shutil.which("bash") and shutil.which("python3")
                and not flag(args, "--python-hooks"))
    src = "hooks.posix.json" if use_bash else "hooks.python.json"
    try:
        with open(os.path.join(root, "hooks", src)) as fh:
            text = fh.read()
        if not use_bash:
            text = text.replace("__PYTHON__", json.dumps(sys.executable)[1:-1])
        with open(os.path.join(root, "hooks", "hooks.json"), "w") as fh:
            fh.write(text)
    except OSError as exc:
        print("  ! could not write hooks/hooks.json: %s" % exc)
        return
    print("  + hooks: %s" % ("shell fast path (~5 ms per hook)" if use_bash
                             else "python fallback (no shell needed)"))

    # And every other copy Claude Code might load, which is the whole point:
    # patching only the directory this file sits in is how an install succeeds
    # while the hooks that actually run are the committed POSIX ones.
    for other in others:
        try:
            with open(os.path.join(other, "hooks", "hooks.json"), "w") as fh:
                fh.write(text)
            print("  + also wired: %s" % short_path(other))
        except OSError as exc:
            print("  ! could not wire %s: %s" % (short_path(other), exc))

    for name in ("bin/agentbus", "bin/ab-hook", "install.sh"):
        p = os.path.join(root, name)
        try:
            os.chmod(p, os.stat(p).st_mode | stat.S_IXUSR | stat.S_IXGRP)
        except OSError:
            pass

    bindir = os.path.join(HOME, ".local", "bin")
    try:
        os.makedirs(bindir, exist_ok=True)
        engine = os.path.join(root, "bin", "agentbus")
        if IS_WIN:
            with open(os.path.join(bindir, "agentbus.cmd"), "w") as fh:
                fh.write('@echo off\r\n"%s" "%s" %%*\r\n' % (sys.executable, engine))
            with open(os.path.join(bindir, "agentbus"), "w") as fh:  # Git Bash
                fh.write('#!/bin/sh\nexec "%s" "%s" "$@"\n'
                         % (sys.executable.replace("\\", "/"), engine.replace("\\", "/")))
        else:
            link = os.path.join(bindir, "agentbus")
            if os.path.islink(link) or os.path.exists(link):
                os.unlink(link)
            os.symlink(engine, link)
        on_path = any(os.path.normcase(os.path.normpath(p)) ==
                      os.path.normcase(os.path.normpath(bindir))
                      for p in os.environ.get("PATH", "").split(os.pathsep))
        print("  %s command: %s%s" % ("+" if on_path else "!", bindir,
                                      "" if on_path else "  (NOT on PATH — add it)"))
    except OSError as exc:
        print("  ! could not create the agentbus command: %s" % exc)

    settings = os.path.join(HOME, ".claude", "settings.json")
    try:
        cfg = read_json(settings)
        if cfg is None and os.path.exists(settings):
            print('  ! ~/.claude/settings.json is not valid JSON — add '
                  '"Bash(agentbus:*)" to permissions.allow yourself')
        else:
            cfg = cfg or {}
            perms = cfg.get("permissions")
            if not isinstance(perms, dict):
                perms = {}
                cfg["permissions"] = perms
            allow = perms.get("allow")
            if not isinstance(allow, list):
                allow = []
                perms["allow"] = allow
            if "Bash(agentbus:*)" in allow:
                print("  + permission: already allowlisted")
            else:
                allow.append("Bash(agentbus:*)")
                os.makedirs(os.path.dirname(settings), exist_ok=True)
                # Atomic: this is the user's global settings file, and a crash
                # between truncate and flush would leave it empty.
                if write_json_pretty(settings, cfg):
                    print("  + permission: Bash(agentbus:*) allowlisted")
                else:
                    print('  ! could not write settings.json — add '
                          '"Bash(agentbus:*)" to permissions.allow yourself')
    except Exception as exc:
        print("  ! could not update settings.json (%s) — add "
              '"Bash(agentbus:*)" to permissions.allow yourself' % exc)

    print()
    cli_doctor([])
    print("\nRestart Claude Code (or /reload-plugins, then `agentbus register`).")
    print("In a repo with shared services: agentbus init-repo")


def cli_forget(args):
    """Drop session records by hand — the broom for anything the automatic
    reaping cannot reach."""
    pos = positional(args)
    gone = []
    for s in load_sessions():
        if flag(args, "--stale"):
            if now() - s.get("beat", 0) > IDLE_SECS * 3:
                gone.append(s)
        elif pos and (s.get("agent") == pos[0] or s["sid"] == pos[0]):
            gone.append(s)
    if not pos and not flag(args, "--stale"):
        print("usage: agentbus forget <agent|session-id> | --stale", file=sys.stderr)
        sys.exit(1)
    for s in gone:
        forget_session(s["sid"])
    refresh_derived()
    print("forgot %d: %s" % (len(gone), ", ".join(s.get("agent", "?") for s in gone)))


def cli_doctor(_args):
    ensure_dirs()
    sessions = load_sessions(reap=True)
    refresh_derived(sessions)
    print("bus dir      : %s" % BUS)
    print("live sessions: %d" % len(sessions))
    print("events       : %d" % read_int(SEQFILE, 0))
    print("guard tokens : %s" % (open(TOKENFILE).read().strip()[:200]
                                 if os.path.exists(TOKENFILE) else "-"))
    _, me = resolve_party()     # read-only: the name this caller answers to
    print("this session : %s" % (me.get("agent") if me else "NOT REGISTERED"))
    root, repo_key, label, _ = git_facts(os.getcwd())
    shared = os.path.join(root, ".claude", "agent-bus.json")
    local = os.path.join(REPOS, "%s.json" % repo_key)
    cfg = repo_config(repo_key, root)
    print("repo         : %s (%s)" % (label, repo_key))
    print("  in repo    : %s" % (shared if os.path.exists(shared) else "-"))
    print("  local      : %s" % (local if os.path.exists(local) else "-"))
    resources = cfg.get("resources", [])
    if not resources:
        print("  resources  : none — `agentbus init-repo` to declare some")
    for res in resources:
        stamp = os.path.join(MATCHED, re.sub(r"[^A-Za-z0-9_.-]", "_",
                                             "%s__%s" % (repo_key, res["name"])))
        try:
            bits = ["last matched %s" % ago(int(os.path.getmtime(stamp)))]
        except OSError:
            bits = ["NEVER matched — a moved port or renamed script fails silently"]
        if res.get("port"):
            root, how = serving(repo_key, res)
            bits.append("serving %s (%s)" % (short_path(root or "-"), how))
        missing = [p for p in res.get("patterns", []) if not literal_runs(p)]
        if missing:
            bits.append("%d pattern(s) with no literal to pre-filter on" % len(missing))
        print("  %-12s %s" % (res["name"], "; ".join(bits)))
    root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    hooks = os.path.join(root, "hooks", "hooks.json")
    print("hooks        : %s" % (hooks if os.path.exists(hooks)
                                 else "MISSING — run the installer"))
    # The copy this is running from is not necessarily the copy Claude Code
    # loads. Reporting only the one just patched is how a Windows install looked
    # healthy while every hook was dying — see loaded_copies.
    for other in loaded_copies():
        why = hooks_look_wrong(other)
        print("  %s %s%s" % ("!" if why else "+", short_path(other),
                             ("  — %s" % why) if why else "  (wired)"))
        if why:
            print("      Claude Code loads this one. Re-run: %s install"
                  % os.path.join(other, "bin", "agentbus"))
    # Every block message this plugin writes tells the agent to run `agentbus
    # <something>`. If that command does not resolve, the agent is handed advice
    # it cannot act on, so this is worth a line of its own.
    import shutil
    found = shutil.which("agentbus")
    print("command      : %s" % (found or "NOT on PATH — run `%s install`"
                                 % os.path.realpath(__file__)))


COMMANDS = {
    "status": cli_status, "whois": cli_whois, "claim": cli_claim,
    "release": cli_release, "wait": cli_wait, "post": cli_post,
    "note": cli_post, "inbox": cli_inbox, "run": cli_run, "name": cli_name,
    "own": cli_own, "disown": cli_disown, "handoff": cli_handoff,
    "watch": cli_watch, "board": cli_board, "here": cli_here,
    "port": cli_port, "env": cli_env,
    "doing": cli_doing, "take": cli_take, "done": cli_done,
    "init-repo": cli_init_repo, "doctor": cli_doctor,
    "register": cli_register, "install": cli_install, "serve": cli_serve,
    "serves": cli_serves, "forget": cli_forget,
}

HOOKS = {
    "session-start": hook_session_start, "prompt-submit": hook_prompt_submit,
    "subagent-start": hook_subagent_start, "subagent-stop": hook_subagent_stop,
    "pre-tool": hook_pre_tool, "post-batch": hook_post_batch,
    "session-end": hook_session_end, "record-write": hook_record_write,
    "post-bash": hook_post_bash,
}

USAGE = """agentbus — coordination between parallel Claude Code sessions

  status                       who is live, what is held, what serves whom
  post [--to <agent>] [--as <you>] "..."   leave a message for the others
  inbox                        everything addressed to this repo / to you
  watch [--repo] [-n 20]       follow every agent on this machine, live
  board [--port 8787]          the same thing as a page, in your browser
  here [<path>] [--as <you>]   record which worktree you are working in
  port <res>                   the port this checkout should use
  env [--json]                 every declared port, as shell exports
  run <res>[,<res>] -- <cmd>   point the services at your tree, hold, run, release
  serve <res>                  restart a service so it serves YOUR worktree
  serves                       which checkout each service is answering for
  own "<glob>" [--why ".."] [--strict]   declare part of the tree yours
  own --list | disown "<glob>" | disown --all
  claim <res> [--why ".."] [--steal] [--as <you>]
  wait <res> [--timeout 90]    queue for a held resource
  release <res> | --all
  take "<what>" [--needs <task>]   say what you have started
  take <task>                  pick up work whose session has gone
  done [<task>] [--note ".."]  say it has landed
  handoff [--note "..."]       summarise what you did, for the others
  doing "..."                  one line others see in their roster
  name [<new>]                 read or set this session's name
  init-repo                    declare this repo's shared resources
  install | doctor | whois | register | forget <agent|--stale>
"""


def run_hook(event, raw):
    """Dispatch one hook from the text of its payload.

    Split out from `main` so the Python fast path can decide whether an event is
    worth waking this module for, having already read stdin — it must not be
    read twice, and the gate has to see it to decide."""
    if event not in HOOKS:
        return
    try:
        payload = json.loads((raw or b"").decode("utf-8-sig", "replace") or "{}")
    except ValueError as exc:
        sys.stderr.write("agent-bus: could not read the %s payload (%s) — "
                         "the guard was skipped for this call\n" % (event, exc))
        return
    HOOKS[event](payload)


def read_payload():
    """The hook payload, from bytes, as UTF-8 whatever the console thinks.

    `sys.stdin.read()` decodes with whatever encoding Python picked, which off
    Windows is UTF-8 and on Windows is the locale codepage unless something in
    the environment says otherwise. Two ways that fails, both measured on a
    Turkish Windows 10 host with `cp1254`:

      - a UTF-8 BOM — which PowerShell prepends when piping to a native
        executable — makes `json.loads` raise on the very first character;
      - a payload naming a file with non-ASCII in it either decodes to mojibake,
        so a glob or pattern whose matched part is not ASCII misses silently, or
        hits a byte undefined in the codepage and raises `UnicodeDecodeError`.

    `utf-8-sig` strips the BOM if one is there and is plain UTF-8 otherwise, and
    reading `buffer` skips the locale guess entirely."""
    raw = sys.stdin.buffer.read()
    return json.loads(raw.decode("utf-8-sig", "replace") or "{}")


def main():
    # Windows consoles are not UTF-8 by default, so every message this prints
    # with an em-dash in it arrives as mojibake — which is enough to make agents
    # on a Turkish machine start transliterating what they say to each other so
    # it stays readable.
    for stream in (sys.stdout, sys.stderr):
        if hasattr(stream, "reconfigure"):
            try:
                stream.reconfigure(encoding="utf-8")
            except (OSError, ValueError):
                pass
    ensure_dirs()
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return
    if argv[0] == "hook":
        if len(argv) < 2 or argv[1] not in HOOKS:
            return
        try:
            payload = read_payload()
        except ValueError as exc:
            # Never silently. A hook that returns nothing is byte-identical to
            # one that considered the call and allowed it, so a guard that fails
            # open has to say it did — on stderr, which never reaches the
            # session's parser. Three separate debugging sessions on Windows
            # were spent concluding the ownership guard was broken when the
            # payload had simply not parsed.
            sys.stderr.write("agent-bus: could not read the %s payload (%s) — "
                             "the guard was skipped for this call\n"
                             % (argv[1], exc))
            return
        HOOKS[argv[1]](payload)
        return
    fn = COMMANDS.get(argv[0])
    if not fn:
        print(USAGE)
        sys.exit(1)
    fn(argv[1:])


if __name__ == "__main__":
    try:
        main()
    except SystemExit:
        raise
    except Exception:
        # A coordination layer must never be the reason a session breaks.
        if os.environ.get("AGENTBUS_DEBUG"):
            import traceback
            traceback.print_exc(file=sys.stderr)
        sys.exit(0)
