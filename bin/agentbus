#!/usr/bin/env python3
"""
agent-bus — coordination for parallel Claude Code sessions on one machine.

WHY THIS EXISTS. Several Claude Code sessions can work the same repository at
once, each in its own git worktree. Their file edits do not collide — separate
checkouts. What they cannot have separately is anything that lives behind a
single port or a single database on this machine: a dev server, a bundler, a
simulator, one Postgres. The failure is silent in the worst possible way: the
port hides which checkout is answering, so an agent runs a test, gets a green
result, and believes it — while it was exercising another worktree's code.

Documentation cannot fix that, because the agent has to remember to read it.
This does, because the decision is made in a PreToolUse hook: the command simply
does not run, and the agent is told who holds the resource and how to get it.

Three jobs:

  presence   every session registers itself, so each new one opens knowing who
             else is live, where, and on what branch
  locks      commands that touch a shared resource take it automatically; if
             someone else holds it the command is denied with a real reason
  messages   an append-only stream, delivered into the other agents' context at
             their next turn — no polling, no file they have to remember to read

Two questions run underneath all three, and each is answered in exactly one
place — because for a long time neither was, and half of this plugin's defects
came out of the disagreements:

  resolve_party  who is acting and where they are working, as a precedence
                 order written down in one function instead of inferred by
                 thirteen
  plan_for       what a Bash command touches, under what names it is locked,
                 what is about to happen to it, and what the reader can run
                 instead. The block message is rendered from that answer
                 rather than written out beside it, so advice the guard would
                 refuse is not something a message knows how to print

`tests/check_syntax.py` fails if either spreads out again.

State lives in ~/.claude/agent-bus (see LAYOUT below), never in this directory,
so updating the plugin never loses it.
"""

import errno
import json
import os
import re
import sys
import time

# hashlib, shlex, shutil, stat and subprocess are imported where they are used.
# Every hook on every tool call pays for this module's import list, and those
# five cost more than the rest of the interpreter start put together — on the
# Windows entry point, where hooks call Python directly, that is the whole bill.

# ---------------------------------------------------------------- layout ----
#
# LAYOUT
#   sessions/<sid>.json   one live session: agent name, worktree, branch, pid
#   sessions/<sid>.beat   empty; its mtime is the session's last sign of life
#   cursors/<sid>         highest event id this session has been shown
#   hot-for/<sid>         paths other live sessions wrote lately (fast-path filter)
#   writes/<sid>.log      "<epoch> <abs path>" per write, for collision checks
#   locks/<key>.json      one held resource
#   repos/<repo>.json     which resources exist in a repo and what claims them
#   events.jsonl          append-only stream, the thing agents actually read
#   events.seq            id of the last event; the fast path compares to cursors
#   live-count            number of live sessions; 1 means the bus is free
#   guard-tokens          ERE of literals worth waking the engine for

IS_WIN = sys.platform.startswith("win")
HOME = os.path.expanduser("~")
# `or`, not a default: `os.environ.get` returns the empty string for a variable
# that is set and empty, and `os.path.join("", "sessions")` is a RELATIVE path —
# so `AGENTBUS_HOME=` put the entire bus in whatever directory the caller
# happened to be standing in. Every part of it: session records, locks, and the
# two derived files the fast path reads. Nothing errored. Presence and the guards
# simply stopped working, because no other process could find any of it, and a
# `live-count` and a `guard-tokens` appeared in somebody's repository to be
# committed. Easy to reach from a script — `AGENTBUS_HOME="$SOME_UNSET_VAR"` is
# one typo — and it fails silently, which is the shape this plugin exists to
# refuse.
BUS = os.environ.get("AGENTBUS_HOME") or os.path.join(HOME, ".claude", "agent-bus")
SESSIONS = os.path.join(BUS, "sessions")
CURSORS = os.path.join(BUS, "cursors")
HOTFOR = os.path.join(BUS, "hot-for")
WRITES = os.path.join(BUS, "writes")
LOCKS = os.path.join(BUS, "locks")
AUTOCLAIM = os.path.join(BUS, "autoclaim")
OWNS = os.path.join(BUS, "owns")
AGENTS = os.path.join(BUS, "agents")
HINTS = os.path.join(BUS, "hints")
SERVES = os.path.join(BUS, "serves")
MATCHED = os.path.join(BUS, "matched")
DECLARED = os.path.join(BUS, "declared")
# What each party last actually did, one line per party and overwritten. Written
# by the shell fast path, never by the engine, and never appended to: see
# `last_action`.
ACTED = os.path.join(BUS, "acted")
REPOS = os.path.join(BUS, "repos")
EVENTS = os.path.join(BUS, "events.jsonl")
SEQFILE = os.path.join(BUS, "events.seq")
LIVEFILE = os.path.join(BUS, "live-count")
TOKENFILE = os.path.join(BUS, "guard-tokens")
PORTS = os.path.join(BUS, "ports.json")
# Which party has already been told about which port, so that a run of the same
# bypass costs its readers one message. One file rather than a directory: it is
# read and rewritten whole under a mutex on a path nothing takes twice a second,
# and a new directory would have to be threaded through `ensure_dirs`, whose "the
# one created LAST" contract is easy to break from here for no gain.
ASTRAY = os.path.join(BUS, "astray.json")

STALE_BEAT = 45 * 60      # no heartbeat this long and no pid: the session is gone
ABANDONED_BEAT = 3 * 3600  # this long without a heartbeat retires it either way
IDLE_SECS = 5 * 60        # holder quiet this long: a soft lock may be taken
SOFT_TTL = 15 * 60        # auto-taken lock, measured from last use
HARD_TTL = 45 * 60        # explicitly claimed lock
COLLIDE_WINDOW = 15 * 60  # two sessions editing one file inside this window collide
MAX_DELIVER = 12          # events shown at once; the rest are summarised
ROTATE_AT = 5000          # events.jsonl lines before trimming
# How long one wrong-port announcement stands for, and — the same number, doing
# the same job from the other end — how quiet a party has to go before the next
# one counts as new rather than as more of the same. Measured: 28 bypasses of one
# port in 24 hours would be 28 identical sentences in everybody's context at one
# per bypass, and four at one per six hours, each of the last three carrying how
# many it is standing for. See `astray_again`.
ASTRAY_AGAIN = 6 * 3600
# Which revision of `git_facts` produced a record's repo_key. Bumped when the
# derivation changes its answer for the same directory, which is the signal
# `heal_derived` needs to re-derive a key written by a version that got it wrong.
# 2: before this, a relative `--git-common-dir` was resolved against the root
# instead of the cwd, so any session working below its repository root was keyed
# and labelled from a directory above the repository.
KEY_REV = 2
# A finished task stays on the board for long enough to be seen landing, and in
# the ledger for long enough that somebody arriving tomorrow can still find out
# what happened to a branch. Both far outlive any lock TTL on purpose: a lock is
# about a resource that frees itself, a task is about work that does not.
TASK_SHOW = 30 * 60
TASK_TTL = 24 * 3600
# How long what a chat SAID about itself outlives the record a reap deleted.
# Deliberately far longer than either of those: a lock is about a resource that
# frees itself, a task about work that lands, and this is about a chat somebody
# may open again after the weekend. It exists only so that a machine which has
# run a thousand chats does not keep a file for every one of them — the ordinary
# case leaves nothing behind at all, because `register` deletes what it used.
DECLARED_TTL = 14 * 24 * 3600

# Deliberately shorter than COLLIDE_WINDOW: a collision is about two sessions
# working the same file at all, while this is about a failure happening RIGHT
# NOW because somebody is mid-edit. Blaming an edit from ten minutes ago for a
# build that just broke is a guess, and a wrong guess here is worse than silence.
INTERFERENCE_WINDOW = 5 * 60
MAX_INTERFERENCE_FILES = 3

# What a failed command looks like from the outside: the shapes compilers, test
# runners and interpreters use.
#
# `errors?\b` is anchored only at the end, deliberately. Anchoring the front as
# well reads better and is wrong: Python names its failures ImportError,
# SyntaxError, TypeError, ValueError, and a leading `\b` misses every one of
# them. The cost of the loose end is that "0 errors" also matches — which does
# not matter here, because a note still requires the output to name a file
# another live session wrote in the last five minutes.
FAILURE_SIGNAL = re.compile(
    r"errors?\b"             # error, ERROR, ImportError, error TS2304, error[E0432]
    r"|\bfailed\b|\bfail:"    # FAILED, FAIL:
    r"|\btraceback\b|\bexception\b"
    r"|\bcannot find\b|\bundefined reference\b|\bpanic:"
    r"|✗|✘",
    re.I)

# Command heads that cannot start a service or reach a port, so a guarded token
# appearing after one of them is a mention, not a use: `grep -r uvicorn api/`.
READONLY_HEADS = {
    "grep", "rg", "cat", "bat", "ls", "ll", "head", "tail", "find", "fd", "tree",
    "echo", "printf", "jq", "yq", "wc", "sed", "awk", "cut", "sort", "uniq",
    "less", "more", "file", "stat", "which", "type", "man", "diff",
    "pwd", "date", "true", "false", "test", "basename", "dirname", "realpath",
    "code", "open", "agentbus",
    # Asking what is running is not running it. `ps ax | grep "[a]lembic"` was
    # matching the database and being stepped over with AGENTBUS_OFF; looking
    # for a process is how an agent works out whether it needs the thing at all.
    # `kill` and `pkill` are deliberately NOT here: killing the process that
    # serves a resource is the most decisive way there is of touching it.
    "ps", "pgrep", "lsof",
}

# `git` is not read-only as a whole: checkout, switch, stash, reset, rebase,
# merge, add and commit all rewrite the working tree or the index, which is how
# two sessions in one checkout actually destroy each other's work.
GIT_READONLY_SUBCOMMANDS = {
    "status", "log", "diff", "show", "rev-parse", "branch", "ls-files", "blame",
    "describe", "remote", "config", "grep", "shortlog", "reflog", "tag",
    "worktree", "fetch", "cat-file", "for-each-ref", "check-ignore",
}

# Heads that reach a guard by a route `command_targets` does not, so being
# read-only to the pattern matcher does not make them uninteresting.
#
# `agentbus` is read-only — it reads and writes the bus, never the repository —
# and `command_targets` duly skips it. But an `agentbus` line names its resource
# outright, which `explicit_resources` reads and `plan_for` acts on, and it
# leaves the party hint that the CLI process a few milliseconds later has no
# other way of obtaining (`leave_party_hint`). Both happen for a command whose
# targets are empty. So the two fast paths must go on waking the engine for it.
GUARD_REACHING_HEADS = {"agentbus"}

# What a fast path may answer for by itself, without starting this module.
#
# A command made only of these yields no targets, so `resources_for` matches
# nothing, `wrong_port_check` sees no port, `explicit_resources` names nothing
# and `leave_party_hint` has nothing to record — the engine starts, finds
# nothing, and returns. Measured on a Windows work machine: 478 ms to start it
# against 132 ms for the Python fast path deciding not to, and on that machine's
# real command mix 11 of 18 commands were exactly this shape.
#
# `bin/ab-hook` and `bin/hook.py` carry this same list, because a fast path
# cannot import this module without paying the cost it exists to avoid.
# `tests/test_matcher.py` fails if any of the three drifts, and asserts the
# direction that matters: whatever a fast path skips, the engine finds nothing
# in. A head that is here and not in `READONLY_HEADS` is a command class nothing
# guards, and it fails silently — it looks exactly like a resource nobody is
# contending for.
FASTPATH_SKIP_HEADS = READONLY_HEADS - GUARD_REACHING_HEADS

# Wrappers to strip before deciding what a segment really runs.
WRAPPERS = {"sudo", "time", "nohup", "exec", "command", "env", "caffeinate"}

# Heads whose `-c` argument is a command rather than text.
SHELL_HEADS = {"bash", "sh", "zsh", "dash", "ksh", "fish"}


# ------------------------------------------------------------- utilities ----

def now():
    return int(time.time())


def ensure_dirs():
    """Create the state directories, but only look once when they are there.

    `makedirs(exist_ok=True)` still costs a filesystem call each time, and this
    runs on every single invocation. On macOS that is 74 microseconds for all
    thirteen; on a Windows host with endpoint scanning it was measured at 12
    milliseconds, because every one of them is a syscall an agent inspects. One
    `isdir` answers the same question 79 times more cheaply.

    The one checked is the one created LAST, and a directory added later has to
    become both — an existing bus already has `matched/`, so leaving the check
    where it was would mean the new directory was never created on any machine
    this plugin was already installed on."""
    if os.path.isdir(ACTED):
        return            # the last one created: if it exists, they all do
    for d in (BUS, SESSIONS, CURSORS, HOTFOR, WRITES, LOCKS, REPOS, AUTOCLAIM,
              OWNS, AGENTS, HINTS, SERVES, MATCHED, DECLARED, ACTED):
        try:
            os.makedirs(d, exist_ok=True)
        except OSError:
            pass


# Every file this plugin owns is UTF-8, on every platform, said out loud.
#
# Python opens a text file in `locale.getpreferredencoding()` when you do not
# tell it otherwise. So on a Turkish Windows the bus wrote `events.jsonl` as
# UTF-8 — that one had an explicit `.encode("utf-8")` — and read it back as
# cp1254: every em dash agent-bus prints in its own event text came back as
# `â€”`. The console was not the cause and had already been ruled out; it was
# the read. Reported from Windows 10 in Turkish on 2026-08-12.
#
# Cosmetic in the board. Not cosmetic in `rotate_events`, which reads the file
# and writes it back: at ROTATE_AT it persists the mangling into the file, and
# one character outside the codepage raises inside the rotation instead — the
# one place a decode error takes the whole event log with it. Same shape in the
# write log, which stores paths, and a path can hold anything a filesystem does.
#
# `errors="replace"` on the reads is deliberate and is not belt-and-braces: a
# file some earlier version already mangled has to stay parseable, or the
# rotation that would finally clear it can never run.
#
# And every read is `utf-8-sig` while every write is plain `utf-8`, which is the
# one asymmetry here worth stating out loud. On reading, `utf-8-sig` strips a
# byte-order mark if there is one and is ordinary UTF-8 if there is not, so it
# is a superset and never the wrong choice; on writing it would *add* a BOM to
# every file this plugin owns, which is why the writes must not use it. Windows
# is where this matters: PowerShell and Notepad both put a BOM on what they
# write, so any JSON a person has touched there has one. `~/.claude/settings.json`
# is exactly that file, and the installer read it, failed, and told the user
# their settings were not valid JSON when they were. Measured on Windows 10 on
# 2026-08-12 — and a repository's own `.claude/agent-bus.json` is the same file
# in the same position, where the cost is not a wrong message but every guard in
# that repository quietly not existing. `read_payload` has taken the BOM
# seriously since 2.3.0 for the same reason; the state files had not.

def read_json(path, default=None):
    try:
        with open(path, "r", encoding="utf-8-sig", errors="replace") as fh:
            return json.load(fh)
    except Exception:
        return default


def write_json(path, obj):
    tmp = "%s.tmp.%d" % (path, os.getpid())
    try:
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(obj, fh)
        os.replace(tmp, path)
        return True
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return False


def write_json_pretty(path, obj):
    """For files a human reads and edits — atomically, like everything else.

    Keeps a byte-order mark if the file being replaced had one. These are the
    files that belong to somebody else: `~/.claude/settings.json` is Claude
    Code's and `.claude/agent-bus.json` is the project's, and on Windows the
    editor that made them puts a BOM on. Adding a line to a file is not licence
    to change how it is encoded — and Windows PowerShell 5.1 reads a file with
    no BOM as ANSI, so dropping one is not free either."""
    enc = "utf-8"
    try:
        with open(path, "rb") as fh:
            if fh.read(3) == b"\xef\xbb\xbf":
                enc = "utf-8-sig"
    except OSError:
        pass
    tmp = "%s.tmp.%d" % (path, os.getpid())
    try:
        with open(tmp, "w", encoding=enc) as fh:
            json.dump(obj, fh, indent=2)
            fh.write("\n")
        os.replace(tmp, path)
        return True
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return False


def read_int(path, default=0):
    try:
        with open(path, "r", encoding="utf-8-sig", errors="replace") as fh:
            return int(fh.read().strip() or default)
    except Exception:
        return default


def write_text(path, text):
    tmp = "%s.tmp.%d" % (path, os.getpid())
    try:
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write(text)
        os.replace(tmp, path)
        return True
    except Exception:
        # On Windows os.replace onto a file another process has open raises. A
        # cursor that silently fails to advance would replay the same messages
        # every turn, so callers that care are told.
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return False


class Mutex:
    """Atomic across processes: mkdir either creates the directory or fails."""

    def __init__(self, name, timeout=5.0):
        self.path = os.path.join(BUS, ".%s.mutex" % name)
        self.timeout = timeout
        self.held = False

    def __enter__(self):
        deadline = time.time() + self.timeout
        while True:
            try:
                os.mkdir(self.path)
                self.held = True
                write_text(os.path.join(self.path, "owner"), "%d\n" % os.getpid())
                return self
            except OSError as exc:
                if exc.errno != errno.EEXIST:
                    return self
                # Break it only when the process that took it is gone. Breaking
                # on age alone lets a slow holder be robbed mid-section, and then
                # its __exit__ removes somebody else's mutex.
                owner = read_int(os.path.join(self.path, "owner"), 0)
                try:
                    stale = time.time() - os.path.getmtime(self.path) > 60
                    if (owner and not pid_alive(owner)) or (not owner and stale):
                        os.rmdir(self.path)
                        continue
                except OSError:
                    pass
                if time.time() > deadline:
                    return self
                time.sleep(0.02)

    def __exit__(self, *_):
        if self.held:
            try:
                os.unlink(os.path.join(self.path, "owner"))
            except OSError:
                pass
            try:
                os.rmdir(self.path)
            except OSError:
                pass
        return False


def ago(ts):
    if not ts:
        return "?"
    d = max(0, now() - int(ts))
    if d < 60:
        return "just now"
    if d < 3600:
        return "%dm ago" % (d // 60)
    if d < 86400:
        return "%dh%02dm ago" % (d // 3600, (d % 3600) // 60)
    return "%dd ago" % (d // 86400)


def held_for(ts):
    d = max(0, now() - int(ts or 0))
    if d < 60:
        return "%ds" % d
    if d < 3600:
        return "%dm" % (d // 60)
    return "%dh%02dm" % (d // 3600, (d % 3600) // 60)


# ------------------------------------------------------------------ repo ----

def git_facts(cwd):
    """(worktree root, repo key, label, branch) — the repo key is shared by all
    worktrees of one repository, because it is derived from the common git dir."""
    import hashlib
    import subprocess
    try:
        # `encoding=` and not bare `text=True`, here and at every other git call:
        # git writes paths and refs as UTF-8, while `text=True` alone decodes in
        # the locale codepage. On a Turkish Windows that turns a checkout under a
        # path with one diacritic in it into a *different* toplevel string —
        # which is the repository key, so the session registers against a repo
        # nobody else is in and every guard silently stops matching.
        out = subprocess.run(
            ["git", "rev-parse", "--git-common-dir", "--show-toplevel",
             "--abbrev-ref", "HEAD"],
            cwd=cwd, capture_output=True, text=True, timeout=5,
            encoding="utf-8", errors="replace",
        )
        common, root, branch = (out.stdout.strip().split("\n") + ["", "", ""])[:3]
        # Not gated on the exit status. In a repository with no commits yet,
        # `--abbrev-ref HEAD` fails and takes the whole call down with it — but
        # the two answers that matter are already on stdout. Throwing them away
        # gave a brand-new repository a path-derived key that changed the moment
        # somebody made their first commit, quietly orphaning anything written
        # against the old one.
        if not common or not root:
            raise RuntimeError
        if branch in ("", "HEAD"):
            # Unborn, or detached. symbolic-ref answers for the first.
            ref = subprocess.run(["git", "symbolic-ref", "--short", "HEAD"],
                                 cwd=cwd, capture_output=True, text=True,
                                 timeout=5, encoding="utf-8", errors="replace")
            branch = ref.stdout.strip() if ref.returncode == 0 else ""
    except Exception:
        root = cwd
        key = "path:" + hashlib.sha1(cwd.encode()).hexdigest()[:8]
        return cwd, key, os.path.basename(cwd.rstrip("/")) or "?", ""
    if not os.path.isabs(common):
        # Against `cwd`, NOT against `root`. `git rev-parse` prints paths
        # relative to the directory it was RUN in, and only the main worktree
        # ever gets a relative answer: `.git` from the top, `../../.git` from two
        # directories down (a linked worktree is always told an absolute path,
        # because its common dir is in another checkout entirely). Resolving that
        # against the root climbed as far ABOVE the repository as the cwd was
        # BELOW it, and the key and label then came from a directory that merely
        # contains the project.
        #
        # Both halves of that were live on 2026-08-06. A session working in
        # `<root>/packages/api` was keyed under the name of the folder holding
        # every project on the machine, while three sessions at the root of the
        # SAME working copy held the real key — so they filed their locks in
        # different places, did not contend for the one database, and the guard
        # told each of them it was free. And two unrelated projects side by side
        # in that folder, each with a session the same depth below its own root,
        # collapsed onto ONE key — false contention, and each project's messages
        # delivered into the other's context.
        #
        # Nothing looked wrong, because `--show-toplevel` is absolute and the
        # recorded root was right the whole time. Only the two derived fields
        # were wrong, and those are the ones nobody reads by eye.
        candidates = [os.path.normpath(os.path.join(cwd, common)),
                      os.path.normpath(os.path.join(root, common))]
        # git's convention first, and the old base kept only as a fallback for a
        # git that ever prints relative-to-toplevel instead: a common dir that
        # does not exist on disk is proof the base was wrong, and that is cheaper
        # to check than to reason about across git versions.
        common = next((c for c in candidates if os.path.exists(c)), candidates[0])
    common = os.path.realpath(common)
    label = os.path.basename(os.path.dirname(common)) or "repo"
    key = "%s:%s" % (label, hashlib.sha1(common.encode()).hexdigest()[:6])
    return root, key, label, branch


def heal_derived(rec, path):
    """Re-derive a record's repo key when an older, wrong derivation wrote it.

    A record holds two different kinds of thing, and the whole of this function
    is the distinction between them. `cwd` is a STATEMENT about where this party
    is working — declared with `agentbus here`, or inferred from its payloads —
    and it is what `pinned` protects and what the relocation guards in
    `_follow_cwd` and `_follow_agent_cwd` protect. `repo_key`, `repo_label`,
    `root` and `branch` are not statements. They are git's ANSWER about that
    directory, and an answer that disagrees with its own question is not a
    declaration to be defended but a mistake to be corrected.

    So: the demonstrable checkout wins over the recorded key, and it wins only
    ever by re-deriving in place from the record's OWN cwd. That is why this may
    be done without consulting either guard. Nothing about where the party is
    working changes — `cwd` is read off the record rather than from a caller who
    could be anywhere, so there is no untrusted move to refuse, and a pinned
    record heals for the same reason: the pin says which directory, and this asks
    git what that directory is. Deleting a guard was never needed; the guards
    were simply never asked this question.

    Who is allowed to correct it: the party itself, on its own next hook. Never
    another session. A wrong key is not visible to its neighbours — it is why
    they cannot see IT — and reaching into somebody else's record to fix what you
    inferred about their checkout is how one bad inference becomes everybody's.

    Stamped, not verified. Checking the key on every hook costs a git subprocess
    (~11ms measured) in every session on this machine, for an answer that cannot
    change once it is right; this plugin's shell fast path exists because 40ms a
    tool call was judged too much to spend. So a record carries the revision that
    derived it and is re-derived once, when that revision is behind.

    A cwd that has since been deleted is left alone. `git_facts` cannot run there
    and would answer with the `path:` fallback, which would replace a wrong key
    with a differently wrong one — and take the recorded root with it."""
    if not rec or rec.get("keyrev") == KEY_REV:
        return rec
    cwd = rec.get("cwd")
    if cwd and os.path.isdir(cwd):
        root, repo_key, label, branch = git_facts(cwd)
        rec.update({"root": root, "repo_key": repo_key,
                    "repo_label": label, "branch": branch})
        # Not the agent name, which `register` also derives from the label. Other
        # sessions address this one by the name they have already seen, and a
        # rename mid-chat to repair a hash nobody reads would cost more than it
        # fixed. The name is a handle; the key is an identity.
        rec["keyrev"] = KEY_REV
        write_json(path, rec)
    return rec


def repo_relative(path, root):
    """`path` as the repository sees it, or "" when it is outside `root`.

    This is the form two worktrees of one repository have in common: the same
    file has two absolute paths and one repository-relative one, so anything
    that has to mean the same thing in both checkouts — an ownership glob, a
    filename in a build failure — is written and compared in this form."""
    try:
        rel = os.path.relpath(os.path.realpath(path), os.path.realpath(root or "/"))
    except ValueError:
        return ""   # different drives on Windows
    return "" if rel.startswith("..") else rel.replace(os.sep, "/")


def agent_name_from(branch, label, taken):
    base = (branch or "").split("/")[-1].strip() or label or "agent"
    if base in ("HEAD", "main", "master", "develop"):
        base = "%s-%s" % (label, base)
    parts = [p for p in re.split(r"[^A-Za-z0-9]+", base) if p][:3]
    name = "-".join(parts).lower() or "agent"
    if name not in taken:
        return name
    for n in range(2, 40):
        cand = "%s#%d" % (name, n)
        if cand not in taken:
            return cand
    return name


def claude_pid():
    """The pid of the Claude Code process this hook belongs to. Used for liveness:
    a heartbeat can be stale during a long turn, but the process is proof."""
    import subprocess
    env = os.environ.get("CLAUDE_PID")
    if env and env.isdigit():
        return int(env)
    pid = os.getppid()
    if IS_WIN:
        return pid  # no cheap portable ancestor walk; CLAUDE_PID covers the rest
    for _ in range(5):
        try:
            out = subprocess.run(["ps", "-o", "ppid=,comm=", "-p", str(pid)],
                                 capture_output=True, text=True, timeout=3)
            line = out.stdout.strip()
            if not line:
                return pid
            ppid, comm = line.split(None, 1)
            if "claude" in comm.lower():
                return pid
            pid = int(ppid)
            if pid <= 1:
                return os.getppid()
        except Exception:
            return os.getppid()
    return os.getppid()


def pid_alive(pid):
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return False
    if pid <= 0:
        return False
    if IS_WIN:
        # os.kill(pid, 0) is NOT a liveness probe on Windows. CPython maps every
        # signal other than CTRL_C_EVENT/CTRL_BREAK_EVENT onto TerminateProcess,
        # so the POSIX idiom would kill the very sessions this is tracking.
        try:
            import ctypes
            k32 = ctypes.windll.kernel32
            k32.OpenProcess.restype = ctypes.c_void_p
            k32.OpenProcess.argtypes = [ctypes.c_ulong, ctypes.c_int, ctypes.c_ulong]
            k32.CloseHandle.argtypes = [ctypes.c_void_p]
            handle = k32.OpenProcess(0x1000, 0, pid)  # QUERY_LIMITED_INFORMATION
            if not handle:
                # ERROR_ACCESS_DENIED means the process exists and belongs to
                # somebody else — an elevated session, say. Reading that as dead
                # would reap a live session and drop its locks.
                return k32.GetLastError() == 5
            code = ctypes.c_ulong()
            k32.GetExitCodeProcess.argtypes = [ctypes.c_void_p,
                                               ctypes.POINTER(ctypes.c_ulong)]
            ok = k32.GetExitCodeProcess(handle, ctypes.byref(code))
            k32.CloseHandle(handle)
            return bool(ok) and code.value == 259  # STILL_ACTIVE
        except Exception:
            return True  # unknown beats reaping a session that is still working
    try:
        os.kill(pid, 0)
        return True
    except OSError as exc:
        return exc.errno == errno.EPERM
    except Exception:
        return False


# -------------------------------------------------------------- sessions ----

def beat_path(sid):
    return os.path.join(SESSIONS, "%s.beat" % sid)


def touch_beat(sid):
    try:
        open(beat_path(sid), "w").close()
    except OSError:
        pass


def last_beat(sid):
    try:
        return int(os.path.getmtime(beat_path(sid)))
    except OSError:
        return 0


def load_sessions(reap=False):
    """All sessions that still look alive. With reap=True, dead ones are removed
    and whatever they were holding is released."""
    out = []
    dead = []
    try:
        names = os.listdir(SESSIONS)
    except OSError:
        return out
    for n in names:
        if not n.endswith(".json"):
            continue
        sid = n[:-5]
        rec = read_json(os.path.join(SESSIONS, n))
        if not rec:
            dead.append(sid)
            continue
        rec["sid"] = sid
        rec["beat"] = last_beat(sid) or rec.get("started", 0)
        alive = pid_alive(rec.get("pid", 0))
        quiet = now() - rec["beat"]
        # The pid is evidence, not proof: it can be recorded wrong, or reused by
        # an unrelated process, and then the record would never expire and would
        # hold locks and a roster line forever. Long enough silence retires a
        # session regardless — it re-registers by itself the moment it acts.
        #
        # So ABANDONED_BEAT retires a session whose process is still alive, and
        # that stays. Everything it frees is genuinely free after three hours of
        # silence: HARD_TTL is 45 minutes, so `sweep_locks` has already taken
        # whatever this session was holding; COLLIDE_WINDOW is 15 minutes, so
        # nothing consults its write log; and a chat that has not beaten for
        # three hours has no subagent still running. Keeping it on the roster
        # would only make `agentbus status` list chats nobody is sitting in.
        #
        # What was wrong was not this rule but what the retirement destroyed on
        # its way past. `forget_session` keeps the chat's own statements now, so
        # a chat left open over lunch comes back as itself: see `keep_declared`.
        if quiet > ABANDONED_BEAT or (not alive and quiet > STALE_BEAT):
            dead.append(sid)
            continue
        rec["alive_pid"] = alive
        out.append(rec)
    if reap and dead:
        for sid in dead:
            forget_session(sid)
    out.sort(key=lambda r: r.get("started", 0))
    return out


# What a chat SAID about itself, as against what was measured about it. These
# are the fields no inference produces: somebody typed them, or the bus has
# already acted on them once and must not act again.
DECLARED_KEYS = ("agent", "started", "title_set")
# The location half, meaningful only together with `pinned` — which is why they
# travel as one group. Unpinned, every one of them is re-derived by `register`
# from the cwd the payload carries, so keeping a copy would be keeping a
# measurement rather than a declaration.
DECLARED_PINNED_KEYS = ("pinned", "cwd", "root", "repo_key", "repo_label",
                        "branch", "keyrev")


def declared_path(sid):
    return os.path.join(DECLARED, "%s.json" % sid)


def keep_declared(sid, rec):
    """Put what this chat declared somewhere the reap cannot reach.

    Retiring a session and forgetting the chat are two different things, and
    until 2.8.0 they were one function. A session is retired so that it stops
    holding locks and stops appearing live — see the reap in `load_sessions` —
    and everything that does is correct after three hours of silence. But the
    same call deleted the record, and the record is the only place the chat's own
    statements lived, so a chat left open over lunch came back as a stranger:

      * its `pinned` location, so `agentbus here` was forgotten and the guard
        went back to judging it wherever the payload's cwd pointed. The
        declaration was cosmetic again, through a different door;
      * its `title_set`, so the chat-title rename fired again and the whole
        repository was told about it a second and a third time. Measured on this
        machine: one chat announced the same rename on three consecutive days,
        and nine of them did it inside eight minutes after being idle overnight;
      * its `agent`, which is the address other sessions hold and post to;
      * its `started`, so "how long has this chat been going" restarted.

    Not a cache and not an un-reap. Nothing here comes back that the reap was
    right to take: the locks stay released, the subagents stay forgotten, the
    session stays off the roster until it acts. What comes back is only what
    nobody but the chat itself could tell us."""
    if not sid or not rec:
        return
    keep = dict((k, rec[k]) for k in DECLARED_KEYS if rec.get(k))
    if rec.get("pinned"):
        keep.update((k, rec[k]) for k in DECLARED_PINNED_KEYS if rec.get(k))
    if keep:
        write_json(declared_path(sid), keep)


def sweep_declared():
    """Forget the chats that never came back.

    `register` deletes the file it recovers from, so in the ordinary case this
    finds nothing. It is here for the chat that was closed and never reopened,
    whose declaration would otherwise sit on disk for the life of the machine."""
    cutoff = now() - DECLARED_TTL
    try:
        names = os.listdir(DECLARED)
    except OSError:
        return
    for name in names:
        path = os.path.join(DECLARED, name)
        try:
            if os.path.getmtime(path) < cutoff:
                os.unlink(path)
        except OSError:
            pass


def forget_session(sid):
    keep_declared(sid, read_json(os.path.join(SESSIONS, "%s.json" % sid)))
    release_all(sid, quiet=True)
    for a in load_agents(sid):
        forget_agent(sid, a.get("agent_id"))
    forget_action(sid)
    for p in (os.path.join(SESSIONS, "%s.json" % sid), beat_path(sid),
              os.path.join(CURSORS, sid), os.path.join(HOTFOR, sid),
              os.path.join(OWNS, "%s.json" % sid),
              os.path.join(WRITES, "%s.log" % sid)):
        try:
            os.unlink(p)
        except OSError:
            pass


def refresh_derived(sessions=None):
    """live-count and guard-tokens are read by the shell fast path, which cannot
    parse JSON. Keep them in sync whenever the engine runs anyway."""
    if sessions is None:
        sessions = load_sessions()
    write_text(LIVEFILE, "%d\n" % len(sessions))
    # Union over every live session's root, not one arbitrary root per repo: all
    # worktrees share a repo_key, so reading only the first would let a worktree
    # whose branch predates the config file switch the guard off for everyone.
    write_text(TOKENFILE, guard_token_line(
        [repo_config(s.get("repo_key"), s.get("root")) for s in sessions]) + "\n")
    sweep_locks(sessions)
    sweep_autoclaims()
    sweep_hints()
    sweep_declared()
    sweep_acted(sessions)
    sweep_serves(sessions)
    rebuild_hot(sessions)


def sweep_serves(sessions):
    """Forget a service record whose process is gone and whose repository nobody
    is in.

    This was the one state directory with no cleanup path at all, and it is the
    one that could not have the ordinary one: every other record belongs to a
    party, so `forget_session` and `forget_agent` take it. A service deliberately
    outlives the session that started it — a detached dev server still answering
    for a tree whose chat has closed is the dangerous case this plugin exists to
    catch — so ending a session must not forget its service.

    What makes a record cruft is therefore not age. It is the pair of facts the
    board already filters on: the process is not running, and no live session is
    in that repository, so nobody can be served by it and nobody will come back
    for it. Found with four such records on the development machine, two of them
    under repository keys that only the `--git-common-dir` defect of 2.7.0 could
    have produced — keys nothing will ever read again.

    This directory holds two kinds of file and only one of them is a service.
    `moves_path` keeps a service's handover history here as `<key>__<res>.moves`,
    deliberately beside the record rather than inside it, because stopping a
    service deletes the record and a handover *is* a stop followed by a start —
    so the history has to outlive it. Those files carry no `repo` and no `pid`,
    which the first version of this function read as evidence of death: it
    deleted the churn history and four assertions about repeated handovers went
    quiet. So the extension is the test, matching `serve_path`.

    Only pids this plugin recorded are examined, and none is signalled."""
    live = {s.get("repo_key") for s in sessions if s.get("repo_key")}
    try:
        names = os.listdir(SERVES)
    except OSError:
        return
    for name in names:
        if not name.endswith(".json"):
            continue      # `.moves` is the history, and outliving is its job
        path = os.path.join(SERVES, name)
        rec = read_json(path)
        if not rec or rec.get("repo") in live:
            continue
        if pid_alive(rec.get("pid", 0)):
            continue      # answering for somebody, chat or no chat
        try:
            os.unlink(path)
        except OSError:
            pass


def sweep_autoclaims():
    """Delete claim records that nothing will ever come back to release.

    An automatic claim is remembered under its tool call's id and forgotten when
    that call finishes. Anything that stops the finish arriving leaves the record
    behind for ever — which is exactly what the PostToolUse-on-error hole did
    until it was found on 2026-07-28, and twenty-two of them were still sitting
    there afterwards.

    Not merely litter. The shell fast path decides whether PostToolUse is worth
    an engine start by asking whether *any* claim record exists, so a handful of
    dead ones make every Bash call in every session on this machine pay ~40ms
    for nothing, for ever. An hour is far longer than the longest real command
    and far shorter than the soft lock it would have belonged to."""
    cutoff = now() - 3600
    try:
        names = os.listdir(AUTOCLAIM)
    except OSError:
        return
    for name in names:
        path = os.path.join(AUTOCLAIM, name)
        try:
            if os.path.getmtime(path) < cutoff:
                os.unlink(path)
        except OSError:
            pass


def sweep_locks(sessions):
    """Delete locks that already grant nothing — expired, or held by a session
    that is gone. They confuse `status` and outlive the reason they were taken;
    leaving them on disk made a session look like it was holding the whole rig
    an hour after it had finished with it."""
    try:
        names = os.listdir(LOCKS)
    except OSError:
        return
    for name in names:
        if not name.endswith(".json"):
            continue
        path = os.path.join(LOCKS, name)
        lock = read_json(path)
        if not lock:
            continue
        holder, stealable, _ = lock_state(lock, sessions)
        if not stealable:
            continue
        with Mutex("lock-" + re.sub(r"[^A-Za-z0-9]", "_",
                                    lock.get("resource", ""))[:40]):
            current = read_json(path)
            if current and current.get("acquired_at") == lock.get("acquired_at"):
                try:
                    os.unlink(path)
                except OSError:
                    pass


def rebuild_hot(sessions):
    """hot-for/<sid> is what the pre-tool fast path greps a tool payload against
    before deciding whether to wake the engine, and it holds three kinds of
    thing, all of them belonging to *other* live sessions:

      - absolute paths they wrote recently, for the reactive collision guard;
      - the fixed leading text of anything they have declared they own;
      - the path of any file they have claimed outright.

    None of these are optimisations; each is what makes its guard work at all.
    Without the second, the engine is woken only once the owner has already
    written the file, so a declaration is enforced one edit too late — the exact
    failure declaring scope up front exists to prevent. Without the third, an
    explicit `agentbus claim 'file:…'` is invisible to the shell path, so the
    block it is supposed to produce never fires — which matters because taking
    the file explicitly is precisely what every file-collision message tells the
    reader to do once the two of them have agreed."""
    cutoff = now() - COLLIDE_WINDOW
    per, owned, claimed = {}, {}, {}
    for s in sessions:
        per[s["sid"]] = recent_writes(s["sid"], cutoff)
        owned[s["sid"]] = [glob_prefix(d.get("glob")) for d in load_owns(s["sid"])]
        claimed[s["sid"]] = []
    for lock in (read_json(os.path.join(LOCKS, n)) or {}
                 for n in (os.listdir(LOCKS) if os.path.isdir(LOCKS) else [])
                 if n.endswith(".json")):
        res = lock.get("resource") or ""
        if res.startswith("file:") and lock.get("sid") in claimed:
            claimed[lock["sid"]].append(res[len("file:"):])
    for s in sessions:
        paths = set()
        for other in per:
            if other == s["sid"]:
                continue
            paths.update(p for _, p in per[other])
            paths.update(owned[other])
            paths.update(claimed[other])
        write_text(os.path.join(HOTFOR, s["sid"]),
                   "".join(p + "\n" for p in sorted(paths) if p))


def recent_writes(sid, cutoff, compact=False):
    """Compact only your OWN log. Rewriting another session's file races with the
    shell hook appending to it, and the append that lands mid-rewrite is lost —
    which means a real edit vanishes from the collision record."""
    path = os.path.join(WRITES, "%s.log" % sid)
    out = []
    try:
        with open(path, "r", encoding="utf-8-sig", errors="replace") as fh:
            lines = fh.readlines()[-800:]
    except OSError:
        return out
    for line in lines:
        try:
            ts, p = line.rstrip("\n").split(" ", 1)
            ts = int(ts)
        except ValueError:
            continue
        if ts >= cutoff:
            out.append((ts, p))
    if compact and len(lines) > 400:
        write_text(path, "".join("%d %s\n" % (t, p) for t, p in out))
    return out


def _follow_cwd(rec, cwd, trusted=True):
    """Keep a session's recorded worktree in step with where it is working.

    Private to `resolve_party`, which is the only place the order these clauses
    sit in is written down. This one is clause (c) and (d) of *where they are
    working* for a session's own call: a pin holds, and otherwise the cwd wins
    and moves the record.

    Claude Code can move a session into a worktree it creates under
    `.claude/worktrees/`, and the record's root is derived once, at SessionStart.
    Left alone it stays wrong for the rest of the session — and everything that
    matters reads it. `serve` starts the service from that root, so the service
    comes up from the tree the session *started* in while the message says it
    used yours; `serving_check` compares against that root, so the session is
    told the port is fine when it is answering with somebody else's code.

    That is the exact silent wrong-checkout failure this plugin exists to
    prevent, produced by the plugin itself. Reported from real use on
    2026-07-27, after it quietly reverted an API to `main` and an agent spent
    time on a fix that had stopped being deployed.

    The new worktree sits *inside* the old root's path, so noticing it means
    asking git again rather than comparing prefixes.

    A hook payload's `cwd` is the session's own and is taken as given. The CLI's
    is only wherever somebody happened to run a command from — a human in
    another terminal could be anywhere — so from there a move is followed only
    within the same repository. That still covers the case this exists for,
    because every worktree of one repository shares its key."""
    # Before the early return below, deliberately. A key written by an older,
    # wrong derivation does not repair itself by being left alone: `register`
    # re-derives only at SessionStart or when a session has no record at all, and
    # the next line returns on a cwd equal to the record's — which, for a session
    # that is not moving, is every payload it ever sends. Between the two, a chat
    # that registered under the wrong derivation kept its wrong key, and its
    # immunity from its neighbours' locks, until its human closed it.
    if rec.get("sid"):
        rec = heal_derived(rec, os.path.join(SESSIONS, "%s.json" % rec["sid"]))
    if not cwd or cwd == rec.get("cwd"):
        return rec
    if rec.get("pinned"):
        # Somebody said where this session is working, with `agentbus here`.
        # Claude Code returns the shell to the directory the chat opened in
        # between tool calls, so every payload afterwards says the old tree —
        # and following it put the session straight back, on the very next turn.
        # An agent in that position was told it was in a checkout it had left,
        # blocked from services it had started itself, and ran the rest of its
        # work with AGENTBUS_OFF=1. A declaration has to outlast the inference
        # that contradicts it; `agentbus here` somewhere else moves it again.
        return rec
    root, repo_key, label, branch = git_facts(cwd)
    if not trusted and repo_key != rec.get("repo_key"):
        return rec
    rec.update({"cwd": cwd, "root": root, "repo_key": repo_key,
                "repo_label": label, "branch": branch})
    write_json(os.path.join(SESSIONS, "%s.json" % rec["sid"]), rec)
    # No announcement. The first version of this emitted a note on every move,
    # and a session running parallel subagents in different worktrees moves on
    # every other tool call: it produced thirty notes in three minutes into
    # every other session's context in that repository. A move is visible in the
    # roster, which is where somebody looking for it will look.
    return rec


def _caller_view(me, cwd, override_pin=False):
    """`me`, but rooted where this particular call is actually running.

    Private to `resolve_party`. It carries two clauses of *where they are
    working*: (d) for the command-line tool, whose shell cwd is followed within
    the same repository, and (a) for `git -C <path>`, which is the one caller
    that passes `override_pin`.

    A session has one worktree; a session running parallel subagents in two
    worktrees does not, and the guards need an answer per call rather than per
    session. `serving_check` asks "is this service answering for *my* tree", and
    for a subagent the honest answer is about the subagent's tree, not its
    parent's.

    A view, not a write. Persisting it was the first thing tried and it was
    worse: two subagents dragged the session's root back and forth between them
    on every tool call, so the record was not even consistently wrong.

    A pinned session is left alone, for the same reason `_follow_cwd` leaves it
    alone: `agentbus here` is a statement about where the work is, and the cwd
    on the payload is what Claude Code reset the shell to. Honouring the pin in
    the record but not here made the declaration cosmetic — the roster showed
    the declared tree while the guard went on locking, and comparing services
    against, the tree the payload named.

    `override_pin` is the single exception, and `resolve_party` passes it from
    exactly one block: `git -C <path>`, where the command names a checkout
    outright. A pin is a statement about where a session is working; `git -C
    <path>` is a statement about one command, and the narrower, more specific
    statement wins. The parameter has to exist because the answer is applied by
    *calling this function* — so the pin check above swallowed `git -C` on its
    way through the very function that was meant to apply it, and a pinned
    session was judged in its pinned tree while running a command about another
    one. A pin still governs every command that names no path."""
    if not cwd or cwd == me.get("cwd"):
        return me
    if me.get("pinned") and not override_pin:
        return me
    root, repo_key, label, branch = git_facts(cwd)
    view = dict(me)
    view.update({"cwd": cwd, "root": root, "repo_key": repo_key,
                 "repo_label": label, "branch": branch})
    return view


_PARTY_HINT = []


def _party_hint(record):
    """The hint the guard left for this exact command line, taken once.

    `take_party_hint` consumes the entry and unlinks the file, deliberately: a
    hint answers for one command, and one left lying about would attribute the
    next command to the same subagent. That was safe while a single function
    asked for it. `resolve_party` is what every verb goes through now, and a
    verb that resolved twice would be told "party unknown" the second time —
    which writes a lock nothing can attribute, and an unidentified lock blocks
    the caller's own siblings once there are two of them. That is the failure
    `same_party` exists to catch, and M1 made it stricter still by giving an
    unidentified CALLER the same treatment. Memoised for the life of the
    process, which for the command-line tool is one command."""
    if not _PARTY_HINT:
        _PARTY_HINT.append(take_party_hint(record) or {})
    return _PARTY_HINT[0]


def resolve_party(payload=None, cmd=""):
    """Who is acting and where they are working.

    Returns (record, view). `record` is the session's own dict, safe to write
    back; `view` is that dict rooted where this particular call is running, and
    must never be persisted. Callers that write use the record; callers that
    decide use the view. `payload` is a hook payload or None for the
    command-line tool; `cmd` is the Bash command being guarded, for `git -C`.

    Thirteen functions used to answer these two questions between them, each
    added to close one defect and none of them removing another. Six of the
    twenty-two defects this plugin has produced came from that, and the most
    recent was half a fix: `agentbus here` pinned the record `status` prints
    while the guard went on locking, and comparing services against, the tree
    the payload named. So both orders are applied here, once, in order, each
    clause a named block below. `tests/test_identity.sh` pins them rule by rule
    through decisions the guard actually made rather than through the record —
    which is exactly how that shipped pin assertion passed while the guard was
    wrong.

      WHO IS ACTING
        (a) the `agent_id` on the payload
        (b) an explicit `--as <name>` — applied by the verb, not here
        (c) the party hint the guard left for this exact command line, if the
            caller is the command-line tool and a hint exists
        (d) otherwise the session

      WHERE THEY ARE WORKING
        (a) a path the command itself names (`git -C <path>`), for that command
            only, without moving any record, and above every declaration below
        (b) the acting subagent's own recorded root — the tree it declared with
            `agentbus here --as <name>`, or else the tree inferred for it
        (c) the root pinned by `agentbus here`, until `here` is run elsewhere
        (d) the payload's cwd, which for an unpinned session is authoritative
            and moves the record; for the command-line tool, the shell's cwd,
            followed only within the same repository and not written back
        (e) the record as it stands

    There is no `as_name` parameter, though the plan drafted one. `--as` is
    clause (b) of the first order and it is deliberately applied by the verb:
    it means different things to different verbs — `agentbus here --as X` says
    where X is working without adopting its locks, `agentbus claim --as X`
    adopts the identity outright — and `acting` exits 1 on a name that
    is not one of this session's own subagents, which in a universal resolver
    would make `agentbus status --as <stale>` exit non-zero. It could not be
    passed in even if that were wanted: validating the name needs
    `load_agents(me["sid"])`, so a caller has to have resolved already before it
    has anything to hand over."""
    # ---- which session -------------------------------------------------------
    #
    # Hooks are told on stdin; the command-line tool reads the environment
    # Claude Code exports into every Bash call. A session with no record is not
    # invented here. The two hooks that may not take no for an answer call
    # `register` and ask again; nothing else creates one, because a
    # PostToolBatch that registered would resurrect a session just reaped.
    sid = safe_id((payload.get("session_id") if payload else None)
                  or os.environ.get("AGENTBUS_SESSION")
                  or os.environ.get("CLAUDE_CODE_SESSION_ID"))
    if not sid:
        return None, None
    record = read_json(os.path.join(SESSIONS, "%s.json" % sid))
    if not record:
        return None, None
    record["sid"] = sid
    # A hook is told who is acting; the CLI has to be told or guess. Which of
    # the two this is decides whether a lock taken here can name its party or
    # has to admit it cannot — see `same_party`.
    record["party_known"] = bool(payload)

    # ---- where (c) and (d), for the session itself ---------------------------
    #
    # The part of "where" that belongs to the session rather than to this call,
    # and therefore the part that persists. `_follow_cwd` leaves a pinned
    # session alone — clause (c) — and otherwise takes the payload's cwd as
    # authoritative and writes it back — clause (d). Claude Code can move a
    # session into a worktree it creates under `.claude/worktrees/`, and a root
    # derived once at SessionStart then stays wrong for the rest of the session
    # while `serve` starts services from it and `serving_check` compares against
    # it. That is the silent wrong-checkout failure this plugin exists to
    # prevent, produced by the plugin itself, on 2026-07-27.
    if payload is not None:
        if not payload.get("agent_id"):
            record = _follow_cwd(record, payload.get("cwd"))
        # A subagent's payload deliberately does not reach that. Its cwd is its
        # own, not the session's, and two subagents in two worktrees would drag
        # the session's single root back and forth between them on every tool
        # call — worse than a stale root, because it is not even consistently
        # wrong. Where the subagent itself is, is clause (b) below.
    else:
        # The same two clauses for the command-line tool, whose cwd is only
        # wherever somebody happened to run the command from — a human in
        # another terminal could be anywhere — so a move is followed only within
        # the same repository, which still covers every worktree of one project.
        # Not written back from here: the caller may be one of several subagents
        # in several worktrees. `agentbus name` and `agentbus doing` do persist
        # it, which is why they are handed the record and not the view.
        here = _caller_view(record, os.getcwd())
        if here.get("repo_key") == record.get("repo_key"):
            record = here

    # ---- who (a): the `agent_id` on the payload ------------------------------
    #
    # First because it is the only answer that cannot be guessed or faked:
    # Claude Code puts it on every hook a subagent causes and on none the
    # session itself causes. A hook is TOLD who is acting, so nothing below may
    # overrule it — a hint left under the same command line least of all.
    aid = payload.get("agent_id") if payload else None
    if aid:
        # ---- where (b): the acting subagent's own recorded root --------------
        #
        # It arrives with the identity, because for a subagent the two are one
        # lookup. `_party_view` roots it in its own record: the tree it declared
        # with `agentbus here --as <name>`, which is pinned and which no
        # inference moves, or else the tree inferred for it — moved only on a
        # cwd that differs from both the record and the parent's, since a cwd
        # equal to the parent's is what a subagent reports when it has never
        # changed directory and therefore says nothing.
        #
        # That record outranks the session's pin (c). A pin is a statement about
        # the session, and one session with two parties in two checkouts is
        # exactly what a single per-session root cannot express. On 2026-07-29
        # an agent that had pointed a service at its own worktree was refused
        # permission to use it and turned the plugin off for the rest of its
        # turn, which is the one outcome this plugin cannot afford.
        view = _party_view(record, payload)
    else:
        view = dict(record)
        # ---- who (b): an explicit `--as <name>` ------------------------------
        #
        # Applied by the verb, through `acting`, on top of what is returned
        # here — and therefore above the hint below, which is the order M1
        # settled: a hint is an inference the guard made from a command line and
        # `--as` is a declaration by the caller, checked against that session's
        # own subagents. It is also the only thing that makes the block advice
        # work, since the unidentified-party block tells a blocked agent to name
        # itself. See this function's docstring for why it is not applied here.
        if payload is None:
            # ---- who (c): the party hint -------------------------------------
            #
            # A subagent's Bash environment is byte-identical to its parent's,
            # so by the time `agentbus` is executing nothing in it knows which
            # subagent is calling. The guard saw the same command a few
            # milliseconds earlier and did know; the hint under a digest of the
            # argv is the only place that answer exists. Hooks never look: they
            # were told.
            hint = _party_hint(record)
            if hint:
                view["agent_id"] = hint.get("agent_id")
                view["agent"] = hint.get("agent") or view.get("agent")
                view["party_known"] = True
                if hint.get("agent_id"):
                    # A shell is the one place a subagent's real directory can
                    # be seen. One that only ever `cd`s inside its commands has
                    # a record still saying where it was launched, and every
                    # hook payload agrees with that record — so this is the only
                    # chance anything has to correct it. Only the record is
                    # corrected: the identity is adopted here and the root is
                    # not, because the caller's own shell is measured now and
                    # the agent's record was written when it started.
                    _follow_agent_cwd(read_json(agent_path(sid, hint["agent_id"])),
                                      os.getcwd(), trusted=False)
        # ---- who (d): otherwise the session ----------------------------------
        #
        # Which is what `view` already is.

    # ---- where (a): a path the command itself names --------------------------
    #
    # Applied last so that it is applied on top of every answer above, which is
    # what puts it first in the order. `git -C <path>` and `git
    # --git-dir=<path>` name a checkout outright, and a chat that works on
    # another worktree that way never changes directory — so everything that
    # infers a tree from a cwd places it in the repository it was launched in,
    # permanently. Reported from Windows on 2026-07-31, where four chats
    # rendered on one branch in one worktree and one of them was somewhere else
    # entirely.
    #
    # `override_pin` is what makes it beat a pin, and it reaches a subagent as
    # well because a subagent's view carries its parent's `pinned`. Until M1 the
    # guard applied this answer by calling `_caller_view`, whose pin check
    # returned before the path was looked at, so the function meant to apply
    # `git -C` was the function that discarded it. It moves this one command and
    # no record: the next command that names no path is judged by the pin again.
    stated = _command_worktree(cmd) if cmd else ""
    if stated:
        view = _caller_view(view, stated, override_pin=True)

    # ---- where (e): otherwise the record as it stands ------------------------
    #
    # No code, by construction: every clause above has a `not cwd` guard, so a
    # payload with nothing to infer from leaves the last established answer
    # alone. Without those guards the guard would ask git about the empty string
    # and place the session wherever the hook process happened to start.

    # What tells the two apart at the four places that write `me` straight back
    # to the session file — see `require_record`.
    view["_view"] = True
    return record, view


def require_record(rec, who):
    """`rec`, if it is a session's own record rather than one party's view of it.

    Four places write what they are handed straight to the session file:
    `rename_session`, `follow_chat_title` — which `hook_prompt_submit` hands its
    own argument to — `cli_name` and `cli_here`. A view is `me` as one *party*
    sees it: a subagent's identity, a subagent's root, or a tree named by a
    single `git -C`. Persisting one was the first thing tried and it was worse
    than a stale record — two subagents dragged the session's root back and
    forth between them on every tool call — and a subagent's `agentbus here --as
    <name>` would end up pinning its parent, one field carrying two meanings.

    `resolve_party` returns the two distinguishably so that this can be checked
    rather than remembered. An exception on stderr is louder than a silent
    persist, and `__main__`'s catch-all keeps it from being the reason a session
    breaks."""
    if rec.get("_view"):
        sys.stderr.write("agent-bus: %s was given a party view where the "
                         "session's own record is required — not persisting "
                         "it\n" % who)
        raise RuntimeError("%s: a party view must never be persisted" % who)
    return rec


# ------------------------------------------------- claude code's registry ----
#
# WHY THIS IS HERE. Messaging between sessions is Claude Code's own now: the
# `SendMessage` tool reaches a session by the name `ListAgents` prints, and wakes
# it. That gives this plugin a job it did not have before — when it blocks a
# command, it must hand the reader an address that tool accepts.
#
# It cannot make one up. The bus names sessions itself, and the two naming
# systems agree only by coincidence: both follow the chat title, so both are
# right until a chat has no title, and then the bus falls back to the branch
# while Claude Code falls back to directory-and-counter. Measured here on
# 2026-09-05 — four of five live sessions matched, and the fifth was
# `checkout-rewrite` on the bus and `product-86` to Claude Code.
# Printing our own name would have sent that session's peers to an address that
# does not exist.
#
# So the address is read, never derived. Claude Code keeps one JSON file per live
# session at `~/.claude/sessions/<pid>.json` carrying `sessionId` — byte
# identical to our `sid` — and `pid`, which is ours too: two independent join
# keys onto records we already write.
#
# Everything here is defensive past the point of taste, deliberately. This is
# somebody else's file format, it is not documented, and it can change under us
# in any release. A missing field, a wrong type, a file half-written as we read
# it: each yields "no address, run ListAgents" rather than an exception, because
# a coordination layer that raises inside a hook is worse than one that admits it
# does not know.

CC_SESSIONS = (os.environ.get("AGENTBUS_CC_SESSIONS")
               or os.path.join(os.environ.get("CLAUDE_CONFIG_DIR")
                               or os.path.join(HOME, ".claude"), "sessions"))

# Statuses seen on 2026-09-05. Anything else is printed verbatim rather than
# translated: a value this build has not met is not one it should interpret.
CC_STATUSES = ("busy", "idle", "shell", "running", "offline")

# Read at most this often. One block message asks for the same three or four
# addresses, and `watch` asks every second for hours, so neither a permanent
# cache nor no cache at all is right.
CC_TTL = 2
_CC_CACHE = {"at": 0.0, "by_sid": None}


def cc_sessions(force=False):
    """Claude Code's live sessions, keyed by session id.

    `{sid: {"sid","pid","name","status","cwd","socket","kind","version","alive"}}`.
    Never raises: a file that cannot be read or parsed is simply not in the
    answer, and a directory that is not there yields an empty one."""
    if (not force and _CC_CACHE["by_sid"] is not None
            and time.time() - _CC_CACHE["at"] < CC_TTL):
        return _CC_CACHE["by_sid"]
    out = {}
    try:
        names = os.listdir(CC_SESSIONS)
    except OSError:
        names = []
    for name in names:
        if not name.endswith(".json"):
            continue
        rec = read_json(os.path.join(CC_SESSIONS, name))
        if not isinstance(rec, dict):
            continue
        sid = rec.get("sessionId")
        if not isinstance(sid, str) or not sid:
            continue

        def text(key):
            val = rec.get(key)
            return val if isinstance(val, str) else ""

        pid = rec.get("pid") if isinstance(rec.get("pid"), int) else 0
        # WHEN it last said that, which turns out to matter more than what it
        # said. `status` is written when a session CHANGES state, not on a
        # heartbeat: measured on 2026-09-05, a session whose entry had read
        # `idle` for eight hours and forty minutes was in the middle of a tool
        # loop and answered a message in seconds. Printing "(idle)" off a value
        # that old is not reporting, it is guessing — and the guess a reader
        # acts on is "nobody is there, do not bother asking".
        at = rec.get("statusUpdatedAt") or rec.get("updatedAt") or 0
        out[sid] = {
            "sid": sid, "pid": pid, "name": text("name"),
            "status": text("status"),
            "status_at": int(at / 1000) if isinstance(at, (int, float)) else 0,
            "cwd": text("cwd"),
            "socket": text("messagingSocketPath"), "kind": text("kind"),
            "version": text("version"),
            # A registry file outlives the process it describes. An address for a
            # session that has gone is worse than no address at all: the reader
            # writes the message, believes it was delivered, and waits.
            "alive": bool(pid) and pid_alive(pid),
        }
    _CC_CACHE["by_sid"] = out
    _CC_CACHE["at"] = time.time()
    return out


def cc_fresh_status(rec):
    """What a session last said it was doing, but only while that is still
    evidence about now.

    The window is the same `IDLE_SECS` this plugin uses for its own quiet
    holder: five minutes. Older than that and the honest answer is nothing at
    all — the roster falls back to the heartbeat the hooks give us, which is
    derived from tool calls actually happening and cannot go stale while a
    session works."""
    if not rec:
        return ""
    at = rec.get("status_at") or 0
    if not at or now() - at > IDLE_SECS:
        return ""
    return rec.get("status") or ""


def cc_for(sid, pid=0):
    """The registry entry for one of our sessions, joined on id and then on pid.

    Only a live one. The pid fallback exists because the two records are written
    by different processes at different moments, and a session that was renamed
    or resumed can carry an id we have not caught up with — but its pid is the
    pid we recorded when we first saw it."""
    if not sid and not pid:
        return None
    reg = cc_sessions()
    rec = reg.get(sid or "")
    if rec:
        return rec if rec["alive"] else None
    if pid:
        # Exactly one, or none. A pid is unique among live processes, so two live
        # entries claiming it means the registry is telling us something we do
        # not understand — and picking whichever came first out of a directory
        # listing would be inventing an identity rather than reading one.
        hits = [o for o in reg.values() if o["pid"] == pid and o["alive"]]
        if len(hits) == 1:
            return hits[0]
    return None


def cc_twins(name):
    """How many live sessions answer to this name. Two is not rare — one listing
    on 2026-08-22 had `ibrahim1` twice — and a name that reaches two sessions
    reaches neither on purpose."""
    if not name:
        return 0
    return sum(1 for r in cc_sessions().values()
               if r["alive"] and r["name"] == name)


def address_of(sid, pid=0):
    """(address, status) for a session, where `address` is what `SendMessage`
    takes, or (None, "") when there is nothing honest to print.

    The name is the address, because that is the form Claude Code documents, the
    form `ListAgents` prints, and the form a human reading a roster recognises.
    The socket path is a fallback and only that: it is accepted — six sends on
    this machine, all delivered — but it is not a documented interface, and an
    address nobody can recognise is worth less than one they can. It earns its
    place in exactly one case, which is the case the name cannot serve: two live
    sessions answering to one name."""
    rec = cc_for(sid, pid)
    if not rec:
        return None, ""
    status = cc_fresh_status(rec)
    if rec["name"] and cc_twins(rec["name"]) < 2:
        return rec["name"], status
    if rec["socket"]:
        return "uds:" + rec["socket"], status
    # A name two sessions answer to, and no socket to tell them apart. Printing
    # it anyway would be the worst of the three outcomes: the reader would send
    # to whichever one the tool picks and believe they had reached the other.
    return None, status


def cc_strangers(sessions):
    """Live Claude Code sessions with no record on this bus.

    They exist — two on 2026-09-05, dropped by the heartbeat while their
    processes were alive — and they can be messaged. A roster that omits them
    tells the reader the machine is emptier than it is.

    Not the whole world either: the registry holds interactive sessions, and
    `ListAgents` also lists Remote Control peers that have no file here at all.
    Which is why the roster line says `ListAgents` knows more."""
    known = {s.get("sid") for s in sessions}
    return [r for r in cc_sessions().values()
            if r["alive"] and r["sid"] not in known]


def say_to(session, party="", lead="  ", about=""):
    """The line that tells a reader how to reach somebody, ready to print.

    `party` is the agent that acted, which is not always the session: a lock
    taken by a subagent is held by that subagent, and `SendMessage` reaches
    sessions only — it cannot address another session's subagent at all. On this
    machine 64 of the 87 blocks that named a holder named a subagent, so this is
    the common case and not the corner. The address is therefore always the
    session's, and when the party is one of its subagents the line says so:
    "message orches" without "about orches/2" sends the reader to somebody who
    does not know what they are being asked about."""
    sid = session.get("sid") or ""
    pid = session.get("pid") or 0
    owner = session.get("agent") or ""
    addr, status = address_of(sid, pid)
    named = party or owner
    if not addr:
        line = ("%s(no address for %s — run the ListAgents tool to find it)"
                % (lead, named or "that session"))
        return line + ('\n%s  "%s"' % (lead, about) if about else "")
    line = '%sSendMessage → to "%s"' % (lead, addr)
    if status:
        line += "   (%s)" % status
    if party and owner and party != owner:
        line += "\n%s  — it is holding this through its subagent %s; say so" % (
            lead, party)
    # The sentence, not just the address. Composing it here is the difference
    # between advice a reader has to act on and advice they have to write first,
    # and the whole reason asking is worth doing is that it is now cheap.
    if about:
        line += '\n%s  "%s"' % (lead, about)
    return line


# -------------------------------------------------------------- subagents ----
#
# A subagent launched with the Task tool runs inside its parent's process and
# its hooks carry the parent's `session_id`. Everything here treats "who is
# acting" as a *party* rather than a session: the session itself, or one
# subagent within it.
#
# That matters because two subagents run genuinely in parallel. Before this they
# shared an identity, so a lock one held read as "already yours" to the other
# and both walked through — two agents driving one simulator, which is the
# failure this plugin exists to stop, happening inside a single session.
#
# What tells them apart is `agent_id`, which Claude Code puts on every hook a
# subagent causes — SubagentStart, its own PreToolUse, PostToolUse and
# PostToolBatch, and SubagentStop — and on none that the session itself causes.
# It is *not* in the environment of the Bash tool, so the CLI cannot know which
# subagent is calling it; every decision that needs to know is therefore made in
# the hook, where it is known.

def safe_id(s):
    """An id as a filename component, and nothing else.

    Claude Code's session and agent ids are uuids, so for every real one this
    returns the id unchanged. But the id arrives on a hook payload and is
    interpolated straight into `sessions/<sid>.json`, `<sid>.beat`,
    `cursors/<party>`, `hot-for/<sid>`, `writes/<sid>.log` and
    `owns/<sid>.json` — a dozen paths built from a value nothing checked. One
    that is not a uuid therefore writes wherever it says: measured, an id of
    `../../escaped` put `escaped.json`, `escaped.beat` and `escaped` in the
    parent directory of AGENTBUS_HOME, outside the state directory entirely.

    Sanitised where an id ENTERS rather than at each path built from it, so the
    value used for identity and the value used for a filename cannot drift
    apart — two records that disagree about which is which would be a worse
    defect than the one being fixed. `agent_path` has always sanitised this way
    and is the reason only the session side was exposed."""
    return re.sub(r"[^A-Za-z0-9_.-]", "_", s or "")


def agent_path(sid, aid):
    return os.path.join(AGENTS, "%s.json" % safe_id("%s__%s" % (sid, aid)))


def load_agents(sid=None):
    """Live subagents, optionally just one session's."""
    out = []
    try:
        names = os.listdir(AGENTS)
    except OSError:
        return out
    for name in sorted(names):
        if not name.endswith(".json"):
            continue
        rec = read_json(os.path.join(AGENTS, name))
        if not rec or (sid and rec.get("sid") != sid):
            continue
        out.append(rec)
    out.sort(key=lambda r: r.get("started", 0))
    return out


def forget_agent(sid, aid):
    release_all_for(sid, aid, quiet=True)
    forget_action(party_key({"sid": sid, "agent_id": aid}))
    for path in (agent_path(sid, aid),
                 os.path.join(CURSORS, party_key({"sid": sid, "agent_id": aid}))):
        try:
            os.unlink(path)
        except OSError:
            pass


def party_key(me):
    """One string naming the party that acts: a session, or a subagent in it.

    Sanitised because this is a filename as well as a name: cursors, hints and
    the live line are all filed under it, and an `agent_id` reaches here from a
    payload without passing through `resolve_party`'s own check. See `safe_id`."""
    aid = safe_id(me.get("agent_id") or "")
    sid = safe_id(me.get("sid") or "")
    return "%s__%s" % (sid, aid) if aid else sid


# ------------------------------------------------------- what it last did ----
#
# The board's live line: "editing api/routes.py, 4s ago". Derived, not reported.
#
# The alternative was asking every agent to write a sentence about itself every
# minute. One `agentbus doing` call is 72 ms of engine, which is not the cost
# that matters — the cost is a tool call per minute, its round trip, and the
# agent's own context filling up with status reports. It is unreliable as well:
# on the live bus one agent in six used `take` at all. The hooks already see
# every tool call, so the board can watch instead of asking.
#
# Three rules make it affordable, and all three are about the WRITE:
#
#   * it never wakes the engine. The line is written from `bin/ab-hook`, which
#     for most tool calls is the only thing that runs — a `printf` into a file
#     the fast path has already got the payload for.
#   * it is one line per party, overwritten. Not a log: nothing here may grow
#     with how long the machine has been up.
#   * the file's mtime IS the timestamp, exactly as the heartbeat's is. Reading a
#     clock in bash 3.2 means a `date` subprocess, and this runs on every tool
#     call of every session on the machine.
#
# It sits beside `doing` rather than replacing it. `doing` is *intent*, which no
# amount of watching can derive: "editing api/routes.py" does not tell you the
# agent is halfway through moving authentication out of the request handler.

def acted_path(key):
    """Where one party's last action is written, or None for a key that may not
    become a filename.

    Both fast paths apply exactly this rule and skip the write when it fails, so
    a party whose id carries anything else simply has no line — rather than the
    two entry points disagreeing about where to put it, or either of them being
    talked into writing outside the bus by a `/` in an id."""
    if not key or re.search(r"[^A-Za-z0-9_.-]", key):
        return None
    return os.path.join(ACTED, key)


def last_action(key):
    """What this party last did, as `{tool, what, at}` — or None.

    `at` is the file's modification time, which is what the fast path wrote it
    with. Only the first line is read and only the first two fields are parsed,
    so a file that somehow grew cannot cost more than one line to read."""
    path = acted_path(key)
    if not path:
        return None
    try:
        with open(path, encoding="utf-8-sig", errors="replace") as fh:
            line = fh.readline(512).strip()
        at = int(os.path.getmtime(path))
    except (OSError, IOError, ValueError):
        return None
    if not line:
        return None
    parts = line.split(" ", 1)
    return {"tool": parts[0][:24], "at": at,
            "what": (parts[1] if len(parts) > 1 else "")[:200]}


# Claude Code's own directory. A file in here is a different KIND of fact from a
# file in the repository — it is the harness's storage, not the work — and the
# board says which rather than drawing the two the same way.
HARNESS = os.path.join(HOME, ".claude")


def action_view(did, root):
    """One party's last action as the board says it.

    The fast path writes what the payload carried and cannot do better: it has no
    idea which checkout the party is in, and it must not spend a subprocess
    finding out. So the reader's side does the three things that need to know.

    An absolute path inside the checkout becomes the repository-relative one —
    the same form the files-written list uses, and the row is already standing on
    a strip that says where the checkout is. A prefix test rather than `realpath`,
    because this runs per party per poll and a window that only watches does not
    get to spend syscalls on presentation.

    A path that is NOT in the checkout gets `where`, a phrase from a vocabulary
    of two that the board draws beside the path and never cuts. Without it a
    left-cut path reads as though the repository contained it. The one worth
    telling apart is Claude Code's own directory: an agent editing its own
    memory file under `~/.claude/projects/<flattened-path>/memory/` is doing
    something real, and drawing it as a headline the way a source file is drawn
    put sixty characters of machine-flattened path where the filename should be.
    That segment is dropped — it is the project's own path with the separators
    swapped, which is the fact the strip's heading already carries, so this is
    the same elision the checkout root already gets. Everything else about the
    path stays, and the title carries the whole of it either way.

    And `cd <somewhere> && …` loses the `cd`. Half the commands on a machine with
    several worktrees start that way, and a board whose every line began "ran cd
    /Users/…" would be saying the one thing the strip above it already said.

    Nothing is cut to a character count here. The board cuts this line to the
    width of the cell it is drawn in, which is a length this function cannot
    know, and a second cut upstream would only take the end the board is keeping
    — which is what happened to a path under `~/.claude`: cut at 96 characters
    from the right, the filename was the part that went."""
    if not did:
        return did
    what = did.get("what") or ""
    did["where"] = ""
    if did.get("tool") == "Bash":
        what = re.sub(r"^cd\s+(?:'[^']*'|\"[^\"]*\"|\S+)\s*&&\s*", "", what)
    elif what:
        base = (root or "").rstrip(os.sep)
        if base and what.startswith(base + os.sep):
            what = what[len(base) + 1:]
        elif what.startswith(HARNESS + os.sep):
            what = flat_free(what[len(HARNESS) + 1:])
            did["where"] = "in ~/.claude"
        else:
            what = short_path(what)
            did["where"] = "outside this checkout"
    did["what"] = what
    return did


def flat_free(rest):
    """`projects/<flattened absolute path>/…` with that one segment elided.

    Only a segment that really is a flattened path — Claude Code builds it by
    replacing every separator in the project's own root with `-`, so it begins
    with one — and only directly under `projects/`, so a directory somebody named
    themselves is left exactly as it is."""
    parts = rest.split("/")
    if len(parts) > 2 and parts[0] == "projects" and parts[1].startswith("-"):
        parts[1] = "…"
    return "/".join(parts)


def forget_action(key):
    path = acted_path(key)
    if not path:
        return
    try:
        os.unlink(path)
    except OSError:
        pass


def sweep_acted(sessions):
    """Lines belonging to parties that have gone.

    `forget_session` and `forget_agent` delete their own on the way out, so this
    is only for the party that never got to: a session killed with -9 leaves no
    SessionEnd. Without it the directory would be the one piece of unbounded
    state on the bus — one file per chat this machine has ever run."""
    # One listdir of `agents/` for the whole sweep. `load_agents(sid)` reads the
    # directory once per session it is asked about, which on a machine running
    # nine chats is nine passes over the same files to answer one question.
    live = {s["sid"] for s in sessions}
    for a in load_agents():
        live.add(party_key({"sid": a.get("sid"), "agent_id": a.get("agent_id")}))
    try:
        names = os.listdir(ACTED)
    except OSError:
        return
    for name in names:
        if name in live:
            continue
        try:
            os.unlink(os.path.join(ACTED, name))
        except OSError:
            pass


_SIBLINGS = {}


def sibling_count(sid):
    """How many subagents this session has.

    Memoised for the life of the process, which for a hook is one call and for
    the CLI is one command. The exception is `agentbus wait`, which loops for up
    to ninety seconds and will not notice a subagent starting or stopping under
    it — it would keep treating an unidentified lock as blocking for the rest of
    that wait. Worth knowing rather than worth a cache invalidation: the wrong
    answer there is one the caller was already going to sit through."""
    if sid not in _SIBLINGS:
        _SIBLINGS[sid] = len(load_agents(sid))
    return _SIBLINGS[sid]


def same_party(holder, me, siblings=None):
    """Whether a lock held by `holder` is already this caller's to use.

    Two different subagents conflict. A parent and its own subagent never do —
    a parent that claimed something and then delegated must not deadlock against
    the agent it is waiting for, and a backgrounded subagent must not be blocked
    by the session that started it.

    The awkward case is a lock with no `agent_id` at all. It means one of two
    things and they want opposite answers: the session itself took it (in which
    case its own subagents must pass), or it was taken through the CLI, where a
    subagent cannot be told from its parent (in which case the siblings must
    NOT pass). Locks now say which — `party_known` — because reading the second
    as the first is what let three subagents drive one simulator on 2026-07-29
    while each was told it held it alone.

    With fewer than two subagents the ambiguity cannot do harm: parent and only
    child never conflict in either direction, so an unidentified holder is left
    permissive rather than blocking a session against itself.

    The ambiguity has two sides and they reason identically. A lock with no
    `agent_id` may or may not be the session's; a CALLER with no `agent_id` may
    or may not be the session either — a hook is told, and a shell cannot be. So
    a caller that cannot say which agent it is gets the same treatment as a lock
    that cannot: permissive while there is at most one subagent, blocking once
    there are two."""
    if (holder.get("sid") or "") != (me.get("sid") or ""):
        return False
    a = holder.get("agent_id") or ""
    b = me.get("agent_id") or ""
    if a == b:
        return True
    if a and b:
        return False        # two different subagents: the case that must serialise
    if a and not b:
        # A named subagent holds it and the caller has no id. From a hook that
        # means the session itself, which never contends with its own subagent.
        # From a shell it means nothing at all: `agentbus wait db` typed any way
        # but the line the guard saw carries no hint, and answering "already
        # yours" against a sibling's lock made the wait print `claimed 'db'`,
        # exit 0 and leave the sibling that read the advice still blocked —
        # having upgraded its one-command soft lock to hard on the way past,
        # which release_autoclaim then would not give back.
        if me.get("party_known"):
            return True
        if siblings is None:
            siblings = sibling_count(holder.get("sid"))
        return siblings < 2
    if holder.get("party_known", True):
        return True         # the side with no id is known to be the session itself
    if siblings is None:
        siblings = sibling_count(holder.get("sid"))
    return siblings < 2


def may_release(lock, me, siblings=None):
    """Whether this caller may hand back that lock.

    Stricter than `same_party` on purpose. Guarding asks "would running this
    collide", and a parent must not collide with its own subagent. Releasing
    asks "is this yours to give away", and a sibling running `agentbus release`
    through the CLI looks exactly like the parent — which is how one agent
    could hand back another's rig in the middle of its run."""
    if not same_party(lock, me, siblings):
        return False
    a = lock.get("agent_id") or ""
    if not a or a == (me.get("agent_id") or ""):
        return True
    # The lock names a specific subagent and the caller cannot prove it is that
    # subagent. `--as` is how it says so; `release --all` is how a session gives
    # back everything it owns without having to.
    return bool(me.get("party_known"))


# `2>&1`, `>out.log`, `> out.log`, `&>/dev/null`, `<<<"$x"`, `<<EOF`: the shell
# acts on these and the program never sees them. The first group is the file
# descriptor, the second whatever target came attached to the operator.
REDIRECTION = re.compile(r"^(?:\d+|&)?(?:>>|>\||>&|>|<<<|<<-?|<&|<>|<)(.*)$")


def without_redirections(tokens):
    """The words a shell hands the program, from the words it was given.

    `shlex` keeps a redirection as a word of the command, so `agentbus wait db
    2>&1` tokenises to five words where the process gets four. A redirection
    with its target attached is one word to drop; a bare operator takes the
    word after it with it. So does a trailing `&`, which `split_segments` does
    not split on."""
    out, i = [], 0
    while i < len(tokens):
        m = REDIRECTION.match(tokens[i])
        if m:
            i += 1 if m.group(1) else 2
        elif tokens[i] == "&":
            i += 1
        else:
            out.append(tokens[i])
            i += 1
    return out


def hint_key(tokens):
    """A key both halves of one `agentbus` command can compute independently.

    The hook sees the whole command line and knows which subagent is running it;
    the CLI knows neither. They do share the argv of the `agentbus` call itself,
    so the hook can leave the party under that key and the CLI can pick it up.

    Shared once the redirections are gone, and not before. The hook reads them
    as words and the process never receives them, so `agentbus wait db --why x
    2>&1 | tail -3` left its hint under one key and looked for it under another.
    That is how most subagents call it: of 125 `wait`s without `--as` in this
    machine's subagent transcripts, 97 ended in a redirection. Each of those
    missed its hint and took the lock in the session's name, and once a second
    subagent was live, the one that had queued was blocked by it. All eleven `steal`s on the log to 2026-09-22 were a subagent forcing a
    lock off its own parent, and eight of them said in their reason that the
    lock was theirs. Both sides strip, so a `--why ">"` that the shell did pass
    through is dropped from both and the keys still agree."""
    import hashlib
    tokens = without_redirections(tokens or [])
    if not tokens:
        return ""
    words = [os.path.basename(tokens[0])] + list(tokens[1:])
    return hashlib.sha1("\x00".join(words).encode("utf-8")).hexdigest()[:16]


def leave_party_hint(me, cmd):
    """Record which party is about to run a lock-taking `agentbus` command.

    Every such command passes through this hook first, and this hook is the one
    place that knows who is running it: `agent_id` when a subagent is, and its
    absence — which Claude Code guarantees for the session's own calls — when
    the session itself is. Either answer is worth recording, because the CLI a
    few milliseconds later can establish neither.

    A command the hook never sees, because it is buried in a runner script, has
    no hint and its lock has to admit it cannot name its party."""
    for seg in split_segments(strip_heredocs(cmd or "")):
        toks = tokens_of(seg)
        while toks and (re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", toks[0])
                        or os.path.basename(toks[0]) in WRAPPERS):
            toks = toks[1:]
        if len(toks) < 2 or os.path.basename(toks[0]) != "agentbus":
            continue
        if toks[1] not in (CLAIMING_VERBS + PASSTHROUGH_VERBS + PARTY_VERBS):
            continue
        key = hint_key(toks)
        if not key:
            continue
        path = os.path.join(HINTS, "%s.json" % key)
        with Mutex("hint"):
            rec = read_json(path) or {}
            waiting = [w for w in rec.get("waiting", [])
                       if now() - w.get("at", 0) < 60]
            waiting.append({"sid": me.get("sid"),
                            "agent_id": me.get("agent_id") or "",
                            "agent": me.get("agent"), "at": now()})
            write_json(path, {"waiting": waiting[-8:]})


def take_party_hint(rec):
    """The party this CLI call belongs to, if its hook left one.

    Two subagents running the *identical* command line at the same moment can
    swap hints. Both are real parties of the same session and the window is one
    process start wide, which is a far smaller error than the one this fixes."""
    key = hint_key(["agentbus"] + sys.argv[1:])
    if not key:
        return None
    path = os.path.join(HINTS, "%s.json" % key)
    if not os.path.exists(path):
        return None     # the common case: no mutex, no work
    with Mutex("hint"):
        data = read_json(path)
        if not data:
            return None
        waiting = [w for w in data.get("waiting", [])
                   if now() - w.get("at", 0) < 60
                   and w.get("sid") == rec.get("sid")]
        if not waiting:
            return None
        mine = waiting.pop(0)
        if waiting:
            write_json(path, {"waiting": waiting})
        else:
            try:
                os.unlink(path)
            except OSError:
                pass
    return mine


def sweep_hints():
    """Hints nobody came back for. A command the guard saw and the CLI never
    ran — denied, or interrupted — leaves one behind."""
    cutoff = now() - 300
    try:
        names = os.listdir(HINTS)
    except OSError:
        return
    for name in names:
        path = os.path.join(HINTS, name)
        try:
            if os.path.getmtime(path) < cutoff:
                os.unlink(path)
        except OSError:
            pass


def subagent_name(parent_agent, sid):
    """`checkout-rewrite/2` — obviously that session's, and typeable."""
    taken = {a.get("name") for a in load_agents(sid)}
    for n in range(1, 60):
        cand = "%s/%d" % (parent_agent or "agent", n)
        if cand not in taken:
            return cand
    return "%s/x" % (parent_agent or "agent")


def register_agent(sid, aid, agent_type=None, cwd=None):
    """Record a subagent. Also reachable from the ordinary hooks, because a
    subagent that missed SubagentStart — the plugin was installed or reloaded
    while it was already running — would otherwise stay nameless and invisible
    for its whole life. Sessions have had the same fallback since the beginning;
    this is the same idea one level down."""
    if not sid or not aid:
        return None
    ensure_dirs()
    parent = read_json(os.path.join(SESSIONS, "%s.json" % sid)) or {}
    cwd = cwd or parent.get("cwd") or os.getcwd()
    root, repo_key, label, branch = git_facts(cwd)
    rec = {"sid": sid, "agent_id": aid, "agent_type": agent_type or "agent",
           "name": subagent_name(parent.get("agent"), sid),
           "parent": parent.get("agent"), "cwd": cwd, "root": root,
           "repo_key": repo_key, "repo_label": label, "branch": branch,
           "keyrev": KEY_REV, "started": now(), "seen": now()}
    write_json(agent_path(sid, aid), rec)
    # Its cursor starts at the end of the stream: a subagent that lives for two
    # minutes does not want the last hour of the repository's chatter.
    write_text(os.path.join(CURSORS, party_key({"sid": sid, "agent_id": aid})),
               "%d\n" % read_int(SEQFILE, 0))
    return rec


def hook_subagent_start(payload):
    register_agent(payload.get("session_id"), payload.get("agent_id"),
                   payload.get("agent_type"), payload.get("cwd"))


def hook_subagent_stop(payload):
    sid, aid = payload.get("session_id"), payload.get("agent_id")
    if sid and aid:
        forget_agent(sid, aid)


def name_hint_once(me):
    """Told to a subagent once: the name everybody else sees it by.

    A subagent has no way to find this out for itself. Its Bash environment is
    its parent's, so anything it does through the CLI is attributed to the
    parent — and the agents on this machine had noticed, and were writing
    "(agent /2)" into the body of every message by hand to compensate. Giving
    them the name is the honest fix: the tool should do that, not the agent.

    The name is also the reason a subagent cannot simply be messaged. It is a
    party on this bus and not a session anywhere else, so `SendMessage` cannot
    reach it: another session addresses the session that started it, and says
    which subagent it means. That is worth telling it once, because a subagent
    that expects to be written to directly waits for something that cannot
    arrive."""
    aid = me.get("agent_id")
    if not aid:
        return ""
    rec = read_json(agent_path(me.get("sid"), aid))
    if not rec or rec.get("told"):
        return ""
    rec["told"] = now()
    write_json(agent_path(me.get("sid"), aid), rec)
    return ("agent-bus: on this machine you are `%s` — that is the name the "
            "other agents see you under. Claim what you take with it, or the "
            "lock is filed under the session that started you and your sibling "
            "walks through it:\n"
            "  agentbus claim <res> --as %s --why \"...\"\n"
            "Nobody can message you directly: SendMessage reaches sessions, so "
            "another agent writes to the session you belong to and names you."
            % (rec["name"], rec["name"]))


def _follow_agent_cwd(rec, cwd, trusted=True):
    """Keep a subagent's recorded worktree in step with where it is working.

    Private to `resolve_party`, and the inferring half of clause (b) of *where
    they are working*. The declaring half is `agentbus here --as <name>`, which
    writes the `pinned` flag this function refuses to move.

    Its record is written at SubagentStart from whatever directory it was
    launched in, which for a subagent is its parent's rather than the tree it
    was told to work in. Everything then read that. On 2026-07-29 an agent that
    had itself pointed the API at its own worktree was refused permission to use
    it — the guard compared against the root it was born with — and it carried
    on with AGENTBUS_OFF=1 rather than argue, which is the one outcome this
    plugin cannot afford.

    The objection that stopped sessions following their cwd does not apply one
    level down: that was two subagents dragging their *parent's* single root
    between them, and here each subagent has a record of its own.

    A cwd equal to the parent's is not evidence. It is what a subagent's payload
    says when it has never changed directory, whatever tree it was told to work
    in, so it says nothing about where the work is and nothing may move on it.

    That guard used to be the whole of a subagent's protection. `agentbus here
    --as <name>` wrote the same five location fields as `agentbus here` and no
    flag, so a session's declaration was protected by `pinned` and a subagent's
    only by the coincidence that its payload happened to name its parent's tree
    — any *other* cwd overwrote what it had declared, on the next tool call. The
    flag exists at both levels now, and a pinned agent is left alone here for
    the reason `_follow_cwd` leaves a pinned session alone."""
    # The same repair one level down, and it matters MORE here: a subagent's
    # record is written once at SubagentStart and `register_agent` is reached
    # again only if the record is missing, so nothing else would ever re-derive
    # it. A subagent launched into a subdirectory would hold a wrong key for its
    # whole life, and its own parent could not hear it.
    if rec and rec.get("sid") and rec.get("agent_id"):
        rec = heal_derived(rec, agent_path(rec["sid"], rec["agent_id"]))
    if not rec or not cwd or cwd == rec.get("cwd"):
        return rec
    if rec.get("pinned"):
        # Somebody said where this agent is working, with `agentbus here --as`.
        # A declaration has to outlast the inference that contradicts it;
        # `agentbus here` somewhere else moves it again.
        return rec
    parent = read_json(os.path.join(SESSIONS, "%s.json" % rec.get("sid"))) or {}
    if cwd == parent.get("cwd"):
        return rec
    root, repo_key, label, branch = git_facts(cwd)
    # A hook payload's cwd is the agent's own and is taken as given. A shell's
    # is only wherever the command happened to be run from — `agentbus run` from
    # a scratch directory, or from $HOME — so from there a move is followed only
    # within the same repository. Without this an agent could be relocated out
    # of its own project by a single command, and every guard would then read
    # its config from somewhere that declares nothing.
    if not trusted and repo_key != rec.get("repo_key"):
        return rec
    rec.update({"cwd": cwd, "root": root, "repo_key": repo_key,
                "repo_label": label, "branch": branch})
    write_json(agent_path(rec.get("sid"), rec.get("agent_id")), rec)
    return rec


def _party_view(me, payload):
    """`me`, seen as whichever party is actually acting.

    A subagent gets its own name and its own worktree; everything else — the
    repo, the session id — it shares with its parent.

    Private to `resolve_party`, where it carries clause (a) of *who is acting*
    and clause (b) of *where they are working* together, because for a subagent
    they are one lookup. Note what it does NOT copy back out: the view is built
    with `dict(me)`, so the parent's `pinned` rides along, and that flag must
    never be read as the subagent's own declaration — the agent's own pin lives
    on the agent record, where `_follow_agent_cwd` reads it off disk. One field
    with two meanings is how a subagent's `agentbus here --as` would end up
    pinning its parent."""
    aid = payload.get("agent_id") if payload else None
    if not aid:
        return me
    view = dict(me)
    view["agent_id"] = aid
    view["agent_type"] = payload.get("agent_type") or "agent"
    rec = read_json(agent_path(me.get("sid"), aid))
    if rec:
        rec = _follow_agent_cwd(rec, payload.get("cwd"))
    else:
        # SubagentStart was missed — the plugin was installed or reloaded while
        # this subagent was already running. Record it now rather than leaving
        # it nameless for the rest of its life.
        rec = register_agent(me.get("sid"), aid, view.get("agent_type"),
                             payload.get("cwd") or me.get("cwd"))
    if rec:
        view["agent"] = rec.get("name") or view.get("agent")
        for k in ("cwd", "root", "repo_key", "repo_label", "branch"):
            if rec.get(k):
                view[k] = rec[k]
    return view


# --------------------------------------------------------------- secrets ----
#
# What the bus records about a command is the command, and the command line is
# where a password gets typed. Every session on the machine can read the log,
# some kinds of event are delivered into other sessions' contexts, and a lock's
# reason is printed in every block it causes. On 2026-09-22, 127 events on this
# machine's log carried one: a database password, in a URL or as `PGPASSWORD=`,
# across lock and block events, and a bearer token in 36 wrong-port
# announcements — a kind that is delivered into other sessions' contexts.

SECRETS = (
    # scheme://user:PASSWORD@host — the password, not who or where.
    (re.compile(r"(\b[A-Za-z][A-Za-z0-9+.-]*://[^\s:/@]*:)[^\s@/]+(?=@)"),
     r"\1***"),
    # NAME=value, when the name says what the value is: `PGPASSWORD=`,
    # `SERVICE_TOKEN=`, `?api_key=` in a URL. Not `MAX_TOKENS=`, whose name is
    # not a secret's.
    (re.compile(r"(?i)(\b[a-z0-9_]*(?:password|passwd|secret|token|api_?key"
                r"|access_?key|private_?key|credentials?)(?:_[a-z0-9_]*)?=)"
                r"(?:\"[^\"]*\"|'[^']*'|[^\s&;|'\"]+)"), r"\1***"),
    # A variable whose last word is KEY — `MERCHANT_KEY=`, `API_KEY=` — and a
    # `?key=` query parameter. Upper case only for the variable: in lower case
    # `key=` is every Python sort in a pasted snippet. Not `KEYBOARD=`, either;
    # the word has to stand on its own.
    (re.compile(r"((?<![A-Za-z0-9_])(?:[A-Z0-9_]*_)?KEY=|[?&]key=)"
                r"(?:\"[^\"]*\"|'[^']*'|[^\s&;|'\"]+)"), r"\1***"),
    # `*_AUTHORIZATION=` and `*_AUTH=`, whose value is often a scheme and a
    # credential — two words, and the second is the one that matters. Last
    # word again: `SSH_AUTH_SOCK=` is a path.
    (re.compile(r"((?<![A-Za-z0-9_])(?:[A-Z0-9_]*_)?AUTH(?:ORIZATION)?=)"
                r"(?:\"[^\"]*\"|'[^']*'|\S+(?:[ \t]+[A-Za-z0-9+/=_-]{16,})?)"),
     r"\1***"),
    # --password VALUE, --token=VALUE.
    (re.compile(r"(?i)(--(?:password|passwd|token|secret|api-?key|access-?key)"
                r"(?:=|\s+))(?:\"[^\"]*\"|'[^']*'|[^\s'\"]+)"), r"\1***"),
    # An Authorization header, and a bearer token wherever it is written.
    (re.compile(r"(?i)(\bauthorization:\s*(?:\w+\s+)?)[^\s'\"]+"), r"\1***"),
    (re.compile(r"(\bBearer\s+)[^\s'\"]+"), r"\1***"),
    # Tokens that say what they are by their shape alone.
    (re.compile(r"\b(?:sk-(?:ant-)?[A-Za-z0-9_-]{16,}|gh[pousr]_[A-Za-z0-9]{20,}"
                r"|github_pat_[A-Za-z0-9_]{20,}|xox[abprs]-[A-Za-z0-9-]{10,}"
                r"|AKIA[0-9A-Z]{16}"
                r"|eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,})"),
     "***"),
)


def redact(text):
    """`text` with every secret it visibly carries replaced by `***`.

    Before any truncation, never after: a command cut at 120 characters can end
    halfway through `postgres://user:pass`, with no `@` left to say that what
    precedes it was a password.

    This is a floor, not a guarantee. It masks what announces itself — by a
    name, a flag, a header or a shape — and a password passed as a bare
    positional argument announces nothing."""
    if not text:
        return text or ""
    for pattern, replacement in SECRETS:
        text = pattern.sub(replacement, text)
    return text


# ---------------------------------------------------------------- events ----

def emit(sid, agent, repo_key, kind, text, to=None, extra=None):
    rec = {"ts": now(), "sid": sid or "", "agent": agent or "?",
           "repo": repo_key or "", "kind": kind,
           "text": redact(text or "")[:1500]}
    if to:
        rec["to"] = to
    if extra:
        rec.update(extra)
    with Mutex("events"):
        seq = read_int(SEQFILE, 0) + 1
        rec["i"] = seq
        line = json.dumps(rec, ensure_ascii=False) + "\n"
        try:
            # A single write of one short line is atomic under O_APPEND, which is
            # what lets every session share this file without a writer lock.
            flags = (os.O_CREAT | os.O_WRONLY | os.O_APPEND
                     | getattr(os, "O_BINARY", 0))
            fd = os.open(EVENTS, flags, 0o600)
            # `errors="replace"` is the floor under this, not the fix. The fix
            # is `repair_argv`, at the boundary where a lone surrogate gets in.
            # But argv is not the only way text reaches here — a path off
            # `os.listdir` can carry one too — and an event log that drops a
            # line rather than writing a `?` in it is the failure mode this
            # whole file exists to prevent somebody else having.
            os.write(fd, line.encode("utf-8", "replace"))
            os.close(fd)
        except OSError:
            return 0
        write_text(SEQFILE, "%d\n" % seq)
    return seq


def read_events(after=0):
    out = []
    try:
        with open(EVENTS, "r", encoding="utf-8-sig", errors="replace") as fh:
            for line in fh:
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if rec.get("i", 0) > after:
                    out.append(rec)
    except OSError:
        pass
    return out


def rotate_events():
    try:
        if os.path.getsize(EVENTS) < ROTATE_AT * 120:
            return
    except OSError:
        return
    # Read and write under the same mutex: reading first and trimming afterwards
    # discards everything appended in between.
    with Mutex("events"):
        try:
            with open(EVENTS, "r", encoding="utf-8-sig", errors="replace") as fh:
                lines = fh.readlines()
        except OSError:
            return
        if len(lines) >= ROTATE_AT:
            write_text(EVENTS, "".join(lines[-1000:]))


# Kinds worth interrupting another agent's turn for. Lock churn is not: with
# automatic claims lasting one command, "took 'api'" / "released 'api'" would be
# two context injections per scoped run carrying nothing anyone can act on. They
# stay in the stream for `status` and `inbox`; they just do not get delivered.
#
# `task` is: it is a sentence an agent chose to write, not machinery announcing
# itself, and the whole reason for writing it is that another chat should not
# start the same work or should learn that what it was waiting for has landed.
# Two lines per piece of work is what the roster costs today for one.
#
# `wrong-port` is the one piece of machinery in here, and it is delivered because
# of who the consequence belongs to. Every other refusal costs the session that
# was refused: it is stopped, it reads the message, it is the only one who needs
# to. A wrong-port guard that was switched off costs everybody else — the
# checkout whose service now has another tree's requests in its log, and whoever
# later reads a conclusion that was measured against code its author was not
# looking at. Telling only the party that already decided to step over it is
# telling the one person the news is not for. Bounded per party and per port by
# `astray_again`, or a run of one mistake would be the noise 2.3.0 removed.
DELIVERED_KINDS = {"serve", "wrong-port", "steal", "churn", "rename",
                   "own", "disown", "worker", "waiting"}


def interesting_to(rec, me):
    """An event reaches a session when it is addressed to it, when it happened in
    the same repository and says something, or when somebody deliberately said it
    to the whole machine. Work in another project otherwise stays out of the way
    entirely, which is what makes the rest of this readable.

    There used to be a third case, and 3.0.0 removed the only thing that could
    produce it. `agentbus post --all` reached every session on the machine, for
    the things that are true of the machine rather than of a repository — one
    simulator two projects drive, a database being reseeded. Nothing emits a
    machine-scoped event any more: every remaining producer is a fact about one
    repository. The reader for that case is not gone, though, and it is not
    served by silence — a session about to reseed still has to tell the other
    projects, and it now does so by listing them (`ListAgents`) and writing to
    each. `agentbus post` prints exactly that list rather than pretending the
    reach it used to have still exists."""
    # Not `sid`: a subagent shares its parent's, and a message from one to the
    # other would be filtered out as the reader's own.
    if rec.get("sid") == me.get("sid") and rec.get("agent") == me.get("agent"):
        return False
    if rec.get("to"):
        return rec["to"] == me.get("agent")
    # An event that says it is another of something already said. It is in the log,
    # where a watcher counting a run wants it, and out of everybody's context,
    # where the twenty-seventh copy of one sentence is worth less than nothing.
    # Only `astray_again` marks one, and only after the first has been delivered.
    if rec.get("again"):
        return False
    if rec.get("kind") not in DELIVERED_KINDS:
        return False
    return rec.get("repo") == me.get("repo_key")


def cursor_of(me, seq=None):
    """How far through the log this party has been shown, clamped to the log.

    A cursor above the sequence number means the counter was reset or restored
    under us — treat it as unread from the start rather than wedging the session
    on a number the log will take days to reach again."""
    if seq is None:
        seq = read_int(SEQFILE, 0)
    cursor = read_int(os.path.join(CURSORS, party_key(me)), 0)
    return 0 if cursor > seq else cursor


def unseen(me, log=None):
    """What this party has not been shown: (everything after its cursor, the
    part addressed to it, its cursor, the sequence number). Writes nothing.

    Split out of `deliver` so the *count* can be asked for without the prose.
    The board wants "how far behind is this session" for every live session on
    every poll, and `deliver` answers with an English sentence that happens to
    contain the number. One body, so the number a watcher reads is the number
    the session will be handed.

    `log` is for a caller that has already read the log from at or below this
    party's cursor — the board reads it once and asks five times, where five
    reads would cost several times the whole poll."""
    seq = read_int(SEQFILE, 0)
    cursor = cursor_of(me, seq)
    if seq <= cursor:
        return [], [], cursor, seq
    fresh = ([r for r in log if r.get("i", 0) > cursor] if log is not None
             else read_events(after=cursor))
    return fresh, [r for r in fresh if interesting_to(r, me)], cursor, seq


def deliver(me, advance=True):
    """Everything this session has not been shown yet, formatted for context."""
    key = party_key(me)
    fresh, mine, cursor, seq = unseen(me)
    if seq <= cursor:
        return ""
    if advance:
        # Advance to what was actually read, not to the sequence number sampled
        # before reading: an event appended in between would be shown twice.
        top = max([seq] + [r.get("i", 0) for r in fresh])
        write_text(os.path.join(CURSORS, key), "%d\n" % top)
    if not mine:
        return ""
    shown = mine[-MAX_DELIVER:]
    lines = []
    for r in shown:
        who = r.get("agent", "?")
        # Kept, and it means more than it used to rather than less: what is
        # addressed now is a fact about the reader — a lock taken from under it,
        # a queue it is holding up — and not a sentence somebody chose to send.
        direct = " → you" if r.get("to") else ""
        text = r.get("text", "")
        if "\n" in text:
            # A handoff is inherently several lines; folding it into the
            # one-line form would run the whole summary together and make the
            # thing that is worth reading the thing that gets skimmed.
            body = "\n".join("      " + ln for ln in text.split("\n"))
            lines.append("  - %s%s, %s:\n%s" % (who, direct, ago(r.get("ts")), body))
        else:
            lines.append("  - %s%s, %s: %s" % (who, direct, ago(r.get("ts")), text))
    head = ("agent-bus — %d thing%s changed under you while you were working:"
            % (len(mine), "" if len(mine) == 1 else "s"))
    if len(mine) > len(shown):
        head += " (showing the last %d)" % len(shown)
    return head + "\n" + "\n".join(lines)


# ----------------------------------------------------------------- locks ----

def lock_path(repo_key, res):
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", "%s__%s" % (repo_key, res))
    return os.path.join(LOCKS, "%s.json" % safe)


def load_lock(repo_key, res):
    return read_json(lock_path(repo_key, res))


def lock_state(lock, sessions):
    """(holder record or None, stealable, why-stealable)"""
    if not lock:
        return None, True, "free"
    holder = next((s for s in sessions if s["sid"] == lock.get("sid")), None)
    if holder is None:
        return None, True, "holder is gone"
    ttl = HARD_TTL if lock.get("mode") == "hard" else SOFT_TTL
    if now() - lock.get("last_used", 0) > ttl:
        return holder, True, "lock expired"
    if lock.get("mode") == "soft" and now() - holder.get("beat", 0) > IDLE_SECS:
        return holder, True, "holder idle and holding only a soft lock"
    return holder, False, ""


def plain_name(key):
    """The resource as a person calls it, from the key it is locked under.

    `worktree@3f9c1a` is how a per-checkout lock is filed; nobody typed that and
    nothing takes it as an argument, so it must not appear in the log either."""
    return (key or "").split("@")[0]


def announce_locks(me, verb, names, why=""):
    """One line for a deliberate claim, and its matching one when it ends.

    On 2026-07-29 the stream carried 219 releases and 7 takes. Every one of the
    51 `agentbus run` invocations that day was silent going in and loud coming
    out: the guard takes the lock before the CLI is even running, the CLI finds
    it already its own and says nothing, and only the release speaks. Somebody
    reading `agentbus watch` saw a wall of things being handed back and could
    not see a single one being taken."""
    if not names:
        return
    shown = [plain_name(n) for n in names]
    tail = (" +%s" % ", ".join(shown[1:])) if len(shown) > 1 else ""
    emit(me.get("sid"), me.get("agent"), me.get("repo_key"), "lock",
         "%s '%s'%s%s" % (verb, shown[0], tail, (" — " + why) if why else ""))


def do_claim(me, res, why="", mode="soft", steal=False, sessions=None,
             announced=False):
    """(ok, lock, holder, reason). Never blocks; `wait` is the blocking form.

    `announced` says the caller is putting a line in the stream for this claim
    itself, so the release can match it. A claim nobody announced is released
    in silence too — automatic ones last a single command and two events each
    would drown everything worth reading."""
    sessions = sessions if sessions is not None else load_sessions()
    repo_key = me.get("repo_key", "")
    # The reason is kept in the lock and printed in every block the lock causes,
    # to whoever it blocks. `run` without `--why` makes it the command line.
    why = redact(why)
    with Mutex("lock-" + re.sub(r"[^A-Za-z0-9]", "_", res)[:40]):
        lock = load_lock(repo_key, res)
        holder, stealable, reason = lock_state(lock, sessions)
        if lock and same_party(lock, me):
            lock["last_used"] = now()
            if mode == "hard":
                lock["mode"] = "hard"
                if why:
                    lock["why"] = why
            write_json(lock_path(repo_key, res), lock)
            return True, lock, None, "already yours"
        if holder and not stealable and not steal:
            return False, lock, holder, reason
        queue = (lock or {}).get("queue", []) if lock else []
        queue = [q for q in queue if q.get("sid") != me.get("sid")]
        spoken = bool(holder) or mode == "hard" or bool(why) or announced
        new = {"resource": res, "repo": repo_key, "sid": me.get("sid"),
               "announced": spoken,
               "agent_id": me.get("agent_id") or "",
               # Whether the empty `agent_id` above means "the session itself"
               # or "nobody could tell". `same_party` needs the difference.
               "party_known": bool(me.get("party_known")),
               "agent": me.get("agent"), "worktree": me.get("root"),
               "branch": me.get("branch"), "mode": mode, "why": why,
               "acquired_at": now(), "last_used": now(), "queue": queue}
        if not write_json(lock_path(repo_key, res), new):
            # Reporting a claim we could not record would hand out the resource
            # to everyone who asks.
            return False, lock, holder, "could not write the lock file"
    if holder:
        # A takeover is not lock churn and is not delivered as such: it is the
        # one lock event somebody needs to be told about, because the party that
        # had it is about to run a command believing it still does. Addressed
        # with the LOCK's agent rather than the session's — a lock a subagent
        # took is held by that subagent, and telling its parent leaves the party
        # that actually lost it uninformed. Until now the thief told the victim
        # by hand, on a channel that no longer exists.
        emit(me.get("sid"), me.get("agent"), repo_key,
             "steal" if steal else "lock",
             "took '%s' from %s (%s)%s" % (plain_name(res), holder.get("agent"),
                                           "forced" if steal else reason,
                                           (' — ' + why) if why else ""),
             to=(lock or {}).get("agent") or holder.get("agent"))
    elif mode == "hard" or why:
        emit(me.get("sid"), me.get("agent"), repo_key, "lock",
             "took '%s'%s" % (plain_name(res), (' — ' + why) if why else ""))
    return True, new, holder, ""


def do_release(me, res, quiet=False):
    repo_key = me.get("repo_key", "")
    # Check and unlink under the same mutex do_claim uses: between a bare check
    # and the unlink, another session can legitimately take the lock, and then
    # this would delete theirs.
    with Mutex("lock-" + re.sub(r"[^A-Za-z0-9]", "_", res)[:40]):
        lock = load_lock(repo_key, res)
        if not lock or not may_release(lock, me):
            return False
        waiting = lock.get("queue", [])
        try:
            os.unlink(lock_path(repo_key, res))
        except OSError:
            return False
    # A release is only worth a line if the claim it answers had one. Otherwise
    # the stream fills with the second half of conversations that never had a
    # first half — which is exactly what it did.
    if not quiet and lock.get("announced", True):
        tail = ""
        if waiting:
            tail = " — waiting: %s" % ", ".join(q.get("agent", "?") for q in waiting)
        emit(me.get("sid"), lock.get("agent") or me.get("agent"), repo_key,
             "lock", "released '%s'%s" % (plain_name(res), tail))
    return True


def release_all(sid, quiet=False):
    try:
        names = os.listdir(LOCKS)
    except OSError:
        return 0
    n = 0
    for name in names:
        lock = read_json(os.path.join(LOCKS, name))
        if lock and lock.get("sid") == sid:
            try:
                os.unlink(os.path.join(LOCKS, name))
                n += 1
            except OSError:
                pass
            if not quiet:
                emit(sid, lock.get("agent"), lock.get("repo"), "lock",
                     "released '%s'" % lock.get("resource"))
    return n


def release_all_for(sid, aid, quiet=False):
    """Everything one subagent was holding, given back when it stops."""
    try:
        names = os.listdir(LOCKS)
    except OSError:
        return 0
    n = 0
    for name in names:
        lock = read_json(os.path.join(LOCKS, name))
        if not lock or lock.get("sid") != sid or (lock.get("agent_id") or "") != aid:
            continue
        try:
            os.unlink(os.path.join(LOCKS, name))
            n += 1
        except OSError:
            pass
        if not quiet:
            emit(sid, lock.get("agent"), lock.get("repo"), "lock",
                 "released '%s'" % lock.get("resource"))
    return n


def held_by(sid):
    out = []
    try:
        for name in os.listdir(LOCKS):
            lock = read_json(os.path.join(LOCKS, name))
            if lock and lock.get("sid") == sid:
                out.append(lock)
    except OSError:
        pass
    return out


def all_locks():
    """Every lock on the bus, raw. One listdir for the callers that need several
    questions answered about the same set — who holds what, and who is queued
    behind whom — rather than one apiece."""
    out = []
    try:
        names = sorted(os.listdir(LOCKS))
    except OSError:
        return out
    for name in names:
        if not name.endswith(".json"):
            continue
        lock = read_json(os.path.join(LOCKS, name))
        if lock:
            out.append(lock)
    return out


# ------------------------------------------------------------------ tasks ----
#
# A lock says "I am using this right now". Ownership says "this part of the tree
# is mine". Neither says what an agent is *trying to do*, or that it cannot get
# on until somebody else has finished — and with several chats open on one
# repository that is the half a person ends up holding in their head, routing by
# hand: "coordinate between yourselves, how do I get both of you to main".
#
# The agents write this, not the person watching, and that decides its shape.
# Agents forget, and it was measured here rather than guessed at: `AGENTBUS_OFF`
# became a reflex, 88 uses in 48 hours of which 76 overrode nothing at all. The
# same failure with the sign flipped is a ledger that is empty exactly when the
# machine is busiest. So an agent types one line when it starts something and one
# when it finishes, and everything a declaration would have to repeat is derived
# from what the bus already records:
#
#   who owns a task, its branch, its worktree   the session record
#   what it has produced                        the write log, from when it was taken
#   which resources its owner holds             the locks
#   what its owner is queued behind             a lock's own `queue`
#   whether its owner is still there            the live session list
#
# What is left, and all that is typed, is *what am I doing* and *which other task
# has to land first*. Neither can be inferred from anything on disk: the bus can
# see a file change and cannot see an intention, and a dependency between two
# pieces of work is not a contention over a resource — there is no lock to queue
# for and nothing to wait on.
#
# Per repository, like a plain `post` and unlike `--all`: two chats merging into
# one trunk is the case, and a task graph spanning projects is not. So ids only
# have to be unique within a repository, which is what keeps them short enough
# for an agent to type.

TASK_REF = re.compile(r"^t[0-9]+$")


# ------------------------------------------------------------- ownership ----
#
# A lock says "I am using this right now". Ownership says "this part of the tree
# is mine for the next while — do not drift into it".
#
# The file guard that already exists is reactive: it blocks a write to a file
# another session touched in the last fifteen minutes. That is one edit too
# late, and it cannot express the thing people running several agents actually
# need, which is to say up front what an agent must NOT touch. Ownership is
# declared, enforced, and dies with the session that declared it — nobody has to
# remember to clean it up, and nobody has to maintain a "never touch" list by
# hand in CLAUDE.md.

def owns_path(sid):
    return os.path.join(OWNS, "%s.json" % sid)


def load_owns(sid):
    rec = read_json(owns_path(sid)) or {}
    globs = rec.get("globs")
    return globs if isinstance(globs, list) else []


def save_owns(sid, globs):
    if globs:
        return write_json(owns_path(sid), {"globs": globs})
    try:
        os.unlink(owns_path(sid))
    except OSError:
        pass
    return True


def normalise_glob(glob, root=None):
    """A declaration in the form everything else compares against: repository-
    relative, forward slashes, no leading or trailing separator. An absolute
    path inside the worktree is accepted and converted, because that is what
    tab-completion produces."""
    glob = (glob or "").strip().replace(os.sep, "/")
    if root and os.path.isabs(glob):
        rel = repo_relative(glob, root)
        if rel:
            glob = rel
    return glob.strip("/")


def glob_matches(glob, rel):
    """Does this declaration cover this repository-relative path?

    `fnmatch`, not pathlib globbing, and the difference is deliberate: here `*`
    crosses directory separators, so `src/*` covers `src/a/b.ts`. Somebody
    claiming `src/*` means the subtree, and the surprising direction would be
    the other one. It is a simplification and it is documented in SKILL.md and
    README.md rather than left to be discovered.

    A declaration with no wildcard at all is read as a directory: `agentbus own
    api` is what a person types when they mean the whole of `api/`, and owning
    exactly one file named `api` and nothing under it would be a silent no-op —
    the worst possible outcome for a guard somebody thought they had set."""
    import fnmatch
    glob = normalise_glob(glob)
    rel = (rel or "").replace(os.sep, "/")
    if not glob or not rel:
        return False
    if not any(ch in glob for ch in "*?["):
        return rel == glob or rel.startswith(glob + "/")
    # fnmatchcase, not fnmatch: fnmatch normalises case *and* separators through
    # os.path.normcase, which on Windows turns the `/` in a glob into `\` and
    # stops it matching anything at all.
    return fnmatch.fnmatchcase(rel, glob)


def glob_prefix(glob):
    """The fixed leading text of a declaration — what the shell fast path can
    grep a tool payload for before deciding to wake the engine.

    Empty when the declaration starts with a wildcard. `grep -F` reads an empty
    pattern as one that matches everything, which is the right answer: a
    declaration that cannot be pre-filtered must not become a declaration that
    is never enforced."""
    glob = normalise_glob(glob)
    cut = len(glob)
    for ch in "*?[":
        i = glob.find(ch)
        if i >= 0:
            cut = min(cut, i)
    return glob[:cut]


def ownership_covers(me, glob):
    """Whether a declaration would actually guard anything: "" when it does,
    "resource" when the caller has typed a resource name where a path goes, and
    "nothing" when it matches no path in the repository.

    `own` and `claim` take arguments that look the same and mean different
    things — a path glob and a resource name — and the failure is silent in the
    direction that matters: the declaration is recorded, `status` lists it, and
    nothing is protected."""
    root = me.get("root")
    if not glob or not root:
        return ""
    if any(ch in glob for ch in "*?["):
        import glob as globmod
        hits = globmod.glob(os.path.join(root, glob.replace("/", os.sep)))
        return "" if hits else "nothing"
    if os.path.exists(os.path.join(root, glob.replace("/", os.sep))):
        return ""
    cfg = repo_config(me.get("repo_key"), root)
    if any(r.get("name") == glob for r in cfg.get("resources", [])):
        return "resource"
    return "nothing"


def owners_of(path, me, sessions):
    """[(session, declaration)] for every live session that has declared this
    path — this session included, so callers can see their own claim."""
    real = os.path.realpath(path)
    out = []
    for s in sessions:
        # A glob is written against a repository root, so one from another
        # project cannot describe this file even if the text happens to fit.
        if s.get("repo_key") != me.get("repo_key"):
            continue
        rel = repo_relative(real, me.get("root")) or \
            repo_relative(real, s.get("root"))
        if not rel:
            continue
        for dec in load_owns(s["sid"]):
            if glob_matches(dec.get("glob"), rel):
                out.append((s, dec))
                break
    return out


def ownership_text(me, path, owner, dec, same_tree):
    rel = repo_relative(os.path.realpath(path), me.get("root")) or path
    lines = [
        'agent-bus: BLOCKED. %s has declared this part of the tree theirs.'
        % owner.get("agent"),
        "",
        "  file    : %s" % rel,
        "  owner   : %s   branch %s" % (owner.get("agent"),
                                        owner.get("branch") or "-"),
        "  claimed : %s, %s ago" % (dec.get("glob"), held_for(dec.get("at"))),
    ]
    if dec.get("why"):
        lines.append('  reason  : "%s"' % dec["why"])
    if same_tree:
        lines.append("  worktree: %s   (the same one you are in)"
                     % short_path(owner.get("root", "")))
    else:
        # Without this the agent can see it is in a different checkout, knows
        # that means no overwrite, and concludes the bus is wrong — which is how
        # an agent learns to route around it.
        lines += [
            "  worktree: %s   (not yours)" % short_path(owner.get("root", "")),
            "",
            "  They marked this scope --strict, which means they want it left "
            "alone even",
            "  from another checkout — usually because they are restructuring "
            "it and any",
            "  parallel edit will be painful to merge.",
        ]
    lines += [
        "",
        "Ask before taking it — a message wakes them, so this is worth doing "
        "and not a formality:",
        say_to(owner, about="I need %s — what are you doing with it?" % rel),
        "",
        "Once they have agreed, take the file itself and the block lifts:",
        "  agentbus claim 'file:%s' --why \"agreed with %s\""
        % (os.path.realpath(path), owner.get("agent")),
        "",
        "(Or the human can rerun the edit with AGENTBUS_OFF=1 in front of it.)",
    ]
    return "\n".join(lines)


def ownership_verdict(me, path, sessions):
    """("deny"|"note"|"", text) for an Edit/Write against declared ownership.

    Denies inside one checkout and warns across worktrees, because two sessions
    editing one path in two branches is what branches are for — denying it would
    be wrong, and a guard that is wrong is a guard agents learn to work around.
    Inside one checkout it is a genuine overwrite. `--strict` is how an owner
    says the cross-worktree case matters to them too."""
    owners = owners_of(path, me, sessions)
    if not owners:
        return "", ""
    if any(s["sid"] == me.get("sid") for s, _ in owners):
        return "", ""   # my own declaration is not a block on me
    mine_root = os.path.realpath(me.get("root") or "")
    same_tree = [(s, d) for s, d in owners
                 if os.path.realpath(s.get("root") or "") == mine_root]
    if same_tree:
        s, dec = same_tree[0]
        return "deny", ownership_text(me, path, s, dec, True)
    strict = [(s, d) for s, d in owners if d.get("strict")]
    if strict:
        s, dec = strict[0]
        return "deny", ownership_text(me, path, s, dec, False)
    s, dec = owners[0]
    rel = repo_relative(os.path.realpath(path), me.get("root")) or path
    return "note", (
        "agent-bus: %s has declared '%s' theirs on %s%s. You are in a different "
        "worktree, so this edit is allowed and nothing is being overwritten — "
        "but you are both changing %s, and that lands at merge time. Worth a "
        "word first if it is more than a line:\n%s"
        % (s.get("agent"), dec.get("glob"), s.get("branch") or "-",
           (' — "%s"' % dec["why"]) if dec.get("why") else "",
           rel, say_to(s, about="I am also editing %s" % rel)))


# ---------------------------------------------------------------- handoff ----
#
# A session ends and what it learned goes with it. The next agent re-derives it
# from the diff, or does not, and repeats the work. Everything needed to write
# the summary is already on disk — this is only the part nobody would think to
# write down, assembled at the one moment somebody is guaranteed not to be
# around to do it by hand.


def bump_guarded(me):
    """Count the commands this session took a shared resource for.

    Kept when the handoff summary that first needed it went: the board reads it
    as a column of its own, and it is the one number about a session that cannot
    be reconstructed afterwards. `matched/` looked like the place to get it and
    is not: it holds one file per repository and resource for the whole machine,
    and its mtime says when that resource last matched *anybody's* command, not
    how many of them were this session's."""
    sid = me.get("sid")
    if not sid:
        return
    path = os.path.join(SESSIONS, "%s.json" % sid)
    rec = read_json(path)
    if not rec:
        return
    # Re-read rather than mutate the caller's copy: the record is also written
    # by `name` and by re-registration, and writing back a stale dict here would
    # silently undo whichever of those happened most recently.
    rec["guarded"] = int(rec.get("guarded", 0) or 0) + 1
    write_json(path, rec)


def still_serving(me):
    """[(resource, root)] — services this session started that are still up.

    These outlive the session, which is the founding bug this whole plugin
    exists for: the process keeps answering on the port long after the session
    that started it has gone, and the next request from any worktree is silently
    served that dead session's code. It is the most useful line in a handoff."""
    out = []
    mine = os.path.realpath(me.get("root") or "")
    try:
        names = os.listdir(SERVES)
    except OSError:
        return out
    for name in sorted(names):
        rec = read_json(os.path.join(SERVES, name))
        if not rec or rec.get("repo") != me.get("repo_key"):
            continue
        if os.path.realpath(rec.get("root") or "") != mine:
            continue
        if not pid_alive(rec.get("pid")):
            continue
        out.append((rec.get("resource"), rec.get("root")))
    return out


def repo_writes(me, cutoff=0):
    """This session's writes that are inside its own repository — newest first,
    one entry per file.

    Writes outside the tree are dropped. A scratch file under /tmp is not work
    anybody needs handed over, and counting one made a session that had done
    nothing else announce itself on the way out: the first handoff this plugin
    ever wrote in anger said "wrote 1 file, most recently /tmp/claude-clip.txt".
    A summary nobody needs is what stops the useful ones being read."""
    seen, raw, out = set(), set(), []
    for ts, path in reversed(recent_writes(me.get("sid"), cutoff)):
        # The same path written eight hundred times is the normal shape of an
        # afternoon's editing, and resolving each one costs a syscall per path
        # component. Dropping the repeats by string first changes no answer — one
        # spelling resolves to one file — and the board asks for this every poll.
        if path in raw:
            continue
        raw.add(path)
        real = os.path.realpath(path)
        if real in seen:
            continue
        seen.add(real)
        rel = repo_relative(real, me.get("root"))
        if rel:
            out.append((ts, rel))
    return out


# --------------------------------------------------------------- serving ----
#
# A lock says who may use a service. It does not say which checkout that service
# is actually serving, and those are different facts: a session can end, its
# detached dev server keeps answering on the same port, the lock is released, and
# the next request from any worktree is silently answered by the dead session's
# code. That is the original bug this whole plugin exists for, and only this part
# of it closes the case.
#
# So ownership is tracked separately from the lock, and agent-bus owns the
# lifecycle: it starts the service, therefore it knows which tree it serves. A
# service it did not start is reported as unknown rather than guessed — the
# working directory of a foreign process is readable on macOS and Linux, and not
# on Windows, and a wrong guess here is worse than no answer.

# How often one service has to change hands before somebody is told. Three
# handovers between two checkouts inside ten minutes is not a workflow, it is
# two agents undoing each other — on 2026-07-29 the API went machine-side,
# rental-side and back in seventeen seconds.
CHURN_WINDOW = 10 * 60
CHURN_MOVES = 3


def moves_path(repo_key, res):
    """Where a service's recent handovers are kept.

    Beside the serve record rather than inside it, because stopping a service
    deletes that record and the history has to outlive the stop — a handover is
    a stop followed by a start, so keeping it in there would erase the very
    thing being counted. No `repo` field, so `still_serving` skips it."""
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", "%s__%s" % (repo_key, res))
    return os.path.join(SERVES, "%s.moves" % safe)


def record_move(me, res, root):
    """Remember that this service was just pointed at a tree, and answer whether
    that has now happened often enough, between enough different trees, to be
    worth telling everybody about."""
    path = moves_path(me.get("repo_key"), res)
    rec = read_json(path) or {}
    moves = [m for m in rec.get("moves", []) if now() - m.get("at", 0) < CHURN_WINDOW]
    moves.append({"root": root, "by": me.get("agent"), "at": now()})
    moves = moves[-8:]
    said = rec.get("said", 0)
    roots = {m.get("root") for m in moves if m.get("root")}
    loud = (len(moves) >= CHURN_MOVES and len(roots) >= 2
            and now() - said >= CHURN_WINDOW)
    write_json(path, {"moves": moves, "said": now() if loud else said})
    return moves if loud else []


def note_churn(me, res, moves):
    """Tell everybody that one service is being pulled back and forth.

    Nothing is wrong from any single session's point of view: every `serve` is
    legitimate, takes the lock properly and reports success. So nothing was ever
    said, and on 2026-07-29 three agents each ran their tests believing the rig
    answered for their own checkout while it was in fact changing hands under
    them. Two of them worked it out an hour in, by reading `lsof`.

    A lock is the answer and they always had one. What they had no way to see
    was that they needed it."""
    if not moves:
        return
    who = []
    for m in moves:
        if m.get("by") and m["by"] not in who:
            who.append(m["by"])
    roots = []
    for m in moves:
        short = short_path(m.get("root") or "")
        if short not in roots:
            roots.append(short)
    emit(me.get("sid"), me.get("agent"), me.get("repo_key"), "churn",
         "'%s' has changed checkouts %d times in the last %d minutes, between "
         "%s (%s). Between one handover and the next, a run reports on whichever "
         "tree happened to hold it — which is what this whole thing exists to "
         "stop. If you need it for more than one command, hold it for the whole "
         "stretch instead of taking it per command:\n"
         "  agentbus claim %s --why \"...\"   then  agentbus release %s"
         % (res, len(moves), CHURN_WINDOW // 60, " and ".join(roots),
            ", ".join(who), res, res))


def serve_path(repo_key, res):
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", "%s__%s" % (repo_key, res))
    return os.path.join(SERVES, "%s.json" % safe)


def port_pid(port):
    """The pid listening on a TCP port, or None."""
    import subprocess
    try:
        if IS_WIN:
            out = subprocess.run(["netstat", "-ano", "-p", "TCP"],
                                 capture_output=True, text=True, timeout=8)
            # Recognise a listening socket by its shape, not by the word
            # "LISTENING". That column is translated on a Windows whose display
            # language is not English, and matching the English word there
            # returns None for every port — which this plugin reads as "the
            # service is down", for every declared service, silently. What no
            # display language changes is the foreign address: a listening
            # socket is the one with the wildcard `0.0.0.0:0` or `[::]:0` in
            # that column, and a connected one never has it.
            for line in out.stdout.splitlines():
                cols = line.split()
                if len(cols) >= 5 and cols[0].upper() == "TCP" \
                        and cols[1].endswith(":%d" % port) \
                        and cols[2].endswith(":0"):
                    try:
                        return int(cols[-1])
                    except ValueError:
                        continue
            return None
        out = subprocess.run(["lsof", "-ti", "tcp:%d" % port, "-sTCP:LISTEN"],
                             capture_output=True, text=True, timeout=8)
        first = out.stdout.split()
        return int(first[0]) if first else None
    except Exception:
        return None


def pid_cwd(pid):
    """The working directory of a running process, or None where the platform
    will not say (Windows does not expose it to another process)."""
    import subprocess
    if IS_WIN or not pid:
        return None
    try:
        out = subprocess.run(["lsof", "-a", "-p", str(pid), "-d", "cwd", "-Fn"],
                             capture_output=True, text=True, timeout=8)
        for line in out.stdout.splitlines():
            if line.startswith("n"):
                return line[1:]
    except Exception:
        pass
    return None


def same_group(a, b):
    """Whether two pids belong to one process group.

    `shell=True` does not always exec the command it was given. On macOS the
    shell replaces itself with a simple command, so the pid we recorded when we
    started the service is the pid listening on the port. On Linux /bin/sh forks
    it and stays, and those two pids differ — which made agent-bus fail to
    recognise a service it had started itself, and fall back to probing the
    port. `start_new_session=True` puts the whole thing in its own group, and
    that is what they still have in common."""
    if IS_WIN or not a or not b:
        return False
    try:
        return os.getpgid(int(a)) == os.getpgid(int(b))
    except (OSError, ValueError):
        return False


def serving(repo_key, res_cfg):
    """Who a declared service is currently serving.

    Returns (root, how) where `how` is 'agent-bus' when we started it, 'probe'
    when the platform let us read a foreign process's directory, 'unknown' when
    something is listening that we cannot attribute, and (None, 'down') when
    nothing is."""
    name, port = res_cfg["name"], res_cfg.get("port")
    rec = read_json(serve_path(repo_key, name))
    # One lsof, not two: it was called again a few lines down for the same port.
    listener = port_pid(port) if port else None
    if rec and pid_alive(rec.get("pid")):
        if not port or listener == rec.get("pid") \
                or same_group(listener, rec.get("pid")):
            return rec.get("root"), "agent-bus"
    if not port:
        return (None, "down") if not rec else (rec.get("root"), "stale")
    if not listener:
        return None, "down"
    pid = listener
    cwd = pid_cwd(pid)
    if cwd:
        root = cwd
        for _ in range(6):  # the service may run from a subdirectory of the tree
            if os.path.isdir(os.path.join(root, ".git")) or \
               os.path.isfile(os.path.join(root, ".git")):
                return root, "probe"
            parent = os.path.dirname(root)
            if parent == root:
                break
            root = parent
        return cwd, "probe"
    return None, "unknown"


def win_kill(pid, extra=()):
    """Terminate a process on Windows. Returns what was tried and what it said,
    for the caller to report if the process is still there afterwards.

    `taskkill` cannot be believed in either direction on a machine with endpoint
    protection in the way. Measured on Windows 10 with corporate EDR: it exits 1
    with "ERROR: Not found" for a pid `Get-Process` confirms and `netstat` shows
    LISTENING, and exits 1 with that same line for an ordinary child it does
    kill. So its exit code decides nothing here — the liveness probe after it
    does. It is still run first, because it is the one of the two that takes a
    whole process tree, and it costs about a tenth of what PowerShell start-up
    does.

    `Stop-Process -Force` is the escalation, and it earned the place: it was the
    only thing on that machine that terminated a service created with
    DETACHED_PROCESS|CREATE_NEW_PROCESS_GROUP, which is how `start_service`
    creates every service on Windows. That it is second and not first is the
    whole trade — the cheap one usually works, and when it does not, this runs.

    The pids are tried in order, so a caller that knows both the listener and
    the shell it was spawned from can hand over both."""
    import subprocess
    tried = []
    for target in [pid] + [p for p in extra if p and p != pid]:
        if not pid_alive(target):
            continue   # the shell usually exits with the service it was waiting on
        for argv in (["taskkill", "/F", "/T", "/PID", str(target)],
                     ["powershell", "-NoProfile", "-NonInteractive", "-Command",
                      "Stop-Process -Id %d -Force" % int(target)]):
            try:
                out = subprocess.run(argv, capture_output=True, text=True,
                                     encoding="utf-8", errors="replace",
                                     timeout=20)
            except Exception as exc:
                tried.append("%s on %s: %s" % (argv[0], target, exc))
                continue
            if out.returncode:
                said = " ".join(((out.stderr or "") + " "
                                 + (out.stdout or "")).split())[:120]
                tried.append("%s on %s exited %d%s"
                             % (argv[0], target, out.returncode,
                                (": %s" % said) if said else ""))
            for _ in range(20):
                if not pid_alive(target):
                    break
                time.sleep(0.25)
            if not pid_alive(target):
                break
    return tried


def stop_service(repo_key, res_cfg):
    """Stop whatever serves this resource. (ok, why) — `why` is the diagnosis
    when it would not stop, and "" when it did.

    The Windows branch used to be one `taskkill` with no wait, no escalation and
    no reading of what it returned, the whole thing inside `except Exception:
    pass`. The port re-check at the end still caught the failure, so what the
    user was told stayed honest — but every word of *why* was thrown away at the
    point it was known."""
    import signal
    name, port = res_cfg["name"], res_cfg.get("port")
    rec = read_json(serve_path(repo_key, name)) or {}
    pid = rec.get("pid")
    spawned = rec.get("spawned")
    if not pid or not pid_alive(pid):
        # The record can outlive the process — another worktree's session may
        # have replaced the service since. Whatever is on the port now is what
        # has to go, not what we last wrote down.
        pid = port_pid(port) if port else None
        spawned = None
    if not pid:
        try:
            os.unlink(serve_path(repo_key, name))
        except OSError:
            pass
        return True, ""  # nothing is running: the goal state is already reached
    tried = []
    try:
        if IS_WIN:
            tried = win_kill(pid, extra=(spawned,))
        else:
            try:
                os.killpg(os.getpgid(pid), signal.SIGTERM)
            except Exception:
                os.kill(pid, signal.SIGTERM)
            for _ in range(40):
                if not pid_alive(pid):
                    break
                time.sleep(0.25)
            if pid_alive(pid):
                try:
                    os.killpg(os.getpgid(pid), signal.SIGKILL)
                except Exception:
                    os.kill(pid, signal.SIGKILL)
    except Exception as exc:
        # It may have exited between the probe and the signal, which is not a
        # failure — the port check below is what decides that. Kept anyway, so a
        # permission error stops being indistinguishable from a clean exit.
        tried.append("%s: %s" % (type(exc).__name__, exc))
    try:
        os.unlink(serve_path(repo_key, name))
    except OSError:
        pass
    if port:
        for _ in range(20):
            if port_pid(port) is None:
                return True, ""
            time.sleep(0.25)
        held = port_pid(port)
        why = ["pid %s still holds the port" % held] if held else []
        return False, "; ".join(why + tried)
    if pid_alive(pid):
        return False, "; ".join(["pid %s is still running" % pid] + tried)
    return True, ""


def wait_ready(res_cfg, root, timeout=60):
    import socket
    import subprocess
    deadline = time.time() + timeout
    ready, port = res_cfg.get("ready"), res_cfg.get("port")
    while time.time() < deadline:
        if ready:
            try:
                if subprocess.run(ready, shell=True, cwd=root, capture_output=True,
                                  timeout=10).returncode == 0:
                    return True
            except Exception:
                pass
        elif port:
            try:
                with socket.create_connection(("127.0.0.1", port), timeout=1):
                    return True
            except OSError:
                pass
        else:
            return True
        time.sleep(1)
    return False


def start_service(me, res_cfg):
    import subprocess
    name = res_cfg["name"]
    root = me.get("root")
    cwd = os.path.join(root, res_cfg["cwd"]) if res_cfg.get("cwd") else root
    logs = os.path.join(BUS, "logs")
    try:
        os.makedirs(logs, exist_ok=True)
    except OSError:
        pass
    log = os.path.join(logs, "%s__%s.log" % (
        re.sub(r"[^A-Za-z0-9_.-]", "_", me.get("repo_key", "")), name))
    kwargs = {}
    if IS_WIN:
        kwargs["creationflags"] = 0x00000008 | 0x00000200  # DETACHED | NEW_GROUP
    else:
        kwargs["start_new_session"] = True                  # its own process group
    try:
        fh = open(log, "ab")
        proc = subprocess.Popen(res_cfg["start"], shell=True, cwd=cwd,
                                stdout=fh, stderr=subprocess.STDOUT,
                                stdin=subprocess.DEVNULL,
                                env=port_env(me), **kwargs)
    except Exception as exc:
        return False, "could not start: %s" % exc
    port = res_cfg.get("port")
    rec = {"resource": name, "repo": me.get("repo_key"), "root": root,
           "cwd": cwd, "by": me.get("agent"), "pid": proc.pid,
           "spawned": proc.pid, "port": port, "started": now(), "log": log}
    # Written before the wait, not after: `wait_ready` can take a minute, and a
    # session that runs `serve` during it has to find the record.
    write_json(serve_path(me.get("repo_key"), name), rec)
    if not wait_ready(res_cfg, cwd):
        return False, "started but never became ready — see %s" % log

    # Then correct the pid to whoever actually holds the port.
    #
    # `shell=True` does not promise to exec the command it was handed. macOS
    # replaces the shell for a simple command, so proc.pid IS the service; Linux
    # forks and keeps /bin/sh, which `same_group` was written to bridge; Windows
    # runs `cmd /c`, and the two pids there have nothing in common that any
    # platform call will tell us — `same_group` and `pid_cwd` both answer False
    # and None on Windows unconditionally. So every one of the three ways
    # `serving` recognises a service failed there, for services agent-bus had
    # started itself: `how` came back 'unknown', which is not 'down', so
    # `ensure_serving` stopped and restarted the service on EVERY serve and
    # never once said "already serving your worktree". Measured on Windows 10:
    # recorded pid 9904, listening pid 31416.
    #
    # The port answers the question that no process API here will. Nothing was
    # listening on it a moment ago — `ensure_serving` cleared it or refused to
    # continue — and this command is what has run since, so whoever holds it now
    # is ours. That inference needs no platform support at all, and it makes the
    # pid we record the same pid every later check compares against. `spawned`
    # keeps what we launched, because that is the handle to kill the tree by.
    if port:
        listener = port_pid(port)
        if listener and listener != proc.pid:
            rec["pid"] = listener
            write_json(serve_path(me.get("repo_key"), name), rec)
    return True, log


def ensure_serving(me, res_cfg, sessions=None):
    """Make this resource serve MY worktree. (ok, message)"""
    if not res_cfg.get("start"):
        return True, ""
    repo_key = me.get("repo_key")
    root, how = serving(repo_key, res_cfg)
    if how in ("agent-bus", "probe") and root and \
            os.path.realpath(root) == os.path.realpath(me.get("root") or ""):
        return True, "already serving your worktree"
    if how != "down":
        stopped, why = stop_service(repo_key, res_cfg)
        if not stopped:
            return False, ("something is on %s that agent-bus could not stop%s; "
                           "stop it yourself and retry"
                           % (res_cfg.get("port") or res_cfg["name"],
                              " (%s)" % why if why else ""))
    ok, detail = start_service(me, res_cfg)
    if not ok:
        return False, detail
    emit(me.get("sid"), me.get("agent"), repo_key, "serve",
         "'%s' now serves %s" % (res_cfg["name"], short_path(me.get("root"))))
    note_churn(me, res_cfg["name"],
               record_move(me, res_cfg["name"], me.get("root")))
    return True, "restarted from your worktree (log: %s)" % detail


# ------------------------------------------------------ resource matching ----

# Where per-worktree ports are allocated from. Above anything a dev tool picks
# by default and below the ephemeral range macOS hands to outgoing connections
# (49152 and up), so an allocation cannot collide with a port the kernel is
# about to reuse.
PORT_BASE = 20000
PORT_SPAN = 10000


def is_primary_worktree(root):
    """Is this the repository's original checkout rather than a linked worktree?

    In the original, `.git` is a directory; in one made by `git worktree add` it
    is a file pointing at the common directory. The distinction matters because
    the primary checkout keeps the ports the repository declares: a human
    working there, and every script and bookmark that says :8082, carries on
    unchanged, and only the worktrees agents create get allocated ones."""
    dotgit = os.path.join(root or "", ".git")
    return os.path.isdir(dotgit)


def port_key(repo_key, name, root):
    return "%s\0%s\0%s" % (repo_key or "", name or "", os.path.realpath(root or ""))


def port_candidate(repo_key, name, root):
    """Where the hash puts this checkout's port, before any collision is
    resolved. Pure: no registry, no probe, no side effect — which is what lets
    "whose port is that" be answered for a worktree nobody has asked about."""
    import hashlib
    digest = hashlib.sha1(port_key(repo_key, name, root).encode()).hexdigest()
    return PORT_BASE + int(digest[:8], 16) % PORT_SPAN


def port_owners(cfg, repo_key, roots):
    """{port: root} for every allocation this machine knows of in this
    repository — from the registry, and failing that from the hash.

    The registry is a cache: it resolves collisions and survives nothing in
    particular. Deleting it must not blind the guard, so every live checkout's
    port is also computed directly."""
    out = {}
    isolated = [r for r in cfg.get("resources", []) if r.get("_declared_port")]
    for v in (read_json(PORTS) or {}).values():
        if v.get("port") and v.get("repo") == repo_key and v.get("root"):
            out[v["port"]] = v["root"]
    for root in roots:
        for res in isolated:
            if is_primary_worktree(root):
                continue          # keeps the declared port, handled separately
            out.setdefault(port_candidate(repo_key, res.get("name"), root),
                           os.path.realpath(root))
    return out


def allocated_port(repo_key, name, root, declared=None):
    """A port for this resource in this checkout that nothing else will take.

    Derived from the checkout's path, so it is the same every time without any
    state — restart the machine, delete the bus, and a worktree gets its port
    back. The registry exists only to resolve the collisions hashing must
    eventually produce, and to let `agentbus env` and `doctor` show who holds
    what.

    The primary checkout keeps the declared port. That is what makes this
    additive: nothing changes for whoever is working in the original clone."""
    root = os.path.realpath(root or "")
    if declared and is_primary_worktree(root):
        return declared
    key, want = port_key(repo_key, name, root), port_candidate(repo_key, name, root)
    reg = read_json(PORTS) or {}
    if reg.get(key, {}).get("port"):
        return reg[key]["port"]
    taken = {v.get("port"): k for k, v in reg.items() if k != key}
    with Mutex("ports"):
        reg = read_json(PORTS) or {}
        if reg.get(key, {}).get("port"):
            return reg[key]["port"]
        taken = {v.get("port"): k for k, v in reg.items() if k != key}
        port = want
        for _ in range(PORT_SPAN):
            if port not in taken and port_pid(port) is None:
                break
            port = PORT_BASE + (port + 1 - PORT_BASE) % PORT_SPAN
        reg[key] = {"port": port, "resource": name, "root": root,
                    "repo": repo_key, "at": now()}
        # Forget worktrees that no longer exist, or the registry grows for ever
        # and starts refusing ports to the living on behalf of the deleted.
        for k in [k for k, v in reg.items()
                  if v.get("root") and not os.path.isdir(v["root"])]:
            del reg[k]
        write_json(PORTS, reg)
    return port


def apply_ports(cfg, repo_key, root):
    """Give every resource that asked for it a port of this checkout's own.

    A resource opts in with `"ports": "per-worktree"`. What that changes, all of
    it here so nothing downstream has to know: the resource's `port` becomes the
    allocated one; `${PORT}` in `start` and `ready` is substituted, and failing
    that any literal occurrence of the declared port, so an existing command
    line keeps working; a pattern for the new port is added, or a command aimed
    at it would match nothing; and the lock becomes per checkout, because two
    checkouts no longer share the thing being locked.

    This is the whole of the isolation feature. Everything else in the plugin
    reads `res["port"]` and is unchanged."""
    if not root:
        return cfg
    out, changed = [], False
    for res in cfg.get("resources", []):
        if res.get("ports") != "per-worktree":
            out.append(res)
            continue
        declared = res.get("port")
        port = allocated_port(repo_key, res.get("name"), root, declared)
        res = dict(res)
        res["port"] = port
        res["_declared_port"] = declared
        for field in ("start", "ready"):
            text = res.get(field)
            if not text:
                continue
            if "${PORT}" in text:
                res[field] = text.replace("${PORT}", str(port))
            elif declared:
                res[field] = text.replace(str(declared), str(port))
        pats = list(res.get("patterns", []))
        token = r":%d\b" % port
        if token not in pats:
            pats.append(token)
        res["patterns"] = pats
        res["scope"] = "worktree"
        out.append(res)
        changed = True
    if not changed:
        return cfg
    merged = dict(cfg)
    merged["resources"] = out
    return merged


def repo_config(repo_key, root=None):
    """What this repository's shared resources are.

    The declaration belongs in the repository — `<root>/.claude/agent-bus.json` —
    so it travels with the project to every machine and every collaborator rather
    than living on the one laptop where somebody happened to write it. A
    machine-local file may add or override entries by name for anything that is
    genuinely local (a different port, a path only you have)."""
    shared = read_json(os.path.join(root, ".claude", "agent-bus.json"), {}) if root else {}
    local = read_json(os.path.join(REPOS, "%s.json" % repo_key), {}) or {}
    if not shared:
        return apply_ports(local, repo_key, root)
    if not local:
        return apply_ports(shared, repo_key, root)
    merged = dict(shared)
    by_name = {r["name"]: r for r in shared.get("resources", [])}
    for res in local.get("resources", []):
        by_name[res["name"]] = res
    merged["resources"] = list(by_name.values())
    return apply_ports(merged, repo_key, root)


def literal_runs(pattern):
    """The runs of plain characters in a regex — every match must contain the
    longest of them, which is what makes it usable as a cheap pre-filter."""
    runs, cur, i, n = [], [], 0, len(pattern or "")
    while i < n:
        ch = pattern[i]
        if ch == "\\" and i + 1 < n:
            nxt = pattern[i + 1]
            if nxt.isalnum():          # \b \d \s \w … : a class or an anchor
                runs.append("".join(cur))
                cur = []
            else:                       # \. \- \/ … : an escaped literal
                cur.append(nxt)
            i += 2
            continue
        if ch in "*?" and cur:
            cur.pop()                   # the preceding character is optional
        if ch in "[](){}|?*+^$.":
            runs.append("".join(cur))
            cur = []
            i += 1
            continue
        cur.append(ch)
        i += 1
    runs.append("".join(cur))
    return [r for r in runs if r]


def strip_groups(pattern):
    """The pattern with every (...) removed — what is left is mandatory."""
    out, depth, i = [], 0, 0
    while i < len(pattern or ""):
        ch = pattern[i]
        if ch == "\\" and i + 1 < len(pattern):
            if depth == 0:
                out.append(ch)
                out.append(pattern[i + 1])
            i += 2
            continue
        if ch == "(":
            depth += 1
        elif ch == ")":
            depth = max(0, depth - 1)
        elif depth == 0:
            out.append(ch)
        i += 1
    return "".join(out)


def top_level_groups(pattern):
    groups, depth, start, i = [], 0, 0, 0
    while i < len(pattern or ""):
        ch = pattern[i]
        if ch == "\\":
            i += 2
            continue
        if ch == "(":
            if depth == 0:
                start = i + 1
            depth += 1
        elif ch == ")":
            depth -= 1
            if depth == 0:
                groups.append(pattern[start:i])
        i += 1
    return groups


def split_alternatives(body):
    parts, depth, cur = [], 0, []
    for ch in body:
        if ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
        if ch == "|" and depth == 0:
            parts.append("".join(cur))
            cur = []
        else:
            cur.append(ch)
    parts.append("".join(cur))
    return parts


def pattern_tokens(pat):
    """Literals such that EVERY string matching `pat` contains at least one.

    The longest literal run in the raw pattern is not that: in
    `git\\s+(checkout|add|cherry-pick)` the longest run lives inside the
    alternation, so filtering on it drops `git add` — the guard silently never
    fires. What is mandatory is what sits outside the groups; failing that, one
    literal from every branch of a group, since a match must take some branch."""
    outside = [r for r in literal_runs(strip_groups(pat)) if len(r) >= 2]
    if outside:
        return {max(outside, key=len)}
    for body in top_level_groups(pat):
        branches, usable = set(), True
        for branch in split_alternatives(body):
            runs = [r for r in literal_runs(branch) if len(r) >= 2]
            if not runs:
                usable = False
                break
            branches.add(max(runs, key=len))
        if usable and branches:
            return branches
    return set()  # nothing can be pre-filtered on: the caller must always wake


def resource_tokens(res):
    """Literal substrings the shell fast path filters on before waking the
    engine. Derived from the patterns so the two cannot drift apart — a
    hand-written list had silently stopped covering `make seed`."""
    out = set(res.get("tokens", []))
    for pat in res.get("patterns", []):
        toks = pattern_tokens(pat)
        if not toks:
            return set()  # signals "cannot filter this resource"
        out |= toks
    if res.get("port"):
        out.add(str(res["port"]))
    return {t for t in out if len(t) >= 2}


def guard_token_line(configs):
    """The one line both fast paths grep a hook payload against.

    A second, lossy answer to "could this command touch a resource at all", and
    the real third copy of the gate decision — the first two being the guard and
    the five command-line verbs, which this plan collapses into `plan_for`. This
    one cannot be collapsed with them: its whole purpose is to answer without
    starting the engine that `resources_for` lives in.

    So it is held to an invariant instead. It must remain a strict SUPERSET of
    what `resources_for` matches: both fast paths exit before the engine runs
    when nothing here matches, so a token that stops being generated makes the
    guard never fire — silently, and looking exactly like a resource nobody is
    contending for. That is what `git add -A` did until 768f183, and no test
    that calls the engine directly would have noticed.

    A function rather than four lines inside `refresh_derived` so that the
    assertion pinning the superset can ask for the exact string the fast paths
    read, rather than reconstructing it — which would be the same defect one
    level up, in the test that exists to catch it."""
    tokens, unfilterable = set(), False
    for cfg in configs:
        for res in cfg.get("resources", []):
            if not res.get("patterns"):
                continue
            toks = resource_tokens(res)
            if not toks:
                unfilterable = True  # nothing mandatory to filter on
                continue
            for tok in toks:
                tokens.add(re.escape(tok))
    # Every `agentbus` command wakes the engine when this repository declares
    # anything. `agentbus serve web` names its resource and nothing else, so
    # none of the patterns' literals appear in it — and the guard has to see it,
    # because deciding which subagent is asking can only be done in the hook.
    if tokens or unfilterable:
        tokens.add(re.escape("agentbus"))
    # A resource whose patterns have no mandatory literal cannot be pre-filtered.
    # Waking the engine on every command costs milliseconds; missing the guard
    # costs a silently wrong test, so the gate opens for everything instead.
    return "." if unfilterable else "|".join(sorted(tokens)) if tokens else ""


def strip_heredocs(cmd):
    """Drop heredoc bodies. What a command feeds to stdin is data — a commit
    message, a plan, a JSON payload — and matching resource patterns against it
    is how `git commit -m "$(cat <<EOF ... restart uvicorn ... EOF)"` ends up
    claiming the API."""
    lines = (cmd or "").split("\n")
    kept, i = [], 0
    while i < len(lines):
        kept.append(lines[i])
        m = re.search(r"<<-?\s*(['\"]?)([A-Za-z_][A-Za-z0-9_]*)\1", lines[i])
        if m:
            word, j = m.group(2), i + 1
            while j < len(lines) and lines[j].strip() != word:
                j += 1
            i = j
        i += 1
    return "\n".join(kept)


def split_segments(cmd):
    """Split on `;`, `&&`, `||`, `|` and newlines that are not inside quotes.
    A quote-blind split invents segments out of the middle of message text."""
    segments, cur, quote, i = [], [], None, 0
    n = len(cmd or "")
    while i < n:
        ch = cmd[i]
        if quote:
            cur.append(ch)
            if ch == quote:
                quote = None
            i += 1
        elif ch in "'\"":
            quote = ch
            cur.append(ch)
            i += 1
        elif ch == "\\" and i + 1 < n:
            cur.append(ch)
            cur.append(cmd[i + 1])
            i += 2
        elif cmd.startswith("&&", i) or cmd.startswith("||", i):
            segments.append("".join(cur))
            cur = []
            i += 2
        elif ch in ";|\n":
            segments.append("".join(cur))
            cur = []
            i += 1
        else:
            cur.append(ch)
            i += 1
    segments.append("".join(cur))
    return [s for s in segments if s.strip()]


def tokens_of(segment):
    import shlex
    try:
        lex = shlex.shlex(segment, posix=True)
        lex.whitespace_split = True
        return list(lex)
    except ValueError:
        return segment.split()


def strip_git_globals(toks):
    """`git -C /path -c x=y add -A` → `git add -A`.

    git's global options sit between the command and its subcommand, and every
    pattern anybody writes — `\\bgit\\s+add\\b` — expects the two to be adjacent.
    So a `git -C <path> checkout` matched nothing and was guarded by nothing,
    which is exactly how a chat that works on another worktree by path slips
    past every guard in the config. Found on Windows on 2026-07-31 while
    teaching the guard to read `-C`."""
    if not toks or os.path.basename(toks[0]) != "git":
        return toks
    out, i = [toks[0]], 1
    while i < len(toks):
        t = toks[i]
        if t in ("-C", "-c", "--namespace", "--work-tree", "--git-dir",
                 "--exec-path", "--config-env"):
            i += 2
            continue
        if t.startswith(("--git-dir=", "--work-tree=", "--namespace=",
                         "--exec-path=", "--config-env=")):
            i += 1
            continue
        if t in ("-p", "--paginate", "-P", "--no-pager", "--bare",
                 "--no-replace-objects", "--literal-pathspecs"):
            i += 1
            continue
        break
    return out + toks[i:]


def is_readonly(head, toks):
    """A guarded word behind a read-only command is a mention, not a use.

    `git` is only read-only in its reading subcommands: `git checkout`, `stash`,
    `reset` and `add -A` rewrite the working tree, which is exactly what two
    sessions sharing one checkout destroy each other with."""
    if head == "git":
        sub = next((t for t in toks[1:] if not t.startswith("-")), "")
        return sub in GIT_READONLY_SUBCOMMANDS
    return head in READONLY_HEADS


def command_targets(cmd, depth=0):
    """The words of a command that are plausibly things it acts on.

    A shell command carries two kinds of words: what it operates on, and text it
    merely transports — a commit message, a PR body, a heredoc. Matching a
    resource pattern against the second kind is how a commit message that names
    a tool claims that tool and blocks the commit. The rule that separates them
    cheaply: a token containing whitespace is prose. Real targets — paths,
    ports, URLs, flags — do not have spaces in them."""
    out = []
    for seg in split_segments(strip_heredocs(cmd)):
        toks = tokens_of(seg)
        while toks and (re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", toks[0])
                        or os.path.basename(toks[0]) in WRAPPERS):
            toks = toks[1:]
        if not toks:
            continue
        toks = strip_git_globals(toks)
        head = os.path.basename(toks[0])
        if head in SHELL_HEADS and depth < 3:
            # `bash -c '…'` — that quoted argument is a command, not prose.
            inline = next((toks[i + 1] for i, tok in enumerate(toks[1:], 1)
                           if tok == "-c" and i + 1 < len(toks)), None)
            if inline is not None:
                out.extend(command_targets(inline, depth + 1))
                continue
            # `bash script.sh` — the script cannot be read, but its name and
            # arguments still can, so fall through rather than going blind.
        if is_readonly(head, toks):
            continue
        out.append(" ".join(t for t in toks if not re.search(r"\s", t)))
    return out


# What an `agentbus` verb means to the guard.
#
# The first three take the resource in the caller's name. The last two act ON a
# lock somebody else is holding, so they must never be blocked by it — and until
# 2026-07-29 they were: the deny message ended in "agentbus wait <res>" and
# "agentbus claim <res> --steal", and the guard that had just printed that advice
# refused both commands. A session in contention had no way out inside the tool,
# which is why three agents spent an afternoon negotiating turns by hand instead.
CLAIMING_VERBS = ("run", "claim", "serve")
PASSTHROUGH_VERBS = ("wait", "release")
# Verbs that take no resource but still need to know which party ran them, so
# the guard has to leave a hint for these too. `take` and `done` write a name
# into the ledger every other agent reads, and a subagent's work filed under its
# parent is the same wrong answer as a lock filed there.
PARTY_VERBS = ("here", "take", "done")


def command_opts_out(cmd):
    """Does this command carry `AGENTBUS_OFF=1` in front of it?

    Every block this plugin writes ends by offering exactly that, and until
    2026-08-01 it did not work: the assignment takes effect in the shell that
    runs the command, and the hook has already decided by then, in another
    process, with the session's own environment. So an agent that read the
    message, followed it to the letter, and was refused a second time was
    right and the tool was wrong.

    Honoured here, where it is visible. It stays an override rather than a
    silent hole because taking it is recorded on the bus — the others can see
    that a guard was stepped over, which is the difference between an escape
    hatch and a bypass."""
    for seg in split_segments(strip_heredocs(cmd or "")):
        for tok in tokens_of(seg):
            if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", tok):
                break        # past the leading assignments; nothing more to see
            name, _, value = tok.partition("=")
            if name == "AGENTBUS_OFF" and value not in ("", "0", "false", "no"):
                return True
    return False


def _command_worktree(cmd):
    """The tree a command says it is operating on, when it says so.

    Private to `resolve_party`, which applies the answer as clause (a) of
    *where they are working* — last, so that it lands on top of every other
    clause, which is what puts it first in the order.

    `git -C <path>` and `git --git-dir=<path>` name a checkout outright, and a
    chat that works on another worktree that way never changes directory — so
    everything that infers a tree from cwd places it in the repository it was
    launched in, permanently. Reported from Windows on 2026-07-31, where four
    chats rendered on one branch in one worktree and one of them was somewhere
    else entirely.

    The guard is already tokenising this command, so reading the path costs
    nothing and makes the common case right without asking the agent to run
    anything."""
    for seg in split_segments(strip_heredocs(cmd or "")):
        toks = tokens_of(seg)
        while toks and (re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", toks[0])
                        or os.path.basename(toks[0]) in WRAPPERS):
            toks = toks[1:]
        if not toks or os.path.basename(toks[0]) != "git":
            continue
        for i, tok in enumerate(toks[1:], 1):
            path = ""
            if tok == "-C" and i + 1 < len(toks):
                path = toks[i + 1]
            elif tok.startswith("--git-dir="):
                path = tok[len("--git-dir="):]
                if os.path.basename(path) == ".git":
                    path = os.path.dirname(path)
            if path and os.path.isdir(path):
                return os.path.realpath(path)
    return ""


def explicit_resources(cmd, cfg):
    """Resources named outright on an `agentbus` command line.

    `agentbus run simulator -- maestro test` is a request for the simulator, and
    the guard has to see it as one. The CLI cannot: a subagent's Bash
    environment is byte-identical to its parent's, so by the time `agentbus run`
    is executing, nothing there knows which subagent is calling. Deciding it
    here, in the hook, where `agent_id` is on the payload, is what makes
    `agentbus run` serialise between two subagents instead of handing both of
    them the same rig."""
    out = []
    by_name = {r["name"]: r for r in cfg.get("resources", [])}
    for seg in split_segments(strip_heredocs(cmd)):
        toks = tokens_of(seg)
        while toks and (re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", toks[0])
                        or os.path.basename(toks[0]) in WRAPPERS):
            toks = toks[1:]
        if len(toks) < 3 or os.path.basename(toks[0]) != "agentbus":
            continue
        verb = toks[1]
        if verb not in CLAIMING_VERBS and verb not in PASSTHROUGH_VERBS:
            continue
        # A steal is a deliberate override of exactly the lock that is in the
        # way. Denying it leaves the reader holding advice they cannot follow.
        # `--steal` overrides a lock somebody holds; `--as` says which agent is
        # asking, which is the answer to an unidentified lock. Both are the
        # message's own advice for getting past a block, so neither may be
        # blocked by it — `agentbus claim <res> --as <name>` was printed by the
        # guard and then refused by it.
        through = (verb in PASSTHROUGH_VERBS or "--steal" in toks
                   or "--as" in toks)
        for name in toks[2].split(","):
            res = by_name.get(name.strip())
            if res and res["name"] not in [h["name"] for h in out]:
                res = dict(res)
                # `serve` and `run` exist to move a service to your tree, so the
                # "this is serving somebody else" check must not stop them.
                res["_explicit"] = True
                res["_verb"] = verb
                if through:
                    res["_passthrough"] = True
                out.append(res)
    return out


def _matches(pat, text):
    """One pattern against one command's targets. A bad regex in somebody's
    config must not take the hook down with it."""
    try:
        return bool(re.search(pat, text, re.I))
    except re.error:
        return False


def resources_for(cmd, cfg):
    """Which declared resources this command would touch."""
    hits = explicit_resources(cmd, cfg)
    resources = cfg.get("resources", [])
    if not resources:
        return hits
    by_name = {r["name"]: r for r in resources}
    seen = {h["name"]: h for h in hits}
    for text in command_targets(cmd):
        for res in resources:
            # `patterns` recognise the tool; `unless` recognises that this
            # particular use of it is not about the thing being guarded. A
            # `db` resource describing the local Postgres matches every `psql`
            # there is, including one aimed at a staging server in another
            # country — which happened on 2026-08-01, and the agent was made to
            # queue behind a lock on a database it was not touching.
            if any(_matches(pat, text) for pat in res.get("unless", [])):
                continue
            for pat in res.get("patterns", []):
                if not _matches(pat, text):
                    continue
                prev = seen.get(res["name"])
                if prev is None:
                    hit = dict(res)
                    seen[res["name"]] = hit
                    hits.append(hit)
                elif prev.get("_passthrough"):
                    # `agentbus wait sim && maestro test …` — the second half is
                    # a real use of the thing, so the pass-through that let the
                    # `wait` through must not cover the command riding with it.
                    prev.pop("_passthrough", None)
                    prev.pop("_explicit", None)
                break
    # A Maestro run needs the simulator, but it is also only meaningful against
    # the bundler and API serving your worktree, so one match can pull in others.
    for res in list(hits):
        if res.get("_passthrough"):
            continue   # waiting for a thing does not take what the thing implies
        for name in res.get("implies", []):
            dep = by_name.get(name)
            if dep and dep["name"] not in seen:
                dep = dict(dep)
                dep["_implied_by"] = res["name"]
                if res.get("_explicit"):
                    # `agentbus run tour` is a statement about the tour AND about
                    # everything the tour is only meaningful against, because
                    # that is exactly what `run` takes and moves. Without this
                    # the guard refused the one line the serving block leads
                    # with: the named resource was exempt from the service probe
                    # and the two it implies were not, so `agentbus run tour --
                    # …`, printed by the block, was denied by the block.
                    dep["_explicit"] = True
                    dep["_verb"] = res.get("_verb", "")
                seen[dep["name"]] = dep
                hits.append(dep)
    return hits


# ------------------------------------------------------------ formatting ----

def in_my_tree(me, root):
    """Is that party standing in the very same working copy as this one?

    Not the same repository — the same directory. Both are resolved, because one
    side may have arrived through a symlink (`/tmp` is one on macOS) and two
    spellings of one checkout would otherwise read as two checkouts.

    An empty root is never a match. A session outside any repository has none,
    and `realpath("")` is the process's cwd, which would make two of them twins
    of each other and of whatever directory the hook happened to run in."""
    if not root or not me.get("root"):
        return False
    return os.path.realpath(root) == os.path.realpath(me["root"])


def roster_text(me, sessions):
    same, other = [], []
    for s in sessions:
        if s["sid"] == me.get("sid"):
            continue
        (same if s.get("repo_key") == me.get("repo_key") else other).append(s)
    lines = []
    if same:
        lines.append("Other sessions on this repo (%d):" % len(same))
        twins = []
        for s in same:
            addr, status = address_of(s.get("sid"), s.get("pid"))
            # Two different idlenesses, and only one of them is worth printing.
            # Ours means "no heartbeat lately", which is a fact about this
            # plugin; Claude Code's `status` is the session saying what it is
            # doing. Where we have theirs, it is strictly the better answer to
            # the question a reader is actually asking — will this person see my
            # message — so ours is the fallback and not the headline.
            quiet = "" if now() - s.get("beat", 0) < IDLE_SECS else "  [idle]"
            lines.append("  - %s  %s  %s  (last seen %s)%s" % (
                s.get("agent"), short_path(s.get("root", "")), s.get("branch") or "-",
                ago(s.get("beat")), "" if status else quiet))
            if addr:
                lines.append('      message it:  SendMessage → to "%s"%s'
                             % (addr, "   (%s)" % status if status else ""))
            else:
                # Better than a name that reaches nobody. This happens for a
                # session Claude Code has not registered, one whose process has
                # gone, and one of two answering to the same name.
                lines.append("      message it:  no address the tool would take"
                             " — run ListAgents to find it")
            if in_my_tree(me, s.get("root")):
                twins.append(s.get("agent"))
            for a in load_agents(s["sid"]):
                lines.append("      · %s  (%s, %s)" % (
                    a.get("name"), a.get("agent_type"),
                    short_path(a.get("root", ""))))
                if in_my_tree(me, a.get("root")):
                    twins.append(a.get("name"))
            owned = owns_summary(s["sid"])
            if owned:
                lines.append("      owns: %s" % owned)
        if twins:
            # The roster prints everybody's path, so this is a string comparison
            # an agent COULD make — and one it should not have to, because
            # nothing else in the briefing suggests the paths are worth
            # comparing. This is the one collision the separate-checkouts
            # assumption does not cover: same files, same index, no lock held
            # while somebody is halfway through an edit, and so nothing for a
            # guard to refuse.
            lines.append("In YOUR checkout too: %s — same files, same index, so "
                         "a `git add -A`, `git stash` or `git checkout` of yours "
                         "takes their half-written work with it."
                         % ", ".join(t for t in twins if t))
    if other:
        labels = sorted({s.get("repo_label", "?") for s in other})
        lines.append("Elsewhere on this machine: %d session%s (%s)." % (
            len(other), "" if len(other) == 1 else "s", ", ".join(labels)))
    # Sessions Claude Code knows about and this bus does not: reaped by the
    # heartbeat while their process is alive, or never registered here at all.
    # They can be messaged, so a roster that leaves them out says the machine is
    # emptier than it is. Named, not counted, because a name is the address.
    strangers = [r["name"] for r in cc_strangers(sessions) if r["name"]]
    if strangers:
        shown = sorted(strangers)[:6]
        more = "" if len(strangers) <= 6 else ", +%d more" % (len(strangers) - 6)
        lines.append("Also live on this machine, not on the bus: %s%s "
                     "(messageable; ListAgents knows the full list)."
                     % (", ".join(shown), more))
    return "\n".join(lines)


def queued_text(lock, sessions):
    """Who is waiting on this lock, for the line its holder reads.

    `enqueue` has recorded this since the beginning and nothing has ever
    rendered it where the holder would see it. It went into the task ledger,
    filtered to the WAITER's own row — so the one party who could act on it, the
    one holding the thing, was the one party never shown it.

    That is the whole of the negotiation this release is supposed to make
    possible. A holder cannot hand something over on request if nothing tells it
    a request exists, and until Claude Code shipped a way to wake a session,
    nothing could tell it in time to matter either."""
    # Only waiters that still exist. A session that queued and then ended left
    # its entry behind, and on the holder's screen that is not a stale row in a
    # file — it is a request to hand something over to somebody who has gone.
    # `cli_wait` removes its own entry when it gives up; this covers the session
    # that was closed while waiting, which cannot remove anything.
    live = {s.get("sid") for s in sessions}
    queue = [q for q in (lock.get("queue") or []) if q.get("sid") in live]
    if not queue:
        return ""
    who = ", ".join("%s (%s)" % (q.get("agent") or "?", held_for(q.get("at")))
                    for q in queue[:3])
    more = "" if len(queue) <= 3 else ", +%d more" % (len(queue) - 3)
    return "   waiting: %s%s" % (who, more)


def locks_text(me, sessions, with_serving=True):
    """Every declared resource and who has it, for `status` and the banner.

    The one place that cannot ask `plan_for`: there is no command and no name,
    only the whole config, so there is nothing for a Plan to be about. It calls
    `lock_name` directly and it is the only caller left that does apart from
    `plan_for` itself.

    Which is why the instance defect outlived M1 here. With no command,
    `lock_name` answers with the bare resource — so a machine where somebody
    held `simulator@ABC123` reported `simulator` as free, on the screen an
    agent reads before deciding whether it needs to wait for anything."""
    cfg = repo_config(me.get("repo_key", ""), me.get("root"))
    resources = cfg.get("resources", [])
    if not resources:
        return ""
    mine = os.path.realpath(me.get("root") or "")
    held, free, serves, down = [], [], [], []
    for res in resources:
        shown = []
        for lock in contending_locks(me, res, lock_name(me, res)):
            holder, stealable, _ = lock_state(lock, sessions)
            if not holder or stealable:
                continue
            # The instance when there is one, because that is what a person
            # types and what a block about one device advertises. Not the
            # `scope: "worktree"` digest, which nobody typed and which is not
            # what anyone calls their checkout — the same rule the exits use.
            name = lock.get("resource") or res["name"]
            if not (res.get("key") and name.startswith(res["name"] + "@")):
                name = res["name"]
            yours = " (yours)" if lock.get("sid") == me.get("sid") else ""
            shown.append("  - %s → %s%s, %s%s%s" % (
                name, lock.get("agent"), yours,
                held_for(lock.get("acquired_at")),
                (', "%s"' % lock["why"]) if lock.get("why") else "",
                queued_text(lock, sessions)))
        # Asked once and used twice. `serving` shells out to `lsof`, so the
        # free/not-running reckoning and the running-services list below read one
        # probe between them rather than one each.
        root, how = None, ""
        if with_serving and (res.get("port") or res.get("start")):
            root, how = serving(me.get("repo_key"), res)
        if shown:
            held.extend(shown)
        elif how == "down":
            # "Free" and "not running" are two different answers and this line
            # used to give the first for both. A session told `Free: api` calls
            # it, gets a connection refused, and spends turns deciding whose
            # fault that is; or it reaches for the port in the config instead,
            # which in a worktree belongs to another checkout and answers.
            down.append(res)
        else:
            free.append(res["name"])
        if how and how != "down":
            if root and os.path.realpath(root) == mine:
                serves.append("  - %s serves YOUR worktree" % res["name"])
            elif root:
                serves.append("  - %s serves %s — a request to it answers with "
                              "THAT checkout's code" % (res["name"], short_path(root)))
            else:
                serves.append("  - %s is up but agent-bus did not start it; which "
                              "checkout it serves is unknown" % res["name"])
    out = []
    if held:
        out.append("Shared resources in use:")
        out.extend(held)
    if free:
        out.append("Free: %s" % ", ".join(free))
    if down:
        out.append(down_text(down))
    if serves:
        out.append("Running services:")
        out.extend(serves)
    return "\n".join(out)


def down_text(down):
    """One line for the declared services that nothing is running.

    Named with the port each one is not answering on, because that is the number
    the reader is about to type and in a worktree it is not the number in the
    config. `agentbus serve` is offered only for the ones it can actually
    start — for a resource with no `start` command it returns success and does
    nothing, and advertising an exit that quietly no-ops is worse than
    advertising none."""
    named = ", ".join("%s%s" % (r["name"], (" (:%d)" % r["port"]) if r.get("port")
                                else "") for r in down)
    startable = [r["name"] for r in down if r.get("start")]
    line = ("Declared but NOT running: %s. Nothing is up there, so a call is "
            "refused rather than answered by the wrong checkout." % named)
    if startable:
        line += " `agentbus serve %s` starts %s from yours." % (
            ",".join(startable), "it" if len(startable) == 1 else "them")
    return line


def ports_text(me):
    """The ports THIS checkout answers on, when they are not the declared ones.

    The one fact a session in a worktree cannot work out and will get wrong by
    default. The config, the README, the Makefile and every note in the
    repository name the original checkout's port; a session that reads any of
    them curls a service belonging to another tree, gets a perfectly good
    answer, and reports it as its own. Measured on the live bus: a subagent in
    exactly that position called the declared port 28 times, with `AGENTBUS_OFF`
    in front of each one, because that was the number in the config and nothing
    had told it otherwise.

    The guard does catch it — that is what those 28 refusals were — which is the
    point. A block is the wrong place to first learn your own address: by then
    the command exists, and the cheapest way past a refusal is to switch the
    guard off. This is the same sentence the block prints, moved to before there
    is anything to refuse.

    Costs nothing: `apply_ports` resolved these when `repo_config` was read, so
    this compares two integers per resource and probes nothing. The original
    checkout keeps the declared port and therefore gets no line at all."""
    cfg = repo_config(me.get("repo_key", ""), me.get("root"))
    rows = []
    for res in cfg.get("resources", []):
        if res.get("ports") != "per-worktree":
            continue
        port, declared = res.get("port"), res.get("_declared_port")
        if not port or port == declared:
            continue
        rows.append("  - %s is on :%d here%s" % (
            res["name"], port,
            (" — the :%d in the config is the original checkout's" % declared)
            if declared else ", allocated to this checkout"))
    if not rows:
        return ""
    return ("Your own ports, because this checkout is not the one the config "
            "names — `eval \"$(agentbus env)\"` exports the set:\n"
            + "\n".join(rows))


def short_path(p):
    return p.replace(HOME, "~") if p else "?"


def owns_summary(sid, limit=4):
    """One line naming what a session has declared, for the roster."""
    decs = load_owns(sid)
    if not decs:
        return ""
    shown = ", ".join("%s%s" % (d.get("glob", "?"),
                                " (strict)" if d.get("strict") else "")
                      for d in decs[:limit])
    if len(decs) > limit:
        shown += ", +%d more" % (len(decs) - limit)
    return shown


def ownership_text_block(me, sessions):
    """The ownership section of `status` and of the session-start banner."""
    lines = []
    for s in sessions:
        summary = owns_summary(s["sid"], limit=8)
        if not summary or s.get("repo_key") != me.get("repo_key"):
            continue
        who = "you" if s["sid"] == me.get("sid") else s.get("agent")
        lines.append("  - %s: %s" % (who, summary))
    if not lines:
        return ""
    return "Declared ownership:\n" + "\n".join(lines)


RULES = (
    "How this works: a command that touches a shared resource takes it for the "
    "length of that command. You hear about it only when someone else holds it, "
    "or when the service is answering for a different checkout than yours — both "
    "are blocked with the reason. Useful: `agentbus status`, "
    "`agentbus serve <res>` to point a service at your worktree, "
    "`agentbus run <res> -- <cmd>` to do that and run one command, "
    "`agentbus wait <res>` to queue for something somebody else is holding. "
    "If you are working in a checkout other than the one this chat opened in, "
    "run `agentbus here` from it once — otherwise the others are told you are "
    "somewhere you are not, and the guards judge you there."
    # This paragraph is the whole of 3.0.0 in five sentences. The bus used to
    # carry messages and could not wake anybody with one, so "ask them" was
    # advice nobody could take: on 2026-09-04 a session was blocked on the
    # database and stepped past the guard eleven seconds later. SendMessage
    # wakes the recipient, which is what makes asking a real option — so the
    # roster prints addresses and this says what to do with them.
    "\n\nTalking to another session is the SendMessage tool, not this plugin. "
    "The roster above prints each session's address, and a message wakes it: an "
    "idle session acts on one within seconds, without its human. Whether it "
    "writes back is its own judgement, so never wait on a reply — queue with "
    "`agentbus wait <res>`, tell them you are queued, and get on with something "
    "else while they finish. The queue is what ends with your command running. "
    "A subagent cannot be addressed from outside its own session, so when a "
    "subagent holds the lock, message its session and name the subagent."
    "\n\nOne rule that is not enforced by a block: if a build or test failure "
    "names files you did not edit, do not fix them. Another session is probably "
    "mid-edit and the error will disappear on its own — wait and re-run. If it "
    "persists, message them rather than editing. Fix only files you own."
)


# ----------------------------------------------------------------- hooks ----

def register(payload):
    """Create or refresh this session's record. Also reachable from the other
    hooks: a session that missed SessionStart — installed mid-session, hook timed
    out, wrongly reaped — would otherwise stay invisible and unguarded forever,
    with nothing to tell anyone.

    An empty `existing` does not mean this chat is new. Any live session's turn
    reaps one that has gone quiet, and a chat left idle for three hours is quiet
    while its process is still alive — so by the time it is typed into again,
    somebody else has usually already deleted its record. `known` is therefore
    what this chat has ever told us, which outlives the record: see
    `keep_declared` for which fields those are and why each one."""
    ensure_dirs()
    sid = safe_id(payload.get("session_id")
                  or os.environ.get("CLAUDE_CODE_SESSION_ID"))
    if not sid:
        return None, False
    cwd = payload.get("cwd") or os.getcwd()
    root, repo_key, label, branch = git_facts(cwd)
    sessions = load_sessions(reap=True)
    existing = read_json(os.path.join(SESSIONS, "%s.json" % sid))
    # Read only when there is no record, so the ordinary hook pays nothing for it.
    known = existing or read_json(declared_path(sid))
    taken = {s.get("agent") for s in sessions if s["sid"] != sid}
    rec = dict(known) if known else {}
    fields = {"sid": sid, "pid": claude_pid(),
              # The chat's age, not the process's. A resumed chat is a new `claude`
              # process — which is why `pid` is measured again right above — and
              # taking its `started` from that would report a chat that has been
              # open since yesterday as a minute old.
              "started": rec.get("started") or now()}
    if not rec.get("pinned") or not known:
        # Stamped with the derivation only where the derived fields are actually
        # written. A pinned record that keeps its own location is deliberately
        # left unstamped, so `heal_derived` re-derives its key from the directory
        # it declared rather than from the cwd this payload happens to carry.
        fields.update({"cwd": cwd, "root": root, "repo_key": repo_key,
                       "repo_label": label, "branch": branch,
                       "keyrev": KEY_REV})
    rec.update(fields)
    if not known:
        rec.pop("pinned", None)     # a fresh chat has not said where it is yet
    # Kept rather than re-derived, because it is an address: the other sessions
    # hold it, every block message prints it, and a name that changes because
    # nobody typed for three hours breaks every address in flight. Re-derived
    # only when it is empty or somebody else has taken it in the meantime —
    # which, for a chat that has been away, is the one thing that can happen.
    if not rec.get("agent") or rec.get("agent") in taken:
        rec["agent"] = agent_name_from(branch, label, taken)
    write_json(os.path.join(SESSIONS, "%s.json" % sid), rec)
    if existing is None and known:
        # Recovered, and the record is the live copy again. Deleted after the
        # write and never before it: a failed write with the declaration already
        # gone would lose it for good, and the next reap rewrites this anyway.
        try:
            os.unlink(declared_path(sid))
        except OSError:
            pass
    # Only hooks build a record, and a hook is always told who is acting. A
    # session recovered here that forgot to say so would take locks nothing
    # could attribute — and then block its own subagents, which is the one
    # thing the party rules exist to prevent.
    rec["party_known"] = True
    touch_beat(sid)
    if existing is None:
        # Start at the current end of the stream: nobody wants a backlog. Keyed
        # on the record and not on `known`, because this is about the roster and
        # not about the chat: a session the bus cannot see has just appeared on
        # it, whatever it remembers about itself, and the events it missed while
        # it was away are about locks that were released hours ago.
        write_text(os.path.join(CURSORS, sid), "%d\n" % read_int(SEQFILE, 0))
    return rec, existing is None


def install_hint_once():
    """Said once per machine: the `agentbus` command cannot be found.

    Installing from a marketplace wires the hooks but cannot put a command on
    anybody's PATH, and every block this plugin produces ends in advice to run
    one. Without this the first block is followed by `command not found` and the
    agent has no way to act on anything it was just told."""
    marker = os.path.join(BUS, ".cli-notice")
    if os.path.exists(marker):
        return ""
    import shutil
    if shutil.which("agentbus"):
        write_text(marker, "on-path\n")
        return ""
    write_text(marker, "%d\n" % now())
    return ("agent-bus: the hooks are running, but the `agentbus` command is "
            "not on PATH — so the commands in any message from agent-bus will "
            "not run. Ask the human to run this once:\n  %s install"
            % os.path.realpath(__file__))


def transcript_title(path, tail=65536):
    """The title this chat is showing, read from the tail of its transcript.

    Claude Code appends `{"type": "custom-title", "customTitle": …}` whenever
    the title is set — by `/rename`, or by a plugin answering SessionStart —
    and the last one wins.

    The transcript is the only place to read it. Measured against 2.1.220 with a
    settings-file hook that logged every payload: SessionStart and
    UserPromptSubmit both carry `transcript_path` and **neither carries the
    title**, so the `session_title` this code used to look for was never there
    and the branch that tested for it always took the same path.

    Only the tail is read. A long session's transcript is megabytes and this is
    consulted once per user turn; a rename lands within a few kilobytes of the
    end and stays readable for many turns after."""
    if not path:
        return ""
    try:
        size = os.path.getsize(path)
        with open(path, "rb") as fh:
            if size > tail:
                fh.seek(size - tail)
                fh.readline()      # drop the half line the seek landed in
            chunk = fh.read()
    except OSError:
        return ""
    title = ""
    for line in chunk.decode("utf-8", "replace").splitlines():
        if '"custom-title"' not in line:
            continue
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        if rec.get("type") == "custom-title" and rec.get("customTitle"):
            title = rec["customTitle"]   # keep going: the last one is the one
    return title


def name_from_title(title, taken, limit=24):
    """A bus name from a chat title: typeable, unique, and short enough to sit
    in a roster line beside the address SendMessage takes.

    Accents are folded rather than deleted. A chat named in Turkish — or any
    language with a diacritic — would otherwise come out as the consonants that
    happened to be ASCII: `çöp ünlü ışık` became `p-nl-k`, which is not a name
    anybody would recognise as theirs. `ı` and `İ` need saying explicitly
    because they are base letters with no decomposition to strip."""
    import unicodedata
    s = (title or "").strip()
    for pair in (("ı", "i"), ("İ", "i"), ("ł", "l"), ("ø", "o"), ("đ", "d")):
        s = s.replace(pair[0], pair[1]).replace(pair[0].upper(), pair[1])
    s = "".join(c for c in unicodedata.normalize("NFKD", s)
                if not unicodedata.combining(c))
    s = re.sub(r"-{2,}", "-",
               re.sub(r"[^A-Za-z0-9_.#-]+", "-", s)).strip("-.").lower()
    # Cut on a word boundary. A name is read as much as it is typed, and
    # `fix-the-login-bug-for-ac` is worse than one word shorter.
    name = ""
    for word in s.split("-"):
        if name and len(name) + 1 + len(word) > limit:
            break
        name = word if not name else "%s-%s" % (name, word)
    name = (name or s)[:limit].strip("-.")
    if not name:
        return ""
    if name not in taken:
        return name
    for n in range(2, 40):
        cand = "%s#%d" % (name[:20], n)
        if cand not in taken:
            return cand
    return ""


def rename_session(rec, new_name, sessions=None, why="renamed"):
    """Take a new name, and take the subagents with it.

    A subagent is called `<parent>/1`, so a parent that renames and leaves them
    behind produces a roster where nothing looks related to anything — and the
    names are addresses, so the stale ones stop working."""
    require_record(rec, "rename_session")
    old = rec.get("agent")
    if not new_name or new_name == old:
        return False
    rec["agent"] = new_name
    write_json(os.path.join(SESSIONS, "%s.json" % rec["sid"]), rec)
    for a in load_agents(rec["sid"]):
        tail = (a.get("name") or "").split("/", 1)
        if len(tail) == 2 and tail[0] == old:
            a["name"] = "%s/%s" % (new_name, tail[1])
            a["parent"] = new_name
            write_json(agent_path(rec["sid"], a.get("agent_id")), a)
    emit(rec["sid"], new_name, rec.get("repo_key"), "rename",
         "%s — was %s" % (why, old))
    return True


def follow_chat_title(rec, payload):
    """Let the name the human gave the chat be the name on the bus.

    A session registers the moment it opens, when its only distinguishing
    feature is its branch — so it is called `feat-login` or, on the trunk,
    `repo-main`, and two sessions on one branch differ by a `#2`. The human then
    names the chat something meaningful, and until now the bus never heard about
    it. It cannot be done at SessionStart alone either: the rename happens after
    the session has registered, which is the whole reason this runs every turn.

    Only a title the human set is adopted. The plugin writes one itself when a
    chat has none, and adopting that would mean renaming a session after its own
    name — so what we wrote is remembered and skipped."""
    require_record(rec, "follow_chat_title")
    title = transcript_title(payload.get("transcript_path"))
    if not title or title == rec.get("title_set"):
        return False
    taken = {s.get("agent") for s in load_sessions() if s["sid"] != rec["sid"]}
    new_name = name_from_title(title, taken)
    rec["title_set"] = title      # theirs now; never adopt or overwrite it again
    write_json(os.path.join(SESSIONS, "%s.json" % rec["sid"]), rec)
    if not new_name or new_name == rec.get("agent"):
        return False
    return rename_session(rec, new_name, why="took the name of its chat")


def hook_session_start(payload):
    rec, first_time = register(payload)
    if not rec:
        return
    # A resumed chat already has the name its human gave it.
    follow_chat_title(rec, payload)
    sid, repo_key = rec["sid"], rec["repo_key"]
    root, branch, label = rec["root"], rec["branch"], rec["repo_label"]
    sessions = load_sessions()
    if first_time and len(sessions) > 1:
        emit(sid, rec["agent"], repo_key, "join",
             "joined on %s (%s)" % (branch or "-", short_path(root)))
    refresh_derived(sessions)
    rotate_events()

    others = [s for s in sessions if s["sid"] != sid]
    hint = install_hint_once()
    if not others:
        # Alone: say nothing, cost nothing — unless the plugin cannot actually
        # be driven, which is worth exactly one sentence, once.
        if hint:
            print(json.dumps({"hookSpecificOutput": {
                "hookEventName": "SessionStart", "additionalContext": hint}}))
        return

    blocks = ["## agent-bus", "You are `%s`. %d other Claude Code session%s live on "
              "this machine right now." % (rec["agent"], len(others),
                                       " is" if len(others) == 1 else "s are")]
    r = roster_text(rec, sessions)
    if r:
        blocks.append(r)
    # Before the resources, because it says which number their names mean.
    pt = ports_text(rec)
    if pt:
        blocks.append(pt)
    lk = locks_text(rec, sessions)
    if lk:
        blocks.append(lk)
    pending = deliver(rec)
    if pending:
        blocks.append(pending)
    if hint:
        blocks.append(hint)
    blocks.append(RULES)

    out = {"hookSpecificOutput": {
        "hookEventName": "SessionStart",
        "additionalContext": "\n\n".join(blocks)}}
    # Name the tab, but never over the human. `session_title` is not on the
    # payload — measured, not assumed — so testing for it meant this always
    # fired, and resuming a chat somebody had renamed put the generated title
    # back. The transcript is what actually knows.
    if not transcript_title(payload.get("transcript_path")):
        title = "%s · %s" % (rec["agent"], branch or label)
        out["hookSpecificOutput"]["sessionTitle"] = title
        rec["title_set"] = title
        write_json(os.path.join(SESSIONS, "%s.json" % sid), rec)
    print(json.dumps(out))


def hook_prompt_submit(payload):
    if os.environ.get("AGENTBUS_OFF"):
        return
    # The record, not the view: `follow_chat_title` writes what it is given
    # straight to the session file. A prompt is submitted by the session and by
    # nothing else, so the two are the same thing here — but that is a fact
    # about UserPromptSubmit, not a property of the call, and the write site
    # checks rather than trusts it.
    me, _ = resolve_party(payload)
    if not me:
        register(payload)       # missing SessionStart is not an exemption
        me, _ = resolve_party(payload)
        if not me:
            return
    sid = me["sid"]
    touch_beat(sid)
    # Every turn, because a chat is renamed after it has already registered —
    # which is when its human has seen enough of it to know what to call it.
    follow_chat_title(me, payload)
    sessions = load_sessions(reap=True)
    refresh_derived(sessions)
    rotate_events()
    # Keep an explicit claim from expiring under a session that is still working.
    # This has to be written back: mutating the parsed dict changed nothing.
    for lock in held_by(sid):
        if lock.get("mode") == "hard":
            lock["last_used"] = now()
            write_json(lock_path(lock.get("repo"), lock.get("resource")), lock)
    text = deliver(me)
    if not text:
        return
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "UserPromptSubmit", "additionalContext": text}}))


def batch_bash_output(payload):
    """Everything the Bash calls in this batch printed.

    This is where the interference guard has to read from, and not from
    PostToolUse, because **PostToolUse does not fire when a tool call errors** —
    which is every single case this guard exists for. Verified against Claude
    Code 2.1.220: a batch whose Bash command exits non-zero produces
    PreToolUse and PostToolBatch and no PostToolUse at all. PostToolBatch
    carries `tool_calls`, each with its `tool_response`, whatever the outcome.

    Only Bash calls are read. A Read of a file that happens to contain the word
    "error" is not a failing build, and treating it as one would produce an
    accusation out of a coincidence."""
    calls = payload.get("tool_calls")
    if not isinstance(calls, list):
        return ""
    parts = []
    for call in calls:
        if not isinstance(call, dict) or call.get("tool_name") != "Bash":
            continue
        text = response_text(call.get("tool_response"))
        if text:
            parts.append(text)
    return "\n".join(parts)


def release_batch_claims(me, payload):
    """Give back what the commands in this batch took.

    PostToolUse releases a claim the moment its command finishes, but it never
    runs for a command that failed — so without this, a failing guarded command
    would hold the resource for its full soft TTL and block the other session
    for a quarter of an hour."""
    calls = payload.get("tool_calls")
    if not isinstance(calls, list):
        return
    for call in calls:
        if isinstance(call, dict):
            release_autoclaim(me, call.get("tool_use_id"))


def hook_post_batch(payload):
    # Deliberately not gated on the live count. What matters is whether there is
    # anything this session has not been shown, and the two are not the same
    # thing: a session that ends hands over on its way out, and its exit is what
    # drops the count. `deliver` reads a cursor and a counter and returns "" when
    # there is nothing, which is the usual case and is cheap.
    if os.environ.get("AGENTBUS_OFF"):
        return
    record, me = resolve_party(payload)
    if not record:
        return
    touch_beat(record["sid"])
    release_batch_claims(me, payload)
    blocks = []
    hint = name_hint_once(me)
    if hint:
        blocks.append(hint)
    if read_int(LIVEFILE, 0) >= 2:
        note = interference_note(me, batch_bash_output(payload), load_sessions())
        if note:
            blocks.append(note)
    text = deliver(me)
    if text:
        blocks.append(text)
    if not blocks:
        return
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PostToolBatch",
        "additionalContext": "\n\n".join(blocks)}}))


def note_block(me, what, why):
    """Record that something was refused.

    A denial used to leave no trace at all: the agent was told, and nobody else
    could ever see that it had happened. So "did the bus actually stop anything
    today" was unanswerable, which is a poor position for a tool whose whole
    claim is that it stops things. Not delivered into anyone's context — it is
    for the log, `watch` and `status`."""
    emit(me.get("sid"), me.get("agent"), me.get("repo_key"), "block",
         "blocked on %s — %s" % (what, why))


def deny(reason):
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": reason}}))


def note_ctx(text):
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse", "additionalContext": text}}))


def hook_pre_tool(payload):
    if os.environ.get("AGENTBUS_OFF"):
        return
    if read_int(LIVEFILE, 0) < 2:
        return  # alone: nothing to collide with, and Windows calls us directly
    tool = payload.get("tool_name")
    ti = payload.get("tool_input") or {}
    # The command goes in because `git -C <path>` is part of the answer to
    # "where is this call running", and only a Bash command can carry one.
    cmd = ti.get("command", "") if tool == "Bash" else ""
    # The view: this hook decides, it does not write the session's record.
    record, me = resolve_party(payload, cmd)
    if not record:
        register(payload)          # missing SessionStart is not an exemption
        record, me = resolve_party(payload, cmd)
        if not record:
            return
    sessions = load_sessions()
    if tool == "Bash":
        # Before anything can deny it: this is the last moment at which who is
        # running an `agentbus` command is still known.
        leave_party_hint(me, cmd)
        return guard_bash(me, cmd, sessions, payload.get("tool_use_id"))
    if tool == "SendMessage":
        return note_message(me, ti)
    if tool in ("Edit", "Write", "NotebookEdit"):
        return guard_file(me, ti.get("file_path") or ti.get("notebook_path") or "",
                          sessions)


def note_message(me, ti):
    """Write one session-to-session message into the log. Decides nothing.

    Since 3.0.0 this plugin does not carry messages — Claude Code's `SendMessage`
    does, and it reaches the reader's context directly. What was lost with the
    old channel was not delivery but SIGHT of it: `agentbus watch` and the board
    were the one place a person could see the whole machine talking, and a
    conversation that leaves no trace anywhere is a conversation nobody can
    review afterwards. So the call is recorded on its way past.

    It is never denied and never delayed. A guard that can refuse a message is a
    guard that can wedge two agents mid-negotiation, which is precisely what the
    negotiation was introduced to avoid. `msg` is not in `DELIVERED_KINDS`
    either: the recipient already has it, and putting it in anybody's context a
    second time would be the duplicate this whole release removed.

    Only outbound calls are visible, which is sufficient — every message is
    somebody's outbound."""
    to = ti.get("to")
    text = ti.get("message") or ti.get("summary") or ""
    if not isinstance(to, str) or not to:
        return
    emit(me.get("sid"), me.get("agent"), me.get("repo_key"), "msg",
         "→ %s: %s" % (to, text if isinstance(text, str) else ""))


def remember_autoclaim(me, tool_use_id, names):
    """What this one command took, so PostToolUse can give it straight back.

    An automatic claim means "for the length of this command" — otherwise a
    one-second curl holds the API for the full soft TTL and the other session
    waits a quarter of an hour for a service nobody is using."""
    if not tool_use_id or not names:
        return
    write_json(autoclaim_path(tool_use_id),
               {"sid": me.get("sid"), "party": party_key(me),
                "repo": me.get("repo_key"), "resources": names})


def response_text(tool_response):
    """Everything a finished Bash call printed, as one string.

    The shape varies — a dict of stdout/stderr, or a bare string — and a hook
    that assumes one of them raises on the other, which would silently disable
    this check on whichever host disagreed."""
    if isinstance(tool_response, str):
        text = tool_response
    elif isinstance(tool_response, dict):
        parts = [tool_response.get(k) for k in
                 ("stdout", "stderr", "output", "error", "content")]
        text = "\n".join(p for p in parts if isinstance(p, str) and p)
    else:
        return ""
    if len(text) > 200000:
        # Compilers put the failure at the top and test runners at the bottom,
        # so keep both ends rather than an arbitrary prefix.
        text = text[:100000] + "\n" + text[-100000:]
    return text


def output_mentions(text, path, rel):
    """Does this output actually name that file?

    The basename is allowed only when it is long enough and carries an
    extension. `x.ts` appears in the error message of every TypeScript file in
    the project, and `main` appears in half of all output; matching on those
    would produce an accusation from a coincidence."""
    if path and path in text:
        return True
    if rel and rel in text:
        return True
    base = os.path.basename(path or "")
    return len(base) >= 6 and "." in base and base in text


def interference_note(me, tool_response, sessions):
    """Text warning that a failure names another live session's in-flight files,
    or "" when nothing applies.

    This is the part of the plugin no amount of documentation can replace: the
    agent reading a build failure cannot tell that the broken file belongs to
    somebody else who is halfway through editing it, and its instinct is to fix
    it. Only the bus knows who touched what and when.

    Conservative on purpose. Two independent conditions must both hold — the
    command must look like it failed, and its output must name a file another
    live session in this repository wrote in the last few minutes. A false
    accusation is worse than silence: an agent that catches the bus being wrong
    about ownership is an agent that starts working around it."""
    text = response_text(tool_response)
    if not text or not FAILURE_SIGNAL.search(text):
        return ""
    cutoff = now() - INTERFERENCE_WINDOW

    # Anything this session also touched inside the window is dropped: the
    # failure may legitimately be its own, and telling an agent not to fix its
    # own broken edit is the one mistake that would make this feature harmful.
    ours = set()
    for _, path in recent_writes(me.get("sid"), cutoff):
        ours.add(os.path.realpath(path))
        rel = repo_relative(path, me.get("root"))
        if rel:
            ours.add(rel)

    found = {}
    for s in sessions:
        if s["sid"] == me.get("sid"):
            continue
        # A session in a different repository cannot have broken this build, so
        # naming it would be a coincidence dressed up as a cause.
        if s.get("repo_key") != me.get("repo_key"):
            continue
        seen = set()
        for ts, path in reversed(recent_writes(s["sid"], cutoff)):
            real = os.path.realpath(path)
            if real in seen:
                continue
            seen.add(real)
            rel = repo_relative(path, s.get("root"))
            if real in ours or (rel and rel in ours):
                continue
            if not output_mentions(text, path, rel):
                continue
            shown = rel or short_path(path)
            if shown not in found or ts > found[shown][1]:
                found[shown] = (s.get("agent"), ts)
    if not found:
        return ""

    ordered = sorted(((p, a, t) for p, (a, t) in found.items()),
                     key=lambda f: -f[2])[:MAX_INTERFERENCE_FILES]
    who = ordered[0][1]
    base = os.path.basename(ordered[0][0])
    lines = ["agent-bus: this failure names files another live session is "
             "editing right now:"]
    for shown, agent, ts in ordered:
        lines.append("  %s — %s, %s ago" % (shown, agent, held_for(ts)))
    lines += [
        "Do not fix them. That session is mid-edit and the error is probably "
        "transient;",
        "re-run the command in a moment. If it persists, ask rather than edit:",
        say_to(next((s for s in sessions if s.get("agent") == who), {}), who,
               about="your edit to %s breaks my build — done soon?" % base),
        "Fix only files you own.",
    ]
    return "\n".join(lines)


def release_autoclaim(me, tool_use_id):
    """Give back what one command took automatically."""
    if not tool_use_id or not me:
        return
    rec = read_json(autoclaim_path(tool_use_id))
    forget_autoclaim(tool_use_id)
    # Exactly this party: one subagent must not hand back what another took.
    if not rec or rec.get("party", rec.get("sid")) != party_key(me):
        return
    spoken = []
    for name in rec.get("resources", []):
        lock = load_lock(me.get("repo_key"), name)
        if lock and lock.get("sid") == me.get("sid") \
                and lock.get("mode") == "soft":
            if do_release(me, name, quiet=True) and lock.get("announced"):
                spoken.append(name)
    # One line for the batch, matching the one that took them. Four resources
    # released one after another is how `agentbus run` filled the log.
    announce_locks(me, "released", spoken)


def hook_post_bash(payload):
    """Give a finished command's claim back as soon as it finishes.

    The interference check is deliberately NOT here. This event does not fire
    when a tool call errors, which is every case that check exists for — so it
    lives in PostToolBatch, where the output arrives whatever the outcome, and
    where the same batch's claims are released again for the commands that
    failed and never reached this hook at all."""
    record, me = resolve_party(payload)
    if not record:
        return
    release_autoclaim(me, payload.get("tool_use_id"))


def instance_of(res, cmd):
    """Which one of a resource this command is about, when there are several.

    A resource is one thing per machine, and sometimes the machine has three of
    them. On 2026-07-31 three agents shot a screen tour on three simulators —
    each with its own device — and the bus, holding one `simulator` lock,
    serialised work that did not contend at all. All three ran their Maestro
    commands with `AGENTBUS_OFF=1` and said so on the bus, which is the tool
    being right in principle and wrong in fact.

    `key` is a regex over the command's targets whose first group names the
    instance: `"key": "--udid\\\\s+(\\\\S+)"` turns one lock into one per device.
    A command that names no instance falls back to the bare resource, and the
    guard treats that as contending with every instance — not knowing which
    device you mean is a reason to wait, not a reason to proceed."""
    pat = res.get("key")
    if not pat or not cmd:
        return ""
    for text in command_targets(cmd):
        try:
            m = re.search(pat, text, re.I)
        except re.error:
            return ""
        if m and m.groups() and m.group(1):
            return re.sub(r"[^A-Za-z0-9_.-]", "_", m.group(1))[:32]
    return ""


def contending_locks(me, res, want):
    """Every held lock this caller has to get past for one resource.

    Usually one. With instances there are several, and which of them contend
    depends on what was said: name a device and you contend with that device
    and with anybody holding the whole resource; name none and you contend with
    all of them, because not knowing which one you mean is a reason to wait
    rather than a reason to proceed.

    `want` is the name this resource is locked under for this caller — what
    `lock_name` answered — and it is passed in rather than worked out again
    here. That is the whole of spine two in one parameter: this function used to
    ask the question a second time, from a command, which is why `locks_text`
    (which has no command) could not use it and went on reporting a device
    somebody was holding as free."""
    out = [load_lock(me.get("repo_key"), want)]
    if res.get("key"):
        base = res["name"]
        if want != base:
            out.append(load_lock(me.get("repo_key"), base))
        else:
            try:
                names = os.listdir(LOCKS)
            except OSError:
                names = []
            for name in sorted(names):
                lock = read_json(os.path.join(LOCKS, name))
                if lock and lock.get("repo") == me.get("repo_key") \
                        and (lock.get("resource") or "").startswith(base + "@"):
                    out.append(lock)
    return [l for l in out if l]


def lock_name(me, res, cmd=""):
    """The name this resource is locked under.

    Most resources are one per machine. A `scope: "worktree"` resource is one per
    checkout — the working tree and the git index, which only sessions sharing a
    root can corrupt for each other. Since automatic claims now last exactly one
    command, this serialises `git commit` against a concurrent `git stash` in the
    same tree without ever making two sessions in different worktrees wait.

    A resource with a `key` is one per instance: one simulator of several, one
    device of several. The instance is normally read off the command by
    `instance_of`; an instance already on the resource is one the caller named
    outright — `agentbus claim simulator@ABC123`, where there is no command for
    a `key` regex to match against — and it wins, because it is the only
    evidence there is."""
    inst = res.get("instance") or instance_of(res, cmd)
    if inst:
        return "%s@%s" % (res["name"], inst)
    if res.get("scope") == "worktree":
        import hashlib
        digest = hashlib.sha1(
            os.path.realpath(me.get("root") or "").encode()).hexdigest()[:6]
        return "%s@%s" % (res["name"], digest)
    return res["name"]


def autoclaim_path(tool_use_id):
    return os.path.join(AUTOCLAIM, "%s.json"
                        % re.sub(r"[^A-Za-z0-9_.-]", "_", tool_use_id or "none"))


def forget_autoclaim(tool_use_id):
    try:
        os.unlink(autoclaim_path(tool_use_id))
    except OSError:
        pass


def serving_check(plan, me):
    """Is the service this command is about to talk to actually serving MY tree?

    Holding the lock does not make :8082 answer with your code. This is the check
    that turns "nobody else has it booked" into "the answer you get is yours",
    and it has to run even when the lock is free — the dangerous case is a
    session that ended while its detached server kept answering.

    The one part of a Plan that shells out: `serving` runs `lsof`, and on some
    paths twice. That is why it is behind `plan_for`'s `probe_services` and off
    by default — the five command-line verbs M4 routes through `plan_for` are
    pure file operations today and must not each grow a probe. `guard_bash`
    leaves the flag off as well and calls this itself, after `commit_plan`,
    because where it runs is load-bearing: a command touching both a held
    resource and a mis-served one reports the lock, since that is the one
    somebody else is actually using.

    There is no `bypass` among the exits it builds, and no branch here that
    could grow one. "I really do mean the other checkout's server" is not a
    thing anybody means: a green result belonging to another worktree is the
    founding failure this plugin exists for, not a preference."""
    mine = os.path.realpath(me.get("root") or "")
    for i, res in enumerate(plan["resources"]):
        root, how = _service_blocker(me, res, mine)
        if not how:
            continue
        out = dict(plan)
        out["blocker"] = {"resource": res, "serving": root,
                          "mine": me.get("root", ""), "also": []}
        if how == "unknown":
            out["verdict"] = "warn"
            out["reason"] = "service-unknown"
            out["exits"] = [_exit("serve", "through",
                                  "agentbus serve %s" % res["name"],
                                  "restarts it from your worktree")]
            return out
        out["blocker"]["started"] = read_json(
            serve_path(me.get("repo_key"), res["name"])) or {}
        out["verdict"] = "deny"
        out["reason"] = "service-elsewhere"
        # Every other service this same command needs and this same checkout does
        # not have. Worked out only now that the answer is a refusal, so the
        # common path still pays one probe and stops: the extra `serving` calls
        # happen on a command that is already being denied.
        #
        # It is what turns a block into a way out. One run wanting a device and
        # the three services it implies produced three blocks in a row, each
        # naming one service, each answered with one `agentbus serve` — and the
        # reader had no way to know there were two more coming. Measured on the
        # live bus over 48 hours: 41 of the 85 guard overrides were one repeated
        # command against exactly that shape.
        also = [r for r in plan["resources"][i + 1:]
                if _service_blocker(me, r, mine)[1] not in ("", "unknown")]
        out["blocker"]["also"] = [r["name"] for r in also]
        moving = [res] + also
        what = "it" if len(moving) == 1 else "all %d" % len(moving)
        # What the command is ABOUT, which is what `agentbus run` has to be
        # given: the resources its patterns matched, not the implied ones it
        # tripped over. `run` expands `implies` itself, one level, exactly as
        # `resources_for` does — so naming the matched ones covers every service
        # in this Plan in a single command, and `expand_implied` is the one
        # function that answers it for both of them.
        about = [_named(r) for r in plan["resources"]
                 if not r.get("_implied_by")] or [_named(res)]
        out["exits"] = [
            _exit("run", "through",
                  "agentbus run %s -- <your command>" % ",".join(about),
                  "one step: moves %s to your tree, then runs it" % what),
            _exit("serve", "through",
                  "agentbus serve %s" % ",".join(_named(r) for r in moving),
                  "moves %s for good, and tells the others" % what),
        ]
        return out
    return plan


def _service_blocker(me, res, mine):
    """`(root, how)` for a declared service that is not answering for `mine`, or
    `(None, "")` when it is nothing to worry about.

    One function rather than a condition written twice: `serving_check` asks this
    question once to decide the verdict and again for every other service the
    same command would have to move, and two copies of it drifting apart is how
    a block came to name one service while three were in the way."""
    if res.get("_explicit"):
        return None, ""    # `agentbus serve`/`run` are how a service gets moved
    if not res.get("start") and not res.get("port"):
        return None, ""
    root, how = serving(me.get("repo_key"), res)
    if how == "down":
        return None, ""
    if root and os.path.realpath(root) == mine:
        return None, ""
    return root, how


def wrong_port_check(me, cfg, cmd, sessions=None):
    """Is this command aimed at a port that belongs to another checkout?

    Per-worktree ports remove contention, and they introduce one new way to be
    silently wrong: an agent curls `localhost:8082` out of habit — from a
    README, from a note, from the shape of every other project — and quietly
    exercises the original checkout's code while believing it tested its own.
    That is the founding failure of this plugin arriving through the back door,
    and isolation cannot prevent it, only notice it.

    Only ports this machine has actually allocated are treated as somebody
    else's. An unknown port is somebody's business but not ours.

    Returns a Plan, or None when there is nothing to say. Its exits are the
    only `correct` ones in the plugin: they do not lift the block and do not
    claim to — they hand over the port that is this checkout's, and the command
    the reader runs afterwards is a different command from the one refused."""
    ports = set()
    for text in command_targets(cmd):
        for m in re.finditer(r"(?::|--port[= ]|-p\s+)(\d{2,5})\b", text):
            ports.add(int(m.group(1)))
    if not ports:
        return None
    isolated = [r for r in cfg.get("resources", []) if r.get("_declared_port")]
    if not isolated:
        return None
    mine = os.path.realpath(me.get("root") or "")
    ours = {r.get("port") for r in isolated}
    # Only this repository's allocations. Another project's port is somebody's
    # business but not ours, and guessing otherwise would block a command that
    # has nothing to do with this checkout.
    roots = {s.get("root") for s in (sessions or []) if s.get("root")
             and s.get("repo_key") == me.get("repo_key")}
    owners = {p: {"root": r, "resource": ""}
              for p, r in port_owners(cfg, me.get("repo_key"), roots).items()}
    for port in sorted(ports):
        if port in ours:
            continue                      # one of this checkout's own
        owner = owners.get(port)
        elsewhere = owner and os.path.realpath(owner.get("root") or "") != mine
        declared_elsewhere = (not is_primary_worktree(mine)
                              and port in {r["_declared_port"] for r in isolated
                                           if r.get("_declared_port")})
        if elsewhere or declared_elsewhere:
            res = next((r for r in isolated
                        if r.get("_declared_port") == port
                        or (owner and r["name"] == owner.get("resource"))),
                       isolated[0])
            whose = (short_path(owner["root"]) if elsewhere
                     else "the repository's original checkout")
            return _plan(cmd, "deny", "wrong-port",
                         {"port": port, "whose": whose, "mine": mine,
                          "resource": res}, [], [
                _exit("env", "correct", 'eval "$(agentbus env)"',
                      "then :%d" % res.get("port", 0)),
                _exit("port", "correct", "agentbus port %s" % res["name"],
                      "just the number"),
                _exit("off", "bypass", "AGENTBUS_OFF=1 <your command>",
                      "if you really do mean another checkout's"),
            ])
    return None


# ------------------------------------------------------------------ plan ----
#
# A Plan is what one command means for the shared resources of one repository:
# which of them it touches, under which names they are locked, what is going to
# happen to it, and — the part that keeps being wrong — what the reader can run
# instead when the answer is no.
#
#     cmd        the command the plan is about
#     resources  the declared resources it touches, each a copy of the config
#                entry with `lock` (from `lock_name`) and `instance` (from
#                `instance_of`) added
#     verdict    "allow" | "deny" | "warn"
#     reason     which decision this is, as a tag and not a sentence: "" for
#                nothing in the way, "opted-out", "lock-held", "wrong-port",
#                "service-elsewhere", "service-unknown"
#     blocker    the facts a refusal is about — the lock and who holds it, the
#                port and whose it is, the service and what it serves. Facts
#                only: English is `render_block`'s business, and a Plan that
#                carried prose would be the second copy again
#     exits      what to run instead; see `_exit`
#     taken      what `commit_plan` actually claimed, so a later deny can give
#                it back
#
# Six of this plugin's twenty-two defects came from "what does this command
# touch and under what name is it locked" being answered in more than one
# place, and the place that hurt was the English at the bottom of a block
# message, which hard-coded its advice as format strings. `agentbus wait <res>`
# was advertised and refused by the guard that printed it. `agentbus claim
# worktree` was advertised, allowed, and wrote a lock nothing ever read. A block
# about one simulator advertised the bare resource, so the exit took a lock
# nothing was contending for and left the device exactly where it was. Building
# the advice out of the same object that produced the verdict is what makes
# that class of defect unavailable rather than merely absent.


def _exit(eid, kind, cmd, when):
    """One line the reader can run, and what running it does.

    `cmd` is fully substituted: the lock actually in the way, the agent actually
    holding it, the port actually allocated. Never a format string — an exit
    exists only because `plan_for` had the facts to build it, so there is
    nothing left for it to get wrong. The single thing never substituted is
    `<your command>`, which is the reader's own command line: it is already on
    their screen, and inlining a shell pipeline twice into a block message reads
    worse than the placeholder does.

    `kind` is what running it achieves. That is the distinction a blocked agent
    needs and the one the plan for this refactor did not name; these four came
    out of walking every block the command surface can emit:

        through   run it and the block lifts — you hold what you were refused,
                  or the service is yours now
        ask       run it and you know more, or somebody else does. The block is
                  exactly where it was, and the line does not pretend otherwise
        correct   the command you ran is aimed at something that is not yours,
                  and this is how to aim it at what is. The block stays, and
                  should: it is not the same command any more
        bypass    steps over the decision instead of resolving it, and says so
                  on the bus
        tell      not a command at all: a tool call, because since 3.0.0 the way
                  to reach another session is Claude Code's `SendMessage` and
                  this plugin cannot send one for you. Rendered so that nobody
                  pastes it into a shell, and never run by anything — including
                  the test that runs every other exit to prove it is reachable

    They are not interchangeable, and flattening them is how `agentbus status`
    came to be printed beside `agentbus wait` with nothing to tell them apart.
    Note also which blocks have which: the serving block has no `bypass` at all,
    because "I really do mean the other checkout's server" is not a thing
    anybody means.

    `eid` is which exit this is — `wait`, `steal`, `off` — so that
    `render_block` can place it in the prose and a test can ask for it by name.
    It is the mechanism where `kind` is the effect, and both are needed: two
    exits of one kind sit in different sentences.

    `when` is one short line saying when this exit is the right one, or what
    running it gives you. It is rendered beside the command wherever the message
    has room for it."""
    return {"id": eid, "kind": kind, "cmd": cmd, "when": when}


def _exit_say(plan, eid, indent="  "):
    """The message a `tell` exit suggests sending, if it suggests one.

    Here rather than in `render_block` for the reason every runnable line is:
    the sentence names a command for its reader to run, and a message that
    composes one of those itself is how this plugin came to advertise three
    commands its own guard refused. `check_exits_are_planned` fails the build if
    it moves back."""
    e = _exit_of(plan, eid) or {}
    say = e.get("say") or ""
    if not say:
        return ""
    lines = say.split("\n")
    return "\n".join('%s%s%s%s' % (indent, '"' if i == 0 else " ", ln,
                                   '"' if i == len(lines) - 1 else "")
                     for i, ln in enumerate(lines))


def _plan(cmd="", verdict="allow", reason="", blocker=None,
          resources=None, exits=None):
    return {"cmd": cmd or "", "resources": list(resources or []),
            "verdict": verdict, "reason": reason, "blocker": blocker,
            "exits": list(exits or []), "taken": []}


def _exit_of(plan, eid):
    return next((e for e in plan.get("exits", []) if e.get("id") == eid), None)


def _exit_cmd(plan, eid):
    """The command line of one of a Plan's exits, or "" when it has no such
    exit — which is how the unidentified block's `--as` line simply disappears
    for a caller nothing can name, instead of being printed with a hole in it."""
    e = _exit_of(plan, eid)
    return e["cmd"] if e else ""


def _exit_when(plan, eid):
    e = _exit_of(plan, eid)
    return e["when"] if e else ""


def _named(res):
    """What to call one of a Plan's resources back to whoever typed it.

    The instance when the caller named one — `simulator@ABC123` is both the key
    it is filed under and the word the block told them to type, so echoing it
    back is answering in their vocabulary. Otherwise the plain name: nobody
    types `worktree@3f9c1a` and it is not what anyone calls their checkout."""
    return res["lock"] if res.get("instance") else res["name"]


def _exit_line(plan, eid, indent="  ", width=36, mark=""):
    """One exit as a line of the message: the command, then what it is for."""
    e = _exit_of(plan, eid)
    if not e:
        return ""
    return "%s%-*s  %s%s" % (indent, width, e["cmd"], mark, e["when"])


def _tell_exit(session, party="", say=""):
    """The `ask them` exit, as the tool call it now is.

    Built from the address book rather than from a name this plugin chose, and
    addressed to the SESSION even when a subagent is the one holding the lock:
    `SendMessage` reaches sessions, and 64 of the 87 takeovers this plugin has
    recorded were between parties inside one. Telling the reader to write to
    `seeder/1` would be telling them to write to nobody."""
    addr, status = address_of(session.get("sid"), session.get("pid"))
    owner = session.get("agent") or ""
    if not addr:
        # No invented address. `ListAgents` is a tool the reader has and this
        # plugin does not, and it knows names the registry cannot see.
        out = _exit("ask", "tell", "ListAgents, then SendMessage",
                    "find their address, then ask them")
        out["say"] = say
        return out
    if party and owner and party != owner:
        when = "ask %s — it holds this through %s" % (owner, party)
    else:
        when = "ask them" + (" (%s)" % status if status else "")
    out = _exit("ask", "tell", 'SendMessage tool → to "%s"' % addr, when)
    out["say"] = say
    return out


def _exit_name(res, lock):
    """The name of one resource, as it has to appear in a line the reader runs.

    For a `key`-bearing resource that is the instance in the way, not the
    resource: `agentbus wait simulator` resolves to a bare `simulator` lock
    nothing was contending for, takes it, prints "claimed" and leaves the device
    exactly where it was. Only the runnable lines use this — the prose keeps the
    plain name, which is what a person calls the thing and, for a
    worktree-scoped resource, the only half of the key anyone typed.

    Its own function because the block has to say it for every resource in the
    way and not only for the first, and the lock is the evidence: `res["lock"]`
    is what THIS caller would file it under, which for an unqualified command
    against a bench of devices is the bare name rather than the device somebody
    is holding."""
    held = lock.get("resource") or res["name"]
    return held if (res.get("key")
                    and held.startswith(res["name"] + "@")) else res["name"]


def _lock_block(me, cmd, res, lock, holder, resources=None, also=()):
    """The Plan for a command refused because another party holds what it needs.

    The only constructor for this verdict, and deliberately the only one: it is
    reached twice, once from the optimistic check `plan_for` makes outside the
    mutex and once from `commit_plan` when `do_claim` re-tests inside the mutex
    and loses that race. Two constructors one function apart is exactly the
    defect this refactor exists to remove.

    `also` is every OTHER resource in the way, as `(resource, lock)` pairs. The
    pairs and not the resources, because the runnable advice has to name each of
    them the way `_exit_name` names the first — and until 2.8.0 they were carried
    as names, appeared in one line of prose, and had no runnable line at all."""
    held = lock.get("resource") or res["name"]
    exit_name = _exit_name(res, lock)
    # The lock's own name, not the session's: a lock taken by a subagent is held
    # by that subagent, and telling the reader to go and talk to the session
    # would point them at the wrong agent.
    who = lock.get("agent") or holder.get("agent")
    blocker = {
        "resource": res, "lock": lock, "holder": holder,
        "held": held, "exit_name": exit_name, "who": who,
        "also": [r["name"] for r, _ in also],
        "same_tree": (os.path.realpath(holder.get("root") or "")
                      == os.path.realpath(me.get("root") or "")),
        # Two subagents of one session. A parent and its own subagent never
        # contend; these two do.
        "sibling": bool(lock.get("sid") == me.get("sid")
                        and (lock.get("agent_id") or "")
                        and (me.get("agent_id") or "")),
        # Taken by somebody in this session through a path where the caller
        # could not be identified — an `agentbus claim` inside a runner script,
        # where the guard never saw the command line and a subagent's shell is
        # indistinguishable from its parent's. Treating that as "the session
        # itself" is what let three agents drive one simulator at once.
        "unidentified": bool(lock.get("sid") == me.get("sid")
                             and not lock.get("party_known", True)
                             and (me.get("agent_id") or "")),
    }
    # Every resource in the way, in one command. `agentbus wait` splits a comma
    # list and keeps ONE deadline for the whole of it, which is the difference
    # between an exit and a chore: a run wanting a device and the three services
    # it implies was told to wait for the device, and the other three arrived as a
    # line of prose — "Also in use: …" — with nothing to run against them. So the
    # honest way out was four commands, four blocks and four discoveries, while
    # `AGENTBUS_OFF=1` in front of the command was one. Over 48 hours on the live
    # bus the guard was overridden 85 times against 6 real blocks, and every one
    # of those overrides was a reader choosing the shorter of those two.
    queue_for = ",".join([exit_name] + [_exit_name(r, l) for r, l in also])
    wait = _exit("wait", "through", 'agentbus wait %s --why "..."' % queue_for,
                 "queue; takes it the moment it frees" if not also
                 else "queue for all %d; takes each as it frees" % (1 + len(also)))
    exits = []
    if blocker["unidentified"]:
        # `--steal` is part of this advice rather than an afterthought. Naming
        # yourself does not make an anonymous lock yours — `same_party` refuses
        # it for exactly the reason this block exists, and believing `--as` here
        # would let one subagent adopt another's lock in silence, which is the
        # three-agents-one-simulator failure. Taking it anyway is a takeover, so
        # it is called one: `--steal` puts "took 'X' from Y (forced)" on the bus
        # and the other agent can see what happened.
        # Named outright, not `<your name>`. This block only exists for a caller
        # that has an `agent_id`, so the Plan is holding the answer the line used
        # to send the reader off to find: it ended "(yours is in the message that
        # named you)", which is a message admitting it had printed a hole. A
        # caller nothing can name gets no `adopt` exit rather than a template —
        # an exit exists only when it would work.
        if me.get("agent"):
            exits.append(_exit(
                "adopt", "through",
                'agentbus claim %s --as %s --steal --why "..."'
                % (exit_name, me.get("agent")),
                "if that agent was you"))
        exits.append(wait)
        exits.append(_exit("release", "through", "agentbus release --all",
                           "from whichever agent took it"))
    if not blocker["unidentified"]:
        # Before the two that only tell you things. Both orders in this function
        # now put the way THROUGH the block above the ways of reading about it:
        # `render_refusal` prints these in list order, and an agent that is
        # already deciding between four commands and one `AGENTBUS_OFF` should
        # not have to read past `agentbus status` to find the one that works.
        exits.append(wait)
    # Asking comes second, under the queue and above everything that only tells
    # you things. The order is the argument: `wait` is what actually ends with
    # your command running, the message is what makes it end sooner, and
    # neither of them is `agentbus status`. Until a message could wake a
    # session, asking belonged down here with the reading — a posted note waited
    # for the holder's next turn, which for an idle session is whenever its
    # human comes back, so "ask them" was advice nobody could take. On
    # 2026-09-04 a session was blocked on the database at 14:38:31 and stepped
    # past the guard with AGENTBUS_OFF at 14:38:42. Eleven seconds is how long
    # it was considered.
    exits.append(_tell_exit(
        holder, who,
        say=("I have queued for %s — `agentbus status` shows me waiting.\n"
             "Release it when your command is done and mine takes it."
             % exit_name)))
    exits.append(_exit("status", "ask", "agentbus status", "what is going on"))
    if cmd:
        # Only when there is a command to put it in front of. A Plan built from
        # a name rather than a command — which is what the five command-line
        # verbs ask for — has nothing this exit could apply to: `AGENTBUS_OFF`
        # is read by the hooks and by nothing in the CLI, so
        # `AGENTBUS_OFF=1 agentbus claim db` would be an exit that does not
        # work, and an exit exists only when it would.
        exits.append(_exit("off", "bypass", "AGENTBUS_OFF=1 <your command>",
                           "when the command does not touch %s at all"
                           % res["name"]))
    exits.append(_exit("steal", "through",
                       'agentbus claim %s --steal --why "..."' % exit_name,
                       # Not "when you know they have finished" any more. You can
                       # find out: they answer in seconds. Taking it while they
                       # are still working is what this line used to make sound
                       # reasonable.
                       "when their session is gone — otherwise ask them first"))
    return _plan(cmd, "deny", "lock-held", blocker,
                 resources if resources is not None else [res], exits)


def _named_resources(cfg, me, names):
    """The resources a command-line verb named outright, and their lock names.

    Returns `(resources, unknown)`, where `unknown` is the base of an
    `<resource>@<instance>` name this repository does not declare — the one
    input that cannot be turned into a lock at all.

    The verbs have a name where the guard has a command, which is why
    `plan_for` takes both. Round-tripping the name through a synthesised
    `"agentbus claim simulator"` so that `explicit_resources` could parse it
    back is lossy in exactly the place that matters: that line carries no
    `--udid`, so the instance — the whole point of a `key` — disappears on the
    way through.

    Four forms, tried in this order:

        db                a declared resource, under `lock_name`'s answer for
                          this caller: the bare name, or `worktree@<digest>`
                          for a `scope: "worktree"` one
        simulator@ABC123  one instance of a declared resource. The `key` regex
                          reads an instance off a command and there is no
                          command here, so the caller says which. Sanitised
                          exactly as `instance_of` sanitises what it reads, or
                          a device called `sim/2` is filed by the verb under a
                          key the guard never writes
        simulatr@ABC123   refused. This resolved by accident before M1, by
                          falling through the pass-through below, so one
                          mistyped character wrote a junk lock and reported it
                          as a claim
        file:/abs/path    passed through untouched. That key is deliberately
                          literal — `@` and all, since a path may contain one —
                          and so is any other undeclared name, which is how a
                          single file gets taken

    A comma list is split, because `explicit_resources` splits one and the two
    have to mean the same thing. They did not: the guard understood `agentbus
    claim rig,bundler` and the verb wrote a single lock named `rig,bundler`,
    printed `claimed`, and held neither of them.

    Each resource comes back with its `instance` filled in and no `lock`:
    naming the lock is `lock_name`'s job and `plan_for` does it for both halves
    at once, so that there is still exactly one function that answers it."""
    by_name = {r["name"]: r for r in cfg.get("resources", [])}
    out, seen = [], set()
    for name in (names if isinstance(names, (list, tuple)) else [names]):
        for part in str(name or "").split(","):
            part = part.strip()
            if not part:
                continue
            res = by_name.get(part)
            if res:
                res = dict(res)
                res["instance"] = ""
            else:
                base, at, inst = part.rpartition("@")
                if at and not part.startswith("file:"):
                    decl = by_name.get(base)
                    if not decl or not inst:
                        return [], base
                    res = dict(decl)
                    res["instance"] = re.sub(
                        r"[^A-Za-z0-9_.-]", "_", inst)[:32]
                else:
                    res = {"name": part, "instance": "", "_literal": True}
            # Named outright, like `explicit_resources` marks the same thing on
            # the guard's side: a deliberate act, worth a line on the bus, and
            # not something the service probe should refuse to move.
            res["_explicit"] = True
            if (res["name"], res["instance"]) in seen:
                continue
            seen.add((res["name"], res["instance"]))
            out.append(res)
    return out, ""


def plan_for(me, cmd=None, names=None, sessions=None, probe_services=False):
    """What this command — or this verb — touches. Pure: reads state, takes
    nothing.

    Returns a Plan: `resources` (each with its resolved lock name and
    instance), `verdict` ("allow" | "deny" | "warn"), `reason`, `blocker`,
    and `exits`. With probe_services False — the default, and what the
    command-line verbs use — the service-ownership check is not run and no
    subprocess is started.

    `cmd` is what the guard has; `names` is what the five command-line verbs
    have, and they are not interchangeable. See `_named_resources` for why the
    name cannot simply be turned back into a command. `names` takes a comma
    list, one string or several, and does NOT expand `implies`: the guard and
    `agentbus run` expand, `agentbus claim` deliberately does not and says so
    instead, so the expansion stays with the caller that wants it.

    Pure matters twice over. It is what lets the guard ask the question before
    deciding whether to answer it, and it is what lets the five command-line
    verbs ask the same question without each of them growing an `lsof`: they
    are pure file operations. Nothing here writes, claims, or emits.
    `commit_plan` does all three — which is why the verbs do not call it; see
    the Decision Log.

    The verdict is deliberately provisional. It is made outside the mutex, so
    it can lose a race to another session between here and `do_claim`;
    `commit_plan` re-tests inside the mutex and its answer is the one that
    counts."""
    cmd = cmd or ""
    if names is None and command_opts_out(cmd):
        # Nothing is touched, deliberately. Said out loud by whoever commits
        # this plan, because a guard everybody can step over quietly is not a
        # guard — this is the only place the plugin lets a command past a
        # decision it would otherwise have made.
        #
        # But only when it stepped over something. The resources are worked out
        # here rather than skipped, because announcing every `AGENTBUS_OFF` was
        # measured on this machine and it hides the ones that matter: over 48
        # hours, 88 of them, of which 76 — 86 per cent — would not have matched
        # a single resource. Agents had learned to write the prefix by habit,
        # `sleep 30` and `ps ax | grep` included, and every one of those put a
        # line on the bus. The twelve real ones were somewhere in the noise, six
        # of them driving the simulator this plugin exists to serialise, and
        # nobody reading `agentbus status` was going to find them.
        cfg = repo_config(me.get("repo_key", ""), me.get("root"))
        over = [h["name"] for h in resources_for(cmd, cfg)
                if not h.get("_passthrough")]
        # And what the wrong-port check WOULD have said, because that is the one
        # decision here with nothing on the other side of it: a lock bypass is a
        # risk somebody accepted, while your own port exists and another
        # checkout's answer is not about your tree however the config is written.
        # Asked here rather than after the opt-out so that the answer is the same
        # object the block would have carried — same facts, same exits, one
        # wording — and asked at all because two of the three things it catches
        # match no pattern in this checkout and so are not in `over` either: an
        # override aimed at another worktree's allocated port went past this guard
        # leaving nothing behind it at all, not even a line in the log.
        wrong = wrong_port_check(
            me, cfg, cmd,
            sessions if sessions is not None else load_sessions())
        return _plan(cmd, "allow", "opted-out",
                     blocker={"overrode": over, "wrong": wrong})
    cfg = repo_config(me.get("repo_key", ""), me.get("root"))
    sessions = sessions if sessions is not None else load_sessions()
    if names is None:
        # Before anything else, and regardless of whether a pattern matched: a
        # command aimed at another checkout's port is wrong however the config
        # is written, and the port that catches it may not be in this
        # checkout's patterns at all — each worktree's patterns name only its
        # own. It comes before the resources are even worked out because
        # claiming first would leave a lock behind a command that is not going
        # to run.
        wrong = wrong_port_check(me, cfg, cmd, sessions)
        if wrong:
            return wrong
        resources = []
        for res in resources_for(cmd, cfg):
            if res.get("_passthrough"):
                continue
            res = dict(res)
            res["instance"] = instance_of(res, cmd)
            res["lock"] = lock_name(me, res, cmd)
            resources.append(res)
    else:
        resources, unknown = _named_resources(cfg, me, names)
        if unknown:
            return _plan(cmd, "deny", "no-such-resource", {"base": unknown},
                         [], [_exit("status", "ask", "agentbus status",
                                    "the resources this repo declares")])
        for res in resources:
            res["lock"] = lock_name(me, res)
    if not resources:
        return _plan(cmd)
    # Check every resource before taking any. A command that is going to be
    # denied must not leave half the rig claimed behind it.
    blocked = []
    for res in resources:
        for lock in contending_locks(me, res, res["lock"]):
            if same_party(lock, me):
                continue
            holder, stealable, _ = lock_state(lock, sessions)
            if holder and not stealable:
                blocked.append((res, lock, holder))
                break
    if blocked:
        res, lock, holder = blocked[0]
        # The resource AND the lock for each of the others: the advice has to name
        # the instance actually in the way, and only the lock knows which it is.
        return _lock_block(me, cmd, res, lock, holder, resources,
                           [(b[0], b[1]) for b in blocked[1:]])
    plan = _plan(cmd, resources=resources)
    if probe_services:
        plan = serving_check(plan, me)
    return plan


def commit_plan(plan, me, sessions, tool_use_id=None):
    """Take what the Plan says to take, inside the mutex, and return the
    authoritative Plan. The optimistic verdict from plan_for can lose a
    race; do_claim's answer inside the mutex is the one that counts, and
    ignoring it is how two sessions both proceeded before c95399c."""
    # A resource whose patterns stop matching — a port moved, a script was
    # renamed — fails silently and looks exactly like a resource nobody is
    # using. Recording the last match lets `doctor` say so. Recorded whatever
    # the verdict, because a command that was refused still touched the thing.
    for res in plan["resources"]:
        try:
            open(os.path.join(MATCHED, re.sub(r"[^A-Za-z0-9_.-]", "_", "%s__%s" % (
                me.get("repo_key"), res["name"]))), "w").close()
        except OSError:
            pass
    if plan["verdict"] != "allow" or not plan["resources"]:
        return plan
    # A command that named its resources outright is a deliberate act and worth
    # a line; a pattern match is one command's worth of housekeeping and is not.
    explicit = any(r.get("_explicit") for r in plan["resources"])
    taken = []
    for res in plan["resources"]:
        ok, lock, holder, _ = do_claim(me, res["lock"], mode="soft",
                                       sessions=sessions, announced=explicit)
        if ok:
            taken.append(res["lock"])
            continue
        # The check in `plan_for` ran outside the mutex; `do_claim` re-tested
        # inside it and lost. Ignoring that answer is how two sessions both
        # proceed. Answering it by building a second Plan here by hand is how
        # the two answers drift apart, so it is the same constructor.
        for name in taken:
            do_release(me, name, quiet=True)
        return _lock_block(me, plan["cmd"], res, lock, holder, plan["resources"])
    remember_autoclaim(me, tool_use_id, taken)
    if taken:
        bump_guarded(me)
        if explicit:
            announce_locks(me, "took", taken, redact(plan["cmd"].strip())[:90])
    plan["taken"] = taken
    return plan


def wrong_port_said(plan, whose="you"):
    """What a wrong-port decision has to say, once, for either of the two
    audiences it has.

    The session that was stopped reads it in a block. The sessions a bypass of
    that block lands on read it in their own context, and they need the same
    facts: which port it was, whose checkout that port serves, which checkout the
    command ran in, which port is that checkout's own, and what an answer from
    the wrong one is worth. Written twice they drift the first time a port is
    renamed — the block saying one thing about a command and the announcement
    another — and a second copy of one explanation is the defect class
    `plans/two-spines-refactor.md` spent a milestone collapsing.

    `whose` is the whole difference between the two, and both persons are written
    here side by side so that changing one is done in front of the other. The
    runnable line is not here at all: it comes out of `plan["exits"]` for both,
    like every other command this plugin prints.

    Returns (facts, worth): the labelled lines, and what an answer from that port
    is worth to whoever ends up reading it."""
    b = plan.get("blocker") or {}
    res = b.get("resource") or {}
    port, name = b.get("port") or 0, res.get("name", "?")
    if whose == "you":
        return ([
            "  :%d belongs to : %s" % (port, b.get("whose", "?")),
            "  you are in    : %s" % short_path(b.get("mine") or ""),
            "  yours is      : %d" % res.get("port", 0),
        ], [
            "  Each checkout runs its own '%s' so that a request answers with "
            "the code you" % name,
            "  are looking at. Reaching another one gives you a green result "
            "for somebody",
            "  else's tree — the exact failure per-worktree ports exist to "
            "remove.",
        ])
    return ([
        "  :%d belongs to : %s" % (port, b.get("whose", "?")),
        "  they are in   : %s" % short_path(b.get("mine") or ""),
        "  theirs is     : %d" % res.get("port", 0),
    ], [
        "  Whatever :%d answered came from that checkout's '%s', and it is "
        "being reported as theirs." % (port, name),
    ])


def astray_again(me, port):
    """Whether this bypass of the wrong-port guard is the one that speaks, and
    how many it is speaking for. Writes; not for `plan_for`.

    Returns (n, said_at, speak). Speaking, `n` is how many were swallowed since
    the last announcement and `said_at` when that was, so the message can say
    what it is standing for. Not speaking, `n` is which one of the run this is —
    the count a watcher reads off the board — and nothing is delivered.

    Bounded per party and per port because both halves were measured. Unbounded,
    one subagent going past this guard 28 times at one port in a day is 28
    identical sentences in everybody's context, which is exactly the noise 2.3.0
    removed: of 88 bypass announcements over 48 hours, 76 were about nothing, and
    they were hiding the twelve that were not. Making this one loud must not undo
    that. Silent for ever after the first, though, and a party that goes on doing
    it all day is mentioned once and then never again — which is how the last
    quiet failure stayed quiet. So neither: the first is delivered in full, the
    ones behind it are counted and stay out of context, and once the window is up
    the next one is delivered saying how many there were.

    Per party and per port, and deliberately not per command: the 28 were 25
    `curl`s and 6 readiness loops, which is one mistake written six ways. Keying
    on the command line would have made it six announcements, and a `while` loop
    around it any number at all."""
    key = "%s\0%d" % (party_key(me), port)
    with Mutex("astray"):
        reg = read_json(ASTRAY) or {}
        rec = reg.get(key) or {}
        # A pair nobody has been past for a whole window is a run that ended, and
        # a record older than that changes no decision here — which is also why
        # pruning needs no policy of its own below. An agent coming back to it
        # tomorrow is not the agent that was told this morning, so it is a first
        # one again, and loud.
        live = now() - (rec.get("last") or 0) <= ASTRAY_AGAIN
        said_at = rec.get("at", 0) if live else 0
        swallowed = rec.get("n", 0) if live else 0
        speak = now() - said_at > ASTRAY_AGAIN
        reg[key] = {"at": now() if speak else said_at, "last": now(),
                    "n": 0 if speak else swallowed + 1,
                    "port": port, "repo": me.get("repo_key", "")}
        for stale in [k for k, v in reg.items()
                      if now() - (v.get("last") or 0) > ASTRAY_AGAIN]:
            del reg[stale]
        write_json(ASTRAY, reg)
    if speak:
        return swallowed, said_at, True
    # This one, the ones swallowed before it, and the announcement that opened the
    # run: "×3" on the board is the third time, not the third one nobody saw.
    return swallowed + 2, said_at, False


def note_astray(me, plan):
    """A bypass of the wrong-port guard, put where the people it lands on read it.

    The one override this plugin answers for. `AGENTBUS_OFF` in front of a lock
    is a real escape — "I accept the contention risk", "this `psql` is aimed at a
    staging box in another country" — and it stays exactly as it is. In front of
    the wrong-port check there is no such case: your own port exists, and the
    answer you get from another checkout's is not about your tree however the
    config is written. So this one is announced rather than merely logged, and
    every word of it is the block's own, read out in the third person.

    Sent to the repository rather than to the port's owner alone. The owner is
    the party whose service is being hit, but they may be nobody — the original
    checkout often has no session in it — and the second consequence has no
    owner at all: anybody who reads this agent's conclusions later is reading
    another tree's results. `emit` addressed to one agent would reach one reader
    and by design nobody else."""
    b = plan.get("blocker") or {}
    port = b.get("port") or 0
    n, said_at, speak = astray_again(me, port)
    head = ("went past the wrong-port guard on :%d with AGENTBUS_OFF — %s"
            % (port, redact(plan["cmd"].strip())[:120]))
    if not speak:
        # Short, and marked. It is in the log for whoever is counting the run and
        # out of everybody's context; see `interesting_to`.
        return emit(me.get("sid"), me.get("agent"), me.get("repo_key"),
                    "wrong-port", head, extra={"again": n, "port": port})
    facts, worth = wrong_port_said(plan, "they")
    lines = [head] + facts + worth
    # The correction that was skipped, in the words the block offered it in —
    # `plan["exits"]` is where every runnable line in this plugin comes from, and
    # an announcement that composed its own would be advertising a command
    # nothing had checked.
    if _exit_cmd(plan, "env"):
        lines.append("  Skipped: %-22s  # %s" % (_exit_cmd(plan, "env"),
                                                 _exit_when(plan, "env")))
    if n:
        lines.append("  And %d more of these since %s, not repeated."
                     % (n, ago(said_at)))
    return emit(me.get("sid"), me.get("agent"), me.get("repo_key"),
                "wrong-port", "\n".join(lines), extra={"port": port})


def note_plan_block(me, plan):
    """Put this Plan's refusal on the bus.

    One place rather than three: the blocks differ only in what they name, and
    they were each emitting their own line from inside the function that
    detected them — which is why the serving one fired before the locks the
    same command had just taken were given back."""
    b = plan.get("blocker") or {}
    if plan.get("reason") == "lock-held":
        note_block(me, "'%s'" % b["resource"]["name"], "held by %s" % b["who"])
    elif plan.get("reason") == "wrong-port":
        note_block(me, ":%d" % b["port"], "it belongs to %s" % b["whose"])
    elif plan.get("reason") == "service-elsewhere":
        note_block(me, "'%s'" % b["resource"]["name"],
                   "it is serving %s" % short_path(b["serving"] or "?"))


def render_block(plan):
    """A Plan whose verdict is 'deny' as the text a session reads.

    A 'warn' too — the one the service probe raises when something is listening
    that agent-bus did not start. It is a sentence rather than a block, but it
    carries an exit like every other refusal and there is no reason for a second
    function to compose it.

    Every runnable line in here comes out of `plan["exits"]`. Nothing in this
    function builds a command, and that is the whole of what this milestone
    changes: advice the guard would refuse is no longer something this function
    is able to print, because it does not know how to write one down."""
    b = plan.get("blocker") or {}
    reason = plan.get("reason")

    if reason == "no-such-resource":
        # The one refusal that belongs to the command-line verbs rather than to
        # the guard: a name nothing in this repository declares. It is rendered
        # here anyway, because it is a Plan saying no and a second place that
        # turns a Plan into English is the defect this milestone is closing.
        return "\n".join([
            "agent-bus: no resource named '%s' in this repo's config. "
            "`<resource>@<instance>` names one of several — one device of the "
            "three the machine has — and the part before the '@' has to be a "
            "declared resource." % b["base"],
            _exit_line(plan, "status", width=20),
        ])

    if reason == "wrong-port":
        # The facts and what they are worth come from `wrong_port_said`, which is
        # also what the announcement reads out when somebody switches this block
        # off — one wording, two audiences.
        facts, worth = wrong_port_said(plan)
        return "\n".join([
            'agent-bus: BLOCKED. This command is aimed at :%d, which is not '
            'this checkout\'s.' % b["port"],
            "",
        ] + facts + [
            "",
        ] + worth + [
            "",
            "Use yours:",
            _exit_line(plan, "env", width=26, mark="# "),
            _exit_line(plan, "port", width=26, mark="# "),
            "",
            "(If you really do mean another checkout's, say so: %s.)"
            % _exit_cmd(plan, "off"),
        ])

    if reason == "service-unknown":
        res = b["resource"]
        return ("agent-bus: something is listening on %s that agent-bus did not "
                "start, so which checkout it serves is unknown — the result you "
                "get may belong to another worktree. `%s` restarts it from yours."
                % (res.get("port") or res["name"], _exit_cmd(plan, "serve")))

    if reason == "service-elsewhere":
        res, started = b["resource"], b.get("started") or {}
        lines = [
            'agent-bus: BLOCKED. "%s" (%s) is serving a different checkout, so '
            "this command would exercise that code and report it as yours."
            % (res["name"], res.get("desc", "shared service")),
            "",
            "  serving   : %s" % short_path(b["serving"] or "?"),
            "  you are in: %s" % short_path(b["mine"]),
        ]
        if started.get("by"):
            lines.append("  started by: %s, %s"
                         % (started["by"], ago(started.get("started"))))
        if b.get("also"):
            # Said before the advice, because it is what makes the advice make
            # sense. Without it the reader answers this block with one
            # `agentbus serve`, runs the command again, and gets the next one.
            lines.append("  also theirs: %s" % ", ".join(b["also"]))
        if res.get("why"):
            lines += ["", "  " + res["why"]]
        lines += [
            "",
            "One step, and the shortest one: this points every service your",
            "command needs at your worktree, takes their locks, runs your",
            "command against your own tree and tells the other sessions:",
            "  %s" % _exit_cmd(plan, "run"),
            "",
            "Or move them for good, and run your command yourself afterwards:",
            "  %s" % _exit_cmd(plan, "serve"),
        ]
        return "\n".join(lines)

    res, lock, holder = b["resource"], b["lock"], b["holder"]
    lines = [
        'agent-bus: BLOCKED. "%s" (%s) is in use by another live Claude Code '
        'session.' % (res["name"], res.get("desc", "shared resource")),
        "",
        "  holder    : %s   branch %s" % (b["who"], holder.get("branch") or "-"),
        "  worktree  : %s%s" % (short_path(holder.get("root", "")),
                                "   (the same one you are in)"
                                if b["same_tree"] else ""),
        "  held for  : %s   (%s lock)" % (held_for(lock.get("acquired_at")),
                                          lock.get("mode", "soft")),
        "  last seen : %s" % ago(holder.get("beat")),
    ]
    if lock.get("why"):
        lines.append('  doing     : "%s"' % lock["why"])
    if res.get("_implied_by"):
        lines += ["", "  Your command drives '%s', which is only meaningful against "
                      "the '%s' serving your worktree — so it needs that too."
                  % (res["_implied_by"], res["name"])]
    if b["unidentified"]:
        lines += ["", "  One of this session's agents took this through a shell, "
                      "where nothing can",
                  "  tell one agent from another — so agent-bus cannot say "
                  "whether it is yours.",
                  "  If it is yours, say so and take it. Nothing here can "
                  "confirm that it is, so",
                  "  this goes on the bus as a takeover and whoever holds it "
                  "sees that it moved:"]
        if _exit_cmd(plan, "adopt"):
            lines.append("    %s" % _exit_cmd(plan, "adopt"))
        lines += ["  If it is not, wait for it, or give it back if you know it "
                  "is finished:",
                  "    %s" % _exit_cmd(plan, "wait"),
                  "    %s   (%s)" % (_exit_cmd(plan, "release"),
                                     _exit_when(plan, "release"))]
        if res.get("why"):
            lines += ["", "  " + res["why"]]
    elif b["sibling"]:
        # Two subagents of one session. Nothing here is about checkouts — they
        # share one — so the same-checkout wording below would be answering a
        # question nobody asked, while the resource's own `why` is exactly the
        # point: one of the thing, two of you.
        lines += ["", "  You are two agents of the same session, running at the "
                      "same time. Wait for theirs to finish — an automatic claim "
                      "lasts only as long as one command — or split the work so "
                      "you are not both driving it."]
        if res.get("why"):
            lines += ["", "  " + res["why"]]
    elif b["same_tree"]:
        # The configured `why` explains cross-worktree damage. Two sessions in
        # ONE checkout are running the same code, so quoting it here would state
        # something the agent can see is false — and an agent that catches the
        # bus being wrong is an agent that starts working around it.
        lines += ["", "  You are both in this checkout, so the result would be "
                      "yours either way — but you would be running it twice at "
                      "once against one service. Wait for their command to end; "
                      "automatic claims last only as long as the command."]
    elif res.get("why"):
        lines += ["", "  " + res["why"]]
    if b["also"]:
        lines.append("  Also in use: %s" % ", ".join(b["also"]))
    lines += [
        "",
        "Do not work around this by editing the command: a different port, a",
        "direct binary path or a subshell all reach the same service.",
        "",
        # The way through first, and on its own. It used to be the third line of
        # a list of three, under two that change nothing — so the shortest
        # correct route was the one a reader found last, while the bypass was in
        # a paragraph of its own further down. That is the whole of why the guard
        # was overridden 85 times against 6 real blocks in 48 hours.
        "Queue for it. One command, however many of them are in the way — it",
        "takes each as it frees, and then your own command runs:",
        "  %s" % _exit_cmd(plan, "wait"),
        "",
        # The second half of the same action, and the reason the queue is worth
        # joining rather than polling: the holder can see a waiter now
        # (`agentbus status` shows it on the lock) but a message is what makes
        # it look. Queue first and then say so, in that order — a message
        # without a queue entry asks somebody to do something you have not
        # arranged to receive, and waiting for a reply before queueing turns a
        # three-second block into a round trip.
        "Then tell them it is queued. A message wakes them — an idle session",
        "acts on one within seconds, without its human — so this is worth doing",
        "and not a formality. Your queue place is what ends with your command",
        "running; the message only makes it sooner:",
        _exit_line(plan, "ask"),
        _exit_say(plan, "ask"),
        "",
        "Or find out more first, which changes nothing:",
        _exit_line(plan, "status"),
    ]
    if res.get("hint"):
        lines += ["", "  " + res["hint"]]
    lines += [
        "",
        "If this command does not touch %s at all — a different host, a remote"
        % res["name"],
        "or staging server, a throwaway container — then it is not what this",
        "guard is for. Say so and it runs:",
        "  %s" % _exit_cmd(plan, "off"),
        "That is recorded on the bus, so use it when it is true and not to get",
        "past a queue. Worth telling whoever maintains the config, too: an",
        '"unless" pattern on the resource stops it matching next time.',
        "",
        "(Last resort, %s: `%s`.)" % (_exit_when(plan, "steal"),
                                      _exit_cmd(plan, "steal")),
    ]
    return "\n".join(lines)


def render_refusal(plan, note=""):
    """A command-line verb saying no, in the CLI's voice, with the Plan's exits.

    Not `render_block`. That is a session's screen-wide banner about a Bash
    command the guard stopped, and almost none of it is true of `agentbus claim
    db` typed by a person: there is no tool call to explain, no "do not work
    around this by editing the command", and no `AGENTBUS_OFF` to put in front
    of anything. What the two do share is the part that kept being wrong — the
    runnable lines underneath. Those come out of `plan["exits"]` here as well,
    so a verb cannot advertise a command the tool would refuse any more than a
    block can, which before that milestone is exactly what `agentbus serve`
    did: it composed a line of its own telling the reader to post."""
    b = plan.get("blocker") or {}
    if plan.get("reason") != "lock-held":
        return render_block(plan)
    lock = b["lock"]
    lines = ["agent-bus: '%s' is held by %s (%s, %s)%s"
             % (b["exit_name"], b["who"], lock.get("mode", "soft"),
                held_for(lock.get("acquired_at")), note or ".")]
    if lock.get("why"):
        lines.append('  doing: "%s"' % lock["why"])
    if b["also"]:
        lines.append("  Also in use: %s" % ", ".join(b["also"]))
    lines.append("")
    lines += [_exit_line(plan, e["id"]) for e in plan.get("exits", [])]
    return "\n".join(lines)


def guard_bash(me, cmd, sessions, payload_tool_use_id=None):
    """Decide one Bash command: plan it, commit it, and say no if it comes to
    that.

    Four steps and no fifth. Everything that used to live here — which resources
    a command touches, under what names they are locked, who is in the way, and
    the hundred lines of English that told the reader what to run instead — is
    in the Plan now, and this function's whole remaining job is the order those
    steps happen in.

    `agentbus wait`, `agentbus release` and `agentbus claim --steal` are the
    three commands whose entire purpose is to act on a lock somebody else holds.
    Guarding them would mean refusing the way out of a block, which is what the
    block itself tells the reader to do; `explicit_resources` marks them
    `_passthrough` and `plan_for` drops them."""
    plan = plan_for(me, cmd, sessions=sessions)
    if plan["reason"] == "opted-out":
        # Said out loud, because a guard everybody can step over quietly is not
        # a guard. This is the only place the plugin lets a command past a
        # decision it would otherwise have made — and the line now names what
        # was stepped over, so a reader can tell the six maestro runs from the
        # eighty `sleep 30`s. An opt-out that overrode nothing is not a step over
        # the guard at all; see `plan_for`.
        #
        # The wrong-port one first, and instead of the ordinary line rather than
        # beside it — the same precedence `plan_for` gives the two when it is
        # allowed to decide, and for the same reason: "ran past the guard on
        # 'api'" is a weaker statement of the same event, and printing both would
        # put two lines in the feed for one command. Announced rather than logged
        # because the cost of this one lands on other people; see `note_astray`.
        b = plan.get("blocker") or {}
        over = b.get("overrode") or []
        if b.get("wrong"):
            note_astray(me, b["wrong"])
        elif over:
            emit(me.get("sid"), me.get("agent"), me.get("repo_key"), "block",
                 "ran past the guard on %s with AGENTBUS_OFF — %s"
                 % (", ".join("'%s'" % n for n in over), redact(cmd.strip())[:120]))
        return
    plan = commit_plan(plan, me, sessions, payload_tool_use_id)
    if plan["verdict"] == "allow":
        # After the claim, and undone below if it denies. The precedence is
        # load-bearing and was undocumented: a command touching both a held
        # resource and a mis-served one reports the lock, because the lock is
        # the one another session is actually using. `plan_for` can fold this in
        # itself with `probe_services=True`; the guard does not use that, so
        # that a command refused here has already taken and given back what it
        # asked for, exactly as it did before.
        plan = serving_check(plan, me)
        if plan["verdict"] == "deny":
            for name in plan["taken"]:
                do_release(me, name, quiet=True)
            forget_autoclaim(payload_tool_use_id)
    if plan["verdict"] == "deny":
        note_plan_block(me, plan)
        deny(render_block(plan))
    elif plan["verdict"] == "warn":
        note_ctx(render_block(plan))


def file_lock_name(path):
    return "file:%s" % path


def guard_file(me, path, sessions):
    if not path:
        return
    path = os.path.realpath(path)
    # An explicit claim is the way out of a file block, so it has to actually do
    # something: the previous message advertised a command that guard_file never
    # consulted, which left a blocked session with no exit but the clock.
    mine = load_lock(me.get("repo_key"), file_lock_name(path))
    if mine and mine.get("sid") == me.get("sid"):
        return
    if mine:
        holder = next((s for s in sessions if s["sid"] == mine.get("sid")), None)
        if holder:
            deny("agent-bus: BLOCKED. %s has explicitly claimed this file:\n\n"
                 "  file  : %s\n  since : %s\n  reason: %s\n\n"
                 "Ask before taking it:\n%s\n"
                 "  agentbus claim 'file:%s' --steal --why \"they agreed\""
                 % (holder.get("agent"), short_path(path),
                    held_for(mine.get("acquired_at")), mine.get("why") or "-",
                    say_to(holder,
                           about="I need %s — are you done with it?"
                                 % short_path(path)), path))
            return
    # Declared ownership comes before the reactive check: it is the whole point
    # of declaring one that the block does not wait for somebody to write the
    # file first. At most one of these speaks — two note_ctx calls would put two
    # JSON documents on stdout and corrupt the session's view of the hook.
    verdict, text = ownership_verdict(me, path, sessions)
    if verdict == "deny":
        note_block(me, short_path(path), "somebody has declared it theirs")
        deny(text)
        return
    if verdict == "note":
        note_ctx(text)
        return
    cutoff = now() - COLLIDE_WINDOW
    same_tree, same_repo = [], []
    for s in sessions:
        if s["sid"] == me.get("sid"):
            continue
        writes = recent_writes(s["sid"], cutoff)
        hit = next((w for w in reversed(writes) if os.path.realpath(w[1]) == path), None)
        if hit and s.get("root") == me.get("root"):
            same_tree.append((s, hit))
        elif s.get("repo_key") == me.get("repo_key"):
            rel = os.path.relpath(path, me.get("root") or "/")
            other = os.path.join(s.get("root") or "/", rel)
            hit2 = next((w for w in reversed(writes)
                         if os.path.realpath(w[1]) == os.path.realpath(other)), None)
            if hit2:
                same_repo.append((s, hit2))
    if same_tree:
        s, hit = same_tree[0]
        note_block(me, short_path(path), "%s is editing it" % s.get("agent"))
        deny("\n".join([
            "agent-bus: BLOCKED. Another live session is editing this exact file in "
            "this exact checkout — your write would be made on top of theirs, or "
            "theirs on top of yours.",
            "",
            "  file    : %s" % short_path(path),
            "  other   : %s  (branch %s, wrote it %s)" % (
                s.get("agent"), s.get("branch") or "-", ago(hit[0])),
            "  worktree: %s   (the same one you are in)" % short_path(s.get("root", "")),
            "",
            "Split the work or take turns:",
            say_to(s, about="I need this file for <reason>"),
            "  agentbus status",
            "",
            "Once they have agreed, take it and the block lifts for you and",
            "applies to them instead:",
            "  agentbus claim 'file:%s' --why \"agreed with %s\"" % (path, s.get("agent")),
            "",
            "(Or the human can rerun the edit with AGENTBUS_OFF=1 in front of it.)",
        ]))
        return
    if same_repo:
        s, hit = same_repo[0]
        note_ctx("agent-bus: %s edited the same file on %s %s (different worktree, "
                 "so no conflict now — but expect it at merge time)."
                 % (s.get("agent"), s.get("branch") or "-", ago(hit[0])))


def hook_session_end(payload):
    sid = payload.get("session_id") or os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not sid:
        return
    rec = read_json(os.path.join(SESSIONS, "%s.json" % sid))
    if rec and len(load_sessions()) > 1:
        rec["sid"] = sid
        # Just that it has gone. A session used to leave a summary of what it had
        # done, assembled from its writes and its locks; 3.0.0 dropped it,
        # because the one moment a session cannot compose a message is the moment
        # it is ending, and a summary nobody can reply to was the last thing on
        # this bus still pretending to be conversation. What replaces it is a
        # session saying so itself, while it still can.
        emit(sid, rec.get("agent"), rec.get("repo_key"), "leave", "session ended")
    forget_session(sid)
    refresh_derived()


def hook_record_write(payload):
    """Fallback only: the shell fast path normally records writes itself."""
    if read_int(LIVEFILE, 0) < 2:
        return
    # Only the session id is wanted, and only from a session that has a record:
    # a write log filed under a session nobody has ever heard of is read by
    # nothing. The party does not come into it — a write is filed against the
    # session, because the ownership guard is about the checkout, not about
    # which of its agents touched the file.
    record, _ = resolve_party(payload)
    if not record:
        return
    sid = record["sid"]
    ti = payload.get("tool_input") or {}
    path = ti.get("file_path") or ti.get("notebook_path")
    if not path:
        return
    try:
        with open(os.path.join(WRITES, "%s.log" % sid), "a",
                  encoding="utf-8") as fh:
            fh.write("%d %s\n" % (now(), path))
    except OSError:
        pass


# ------------------------------------------------------------------- cli ----

def need_party():
    """(record, view) for a command-line verb, or the not-attached message.

    Two answers rather than one because they are used for opposite things.
    `agentbus claim --as X` decides as a subagent; `agentbus name` writes what
    it is handed to the session file. Handing one value to both is how a
    subagent's identity would end up in its parent's record."""
    record, view = resolve_party()
    if not record:
        print("agent-bus: this shell is not attached to a registered session.\n"
              "Start a new Claude Code session, or run `agentbus register`.",
              file=sys.stderr)
        sys.exit(1)
    return record, view


def need_me():
    """The party running this command, rooted where its shell is standing."""
    return need_party()[1]


def need_record():
    """This session's own dict, for the two verbs that write it straight back."""
    return need_party()[0]


def cli_status(_args):
    sessions = load_sessions(reap=True)
    refresh_derived(sessions)
    # Read-only: the view, because "which of these rows is me" is a question
    # about the caller, and nothing here is written back.
    _, me = resolve_party()
    if not me:
        # Run from a shell that is not a registered session: report on whatever
        # repository the caller is standing in.
        root, repo_key, label, _ = git_facts(os.getcwd())
        me = {"sid": "", "repo_key": repo_key, "root": root, "repo_label": label}
    for other, why in unwired_copies():
        print("!  %s is the copy Claude Code loads, and it %s.\n"
              "   Until you re-run the installer no hook in it fires, so\n"
              "   sessions are not registering and this roster is a guess:\n"
              "     %s install\n"
              % (short_path(other), why,
                 os.path.join(other, "bin", "agentbus")))
    print("agent-bus — %d live session%s" % (len(sessions), "" if len(sessions) == 1 else "s"))
    for s in sessions:
        mark = "*" if s["sid"] == me.get("sid") else " "
        # The address under the row, for the same reason the banner carries one:
        # this is the other place an agent looks to find out who is here, and a
        # roster that names somebody without saying how to reach them is a
        # roster that gets a message sent to a name nobody answers to.
        addr, cc_status = address_of(s.get("sid"), s.get("pid"))
        print(" %s %-18s %-42s %-28s %s" % (
            mark, s.get("agent"), short_path(s.get("root", "")),
            s.get("branch") or "-", ago(s.get("beat"))))
        if s["sid"] != me.get("sid"):
            print("   %-18s SendMessage → to \"%s\"%s"
                  % ("", addr, "   (%s)" % cc_status if cc_status else "")
                  if addr else
                  "   %-18s no address — run ListAgents to find it" % "")
        for a in load_agents(s["sid"]):
            print("   %-18s %-42s %-28s %s" % (
                "  · " + (a.get("name") or "?"), short_path(a.get("root", "")),
                a.get("branch") or "-", a.get("agent_type") or ""))
    print()
    lk = locks_text(me, sessions)
    print(lk if lk else "No shared resources declared for this repo "
                        "(`agentbus init-repo` to add some).")
    owned = ownership_text_block(me, sessions)
    if owned:
        print("\n" + owned)
    recent = read_events(after=max(0, read_int(SEQFILE, 0) - 15))
    if recent:
        print("\nRecent:")
        for r in recent[-8:]:
            print("  %-16s %-9s %s" % (r.get("agent"), ago(r.get("ts")), r.get("text")))


def cli_whois(_args):
    for s in load_sessions():
        print("%-18s %-42s %s" % (s.get("agent"), short_path(s.get("root", "")),
                                  s.get("branch") or "-"))
        for a in load_agents(s["sid"]):
            print("  · %-16s %-42s %s" % (
                a.get("name"), short_path(a.get("root", "")),
                a.get("agent_type") or ""))


def opt(args, name, default=None):
    if name in args:
        i = args.index(name)
        if i + 1 < len(args):
            return args[i + 1]
    return default


def flag(args, name):
    return name in args


def positional(args):
    out, skip = [], False
    for i, a in enumerate(args):
        if skip:
            skip = False
            continue
        if a.startswith("--"):
            if a in ("--why", "--to", "--timeout", "--as", "--note", "--needs"):
                skip = True
            continue
        out.append(a)
    return out


def cli_claim(args):
    me = acting(need_me(), args)
    pos = positional(args)
    if not pos:
        print("usage: agentbus claim <resource>[,<resource>] [--why \"...\"] "
              "[--steal] [--as <you>]", file=sys.stderr)
        sys.exit(1)
    steal, why = flag(args, "--steal"), opt(args, "--why", "")
    plan = plan_for(me, names=pos[0])
    if plan["reason"] == "no-such-resource":
        print(render_block(plan), file=sys.stderr)
        sys.exit(1)
    if plan["verdict"] == "deny" and not steal:
        # Refused before anything is taken, from the same optimistic check the
        # guard makes. Taking what is free and handing it back on the way out
        # would be correct and still wrong: a hard claim speaks on the bus, so
        # `claim rig,bundler` that cannot have the bundler would leave "took
        # 'rig'" and "released 'rig'" behind it for a claim that never happened.
        print(render_refusal(plan), file=sys.stderr)
        sys.exit(1)
    taken = []
    for res in plan["resources"]:
        ok, lock, holder, reason = do_claim(me, res["lock"], why=why,
                                            mode="hard", steal=steal)
        if not ok:
            for name in taken:
                do_release(me, name, quiet=True)
            if not holder:
                print("agent-bus: could not claim '%s': %s"
                      % (_named(res), reason), file=sys.stderr)
                sys.exit(1)
            # The check above ran outside the mutex and lost the race to it.
            # `do_claim`'s answer is the one that counts — the rule
            # `commit_plan` states for the guard — and the refusal is built by
            # the same constructor rather than written out a second time here.
            print(render_refusal(_lock_block(me, "", res, lock, holder,
                                             plan["resources"])),
                  file=sys.stderr)
            sys.exit(1)
        taken.append(res["lock"])
        # The shell fast path filters an Edit against hot-for, and a file claim
        # is neither a recent write nor a declared glob — so without this the
        # block it exists to produce does not start until somebody's next turn.
        # Same argument as `own`: a claim the others learn about later is not a
        # claim. See rebuild_hot.
        if res["lock"].startswith("file:"):
            refresh_derived()
        print("claimed '%s'" % _named(res))
    # Asked of the resources the Plan resolved, not of the string that was
    # typed. `<resource>@<instance>` is what the block about one device
    # advertises and therefore what an agent reaches for, and as a bare string
    # it matches no declared resource — so the claim that most needs this
    # warning was the one that lost it: you hold the device and not the bundler
    # it is only meaningful against.
    _, implied = expand_implied([r["name"] for r in plan["resources"]], me)
    if implied:
        # Not expanded silently: a claim is deliberate, and expanding it would
        # hold more than the caller asked for. But holding the simulator while
        # somebody else re-serves the bundler under you is the trap this exists
        # to prevent, so it is said out loud instead.
        #
        # One command, which is what it advertised before M1 and could not
        # honour: `explicit_resources` splits a comma list and no verb did, so
        # the guard understood `agentbus claim rig,bundler` while this one wrote
        # a single lock named after the list and held neither of them. M1 broke
        # the line into one command per resource rather than teach this verb a
        # second copy of that split; `plan_for(names=…)` is where it belongs and
        # the line is one command again.
        print("note: '%s' implies %s, which you have NOT taken. "
              "`agentbus claim %s` if the run needs them held too."
              % (pos[0], ", ".join(implied), ",".join(implied)))


def cli_release(args):
    me = acting(need_me(), args)
    if flag(args, "--all"):
        print("released %d" % release_all(me["sid"]))
        return
    pos = positional(args)
    if not pos:
        print("usage: agentbus release <resource>[,<resource>] | --all "
              "[--as <you>]", file=sys.stderr)
        sys.exit(1)
    plan = plan_for(me, names=pos[0])
    if plan["reason"] == "no-such-resource":
        print(render_block(plan), file=sys.stderr)
        sys.exit(1)
    for res in plan["resources"]:
        key, name = res["lock"], _named(res)
        if do_release(me, key):
            if key.startswith("file:"):
                refresh_derived()      # and the block lifts in the same second
            print("released '%s'" % name)
            continue
        lock = load_lock(me.get("repo_key"), key)
        if lock and lock.get("sid") == me.get("sid") and lock.get("agent_id"):
            # Somebody in this session holds it, and this caller cannot show it
            # is them. Refusing beats guessing: a sibling handing back another
            # agent's rig mid-run is the failure this is here to stop.
            print("agent-bus: '%s' is held by %s, one of this session's agents, "
                  "and nothing in a shell can tell which agent is asking. Say "
                  "so, or give back everything you hold:\n"
                  "  agentbus release %s --as %s\n"
                  "  agentbus release --all"
                  % (name, lock.get("agent"), name, lock.get("agent")),
                  file=sys.stderr)
            sys.exit(1)
        print("not yours: '%s'" % name)


def cli_wait(args):
    me = acting(need_me(), args)
    pos = positional(args)
    if not pos:
        print("usage: agentbus wait <resource>[,<resource>] [--timeout 300] "
              "[--why \"...\"] [--as <you>]", file=sys.stderr)
        sys.exit(1)
    why = opt(args, "--why", "")
    plan = plan_for(me, names=pos[0])
    if plan["reason"] == "no-such-resource":
        print(render_block(plan), file=sys.stderr)
        sys.exit(1)
    # Below the Bash tool's own default timeout, so the wait reports back rather
    # than being killed with its queue entry left behind. One deadline for the
    # whole list rather than one each: a caller waiting for three things has a
    # command to run after them, and three timeouts in a row is four and a half
    # minutes of a tool call that was told to take ninety seconds.
    deadline = time.time() + int(opt(args, "--timeout", "90"))
    for res in plan["resources"]:
        # The key is what the lock lives under; `_named` is what a person typed
        # and what every message says back to them. For a worktree-scoped
        # resource these differ, and showing the key would be answering in the
        # plugin's private vocabulary. For an instance they are the same string
        # — `simulator@ABC123` is the key and it is also what the block told the
        # reader to type, so echoing it back is answering in theirs.
        key, name = res["lock"], _named(res)
        announced = False
        while True:
            ok, lock, holder, _ = do_claim(me, key, why=why, mode="hard")
            if ok:
                print("claimed '%s'" % name)
                break
            if not announced:
                enqueue(me, key)
                emit(me["sid"], me["agent"], me["repo_key"], "waiting",
                     "waiting for '%s'%s" % (name, (' — ' + why) if why else ""),
                     to=(lock or {}).get("agent") or holder.get("agent"))
                announced = True
                print("'%s' is held by %s; queued." % (name, holder.get("agent")),
                      file=sys.stderr)
            if time.time() > deadline:
                # Whatever earlier names in the list were taken stay taken, the
                # same way `agentbus claim` leaves a partial list alone once it
                # has spoken for it. Giving them back would race the session
                # that is about to be told this one is queueing.
                # And leave the queue. A waiter that has given up but is still
                # listed asks the holder for something nobody wants any more —
                # and the queue is now on the holder's screen, so a stale entry
                # is not a harmless row in a file: it is a request to hand over
                # a resource to somebody who has gone.
                dequeue(me, key)
                print("timed out waiting for '%s'" % name, file=sys.stderr)
                sys.exit(1)
            time.sleep(3)


def dequeue(me, res):
    """Take this party out of a lock's queue."""
    with Mutex("lock-" + re.sub(r"[^A-Za-z0-9]", "_", res)[:40]):
        lock = load_lock(me["repo_key"], res)
        if not lock:
            return
        keep = [x for x in lock.get("queue", []) if x.get("sid") != me["sid"]]
        if len(keep) != len(lock.get("queue", [])):
            lock["queue"] = keep
            write_json(lock_path(me["repo_key"], res), lock)


def enqueue(me, res):
    with Mutex("lock-" + re.sub(r"[^A-Za-z0-9]", "_", res)[:40]):
        lock = load_lock(me["repo_key"], res)
        if not lock:
            return
        q = [x for x in lock.get("queue", []) if x.get("sid") != me["sid"]]
        q.append({"sid": me["sid"], "agent": me["agent"], "at": now()})
        lock["queue"] = q
        write_json(lock_path(me["repo_key"], res), lock)


def speak_as(me, name):
    """The name this caller may sign a message with: its own, or one of its own
    subagents'. Not anybody else's — a name on this bus is worth something only
    because it says who actually spoke."""
    if not name or name == me.get("agent"):
        return me.get("agent")
    for a in load_agents(me.get("sid")):
        if a.get("name") == name:
            return name
    return None


def act_as(me, name):
    """`me`, acting as one of this session's own subagents.

    The last resort for identity. A subagent's environment is its parent's, so
    a `agentbus claim` buried in a runner script cannot be attributed — the
    guard never saw the command line, so there is no hint to pick up either.
    Saying the name outright is the only thing left, and it is better than a
    lock that has to admit it does not know whose it is.

    Only the identity is adopted. The worktree stays whatever the caller's own
    shell says it is, because that is measured now and the agent's record was
    written when it started."""
    if not name or name == me.get("agent"):
        return me
    for a in load_agents(me.get("sid")):
        if a.get("name") == name:
            view = dict(me)
            view["agent_id"] = a.get("agent_id")
            view["agent"] = name
            view["party_known"] = True
            return view
    return None


def acting(me, args):
    """`me`, after honouring a `--as <name>` on this command line."""
    name = opt(args, "--as")
    if not name:
        return me
    view = act_as(me, name)
    if view is None:
        print("agent-bus: '%s' is not you or one of your subagents. "
              "`agentbus whois` lists who is who." % name, file=sys.stderr)
        sys.exit(1)
    return view


def whom(name, sessions=None):
    """(session, party) for a name somebody typed, in either name space.

    A reader who has been told to message `orches` should not have to know
    whether that is what this plugin calls the session, what Claude Code calls
    it, or the name of a subagent inside it. All three resolve, because all
    three are names a block message might have printed at some point."""
    if not name:
        return None, ""
    sessions = load_sessions() if sessions is None else sessions
    for s in sessions:
        if s.get("agent") == name:
            return s, ""
    for s in sessions:
        for a in load_agents(s.get("sid")):
            if a.get("name") == name:
                return s, name
    for rec in cc_sessions().values():
        if rec["alive"] and rec["name"] == name:
            for s in sessions:
                if s.get("sid") == rec["sid"]:
                    return s, ""
            # Live, addressable, and not on this bus. There is no session record
            # to return, but there is an address, which is all the caller wants.
            return {"sid": rec["sid"], "pid": rec["pid"], "agent": rec["name"]}, ""
    return None, ""


# `post` and `inbox` do not deliver anything any more, and do not pretend to.
#
# They could simply have been deleted. They are kept for one release because the
# habit of using them is not only in agents' heads: it is in this plugin's own
# rules text, in two READMEs, in the `hint` field of other repositories'
# .claude/agent-bus.json files, and in several sessions' memory. A verb that
# vanishes teaches a reader nothing; one that answers with the call that does
# work teaches them once, and the non-zero exit is what stops an agent believing
# a message went somewhere.

MOVED = "agent-bus no longer carries messages — Claude Code does."


def cli_post(args):
    me = need_me()
    pos = positional(args)
    text = " ".join(pos).strip()
    to = opt(args, "--to")
    everywhere = flag(args, "--all")
    sessions = load_sessions()
    print(MOVED, file=sys.stderr)
    print(file=sys.stderr)

    if to:
        target, party = whom(to, sessions)
        if not target:
            print("Nothing live is called %r. `ListAgents` lists every session "
                  "on this machine, and its names are the addresses." % to,
                  file=sys.stderr)
            sys.exit(2)
        print("Send it yourself — the tool wakes them, which this never did:",
              file=sys.stderr)
        print(file=sys.stderr)
        print(say_to(target, party), file=sys.stderr)
        if text:
            print(file=sys.stderr)
            print("  message: %s" % (text if len(text) < 300
                                     else text[:297] + "..."), file=sys.stderr)
        sys.exit(2)

    # The broadcast, which is the one shape SendMessage does not have. Said
    # plainly rather than papered over: a reseed that invalidates every id in the
    # database is exactly the case this plugin exists for, and it is now several
    # calls instead of one.
    peers = [s for s in sessions if s.get("sid") != me.get("sid")]
    if not everywhere:
        peers = [s for s in peers if s.get("repo_key") == me.get("repo_key")]
    scope = "on this machine" if everywhere else "on this repo"
    if not peers:
        print("Nothing to tell: no other session is %s." % scope, file=sys.stderr)
        sys.exit(2)
    print("It addresses one session at a time, and %d %s %s:"
          % (len(peers), "session is" if len(peers) == 1 else "sessions are",
             scope), file=sys.stderr)
    print(file=sys.stderr)
    for s in peers:
        print(say_to(s), file=sys.stderr)
    print(file=sys.stderr)
    if len(peers) > 1:
        print("That is %d calls rather than one — the broadcast is the shape "
              "SendMessage does not have." % len(peers), file=sys.stderr)
    print("`ListAgents` also lists sessions this bus cannot see.",
          file=sys.stderr)
    sys.exit(2)


def cli_inbox(_args):
    me = need_me()
    print("agent-bus has no inbox: a message from another session arrives in "
          "this conversation, not here.", file=sys.stderr)
    print(file=sys.stderr)
    # Not empty-handed, because the bus does still tell you things — it just
    # tells you them unasked, and only when they are facts about the machine
    # rather than sentences somebody wrote.
    shown = [r for r in read_events(after=0)
             if interesting_to(r, me)][-8:]
    if shown:
        print("What it does still record for you:", file=sys.stderr)
        for r in shown:
            print("  %-16s %-9s %s" % (r.get("agent"), ago(r.get("ts")),
                                       r.get("text")), file=sys.stderr)
    else:
        print("Nothing has happened to you that the bus would have told you "
              "about.", file=sys.stderr)
    sys.exit(2)


def watch_line(r, width=None):
    """One event, formatted for a human reading over the agents' shoulders."""
    when = time.strftime("%H:%M:%S", time.localtime(r.get("ts", 0)))
    who = r.get("agent", "?")
    kind = r.get("kind", "?")
    repo = (r.get("repo") or "").split(":")[0]
    to = " → %s" % r["to"] if r.get("to") else ""
    head = "%s  %-20s %-8s %-14s" % (when, (who + to)[:20], kind, repo[:14])
    text = (r.get("text") or "").rstrip()
    if "\n" not in text:
        return head + text
    pad = " " * 10
    return head + text.split("\n")[0] + "\n" + "\n".join(
        pad + ln for ln in text.split("\n")[1:])


def cli_watch(args):
    """Follow what every agent on this machine is doing, as it happens.

    `status` is a snapshot and `inbox` is what was addressed to you. Neither
    answers "what is going on right now", which is the question somebody with
    four terminals open actually has — and until refusals were recorded as
    events, nothing answered "did it stop anything today" either.

    Polling, not inotify: two file reads a second, no dependency, same on both
    platforms."""
    only_repo = flag(args, "--repo")
    tail = int(opt(args, "-n", "15"))
    me = None
    if only_repo:
        _, me = resolve_party()     # read-only: only `repo_key` is wanted
        if not me:
            root, repo_key, label, _ = git_facts(os.getcwd())
            me = {"repo_key": repo_key}
    seq = read_int(SEQFILE, 0)
    start = max(0, seq - tail)
    print("agent-bus — following%s. Ctrl-C to stop.\n"
          % (" this repository" if only_repo else " every repository"))
    shown = start
    try:
        while True:
            for r in read_events(after=shown):
                shown = max(shown, r.get("i", 0))
                if only_repo and r.get("repo") != me.get("repo_key"):
                    continue
                print(watch_line(r))
                sys.stdout.flush()
            time.sleep(0.8)
    except KeyboardInterrupt:
        print()


