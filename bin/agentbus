 top:var(--fh);height:2px;background:var(--ground)}
.left{grid-area:left;display:grid;row-gap:8px;margin-top:7px;
 grid-template-columns:repeat(auto-fill,minmax(322px,1fr))}
/* What this checkout would land belongs to the CHECKOUT and not to any agent
   standing on it, so it starts on the heading's line — and it spans down past
   the figures rather than sitting inside the heading row, because it runs to
